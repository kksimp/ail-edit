            "The font size in points (also Ctrl-+, Ctrl--, Ctrl-0)",
        ),
        row(
            "fontfamily",
            "Font family",
            Kind.Text,
            "mono",
            Scope.User,
            "The font's family name; `mono` is the system's monospace font",
        ),
        onoff(
            "restore",
            "Reopen tabs at start",
            "on",
            Scope.User,
            "Reopen the folder's tabs and carets",
        ),
        onoff("welcome", "Welcome screen", "on", Scope.User, "Show the welcome screen at start"),
        onoff(
            "gitmarks",
            "Git marks in the tree",
            "on",
            Scope.User,
            "Mark changed files in the tree",
        ),
        onoff(
            "surround",
            "Surround selection",
