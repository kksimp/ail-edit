## The settings model (parity plan C8, lane P12): every setting with its
## kind, default, description and scope, and the settings files' text. The
## user's file is `~/.ail-edit`; a project may hold `.ail-edit` in its root,
## which wins for project-scope settings only. Both are lines of
## `KEY VALUE`; a line starting with `#` is a comment. Lines this model
## doesn't know (`bind.KEY`, `open:DIR`, `agent.NAME`, a key from a newer
## editor) are kept in order, so a rewrite never loses them. Booleans are
## written `on` and `off`, as the file always has.

use themes

## What values a setting takes: one of `choices`; a whole number from
## `min` to `max`, both included; any text, spaces included; `on` or `off`.
pub enum Kind
    Choice(choices List[str])
    Int(min int, max int)
    Text
    Bool

## Which file may set it: `User` only `~/.ail-edit`; `Project` also the
## project's `.ail-edit`, which wins.
pub enum Scope
    User
    Project

## One setting.
pub struct Setting
    pub key str
    pub label str
    pub kind Kind
    pub default str
    pub description str
    pub scope Scope

## A mistake on one line of a settings file. `line` is 0-based.
pub struct Problem
    pub line int
    pub message str

## One `KEY VALUE` line.
struct Entry
    key str
    value str

## Font sizes the Settings list offers (as `workspace.FONTS`).
FONTS := ["14", "16", "18", "20", "24", "28", "32"]

## Key prefixes whose lines pass through unchecked: rebound keys, the
## remembered tabs of a directory, and agent commands.
PASS := ["bind.", "open:", "agent."]

## The key of the agent command rows: `agent.` and any name.
AGENT_ROW := "agent.NAME"

fn row(key str, label str, kind Kind, dflt str, scope Scope, does str) Setting
    Setting(key: key, label: label, kind: kind, default: dflt, description: does, scope: scope)

fn onoff(key str, label str, dflt str, scope Scope, does str) Setting
    row(key, label, Kind.Bool, dflt, scope, does)

## Every setting, in the order the Settings list shows them.
pub fn all() List[Setting]
    [
