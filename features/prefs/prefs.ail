            "Typing a bracket or quote over a selection surrounds it",
        ),
        onoff(
            "trim",
            "Trim spaces on save",
            "on",
            Scope.Project,
            "Remove spaces at line ends on save",
        ),
        onoff(
            "finalnewline",
            "Final newline on save",
            "on",
            Scope.Project,
            "End the file with one newline on save",
        ),
        onoff("wrap", "Word wrap", "off", Scope.User, "Wrap long lines at the window's width"),
        row(
            "treew",
            "Tree width",
            Kind.Int(min: 0, max: 200),
            "0",
            Scope.User,
            "The file tree's width in cells; 0 is automatic (set by dragging its edge)",
        ),
        row(
            "paneh",
            "Pane height",
            Kind.Int(min: 0, max: 200),
            "0",
            Scope.User,
            "The pane's height in rows; 0 is automatic (set by dragging the status bar)",
        ),
        row(
            "keymap",
            "Keymap",
            Kind.Choice(choices: ["classic", "vscode"]),
            "classic",
            Scope.User,
            "Which keys run which commands: `classic` (this editor's) or `vscode`",
        ),
        row(
            "autosave",
            "Auto save",
            Kind.Choice(choices: ["off", "afterdelay", "onfocuschange"]),
            "off",
            Scope.User,
            "Save changed tabs by themselves: never, after a pause in typing, or when the window loses focus",
        ),
        onoff(
            "formatonsave",
            "Format on save",
            "on",
            Scope.Project,
            "Format with `ail fmt` on save, when the program has no errors",
        ),
