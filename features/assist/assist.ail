@test fn hover_lays_out_for_a_width()
    h := hover_text(
        "fn half(n int) int",
        "Half of n.\n\nRounds down.",
        ["requires n >= 0"],
        ["io", "fs"],
        40,
    )
    assert_eq(h, [
        "fn half(n int) int",
        "",
        "Half of n.",
        "",
        "Rounds down.",
        "",
        "requires n >= 0",
        "effects: io, fs",
    ])
    w := hover_text("fn long(alpha int, beta int, gamma int) int", "", List[str](), List[str](), 20)
    assert_eq(w, ["fn long(alpha int,", "    beta int, gamma", "    int) int"])
    for wl in w
        assert(wl.len() <= 20)
    cut := hover_text("abcdefghijklmnopqrstuvwxyz", "", List[str](), List[str](), 10)
    for cl in cut
        assert(cl.len() <= 10)
    r := parse_row("fs.exists(path str) bool   (std.fs.4)") else return
    rh := row_hover(r, 60)
    assert_eq(rh, ["fs.exists(path str) bool", "", "rule std.fs.4 (ail explain std.fs.4)"])

@test fn live_check_waits_for_a_pause()
    mut lv := Live.new(500)
    assert(not lv.due(10000))
    lv.edited(1000)
    assert(not lv.due(1400))
    assert(lv.due(1500))
    g := lv.started(1500)
    assert(not lv.due(5000))
    assert(lv.finished(g, 1700))
    assert(not lv.due(9000))
    lv.enabled = false
    lv.edited(10000)
    assert(not lv.due(20000))

@test fn live_check_drops_stale_results()
    mut lv := Live.new(500)
    lv.edited(0)
    g := lv.started(600)
    lv.edited(700)
    assert(not lv.finished(g, 900))
    assert(lv.due(1200))

@test fn live_check_backs_off_on_slow_checks()
    mut lv := Live.new(500)
    lv.edited(0)
    g := lv.started(500)
    _ := lv.finished(g, 2500)
    assert_eq(lv.delay, 2000)
    lv.edited(3000)
    assert(not lv.due(4000))
    assert(lv.due(5000))
    g2 := lv.started(5000)
    _ := lv.finished(g2, 5100)
    assert_eq(lv.delay, 500)

@test fn doctor_output_parses()
    l1 := "ok    toolchain: /opt/ail"
    l2 := "warn  path: no `ail` on PATH; fix: add this line: export PATH=\"/opt/ail:$PATH\""
    l3 := "fail  cache: /x is not writable; fix: run chmod"
    out := "{l1}\n{l2}\n{l3}\n"
    d := parse_doctor(out)
    assert_eq(d.checks.len(), 3)
    assert(not d.ok)
    first := DoctorCheck(name: "toolchain", ok: true, status: "ok", message: "/opt/ail", fix: "")
    assert_eq(d.checks[0], first)
    assert_eq(d.checks[1].fix, "add this line: export PATH=\"/opt/ail:$PATH\"")
    assert_eq(d.checks[1].message, "no `ail` on PATH")
    assert_eq(problems(d).len(), 2)
    assert_eq(problems(d)[1], "cache: /x is not writable; fix: run chmod")
    good := parse_doctor("ok    version: 0.1.0, seed seed-2026.11.14b\nnoise\n")
    assert(good.ok)
    assert_eq(good.checks[0].message, "0.1.0, seed seed-2026.11.14b")

@test fn version_and_status_segment()
    v := "ail 0.1.0 (v0.1.0-3-g64f5cae, native)\n"
    assert_eq(parse_version(v), "0.1.0")
    assert_eq(parse_describe(v), "v0.1.0-3-g64f5cae")
    assert_eq(parse_describe("ail 0.1.0 (abc1234-dirty, native)"), "abc1234")
    assert_eq(parse_describe("ail 0.1.0 (unknown, native)"), "")
    assert_eq(parse_version("bash: ail: not found"), "")
    assert_eq(status_segment("0.1.0"), "ail 0.1.0")
    assert_eq(status_segment(""), "ail ?")

@test fn pin_mismatch_compares_commits_and_versions()
    pin := "64f5caef6e5a44a343e97b3f021c8cc5358f587a\n"
    assert_eq(pin_mismatch(pin, "ail 0.1.0 (v0.1.0-3-g64f5cae, native)"), none)
    assert_eq(pin_mismatch(pin, "ail 0.1.0 (64f5caef6e5a, native)"), none)
    assert_eq(pin_mismatch(pin, "ail 0.1.0 (v0.1.0, native)"), none)
    wrong := pin_mismatch(pin, "ail 0.1.0 (v0.1.0-9-g1234abc, native)") else ""
    assert(wrong.starts_with(".ail-version pins ail 64f5caef6e5a"))
    assert(wrong.contains("0.1.0 (v0.1.0-9-g1234abc)"))
    assert_eq(pin_mismatch("0.1.0", "ail 0.1.0 (v0.1.0, native)"), none)
    assert_eq(pin_mismatch("v0.1.0", "ail 0.1.0 (v0.1.0, native)"), none)
    assert(pin_mismatch("0.2.0", "ail 0.1.0 (v0.1.0, native)") != none)
    assert_eq(pin_mismatch("", "ail 0.1.0"), none)
