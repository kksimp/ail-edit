## Key names a spec may end with besides one character and `f1` to `f24`.
NAMED := [
    "up",
    "down",
    "left",
    "right",
    "home",
    "end",
    "pageup",
    "pagedown",
    "tab",
    "enter",
    "escape",
    "backspace",
    "delete",
    "insert",
    "space",
]

fn bind(command str, key str) Binding
    Binding(command: command, key: key)

