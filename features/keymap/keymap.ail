## The preset names, in the order the Settings list cycles through them.
pub fn names() List[str]
    ["classic", "vscode"]

## The preset called `name`; `none` for an unknown name.
pub fn preset(name str) List[Binding]?
    if name == "classic"
        return classic()
    if name == "vscode"
        return vscode()
    none

## The keys that open the command palette in a preset (the workspace
## handles them itself; no binding of the preset uses them).
pub fn palette_keys(name str) List[str]
    if name == "vscode"
        return ["ctrl+shift+p", "f1"]
    ["ctrl+shift+p"]

# ---- Specs --------------------------------------------------------------

fn modifier(m str) str?
    match m
        "ctrl" | "control" | "cmd" | "command" => "ctrl"
        "alt" | "option" | "opt" => "alt"
        "shift" => "shift"
        _ => none

fn key_alias(k str) str
    match k
        "esc" => "escape"
        "return" => "enter"
        "plus" => "+"
        "minus" => "-"
        "del" => "delete"
        "ins" => "insert"
        "pgup" => "pageup"
        "pgdn" => "pagedown"
        "spacebar" => "space"
        "backtick" => "`"
        _ => k

## The key part of a spec in its one spelling, or `none`.
fn key_name(k str) str?
    n := key_alias(k)
    if NAMED.contains(n)
        return n
    if n.len() == 1
        return n
    if n.len() >= 2 and n.starts_with("f")
        num := n.slice(1, n.len()).to_int() else return none
        if num >= 1 and num <= 24
            return "f{num}"
    none

## The spec in its one spelling: modifiers in the order ctrl, alt, shift,
## lower case, `+` between them (`-` is accepted too, so the README's
## `Ctrl-Shift-P` reads), and the aliases `cmd`, `command`, `control`,
## `option`, `opt`, `esc`, `return`, `plus`, `minus`, `del`, `ins`,
## `pgup`, `pgdn`, `spacebar`, `backtick`. `none` when it is no key.
pub fn normalize(spec str) str?
    s := spec.trim().to_lower()
    cs := s.chars()
    n := cs.len()
    if n == 0
        return none
    mut key := s
    mut mods := ""
    if n >= 2 and (cs[n - 1] == '+' or cs[n - 1] == '-') and (cs[n - 2] == '+' or cs[n - 2] == '-')
        key = "{cs[n - 1]}"
        mods = s.slice(0, n - 2)
    elif n >= 2
        mut last := -1
        for i in 0..n
            if cs[i] == '+' or cs[i] == '-'
                last = i
        if last == n - 1
            return none
        if last >= 0
            key = s.slice(last + 1, n)
            mods = s.slice(0, last)
    mut ctrl := false
    mut alt := false
    mut shift := false
    if mods != ""
        for part in mods.replace("-", "+").split("+")
            m := modifier(part.trim()) else return none
            if m == "ctrl"
                ctrl = true
            elif m == "alt"
                alt = true
            else
                shift = true
    k := key_name(key.trim()) else return none
    mut out := ""
    if ctrl
        out = "ctrl+"
    if alt
        out = "{out}alt+"
    if shift
        out = "{out}shift+"
    "{out}{k}"

fn key_shown(k str) str
    match k
        "up" => "Up"
        "down" => "Down"
        "left" => "Left"
        "right" => "Right"
        "home" => "Home"
        "end" => "End"
        "pageup" => "PageUp"
        "pagedown" => "PageDown"
        "tab" => "Tab"
        "enter" => "Enter"
        "escape" => "Escape"
        "backspace" => "Backspace"
        "delete" => "Delete"
        "insert" => "Insert"
        "space" => "Space"
        _ => k.to_upper()

## A spec as the README shows keys: `ctrl+shift+p` is `Ctrl-Shift-P`,
## `alt+left` is `Alt-Left`, `f5` is `F5`. A spec that is no key is shown
## as written.
pub fn shown(spec str) str
    s := normalize(spec) else return spec
    mut out := ""
    mut rest := s
    if r1 := rest.strip_prefix("ctrl+")
        out = "Ctrl-"
        rest = r1
    if r2 := rest.strip_prefix("alt+")
        out = "{out}Alt-"
        rest = r2
    if r3 := rest.strip_prefix("shift+")
        out = "{out}Shift-"
        rest = r3
    "{out}{key_shown(rest)}"

# ---- Resolving ----------------------------------------------------------

## The key map the editor dispatches with: each normalized spec to its
## command, the preset's bindings first, then the user's (`bind.` lines),
## a user binding replacing the preset's command on the same key. Bindings
## whose key is no key are left out.
pub fn resolve(preset List[Binding], user List[Binding]) Map[str, str]
    mut out := Map[str, str]()
    for b in preset
        spec := normalize(b.key) else continue
        out[spec] = b.command
    for b in user
        uspec := normalize(b.key) else continue
        out[uspec] = b.command
    out

## The keys (normalized) that two different commands of `bindings` claim,
## each once, in the order they are first claimed twice.
pub fn conflicts(bindings List[Binding]) List[str]
    mut owner := Map[str, str]()
    mut out := List[str]()
    for b in bindings
        spec := normalize(b.key) else continue
        if prev := owner.get(spec)
            if prev != b.command and not out.contains(spec)
                out.push(spec)
        else
            owner[spec] = b.command
    out

## The key of `command` in a resolved map, as the README shows it (for the
## palette and menus); "" when no key runs it. With several keys, the one
## the map holds first.
pub fn key_for(command str, resolved Map[str, str]) str
    for spec, cmd in resolved
        if cmd == command
            return shown(spec)
    ""

## Every key of `command` in `bindings`, shown, in order.
fn keys_of(command str, bindings List[Binding]) List[str]
    mut out := List[str]()
    for b in bindings
        if b.command == command
            out.push(shown(b.key))
    out

## The README key table for a preset: a header, then one line per row.
## For `classic` the rows' own keys are shown, so the table is today's;
## for another preset a command's keys come from the preset ("palette"
## when it has none), and a row that is no command keeps its keys (the
## palette row shows the preset's palette keys). Empty for an unknown
## preset.
pub fn table(preset_name str, rows List[Row]) List[str]
    bs := preset(preset_name) else return List[str]()
    mut out := ["| Key | Does |", "|---|---|"]
    for r in rows
        mut keys := r.keys
        if preset_name != "classic"
            if r.name != ""
                got := keys_of(r.name, bs)
                keys = if got.len() == 0 then "palette" else got.join(", ")
            elif (normalize(r.keys) else "") == "ctrl+shift+p"
                mut ps := List[str]()
                for p in palette_keys(preset_name)
                    ps.push(shown(p))
                keys = ps.join(", ")
        out.push("| {keys} | {r.does} |")
    out

# ---- Tests --------------------------------------------------------------

fn command_names(bs List[Binding]) List[str]
    mut out := List[str]()
    for b in bs
        if not out.contains(b.command)
            out.push(b.command)
    out

@test fn presets_have_no_conflicts_and_spare_the_palette_keys()
    assert_eq(names(), ["classic", "vscode"])
    for name in names()
        bs := preset(name) else unreachable("listed")
        assert_eq(conflicts(bs), List[str]())
        for b in bs
            spec := normalize(b.key) else unreachable("every key is a key")
            assert(not palette_keys(name).contains(spec), "{name}: {b.key}")
    assert(preset("emacs") == none)
    assert_eq(classic().len(), 101)

@test fn every_classic_command_is_in_vscode_or_listed_palette_only()
    vs := command_names(vscode())
    for name in command_names(classic())
        assert(vs.contains(name) or PALETTE_ONLY_IN_VSCODE.contains(name), name)
    for name in PALETTE_ONLY_IN_VSCODE
        assert(not vs.contains(name), name)
    known := command_names(classic())
    for name in vs
        assert(known.contains(name) or PALETTE_COMMANDS.contains(name), name)

@test fn vscode_keys_are_the_well_known_ones()
    m := resolve(vscode(), List[Binding]())
    assert_eq(m["ctrl+d"], "Add next occurrence")
    assert_eq(m["ctrl+shift+k"], "Delete line")
    assert_eq(m["ctrl+h"], "Replace")
    assert_eq(m["ctrl+shift+t"], "Reopen closed tab")
    assert_eq(m["ctrl+shift+l"], "Select all occurrences")
    assert_eq(m["shift+f5"], "Stop the running job")
    assert_eq(m["ctrl+`"], "Show jobs")
    assert_eq(m["alt+shift+f5"], "Previous change")
    assert(m.get("f8") == none)

@test fn normalize_orders_lowers_and_reads_aliases()
    assert_eq(normalize("Shift+Ctrl+P") else "", "ctrl+shift+p")
    assert_eq(normalize("cmd+option+esc") else "", "ctrl+alt+escape")
    assert_eq(normalize("ctrl+plus") else "", "ctrl++")
    assert_eq(normalize("ctrl++") else "", "ctrl++")
    assert_eq(normalize("Ctrl--") else "", "ctrl+-")
    assert_eq(normalize("return") else "", "enter")
    assert_eq(normalize("F5") else "", "f5")
    assert_eq(normalize("shift+alt+f5") else "", "alt+shift+f5")
    assert_eq(normalize(" Ctrl-Shift-[ ") else "", "ctrl+shift+[")
    assert(normalize("") == none)
    assert(normalize("hyper+a") == none)
    assert(normalize("ctrl+") == none)
    assert(normalize("ctrl+f99") == none)
    assert(normalize("ctrl+banana") == none)

@test fn shown_matches_the_readme_and_round_trips()
    assert_eq(shown("ctrl+shift+p"), "Ctrl-Shift-P")
    assert_eq(shown("alt+left"), "Alt-Left")
    assert_eq(shown("f5"), "F5")
    assert_eq(shown("ctrl+\\"), "Ctrl-\\")
    assert_eq(shown("shift+alt+f5"), "Alt-Shift-F5")
    assert_eq(shown("ctrl+-"), "Ctrl--")
    assert_eq(shown("ctrl+space"), "Ctrl-Space")
    assert_eq(shown("not a key"), "not a key")
    mut all_keys := classic()
    all_keys.extend(vscode())
    for b in all_keys
        spec := normalize(b.key) else unreachable("a key")
        assert_eq(normalize(shown(b.key)) else "", spec)
        assert_eq(normalize(spec) else "", spec)

@test fn user_bindings_win_and_conflicts_are_found()
    user := [bind("Next theme", "ctrl+h"), bind("Quit", "Ctrl+Alt+Q")]
    m := resolve(vscode(), user)
    assert_eq(m["ctrl+h"], "Next theme")
    assert_eq(m["ctrl+alt+q"], "Quit")
    assert_eq(key_for("Quit", m), "Ctrl-Q")
    assert_eq(key_for("Next theme", m), "Ctrl-H")
    assert_eq(key_for("Replace", m), "")
    assert_eq(key_for("Redo", m), "Ctrl-Y")
    clash := [bind("A", "ctrl+x"), bind("B", "Ctrl+X"), bind("A", "ctrl+x"), bind("C", "ctrl+x")]
    assert_eq(conflicts(clash), ["ctrl+x"])
    assert_eq(conflicts([bind("A", "f1"), bind("A", "F1")]), List[str]())

@test fn table_shows_each_presets_keys()
    rows := [
        Row(keys: "Arrows", name: "", does: "Move"),
        Row(keys: "Ctrl-D", name: "Duplicate line", does: "Duplicate"),
        Row(keys: "palette", name: "Delete line", does: "Delete"),
        Row(keys: "Ctrl-Shift-T", name: "Next theme", does: "Theme"),
        Row(keys: "Ctrl-Shift-P", name: "", does: "Palette"),
        Row(keys: "Ctrl-Y", name: "Redo", does: "Redo"),
    ]
    c := table("classic", rows)
    assert_eq(c[0], "| Key | Does |")
    assert_eq(c[1], "|---|---|")
    assert_eq(c[3], "| Ctrl-D | Duplicate |")
    assert_eq(c[4], "| palette | Delete |")
    v := table("vscode", rows)
    assert_eq(v.len(), 8)
    assert_eq(v[2], "| Arrows | Move |")
    assert_eq(v[3], "| Alt-Shift-Down | Duplicate |")
    assert_eq(v[4], "| Ctrl-Shift-K | Delete |")
    assert_eq(v[5], "| palette | Theme |")
    assert_eq(v[6], "| Ctrl-Shift-P, F1 | Palette |")
    assert_eq(v[7], "| Ctrl-Y, Ctrl-Shift-Z | Redo |")
    assert_eq(table("emacs", rows), List[str]())
