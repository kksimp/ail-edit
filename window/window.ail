## The editor's window on `std.app` (S1 of docs/plan-2026-11.md).
##
## The headless editor still draws a grid of colored cells (`Screen`). This
## module turns that grid plus a little chrome (tabs, status bar, scrollbar)
## into canvas ops, and turns the host's pixel events back into the cell
## events the editor already understands. It knows nothing about `Editor` or
## `Workspace`: `edit.ail` hands it plain values, so every function here is
## testable without a window.
use std.app

## Pixel sizes of the chrome, in points.
pub SCROLL_W := 12.0
pub TAB_PAD := 14.0
pub TAB_CLOSE_W := 22.0
pub MIN_LINE_H := 14.0

## Colors as 0xRRGGBB, taken from the editor's theme.
pub struct Colors
    pub bg int
    pub fg int
    pub pane_bg int
    pub line_bg int
    pub status_bg int
    pub status_fg int
    pub gutter_fg int
    pub select_bg int
    pub error_fg int
    pub warn_fg int

## A run of text on one row of the cell grid.
pub struct Run
    pub row int
    pub col int
    pub text str
    pub fg int
    pub bg int

## A tab of the tab strip.
pub struct Tab
    pub name str
    pub active bool
    pub dirty bool
    pub errors int
    pub warnings int

## A mark on the scrollbar: a 0-based buffer line and `error`, `warning` or `match`.
pub struct Mark
    pub line int
    pub kind str

## The scrollbar's numbers: the first visible line, the buffer's lines, the
## visible lines.
pub struct Bar
    pub top int
    pub total int
    pub visible int
    pub marks List[Mark]

## Everything one frame shows.
pub struct Frame
    pub colors Colors
    pub runs List[Run]
    pub tabs List[Tab]
    pub cols int
    pub rows int
    ## The grid row of the status bar, and its text.
    pub status_row int
    pub status str
    pub cursor_col int
    pub cursor_row int
    ## The first grid column of the text area (the file tree is left of it).
    pub left int
    ## The grid rows the scrollbar spans: first and one past the last.
    pub bar_from int
    pub bar_to int
    pub bar Bar

## How grid cells map to points.
pub struct Metrics
    pub w float
    pub h float
    ## The mono font size in points, one cell's width and height.
    pub size float
    pub cw float
    pub ch float
    ## The tab strip's height; grid row 0 is the strip, row 1 starts at `tab_h`.
    pub tab_h float
    pub cols int
    pub rows int

## The metrics for a canvas of `w` by `h` points. `cell_w` and `cell_h` are the
## host's measure of one `mono` character at 13 points (std.app.5).
pub fn metrics(w float, h float, cell_w float, cell_h float, size float) Metrics
    k := size / 13.0
    cw := (cell_w * k).max(1.0)
    ch := (cell_h * k).max(MIN_LINE_H)
    tab_h := (ch * 1.5).ceil()
    cols := ((w - SCROLL_W) / cw).floor().to_int().max(10)
    rows := (1.0 + ((h - tab_h) / ch).floor()).to_int().max(4)
    Metrics(w: w, h: h, size: size, cw: cw, ch: ch, tab_h: tab_h, cols: cols, rows: rows)

## The top edge of grid row `r`.
pub fn row_y(m Metrics, r int) float
    if r <= 0
        return 0.0
    m.tab_h + (r - 1).to_float() * m.ch

## The grid cell under point (`x`, `y`); row 0 is the tab strip.
pub struct Cell
    pub col int
    pub row int

pub fn cell_at(m Metrics, x float, y float) Cell
    mut r := 0
    if y >= m.tab_h
        r = 1 + ((y - m.tab_h) / m.ch).floor().to_int()
    c := (x / m.cw).floor().to_int().max(0)
    Cell(col: c, row: r.min(m.rows - 1))

## The chrome's font size (tabs and status bar), a little under the code's.
pub fn chrome_size(m Metrics) float
    (m.size * 0.92).max(10.0)

fn sans_w(s str, size float) float
    s.chars().len().to_float() * size * 0.56

## The width of tab `t` at the chrome's font size `size`.
pub fn tab_w(t Tab, size float) float
    base := t.name.chars().len() + (if t.errors > 0 then 3 else 0) + (if t.warnings > 0 then 3 else 0)
    TAB_PAD * 2.0 + base.to_float() * size * 0.56 + TAB_CLOSE_W

## What a click on the tab strip hit: a tab, and whether its close button.
pub struct TabHit
    pub index int
    pub close bool

## The tab at `x` on the strip, or index -1.
pub fn tab_hit(tabs List[Tab], size float, x float) TabHit
    mut at := 0.0
    for i in 0..tabs.len()
        w := tab_w(tabs[i], size)
        if x >= at and x < at + w
            return TabHit(index: i, close: x >= at + w - TAB_CLOSE_W)
        at += w
    TabHit(index: -1, close: false)

fn txt(x float, y float, s str, fg int, size float, bold bool) app.Op
    app.Op.Str(
        x: x,
        y: y,
        text: s,
        font: "sans",
        size: size,
        fg: fg,
        bold: bold,
        italic: false,
        underline: false,
    )

fn mono(x float, y float, s str, fg int, size float) app.Op
    app.Op.Str(
        x: x,
        y: y,
        text: s,
        font: "mono",
        size: size,
        fg: fg,
        bold: false,
        italic: false,
        underline: false,
    )

## The tab strip: the strip's band, each tab with its dirty dot, counts and
## close button, the active one raised to the editor's background.
pub fn tab_ops(f Frame, m Metrics) List[app.Op]
    c := f.colors
    mut ops := [app.draw_rect(0.0, 0.0, m.w, m.tab_h, c.pane_bg)]
    size := chrome_size(m)
    ty := ((m.tab_h - size) / 2.0).floor() - 1.0
    mut x := 0.0
    for t in f.tabs
        w := tab_w(t, size)
        if t.active
            ops.push(app.draw_rect(x, 0.0, w, m.tab_h, c.bg))
            ops.push(app.draw_rect(x, 0.0, w, 2.0, c.status_bg))
        mut fg := c.gutter_fg
        if t.active
            fg = c.fg
        ops.push(txt(x + TAB_PAD, ty, t.name, fg, size, false))
        mut nx := x + TAB_PAD + sans_w(t.name, size) + 6.0
        if t.errors > 0
            ops.push(txt(nx, ty, "E{t.errors}", c.error_fg, size, true))
            nx += sans_w("E{t.errors}", size) + 6.0
        if t.warnings > 0
            ops.push(txt(nx, ty, "W{t.warnings}", c.warn_fg, size, true))
        cx := x + w - TAB_CLOSE_W / 2.0 - 3.0
        cy := m.tab_h / 2.0
        if t.dirty
            ops.push(app.draw_rect(cx - 3.0, cy - 3.0, 7.0, 7.0, fg))
        else
            ops.push(app.Op.Stroke(x1: cx - 3.5, y1: cy - 3.5, x2: cx + 3.5, y2: cy + 3.5, color: c.gutter_fg, width: 1.3))
            ops.push(app.Op.Stroke(x1: cx - 3.5, y1: cy + 3.5, x2: cx + 3.5, y2: cy - 3.5, color: c.gutter_fg, width: 1.3))
        x += w
    ops

## The cell grid: backgrounds first, then text, so a run's background never
## covers the text of a neighbour. The status row is left to `status_ops`.
pub fn grid_ops(f Frame, m Metrics) List[app.Op]
    c := f.colors
    mut ops := List[app.Op]()
    ops.push(app.draw_rect(0.0, m.tab_h, m.w, m.h - m.tab_h, c.bg))
    for r in f.runs
        if r.row <= 0 or r.row == f.status_row
            continue
        if r.bg != c.bg
            n := r.text.chars().len().to_float()
            ops.push(app.draw_rect(r.col.to_float() * m.cw, row_y(m, r.row), n * m.cw, m.ch, r.bg))
    for r in f.runs
        if r.row <= 0 or r.row == f.status_row
            continue
        if r.text.trim() != ""
            ops.push(mono(r.col.to_float() * m.cw, row_y(m, r.row), r.text, r.fg, m.size))
    ops

## The caret, a 2-point bar at the cursor's cell.
pub fn caret_ops(f Frame, m Metrics) List[app.Op]
    if f.cursor_row <= 0 or f.cursor_col < 0
        return []
    [app.draw_rect(f.cursor_col.to_float() * m.cw, row_y(m, f.cursor_row), 2.0, m.ch, f.colors.fg)]

## The status bar: `status` in sans type on the status color, across the window.
pub fn status_ops(f Frame, m Metrics) List[app.Op]
    c := f.colors
    y := row_y(m, f.status_row)
    size := chrome_size(m)
    [
        app.draw_rect(0.0, y, m.w, m.ch, c.status_bg),
        txt(10.0, y + ((m.ch - size) / 2.0).floor() - 1.0, f.status.trim(), c.status_fg, size, false),
    ]

## The scrollbar down the right edge: a track, the thumb for the visible
## lines, and a tick for each mark.
pub fn bar_ops(f Frame, m Metrics) List[app.Op]
    c := f.colors
    if f.bar_to <= f.bar_from or f.bar.total <= 0
        return []
    y0 := row_y(m, f.bar_from)
    h := row_y(m, f.bar_to) - y0
    x := m.w - SCROLL_W
    total := f.bar.total.to_float()
    mut ops := [app.Op.Shade(x: x, y: y0, w: SCROLL_W, h: h, color: c.line_bg, alpha: 0.6)]
    th := (h * f.bar.visible.to_float() / total).min(h).max(18.0)
    ty := y0 + (h - th) * f.bar.top.to_float() / (total - f.bar.visible.to_float()).max(1.0)
    ops.push(app.Op.Shade(x: x + 2.0, y: ty, w: SCROLL_W - 4.0, h: th, color: c.gutter_fg, alpha: 0.45))
    for mk in f.bar.marks
        my := y0 + h * mk.line.to_float() / total
        mut col := c.select_bg
        if mk.kind == "error"
            col = c.error_fg
        elif mk.kind == "warning"
            col = c.warn_fg
        ops.push(app.draw_rect(x, my, SCROLL_W, 2.0, col))
    ops

## The whole canvas, back to front.
pub fn ops(f Frame, m Metrics) List[app.Op]
    mut out := grid_ops(f, m)
    out.extend(status_ops(f, m))
    out.extend(bar_ops(f, m))
    out.extend(caret_ops(f, m))
    out.extend(tab_ops(f, m))
    out

## The editor's `Key` fields for a host key event (std.app.5): Command and
## Control both report as `ctrl`, and a text key with Ctrl held is lowercase
## (std.ui.7).
pub struct KeySpec
    pub key str
    pub ctrl bool
    pub alt bool
    pub shift bool

pub fn key_spec(text str, ctrl bool, meta bool, alt bool, shift bool) KeySpec
    c := ctrl or meta
    mut k := text
    if c and text.chars().len() == 1
        k = text.to_lower()
    KeySpec(key: k, ctrl: c, alt: alt, shift: shift)

## Wheel points to lines: at least one line for any movement, sign kept.
pub fn wheel_lines(dy float, ch float) int
    if dy == 0.0
        return 0
    n := (dy.abs() / ch).round().to_int().max(1)
    if dy < 0.0
        return -n
    n

## The right-click menu: its labels, and the key (as `ctrl+c`) each runs.
pub MENU := ["Cut", "Copy", "Paste", "Command palette", "Next tab", "Close tab"]
pub MENU_KEYS := ["ctrl+x", "ctrl+c", "ctrl+v", "ctrl+shift+p", "ctrl+tab", "ctrl+w"]

## The key spec for a menu label, or "".
pub fn menu_key(label str) str
    at := MENU.index_of(label) else return ""
    MENU_KEYS[at]

@test fn metrics_scale_with_the_font()
    a := metrics(1000.0, 700.0, 8.0, 16.0, 13.0)
    b := metrics(1000.0, 700.0, 8.0, 16.0, 26.0)
    assert(b.cw > a.cw)
    assert(b.cols < a.cols)
    assert_eq(a.cols, ((1000.0 - SCROLL_W) / 8.0).floor().to_int())

@test fn cells_round_trip_through_points()
    m := metrics(800.0, 600.0, 8.0, 16.0, 13.0)
    c := cell_at(m, 41.0, row_y(m, 3) + 1.0)
    assert_eq(c.col, 5)
    assert_eq(c.row, 3)
    assert_eq(cell_at(m, 4.0, 2.0).row, 0)

@test fn tab_clicks_find_the_tab_and_its_close_button()
    tabs := [
        Tab(name: "a.ail", active: true, dirty: false, errors: 0, warnings: 0),
        Tab(name: "b.ail", active: false, dirty: true, errors: 1, warnings: 0),
    ]
    first := tab_w(tabs[0], 12.0)
    assert_eq(tab_hit(tabs, 12.0, 5.0).index, 0)
    assert(not tab_hit(tabs, 12.0, 5.0).close)
    assert(tab_hit(tabs, 12.0, first - 3.0).close)
    assert_eq(tab_hit(tabs, 12.0, first + 5.0).index, 1)
    assert_eq(tab_hit(tabs, 12.0, 9999.0).index, -1)

@test fn keys_follow_std_ui_7()
    k := key_spec("S", false, true, false, true)
    assert(k.ctrl)
    assert_eq(k.key, "s")
    assert(k.shift)
    plain := key_spec("A", false, false, false, true)
    assert(not plain.ctrl)
    assert_eq(plain.key, "A")
    assert_eq(key_spec("enter", false, false, false, false).key, "enter")

@test fn wheel_moves_at_least_one_line()
    assert_eq(wheel_lines(0.0, 16.0), 0)
    assert_eq(wheel_lines(3.0, 16.0), 1)
    assert_eq(wheel_lines(-40.0, 16.0), -3)

@test fn menu_labels_map_to_keys()
    assert_eq(menu_key("Copy"), "ctrl+c")
    assert_eq(menu_key("nope"), "")
    assert_eq(MENU.len(), MENU_KEYS.len())

@test fn a_frame_draws_tabs_status_and_text()
    c := Colors(
        bg: 0x1e1e1e,
        fg: 0xd4d4d4,
        pane_bg: 0x252526,
        line_bg: 0x2a2a2a,
        status_bg: 0x007acc,
        status_fg: 0xffffff,
        gutter_fg: 0x858585,
        select_bg: 0x264f78,
        error_fg: 0xf48771,
        warn_fg: 0xcca700,
    )
    f := Frame(
        colors: c,
        runs: [
            Run(row: 1, col: 0, text: "fn main()", fg: c.fg, bg: c.bg),
            Run(row: 5, col: 0, text: "status", fg: c.status_fg, bg: c.status_bg),
        ],
        tabs: [Tab(name: "x.ail", active: true, dirty: true, errors: 0, warnings: 2)],
        cols: 80,
        rows: 6,
        status_row: 5,
        status: " x.ail  1:1 ",
        cursor_col: 3,
        cursor_row: 1,
        left: 0,
        bar_from: 1,
        bar_to: 5,
        bar: Bar(top: 0, total: 40, visible: 4, marks: [Mark(line: 10, kind: "error")]),
    )
    m := metrics(640.0, 300.0, 8.0, 16.0, 13.0)
    o := ops(f, m)
    assert(o.len() > 10)
    assert_eq(status_ops(f, m).len(), 2)
    assert_eq(caret_ops(f, m).len(), 1)
