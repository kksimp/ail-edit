        ),
        key_row("Ctrl-Tab", "Next tab", "ctrl+tab", "Next tab; a click on a tab selects it"),
        key_row("Ctrl-Shift-Tab", "Previous tab", "ctrl+shift+tab", "Previous tab"),
        key_row(
            "Ctrl-W",
            "Close tab",
            "ctrl+w",
            "Close the tab; with unsaved changes, press it twice",
        ),
        key_row("Ctrl-+ (or Ctrl-=)", "Larger font", "ctrl+=", "Larger font (ADR 0243)"),
        key_row("Ctrl--", "Smaller font", "ctrl+-", "Smaller font"),
        key_row("Ctrl-0", "Default font size", "ctrl+0", "Default font size"),
        key_row(
            "Ctrl-Shift-T",
            "Next theme",
            "ctrl+shift+t",
            "Next theme: dark, light, solarized, high-contrast; remembered for the next start",
        ),
        key_row(
            "Ctrl-Q",
            "Quit",
            "ctrl+q",
            "Quit; with unsaved changes in any tab, press it twice. Closing the window counts as Ctrl-Q",
        ),
        key_row(
            "Palette",
            "Toggle minimap",
            "",
            "Show or hide the minimap beside the text (window)",
        ),
        key_row("Palette", "Toggle zen mode", "", "Hide the tab strip and status bar (window)"),
        key_row(
            "Mouse",
            "",
            "",
            "Click places the caret, drag or Shift-click selects, the wheel scrolls, a click on a diagnostic or an output location jumps to it",
        ),
    ]

## The README's key table (`--keys`).
fn key_table() List[str]
    mut out := ["| Key | Does |", "|---|---|"]
    for r in key_rows()
        out.push("| {r.keys} | {r.does} |")
    out

## The key event a spec such as `ctrl+shift+f`, `f2` or `ctrl+space` names.
fn key_event(spec str) ui.Event
    mut parts := spec.split("+")
    mut key := parts.pop() else ""
    if key == "space"
        key = " "
    Key(
        key: key,
        ctrl: parts.contains("ctrl"),
        alt: parts.contains("alt"),
        shift: parts.contains("shift"),
    )

## The key of a key event without Ctrl or Alt.
fn pressed(ev ui.Event) str?
    match ev
        Key(k, ctrl, alt, _) =>
            if ctrl or alt
                return none
            k
        Resize(_, _) | Close | Mouse(_, _, _, _) | Scroll(_) => none

## Keys the workspace handles itself, before the active tab sees them.
enum WsKey
    NextTab
    PreviousTab
    CloseTab
    QuitAll
    OpenFile
    Palette
    Search
    NextHit
    Tree
    Theme
    Trace
    FailurePaths
    Coverage
    Card
    Problems
    References
    ReplaceInFiles
    TestOnSave
    TestTool(mode str)
    TaskPanel
    AffectedTests
    TaskVerify
    AskBar
    Symbols
    Hierarchy
    Zoom(key str)
    Diff(kind str)

fn workspace_key(k str, ctrl bool, alt bool, shift bool) WsKey?
    if alt and shift and (k == "h" or k == "H")
        return Hierarchy
    if not ctrl
        if k == "f4" and not shift
            return NextHit
        if k == "f5" and shift
            return Trace
        if k == "f6" and shift
            return TestTool("one")
        if k == "f7" and not shift
            return TaskVerify
        if k == "f8" and not shift
            return AffectedTests
        if k == "f12" and shift
            return References
        return none
    if k == "tab"
        if shift
            return PreviousTab
        return NextTab
    if k == "=" or k == "+" or k == "-" or k == "0"
        return Zoom(k)
    if shift
        return match k
            "p" | "P" => Palette
            "f" | "F" => Search
            "t" | "T" => Theme
            "e" | "E" => FailurePaths
            "c" | "C" => Coverage
            "i" | "I" => Card
            "m" | "M" => Problems
            "h" | "H" => ReplaceInFiles
            "u" | "U" => TestOnSave
            "d" | "D" => Diff("diff")
            "v" | "V" => Diff("verify")
            "j" | "J" => TestTool("tree")
            "y" | "Y" => TestTool("replay")
            "z" | "Z" => TestTool("shrink")
            "x" | "X" => TestTool("contracts")
            "k" | "K" => TaskPanel
            "a" | "A" => AskBar
            _ => none
    match k
        "b" | "B" => Tree
        "w" | "W" => CloseTab
        "q" | "Q" => QuitAll
        "p" | "P" => OpenFile
        "t" | "T" => Symbols
        _ => none

## The palette's rows matching what is typed: those that run a command
## (a key, or a palette-only row: spec "" and a name, run by `run_command`).
fn Workspace.commands(self) List[KeyRow]
    mut out := List[KeyRow]()
    for r in key_rows()
        if r.name != "" and fuzzy(r.name, field.text)
            out.push(r)
    out

fn Workspace.start_palette(mut self)
    picking = true
    commanding = true
    field = widgets.TextField.new("command: ", "")
    list = picker_list()

## What the open list shows: commands with their keys, or file paths.
fn Workspace.choices(self) List[str]
    if not commanding
        return matches()
    mut out := List[str]()
    for r in commands()
        out.push("{r.name.pad_right(28, ' ')} {r.keys}")
    out

## Enter in the open list: runs the command, or opens the file.
fn Workspace.choose(mut self)
    picking = false
    if commanding
        found := commands()
        commanding = false
        if list.selected < found.len()
            row := found[list.selected]
            if row.spec == ""
                run_command(row.name)
            else
                on_event(key_event(row.spec))
        return
    found := matches()
    if list.selected < found.len()
        open(found[list.selected])

## Palette-only commands: a `key_row("palette", NAME, "", DOES)` in
## `key_rows()` and one arm here, which a slice adds for its own command.
fn Workspace.run_command(mut self, name str)
    match name
        "Toggle minimap" => minimap = not minimap
        "Toggle zen mode" => zen = not zen
        "API diff" => diff_view("api")
        "Git change gutter" => diff_view("gutter")
        "Update preview" => test_tool("preview")
        "Apply test update" => test_tool("apply")
        "Record tests" => test_tool("record")
        "Trace replay" => test_tool("trace")
        "Count tokens" => token_report()
        "Toggle token meter" => askbar.toggle()
        _ => message = "no command `{name}`"

# ---- Tabs ---------------------------------------------------------------

## Several files, one tab each, and the Ctrl-P file picker. The editor in
## each tab gets every row but the tab bar.
struct Workspace
    eds List[Editor]
    active int
    cols int
    rows int
    picking bool
    ## The open list is the command palette, not the file picker.
    commanding bool
    ## Ctrl-P and Ctrl-Shift-P: what is typed, and the choices it leaves
    ## (std.ui.widgets).
    field widgets.TextField
    list widgets.ListView
    files List[str]
    ## Ctrl-Shift-F: the query being typed, the hits, and whether Up/Down
    ## and Enter go to them.
    searching bool
    search str
    ## Replace in files (ADR 0339): 0 off, 1 typing what to find, 2 typing
    ## the replacement, 3 the preview is showing.
    repl_step int
    repl_with str
    ## Preview rows the person skipped (ADR 0354).
    repl_skip Set[int]
    hits List[Hit]
    hits_title str
    hit_sel int
    hit_top int
    browsing bool
    ## Ctrl-B: the file tree, whether it has the keys, and which directories
    ## are expanded.
    ## The directory the tree shows: the working directory.
    tree_root str
    tree_open bool
    tree_focus bool
    tree List[TreeRow]
    tree_sel int
    expanded Set[str]
    quit_armed bool
    quit bool
    message str
    ## The font size, as a cell height in pixels (std.ui.15).
    font int
    ## The theme's name and colors (ADR 0295); `remember` saves changes to
    ## `~/.ail-edit` (off in tests).
    theme str
    pal Palette
    remember bool
    ## The problems list refreshes while shown (ADR 0353): after a save,
    ## and 500 ms after the last edit (`typed_at`, in ms; 0 when none).
    live_problems bool
    ## Ctrl-Shift-U: run the tab's tests after each save (ADR 0354).
    test_on_save bool
    typed_at int
    ## Palette toggles of the window: the minimap and zen mode.
    minimap bool
    zen bool
    ## The ask bar and the token meter (features/ask, plan S8).
    askbar ask.Bar

fn Workspace.new(ed Editor) Workspace
    Workspace(
        eds: [ed],
        active: 0,
        cols: ed.cols,
        rows: ed.rows + 1,
        picking: false,
        commanding: false,
        field: widgets.TextField.new("open: ", ""),
        list: widgets.ListView.new([]),
        files: [],
        searching: false,
        search: "",
        repl_step: 0,
        repl_with: "",
        repl_skip: Set[int](),
        hits: [],
        hits_title: "",
        hit_sel: 0,
        hit_top: 0,
        browsing: false,
        tree_root: ".",
        tree_open: false,
        tree_focus: false,
        tree: [],
        tree_sel: 0,
        expanded: Set[str](),
        quit_armed: false,
        quit: false,
        message: "",
        font: 20,
        theme: "dark",
        pal: palette(Map[str, int]()),
        remember: false,
        live_problems: false,
        test_on_save: false,
        typed_at: 0,
        minimap: false,
        zen: false,
        askbar: ask.Bar.new(),
    )

## The file name a tab shows: the path after its last `/`.
fn base_name(path str) str
    parts := path.split("/")
    parts[parts.len() - 1]

## `path` as a list row shows it: relative to `root` when it lies inside,
## unchanged when it is already relative, else its base name.
fn shown_path(root str, path str) str
    if rel := path.strip_prefix("{root}/")
        return rel
    if path.starts_with("/")
        return base_name(path)
    path

@test fn shown_paths_stay_short()
    assert_eq(shown_path("/w", "/w/src/a.ail"), "src/a.ail")
    assert_eq(shown_path("/w", "/var/folders/x/T/ail-edit-1/agent.ail"), "agent.ail")
    assert_eq(shown_path("/w", "src/a.ail"), "src/a.ail")

## Opens `path` in a new tab, or switches to it if it is open.
fn Workspace.open(mut self, path str)
    for i in 0..eds.len()
        if eds[i].path == path
            active = i
            return
    mut text := ""
    if fs.exists(path)
        got := fs.read_text(path) else err
            message = "can't open {err.path}: {err.kind}"
            return
        text = got
    mut ed := Editor.new(path, text, (cols - left()).max(10), (rows - 1).max(1))
    ed.index()
    eds.push(ed)
    active = eds.len() - 1

## Closes the active tab, asking first if it has unsaved changes. The
## workspace quits when the last tab closes.
fn Workspace.close_tab(mut self)
    eds[active].apply(Quit)
    if not eds[active].quit
        return
    mut rest := List[Editor]()
    for i in 0..eds.len()
        if i != active
            rest.push(eds[i])
    eds = rest
    if eds.len() == 0
        quit = true
        return
    active = active.min(eds.len() - 1)

## Ctrl-Q: quit, asking first if any tab has unsaved changes.
fn Workspace.quit_all(mut self)
    mut unsaved := 0
    for ed in eds
        if ed.dirty
            unsaved += 1
    if unsaved > 0 and not quit_armed
        quit_armed = true
        message = "{unsaved} unsaved tab(s): Ctrl-Q again quits without saving"
        return
    quit = true

fn Workspace.on_event(mut self, ev ui.Event)
    if picking
        pick_event(ev)
        return
    if searching
        search_event(ev)
        return
    if askbar.open
        askbar_event(ev)
        return
    if browsing and repl_step == 3
        if ev == Key(key: "enter", ctrl: true, alt: false, shift: false)
            apply_replace()
            return
        if k := pressed(ev)
            if k == " " or k == "a" or k == "A"
                mark_rows(k != " ")
                return
    if browsing
        if k := pressed(ev)
            if hits_key(k)
                return
    repl_step = 0
    if tree_focus
        if k := pressed(ev)
            if tree_key(k)
                return
    # A message stays up through a resize, which a font change causes.
    resize := match ev
        Resize(_, _) => true
        Key(_, _, _, _) | Close | Mouse(_, _, _, _) | Scroll(_) => false
    if ev != Close and not resize
        quit_armed = false
        message = ""
    match ev
        Key(k, ctrl, alt, shift) =>
            if wk := workspace_key(k, ctrl, alt, shift)
                n := eds.len()
                match wk
                    NextTab => active = (active + 1) % n
                    PreviousTab => active = (active + n - 1) % n
                    CloseTab => close_tab()
                    QuitAll => quit_all()
                    OpenFile => start_picking()
                    Palette => start_palette()
                    Zoom(z) => zoom(z)
                    Search => start_search()
                    NextHit => next_hit()
                    Tree => toggle_tree()
                    Theme => next_theme()
                    Trace => trace_run()
                    FailurePaths => failure_paths()
                    Coverage => eds[active].coverage()
                    TestTool(m) => test_tool(m)
                    Card => card_view()
                    Diff(w) => diff_view(w)
                    Problems => problems()
                    References => show_references()
                    ReplaceInFiles => start_replace()
                    TaskPanel => task_panel()
                    AffectedTests => eds[active].affected_tests()
                    TaskVerify => task_action("verify")
                    AskBar => askbar.start(0)
                    Symbols => askbar.start(1)
                    Hierarchy => show_hierarchy()
                    TestOnSave =>
                        test_on_save = not test_on_save
                        if test_on_save
                            eds[active].test_quietly()
                        else
                            eds[active].tests = ""
                return
            saves := eds[active].saves
            eds[active].on_event(ev)
            if eds[active].saves != saves
                check_other_tabs()
                eds[active].impact_refresh()
                if hits_title.starts_with("program card")
                    card_view()
                if live_problems
                    refresh_problems()
                if test_on_save
                    eds[active].test_quietly()
            elif live_problems and eds[active].dirty
                typed_at = time.now_ms()
        Resize(_, _) => on_resize(ev)
        Close => quit_all()
        Mouse(c, r, button, kind) =>
            if r == 0
                if kind == "down"
                    click_tab(c)
                return
            if c < left()
                if kind == "down" and button == "left"
                    click_tree(r)
                return
            tree_focus = false
            if kind == "down" and button == "left"
                ed := eds[active]
                if loc := ed.pane_location(r - 1 - ed.text_rows() - 1)
                    if loc.path != ed.path
                        open(loc.path)
                        eds[active].jump_to(loc)
                        return
            eds[active].on_event(Mouse(col: c - left(), row: r - 1, button: button, kind: kind))
        Scroll(_) => eds[active].on_event(ev)
    if eds[active].quit
        close_tab()
        return
    askbar_refresh()

## After a save, checks every other open tab too, since a change can break
## a file that uses it; each tab's label shows its counts (ADR 0293).
fn Workspace.check_other_tabs(mut self)
    for i in 0..eds.len()
        if i != active
            eds[i].run(Check)

## Ctrl-+ (or Ctrl-=) and Ctrl-- step the font size; Ctrl-0 resets it.
fn Workspace.zoom(mut self, k str)
    if k == "0"
        font = 20
        return
    mut at := FONT_SIZES.len() - 1
    for i in 0..FONT_SIZES.len()
        if FONT_SIZES[i] >= font
            at = i
            break
    if k == "-"
        at = (at - 1).max(0)
    elif FONT_SIZES[at] == font
        at = (at + 1).min(FONT_SIZES.len() - 1)
    font = FONT_SIZES[at]
    message = "font size {font}"

## The columns each tab's label covers on the tab bar.
fn Workspace.tab_labels(self) List[str]
    mut out := List[str]()
    for ed in eds
        mut flag := ""
        if ed.dirty
            flag = " *"
        e := ed.diag_count("error")
        w := ed.diag_count("warning")
        if e > 0
            flag = "{flag} E{e}"
        if w > 0
            flag = "{flag} W{w}"
        out.push(" {base_name(ed.path)}{flag} ")
    out

fn Workspace.click_tab(mut self, c int)
    mut x := 0
    labels := tab_labels()
    for i in 0..labels.len()
        w := labels[i].chars().len()
        if c >= x and c < x + w
            active = i
            return
        x += w + 1

# ---- Rename (F2) ----------------------------------------------------------

## What F2 renames: every place of `name`, found through `ail api --refs` when
## `semantic`, else every whole-word occurrence in the buffer.
struct RenamePlan
    name str
    at List[Range]
    semantic bool

## The range of `name` at a 1-based line and column from `ail api`.
fn place(l int, c int, name str) Range
    Range(line: l - 1, col: c - 1, end_line: l - 1, end_col: c - 1 + name.chars().len())

fn Editor.holds_at(self, r Range, name str) bool
    if r.line < 0 or r.line >= lines.len()
        return false
    cs := lines[r.line].chars()
    r.col >= 0 and r.end_col <= cs.len() and cs[r.col..r.end_col].join("") == name

## Every whole-word occurrence of `name`.
fn Editor.word_places(self, name str) List[Range]
    n := name.chars().len()
    mut out := List[Range]()
    for l in 0..lines.len()
        cs := lines[l].chars()
        mut c := 0
        while c + n <= cs.len()
            if cs[c..c + n].join("") == name
                and (c == 0 or not is_word(cs[c - 1]))
                and (c + n == cs.len() or not is_word(cs[c + n]))
                out.push(Range(line: l, col: c, end_line: l, end_col: c + n))
                c += n
            else
                c += 1
    out

## Whether `name` can be a new name: a word that isn't a keyword.
fn valid_name(name str) bool
    cs := name.chars()
    if cs.len() == 0 or cs[0].is_digit() or KEYWORDS.contains(name)
        return false
    for c in cs
        if not is_word(c)
            return false
    true

## Replaces each place with `new`, as one undo step; the cursor stays on
## its word.
fn Editor.rename_all(mut self, at List[Range], new str)
    snapshot()
    for l in 0..lines.len()
        mut starts := List[int]()
        mut n := 0
        for a in at
            if a.line == l
                starts.push(a.col)
                n = a.end_col - a.col
        if starts.len() == 0
            continue
        cs := lines[l].chars()
        mut out := ""
        mut from := 0
        mut shift := 0
        for c in starts.sorted()
            out = "{out}{cs[from..c].join("")}{new}"
            from = c + n
            if l == line and c + n <= col
                shift += new.chars().len() - n
        lines[l] = "{out}{cs[from..].join("")}"
        if l == line
            set_col((col + shift).min(lines[l].chars().len()))

## Passes a resize to every tab while a prompt stays open.
fn Workspace.on_resize(mut self, ev ui.Event)
    match ev
        Resize(c, r) =>
            cols = c
            rows = r
            resize_tabs()
        Key(_, _, _, _) | Close | Mouse(_, _, _, _) | Scroll(_) => return

# ---- The file tree (Ctrl-B) -----------------------------------------------

## A row of the file tree: a file or directory under the working directory.
struct TreeRow
    path str
    name str
    depth int
    dir bool

## The tree's width in columns, the separator included; 0 when closed.
fn Workspace.left(self) int
    if not tree_open
        return 0
    TREE_W + 1

## The entries of `dir` as rows: `.ail` files first, then directories, then
## other files, each group by name; hidden and build directories skipped.
## Expanded directories list their entries below them.
fn Workspace.tree_rows(self, dir str, depth int) List[TreeRow]
    names := fs.list_dir(dir) else return List[TreeRow]()
    mut ail := List[TreeRow]()
    mut dirs := List[TreeRow]()
    mut rest := List[TreeRow]()
    for n in names.sorted()
        if n.starts_with(".") or n == "target"
            continue
        mut path := n
        if dir != "."
            path = "{dir}/{n}"
        if sub := fs.list_dir(path)
            if sub.len() >= 0
                dirs.push(TreeRow(path: path, name: "{n}/", depth: depth, dir: true))
        elif n.ends_with(".ail")
            ail.push(TreeRow(path: path, name: n, depth: depth, dir: false))
        else
            rest.push(TreeRow(path: path, name: n, depth: depth, dir: false))
    mut out := ail
    for d in dirs
        out.push(d)
        if expanded.contains(d.path)
            out.extend(tree_rows(d.path, depth + 1))
    out.extend(rest)
    out

## Ctrl-B: opens the tree and focuses it; focused, closes it; open but not
## focused, focuses it.
fn Workspace.toggle_tree(mut self)
    if tree_open and tree_focus
        tree_open = false
        tree_focus = false
    else
        if not tree_open
            tree = tree_rows(tree_root, 0)
            tree_sel = 0
        tree_open = true
        tree_focus = true
    resize_tabs()

## Gives every tab the columns the tree leaves.
fn Workspace.resize_tabs(mut self)
    c := (cols - left()).max(10)
    r := (rows - 1).max(1)
    for mut ed in eds
        ed.apply(Command.Resize(cols: c, rows: r))

## Enter or a click on a row: a directory expands or collapses, a file
## opens in a tab and takes the focus.
fn Workspace.activate_tree_row(mut self)
    if tree_sel >= tree.len()
        return
    t := tree[tree_sel]
    if t.dir
        if expanded.contains(t.path)
            expanded.remove(t.path)
        else
            expanded.add(t.path)
        tree = tree_rows(tree_root, 0)
        return
    open(t.path)
    tree_focus = false

## Keys while the tree has the focus: Up/Down select, Enter or Right opens,
## Left collapses (or goes to the parent), Escape gives the focus back.
## Other keys go to the editor. True if `k` was used here.
fn Workspace.tree_key(mut self, k str) bool
    if k == "up"
        tree_sel = (tree_sel - 1).max(0)
    elif k == "down"
        tree_sel = (tree_sel + 1).min((tree.len() - 1).max(0))
    elif k == "enter" or k == "right"
        activate_tree_row()
    elif k == "left"
        if tree_sel < tree.len()
            t := tree[tree_sel]
            if t.dir and expanded.contains(t.path)
                activate_tree_row()
            else
                mut i := tree_sel
                while i > 0 and tree[i].depth >= t.depth
                    i -= 1
                if tree[i].depth < t.depth
                    tree_sel = i
    elif k == "escape"
        tree_focus = false
    else
        tree_focus = false
        return false
    true

## Draws the tree down the left side, the selection kept in view.
fn Workspace.render_tree(self, mut s Screen)
    n := rows - 1
    top := (tree_sel - n + 1).max(0)
    for r in 1..rows
        s.put(r, 0, " ".repeat(TREE_W), FG, PANE_BG)
        s.put(r, TREE_W, " ", FG, BG)
        i := top + r - 1
        mut text := ""
        if i < tree.len()
            t := tree[i]
            mut bg := PANE_BG
            if i == tree_sel
                bg = LINE_BG
                if tree_focus
                    bg = SELECT_BG
            mut fg := FG
            if t.dir
                fg = KEYWORD_FG
            elif not t.name.ends_with(".ail")
                fg = GUTTER_FG
            indent := "  ".repeat(t.depth)
            cs := "{indent}{t.name}".chars()
            text = cs[..cs.len().min(TREE_W - 1)].join("")
            s.put(r, 0, " {text}".pad_right(TREE_W, ' '), fg, bg)
        shown := " {text}".pad_right(TREE_W + 1, ' ')
        s.text[r] = "{shown}{s.text[r]}"
    if tree_focus
        s.cursor_row = 1 + tree_sel - top
        s.cursor_col = 1

## A click in the tree selects that row and activates it.
fn Workspace.click_tree(mut self, r int)
    top := (tree_sel - (rows - 1) + 1).max(0)
    i := top + r - 1
    if i >= 0 and i < tree.len()
        tree_sel = i
        tree_focus = true
        activate_tree_row()

# ---- Project search (Ctrl-Shift-F) ----------------------------------------

## A match of a project search: where, and its line's text.
struct Hit
    loc Loc
    text str

## Every line of `text` containing `query`, as hits in `path` (1-based).
fn search_text(path str, text str, query str) List[Hit]
    mut out := List[Hit]()
    if query == ""
        return out
    ls := text.lines()
    for l in 0..ls.len()
        if c := ls[l].find(query)
            out.push(Hit(
                loc: Loc(path: path, line: l + 1, col: c + 1),
                text: "{path}:{l + 1}:{c + 1}: {ls[l].trim()}",
            ))
    out

## Searches every `.ail` file under the directory, open tabs as they are in
## the editor (unsaved changes included), at most `limit` hits.
fn Workspace.search_project(self, q str, limit int) List[Hit]
    mut out := List[Hit]()
    for f in list_files(".", 8, 5000)
        if not f.ends_with(".ail")
            or f.ends_with(".edit-check.ail")
            or f.ends_with(".edit-query.ail")
            continue
        mut text := ""
        mut open := false
        for ed in eds
            if ed.path == f or ed.path == "./{f}"
                text = ed.text()
                open = true
        if not open
            got := fs.read_text(f) else continue
            text = got
        for h in search_text(f, text, q)
            if out.len() >= limit
                return out
            out.push(h)
    out

fn Workspace.start_search(mut self)
    searching = true
    search = ""
    ed := eds[active]
    if w := ed.word_at()
        search = ed.lines[ed.line].slice(w.col, w.end_col)

## Typing the query: Enter searches, Escape cancels.
fn Workspace.search_event(mut self, ev ui.Event)
    match ev
        Key(k, ctrl, _, _) =>
            if ctrl
                return
            if k == "escape"
                searching = false
                repl_step = 0
            elif k == "enter" and repl_step == 1
                if search == ""
                    searching = false
                    repl_step = 0
                else
                    repl_step = 2
                    repl_with = ""
            elif k == "enter" and repl_step == 2
                searching = false
                preview_replace()
            elif k == "enter"
                searching = false
                show_hits(search_project(search, 1000))
            elif k == "backspace" and repl_step == 2
                repl_with = drop_last(repl_with)
            elif k == "backspace"
                search = drop_last(search)
            elif k.chars().len() == 1 and repl_step == 2
                repl_with = "{repl_with}{k}"
            elif k.chars().len() == 1
                search = "{search}{k}"
        Close => quit_all()
        Resize(_, _) => on_resize(ev)
        Mouse(_, _, _, _) | Scroll(_) => return

## Puts the hits in the active tab's pane and focuses them: Up/Down
## select, Enter (or F4, the next one) jumps, Escape closes.
fn Workspace.show_hits(mut self, found List[Hit])
    mut more := ""
    if found.len() >= 1000
        more = " (first 1000)"
    if found.len() == 0
        message = "no match for `{search}`"
        return
    show_list("search `{search}`: {found.len()} matches{more}", found)

## Puts rows in the active tab's pane under `title` and focuses them:
## Up/Down select, Enter (or F4, the next) jumps to a row's position,
## Escape closes. Search, trace and failure paths all use it.
fn Workspace.show_list(mut self, title str, found List[Hit])
    hits = found
    hits_title = title
    hit_sel = 0
    hit_top = 0
    browsing = true
    live_problems = false
    fill_hits()

## Writes the visible part of the hits into the active tab's pane, keeping
## the selection in view.
fn Workspace.fill_hits(mut self)
    mut ed := eds[active]
    ed.pane = Text
    room := (ed.pane_rows() - 1).max(1)
    hit_top = hit_top.min(hit_sel).max(hit_sel - room + 1).max(0)
    ed.pane_text = ["{hits_title}; Up/Down, Enter jumps, F4 next, Esc closes"]
    for i in hit_top..(hit_top + room).min(hits.len())
        ed.pane_text.push(hits[i].text)
    eds[active] = ed

## Opens the selected hit's file in a tab, moves there, and shows the hits
## in that tab's pane.
fn Workspace.jump_to_hit(mut self)
    if hit_sel >= hits.len()
        return
    loc := hits[hit_sel].loc
    if loc.line == 0
        return
    open(loc.path)
    eds[active].jump_to(loc)
    fill_hits()

## Keys while the hits are focused; others go to the editor.
fn Workspace.hits_key(mut self, k str) bool
    if hits.len() == 0
        browsing = false
        return false
    if hits_title.starts_with("task") and tp.action_for(k) != ""
        task_action(tp.action_for(k))
        return true
    if k == "up"
        hit_sel = (hit_sel - 1).max(0)
    elif k == "down"
        hit_sel = (hit_sel + 1).min(hits.len() - 1)
    elif k == "enter"
        jump_to_hit()
        browsing = false
        return true
    elif k == "escape"
        browsing = false
        return false
    else
        browsing = false
        return false
    fill_hits()
    true

## F4: the next hit, from anywhere, wrapping to the first.
fn Workspace.next_hit(mut self)
    if hits.len() == 0
        message = "no search results: Ctrl-Shift-F searches the project"
        return
    if not browsing
        hit_sel = (hit_sel + 1) % hits.len()
    jump_to_hit()
    browsing = false

## The search prompt on the tab bar, or the selected hit's pane row.
fn Workspace.render_search(self, mut s Screen)
    if searching
        mut head := " search the project: "
        mut entry := search
        if repl_step == 1
            head = " replace in files, find: "
        elif repl_step == 2
            head = " replace `{search}` with: "
            entry = repl_with
        s.put(0, 0, "{head}{entry} ".pad_right(cols, ' '), STATUS_FG, SELECT_BG)
        s.text[0] = "{head}{entry}"
        s.cursor_row = 0
        s.cursor_col = head.chars().len() + entry.chars().len()
    elif browsing
        ed := eds[active]
        r := 1 + ed.text_rows() + 2 + hit_sel - hit_top
        if r < rows and ed.pane == Text
            x := left()
            s.put(r, x, " ".repeat(cols - x), FG, SELECT_BG)
            s.put(r, x + 1, ed.pane_text[1 + hit_sel - hit_top], FG, SELECT_BG)

# ---- The agent panel: trace, failure paths, coverage ----------------------

## A JSON value as short text: strings as they are, others as JSON.
fn jtext(j Json) str
    if s := j.as_str()
        return s
    j.to_text()

## `name: value, ...` from a JSON object such as a frame's `locals`.
fn json_pairs(j Json) str
    mut out := List[str]()
    for m in j.as_obj() else List[JsonMember]()
        out.push("{m.key} = {jtext(m.value)}")
    out.join(", ")

## A native trap is text on standard error (trace.run.1): `FILE:L:C: trap[RULE]: MESSAGE`, then
## one `  at L:C in NAME(ARGS); LOCALS` line per frame, the values shown by `--values` (ADR 0886).
fn trap_text_hits(path str, l str) List[Hit]
    mut hits := List[Hit]()
    if l.contains(": trap[")
        parts := l.split(": trap[")
        place := parts[0].split(":")
        if place.len() < 3
            return hits
        at := Loc(
            path: path,
            line: place[place.len() - 2].to_int() else 0,
            col: place[place.len() - 1].to_int() else 0,
        )
        rest := parts[1].split("]: ")
        message := if rest.len() > 1 then rest[1] else ""
        hits.push(Hit(loc: at, text: "trap[{rest[0]}] {message}  {at.line}:{at.col}"))
    elif l.starts_with("  at ") and l.contains(" in ")
        body := l.slice(5, l.len())
        head := body.split(" in ")[0].split(":")
        if head.len() != 2
            return hits
        floc := Loc(path: path, line: head[0].to_int() else 0, col: head[1].to_int() else 0)
        frame := body.slice(body.split(" in ")[0].len() + 4, body.len())
        mut locals := ""
        mut call := frame
        if i := frame.find("); ")
            call = frame.slice(0, i + 1)
            locals = frame.slice(i + 3, frame.len())
        open := call.find("(") else call.len()
        name := call.slice(0, open)
        mut args := ""
        if open < call.len() - 1
            args = call.slice(open + 1, call.len() - 1)
        if args == ".."
            args = ""
        mut row := "  in {name} {floc.line}:{floc.col}"
        if args != ""
            row = "{row}  args: {args}"
        if locals != ""
            row = "{row}  locals: {locals}"
        hits.push(Hit(loc: floc, text: row))
    hits

## The rows of `ail run --trace=all --json` (standard error): calls indented
## by depth, returns, contracts, and a trap with every frame's locals; then
## the program's output. Rows with a position jump there (ADR 0312).
fn trace_hits(path str, err str, out str) List[Hit]
    mut hits := List[Hit]()
    for l in err.lines()
        j := parse_json(l) else
            hits.extend(trap_text_hits(path, l))
            continue
        at := Loc(path: path, line: jint(j, "line"), col: jint(j, "col"))
        pad := "  ".repeat((jint(j, "depth") - 1).max(0))
        kind := jstr(j, "trace")
        if kind == "call"
            hits.push(Hit(
                loc: at,
                text: "{pad}call {jstr(j, "fn")}({json_pairs(j.get("args") else Json.Null)})  {at.line}:{at.col}",
            ))
        elif kind == "return"
            hits.push(Hit(
                loc: at,
                text: "{pad}return {jstr(j, "fn")} = {jtext(j.get("value") else Json.Null)}",
            ))
        elif kind == "contract"
            mut held := "held"
            if (j.get("held") else Json.Null) != Json.Bool(true)
                held = "FAILED"
            hits.push(Hit(
                loc: at,
                text: "{pad}{jstr(j, "kind")} {jstr(j, "cond")} {held}  {at.line}:{at.col}",
            ))
        elif kind == "summary"
            hits.push(Hit(
                loc: Loc(path: path, line: 0, col: 0),
                text: "{jint(j, "shown")} events, {jint(j, "dropped")} dropped",
            ))
        elif kind != ""
            hits.push(Hit(loc: at, text: "{pad}{kind} {jstr(j, "fn")}  {at.line}:{at.col}"))
        elif jstr(j, "severity") == "trap"
            hits.push(Hit(
                loc: at,
                text: "trap[{jstr(j, "rule")}] {jstr(j, "message")}  {at.line}:{at.col}",
            ))
            for f in jarr(j, "stack")
                floc := Loc(path: path, line: jint(f, "line"), col: jint(f, "col"))
                mut row := "  in {jstr(f, "fn")} {floc.line}:{floc.col}"
                args := json_pairs(f.get("args") else Json.Null)
                if args != ""
                    row = "{row}  args: {args}"
                locals := json_pairs(f.get("locals") else Json.Null)
                if locals != ""
                    row = "{row}  locals: {locals}"
                hits.push(Hit(loc: floc, text: row))
    for l in out.lines()
        hits.push(Hit(loc: Loc(path: path, line: 0, col: 0), text: "> {l}"))
    hits

## The rows of `ail check --errors` (err.api.1): each function with the
## errors it can fail with, then each failure path (return, propagate,
## handle) at its position (ADR 0312).
fn failure_hits(path str, out str) List[Hit]
    mut hits := List[Hit]()
    j := parse_json(out.trim()) else return hits
    for f in jarr(j, "functions")
        mut fails := List[str]()
        for e in jarr(f, "fails_with")
            fails.push(jtext(e))
        mut head := "fn {jstr(f, "name")}"
        if fails.len() > 0
            head = "{head} fails with {fails.join(" | ")}"
        else
            head = "{head} fails with nothing"
        hits.push(Hit(loc: Loc(path: path, line: jint(f, "line"), col: 1), text: head))
        for p in jarr(f, "paths")
            mut errs := List[str]()
            for e in jarr(p, "errors")
                errs.push(jtext(e))
            mut what := jstr(p, "kind")
            if jstr(p, "how") != ""
                what = "{what} ({jstr(p, "how")})"
            if jstr(p, "call") != ""
                what = "{what} {jstr(p, "call")}()"
            hits.push(Hit(
                loc: Loc(path: path, line: jint(p, "line"), col: jint(p, "col")),
                text: "  {jint(p, "line")}:{jint(p, "col")} {what}: {errs.join(" | ")}",
            ))
    hits

## Shift-F5: runs the buffer with every trace event; the events fill the
## pane and take Up/Down and Enter.
fn Workspace.trace_run(mut self)
    r := eds[active].ail_on_buffer(["run", "--trace=all", "--json", "--values"]) else return
    show_list("trace (exit {r.status})", trace_hits(eds[active].path, r.err, r.out))

## Ctrl-Shift-E: the file's failure paths from `ail check --errors`.
fn Workspace.failure_paths(mut self)
    r := eds[active].ail_on_buffer(["check", "--errors"]) else return
    if r.status != 0
        message = "failure paths need a program without errors: Ctrl-K shows them"
        return
    show_list("failure paths", failure_hits(eds[active].path, r.out))

# ---- Test tools (S6) --------------------------------------------------------

## Ctrl-Shift-J and its neighbours (features/tests): runs the tool `mode`
## names and lists its rows like search hits. Replay, trace and shrink act
## on the selected FAIL row of the test tree.
fn Workspace.test_tool(mut self, mode str)
    mut sel := ""
    if hit_sel < hits.len()
        sel = hits[hit_sel].text
    if mode == "one"
        name := ttree.test_at(eds[active].lines, eds[active].line) else
            message = "the caret is not in a test"
            return
        sel = name
    p := ttree.plan(mode, sel, eds[active].dirty)
    if p.problem != ""
        message = p.problem
        return
    mut st := 0
    mut so := ""
    mut se := ""
    if p.on_file
        r := eds[active].ail_on_buffer(p.args) else return
        st = r.status
        so = r.out
        se = r.err
    else
        r := proc.run(ail_command(), p.args) else e
            message = "can't run {e.cmd}: {e.kind}"
            return
        st = r.status
        so = r.out
        se = r.err
    path := eds[active].path
    mut found := List[Hit]()
    for row in ttree.result_rows(mode, path, sel, so, se)
        found.push(Hit(loc: Loc(path: row.path, line: row.line, col: row.col), text: row.text))
    if mode == "apply" and st == 0
        got := fs.read_text(path) else e2
            message = "updated {path}, but can't reload it"
            return
        mut ed := Editor.new(path, got, (cols - left()).max(10), (rows - 1).max(1))
        ed.index()
        eds[active] = ed
    if found.len() == 0
        message = "{p.title}: no output (exit {st})"
        return
    show_list("{p.title}: exit {st}", found)

@test fn test_tool_keys_map_to_modes()
    assert_eq(workspace_key("j", true, true), TestTool("tree"))
    assert_eq(workspace_key("z", true, true), TestTool("shrink"))
    assert_eq(workspace_key("f6", false, true), TestTool("one"))
    assert_eq(workspace_key("j", true, false), none)

@test fn test_tools_refuse_without_a_failed_row()
    mut ws := Workspace.new(typed("fn main()\n    print(1)\n", []))
    ws.test_tool("replay")
    assert(ws.message.starts_with("select a FAIL row"))
    ws.eds[0].dirty = true
    ws.test_tool("apply")
    assert(ws.message.starts_with("save first"))

## The lines `ail test --coverage=lines --json` reports as never run,
## 0-based, and its summary line.
fn parse_coverage(out str) Set[int]
    mut missed := Set[int]()
    for l in out.lines()
        j := parse_json(l) else continue
        if (j.get("coverage") else Json.Null) != Json.Bool(true)
            continue
        for r in jarr(j, "missed")
            span := r.as_arr() else continue
            if span.len() == 2
                a := ((span[0].as_num() else 0.0).to_int())
                b := ((span[1].as_num() else 0.0).to_int())
                for n in a..b + 1
                    missed.add(n - 1)
    missed

## Ctrl-Shift-C: runs the tests with line coverage and marks the lines
## they never ran in the gutter until the next edit (ADR 0313).
fn Editor.coverage(mut self)
    r := ail_on_buffer(["test", "--coverage=lines", "--json"]) else return
    missed = parse_coverage(r.out)
    for l in r.out.lines()
        j := parse_json(l) else continue
        if (j.get("coverage") else Json.Null) == Json.Bool(true)
            message = "coverage: lines {jint(j, "lines_hit")}/{jint(j, "lines")}, functions {jint(j, "functions_hit")}/{jint(j, "functions")}; unrun lines are marked; an edit clears them"
            return
    message = "no coverage: does the file have @test functions? (exit {r.status})"

# ---- The task panel and impact gutter (S4, features/taskpanel) ---------------

## The open task, from `.ail-task` in the working directory (task.state.1).
fn task_job() tp.Job
    text := fs.read_text(".ail-task") else return tp.parse_job("")
    tp.parse_job(text)

## `ail ask FILE --affected --json` against `rev` (api.impact.3-4).
fn impact_of(file str, rev str) tp.Impact
    r := proc.run(ail_command(), [
        "ask",
        file,
        "--affected",
        "--rev",
        rev,
        "--json",
    ]) else return tp.parse_impact("")
    tp.parse_impact(r.out)

## After a save: marks the affected declarations in the gutter. Nothing is
## marked when the file can't be compared (no git revision, or errors).
fn Editor.impact_refresh(mut self)
    if dirty
        return
    job := task_job()
    mut rev := "HEAD"
    if job.open and job.program == path
        rev = job.rev
    imp := impact_of(path, rev)
    mut ids := List[str]()
    mut at := List[int]()
    for sym in symbols
        ids.push(sym.id)
        at.push(sym.line)
    impact = tp.marked_lines(ids, at, imp)

## Ctrl-Shift-Y: only the tests the changes can reach (test.affected.1).
fn Editor.affected_tests(mut self)
    if dirty
        message = "affected tests compare the saved file: save first"
        return
    job := task_job()
    mut args := ["test", path, "--affected"]
    if job.open and job.program == path
        args.push("--since")
        args.push(job.rev)
    r := proc.run(ail_command(), args) else err
        message = "can't run {err.cmd}: {err.kind}"
        return
    show_output("test --affected", r)

## The panel's task and impact: the open task's program, else the active tab.
fn Workspace.task_impact(self, job tp.Job) tp.Impact
    if job.open
        return impact_of(job.program, job.rev)
    if eds[active].dirty
        return tp.parse_impact("")
    impact_of(eds[active].path, "HEAD")

## `--print --task-json`: the panel for agents (plan D4).
fn Workspace.task_json(self) str
    job := task_job()
    tp.panel_json(job, task_impact(job))

## Ctrl-Shift-K: the task panel as a list; a row with a declaration jumps to it.
fn Workspace.task_panel(mut self)
    job := task_job()
    ed := eds[active]
    mut found := List[Hit]()
    for r in tp.panel_rows(job, task_impact(job))
        mut loc := Loc(path: "", line: 0, col: 0)
        for sym in ed.symbols
            if r.id != "" and sym.id == r.id
                loc = Loc(path: ed.path, line: sym.line, col: 1)
        found.push(Hit(loc: loc, text: r.text))
    show_list("task", found)

## V, F or X in the panel: `ail task verify|finish|abort`, answer shown as rows.
fn Workspace.task_action(mut self, sub str)
    mut args := ["task", sub]
    if sub != "abort"
        args.push("--json")
    r := proc.run(ail_command(), args) else err
        message = "can't run {err.cmd}: {err.kind}"
        return
    mut found := List[Hit]()
    for l in tp.answer_rows("{r.out}{r.err}")
        found.push(Hit(loc: Loc(path: "", line: 0, col: 0), text: l))
    show_list("task {sub}", found)

@test fn the_task_panel_has_its_keys_and_marks_the_gutter()
    kk := workspace_key("k", true, true) else Zoom("")
    assert(kk == TaskPanel)
    ky := workspace_key("f8", false, false) else Zoom("")
    assert(ky == AffectedTests)
    kv := workspace_key("f7", false, false) else Zoom("")
    assert(kv == TaskVerify)
    mut ed := typed("fn a()\n    1\n", [])
    ed.impact = Set[int]()
    ed.impact.add(0)
    mut mark := ""
    for sp in ed.render().spans
        if sp.row == 0 and sp.col == 0
            mark = sp.text
    assert(mark.ends_with("~"))
    ed.apply(Insert("x"))
    assert_eq(ed.impact.len(), 0)

# ---- The program card (Ctrl-Shift-I) --------------------------------------

## A source file's lines, for finding where a card item is declared.
struct Source
    path str
    lines List[str]

## Where `signature` is declared: the first line that is it (after `pub `
## and indentation) or starts with it, else for a constant the line that
## assigns its name; none when no line matches.
fn declared_at(sources List[Source], signature str) Loc?
    for src in sources
        for i in 0..src.lines.len()
            mut t := src.lines[i].trim()
            if p := t.strip_prefix("pub ")
                t = p
            if t == signature or t.starts_with("{signature} ")
                return Loc(path: src.path, line: i + 1, col: indent_of(src.lines[i]) + 1)
    # A constant's card shows its value, not its source text.
    if at := signature.find(" := ")
        name := signature.slice(0, at)
        for src in sources
            for i in 0..src.lines.len()
                if src.lines[i].starts_with("{name} := ")
                    or src.lines[i].starts_with("pub {name} := ")
                    return Loc(path: src.path, line: i + 1, col: 1)
    none

## The rows of `ail api --card --json` (lane 67): the entry point and
## tests, then each module's items with their signatures, effects,
## contracts and error sets, members indented below; each declaration row
## jumps to where it is declared in `sources` (ADR 0331).
fn card_hits(j Json, sources List[Source]) List[Hit]
    nowhere := Loc(path: "", line: 0, col: 0)
    mut hits := List[Hit]()
    if jstr(j, "entry") != ""
        hits.push(Hit(loc: nowhere, text: "entry: {jstr(j, "entry")}"))
    mut tests := List[str]()
    for t in jarr(j, "tests")
        tests.push(jtext(t))
    if tests.len() > 0
        hits.push(Hit(loc: nowhere, text: "tests: {tests.join(", ")}"))
    for m in jarr(j, "modules")
        mut name := jstr(m, "module")
        if name == ""
            name = "(root)"
        hits.push(Hit(loc: nowhere, text: "module {name}: {jint(m, "count")} items"))
        for it in jarr(m, "items")
            card_item(mut hits, it, sources, 1, nowhere)
    for d in jarr(j, "dropped")
        hits.push(Hit(loc: nowhere, text: "(dropped to fit: {jtext(d)})"))
    hits

fn card_item(mut hits List[Hit], it Json, sources List[Source], depth int, parent Loc)
    pad := "  ".repeat(depth)
    sig := jstr(it, "signature")
    mut effects := List[str]()
    for e in jarr(it, "effects")
        effects.push(jtext(e))
    mut row := "{pad}{sig}"
    if effects.len() > 0
        row = "{row}  [{effects.join(" ")}]"
    # api.card.2 gives the position; an older `ail` without it falls back to
    # finding the signature in the sources.
    mut at := Loc(path: jstr(it, "file"), line: jint(it, "line"), col: jint(it, "col"))
    if at.line == 0 or at.path == ""
        at = declared_at(sources, sig) else parent
    hits.push(Hit(loc: at, text: row))
    for f in facts_of(it)
        if not f.starts_with("effects:")
            hits.push(Hit(loc: at, text: "{pad}    {f}"))
    # A variant's signature already shows its fields.
    if jstr(it, "kind") != "variant"
        for sub in jarr(it, "members")
            card_item(mut hits, sub, sources, depth + 1, at)

## Ctrl-Shift-I: the program card of the file's program (the file, the
## modules beside it), as a list whose declarations Enter jumps to;
## refreshed on save while it shows.
fn Workspace.card_view(mut self)
    path := eds[active].path
    r := proc.run(ail_command(), ["api", "--card", "--json", "--budget", "100000", path]) else err
        message = "can't run {err.cmd}: {err.kind}"
        return
    if r.status != 0
        message = "no program card: the program has errors (Ctrl-K shows them)"
        return
    j := parse_json(r.out.trim()) else
        message = "can't read the card"
        return
    # The file first, so its declarations win over same-named ones in
    # other programs in the same directory.
    parts := path.split("/")
    mut dir := "."
    if parts.len() > 1
        dir = parts[..parts.len() - 1].join("/")
    mut paths := [path]
    for f in list_files(dir, 4, 2000)
        if f.ends_with(".ail") and f != path and "./{f}" != path
            paths.push(f)
    mut sources := List[Source]()
    for f in paths
        mut text := ""
        for ed in eds
            if ed.path == f
                text = ed.text()
        if text == ""
            text = fs.read_text(f) else ""
        sources.push(Source(path: f, lines: text.lines()))
    show_list("program card {jstr(j, "card")}", card_hits(j, sources))

# ---- Semantic diff (Ctrl-Shift-D, Ctrl-Shift-V, palette) ----------------------

## The saved file against git HEAD, three ways (`ail diff`, `ail api --diff`,
## `ail verify --diff`) as a list whose rows jump to the declaration, or the
## `+` marks of `git diff -U0` in the gutter (S5, features/diff).
fn Workspace.diff_view(mut self, kind str)
    path := eds[active].path
    if eds[active].dirty
        message = "the diff is of the saved file: save with Ctrl-S first"
        return
    if kind == "gutter"
        g := proc.run("git", ["diff", "-U0", "HEAD", "--", path]) else err
            message = "can't run {err.cmd}: {err.kind}"
            return
        eds[active].git_marks = sdiff.changed_lines(g.out)
        message = "{eds[active].git_marks.len()} lines differ from HEAD; an edit clears the marks"
        return
    mut args := ["diff", "--no-tests", "--json", "--rev", "HEAD", path]
    mut title := "semantic diff vs HEAD"
    if kind == "api"
        args = ["api", "--diff", "--json", "--rev", "HEAD", path]
        title = "API diff vs HEAD"
    elif kind == "verify"
        args = ["verify", "--diff", "--json", "--rev", "HEAD", path]
        title = "verify vs HEAD"
    r := proc.run(ail_command(), args) else err
        message = "can't run {err.cmd}: {err.kind}"
        return
    if r.status > 1 and r.out.trim() == ""
        why := r.err.trim().lines()
        message = "{title}: {if why.is_empty() then "failed" else why[0]}"
        return
    report := if kind == "verify" then sdiff.verify_rows(r.out) else sdiff.diff_rows(r.out)
    if report.is_empty()
        message = "{title}: no changes"
        return
    eds[active].index()
    mut found := List[Hit]()
    for row in report
        mut line := 0
        if sym := eds[active].symbol(row.id)
            line = sym.line
        found.push(Hit(loc: Loc(path: path, line: line, col: 1), text: row.text))
    show_list("{title}: {sdiff.change_count(report)} changes", found)

# ---- Replace in files (Ctrl-Shift-H) ---------------------------------------

## Ctrl-Shift-H: asks what to find (the word at the cursor to start), then
## the replacement.
fn Workspace.start_replace(mut self)
    start_search()
    repl_step = 1

## The preview: one row per changed line, `PATH:L:C: old -> new`.
fn Workspace.preview_replace(mut self)
    found := search_project(search, 1000)
    if found.len() == 0
        repl_step = 0
        message = "no match for `{search}`"
        return
    mut preview := List[Hit]()
    for h in found
        old := h.text.split(": ")[1..].join(": ")
        preview.push(Hit(
            loc: h.loc,
            text: "[x] {h.loc.path}:{h.loc.line}:{h.loc.col}: {old} -> {old.replace(search, repl_with)}",
        ))
    repl_skip = Set[int]()
    show_list("", preview)
    repl_step = 3
    retitle_replace()

## The preview's title: what, and how many rows and files are accepted.
fn Workspace.retitle_replace(mut self)
    mut touched := Set[str]()
    for i in 0..hits.len()
        if not repl_skip.contains(i)
            touched.add(hits[i].loc.path)
    n := hits.len() - repl_skip.len()
    hits_title = "replace `{search}` with `{repl_with}`: {n} of {hits.len()} lines, {touched.len()} files; Space skips, A all, Ctrl-Enter applies"
    fill_hits()

## Space on a preview row: skip it, or accept it again; `all` (A) accepts
## every row.
fn Workspace.mark_rows(mut self, all bool)
    if all
        repl_skip = Set[int]()
    elif repl_skip.contains(hit_sel)
        repl_skip.remove(hit_sel)
    else
        repl_skip.add(hit_sel)
    for i in 0..hits.len()
        mut mark := "[x] "
        if repl_skip.contains(i)
            mark = "[ ] "
        hits[i].text = "{mark}{hits[i].text.chars()[4..].join("")}"
    retitle_replace()

## Ctrl-Enter on the preview: replaces on the accepted rows' lines in
## each file's buffer, opening it as a tab; nothing is saved, and Ctrl-Z
## undoes each tab.
fn Workspace.apply_replace(mut self)
    back := eds[active].path
    mut done := Set[str]()
    for i in 0..hits.len()
        p := hits[i].loc.path
        if repl_skip.contains(i) or done.contains(p)
            continue
        done.add(p)
        mut at_lines := List[int]()
        for j in i..hits.len()
            if hits[j].loc.path == p and not repl_skip.contains(j)
                at_lines.push(hits[j].loc.line - 1)
        mut at := -1
        for e in 0..eds.len()
            if eds[e].path == p or eds[e].path == "./{p}"
                at = e
        if at < 0
            open(p)
            at = active
        eds[at].replace_on(search, repl_with, at_lines)
    open(back)
    browsing = false
    repl_step = 0
    hits = []
    eds[active].pane = Diags
    eds[active].message = "replaced `{search}` in {done.len()} files, not saved; Ctrl-Z undoes per tab"

# ---- References (Shift-F12) ----------------------------------------------

## The rows of `ail api --refs` output: each place of the name, with
## `declaration` or `reference`, shown relative to `root` (ADR 0489). The
## buffer's own temporary copy counts as its file.
fn refs_hits(root str, j Json) List[Hit]
    mut out := List[Hit]()
    for r in jarr(j, "refs")
        mut file := jstr(r, "file")
        if f := file.strip_suffix(".edit-query.ail")
            file = f
        mut what := "reference"
        if d := (r.get("def") else Json.Null).as_bool()
            if d
                what = "declaration"
        at := Loc(path: file, line: jint(r, "line"), col: jint(r, "col"))
        out.push(Hit(loc: at, text: "{shown_path(root, file)}:{at.line}:{at.col}: {what}"))
    out

## Shift-F12: the references of the name under the cursor in the pane,
## Enter jumps to one (ADR 0489). Names the cursor isn't on say so.
fn Workspace.show_references(mut self)
    j := eds[active].api_at(
        "--refs",
        eds[active].text(),
        eds[active].line + 1,
        eds[active].col + 1,
    ) else
        eds[active].message = "references: put the cursor on a name"
        return
    found := refs_hits(env.cwd(), j)
    if found.len() == 0
        eds[active].message = "no references found"
        return
    show_list("references: {found.len()}", found)

# ---- Problems (Ctrl-Shift-M) ----------------------------------------------

## The rows of `ail check --json` output (standard error), one per
## diagnostic not already in `seen`: `FILE:LINE:COL: severity[rule]
## message`. A check copy of an unsaved buffer counts as its file. The
## row shows the file relative to `root` (the working directory), or its
## base name when it lies elsewhere, so a long absolute path (macOS's
## temporary directory, say) doesn't push the message off the row.
fn problem_hits(root str, err str, mut seen Set[str]) List[Hit]
    mut hits := List[Hit]()
    for l in err.lines()
        j := parse_json(l) else continue
        if jstr(j, "rule") == ""
            continue
        mut file := jstr(j, "file")
        if f := file.strip_suffix(".edit-check.ail")
            file = f
        at := Loc(path: file, line: jint(j, "line"), col: jint(j, "col"))
        row := "{shown_path(root, file)}:{at.line}:{at.col}: {jstr(j, "severity")}[{jstr(j, "rule")}] {jstr(j, "message")}"
        if seen.contains(row)
            continue
        seen.add(row)
        hits.push(Hit(loc: at, text: row))
    hits

## Every diagnostic of the programs of the open tabs (each checked whole,
## modules included, buffers as edited), errors first.
fn Workspace.collect_problems(mut self) List[Hit]
    mut seen := Set[str]()
    mut errors := List[Hit]()
    mut others := List[Hit]()
    for i in 0..eds.len()
        r := eds[i].ail_on_buffer(["check", "--json"]) else continue
        for h in problem_hits(env.cwd(), r.err, mut seen)
            if h.text.contains(": error[")
                errors.push(h)
            else
                others.push(h)
    errors.extend(others)
    errors

## The list's title: the counts by severity.
fn problems_title(found List[Hit]) str
    mut errors := 0
    for h in found
        if h.text.contains(": error[")
            errors += 1
    "problems: {errors} errors, {found.len() - errors} others"

## What identifies a diagnostic across edits: its file and message, not
## its position, which moves as lines are added above it.
fn problem_key(h Hit) str
    "{h.loc.path} {h.text.split(": ")[1..].join(": ")}"

## Ctrl-Shift-M: the problems as a list Enter jumps from (ADR 0339),
## kept live while shown (ADR 0353).
fn Workspace.problems(mut self)
    found := collect_problems()
    if found.len() == 0
        message = "no problems in {eds.len()} open file(s)"
        return
    show_list(problems_title(found), found)
    live_problems = true
    typed_at = 0

## Rebuilds the shown problems list from the buffers, keeping the
## selection on the same diagnostic when it still exists and the focus
## where it is (ADR 0353).
fn Workspace.refresh_problems(mut self)
    typed_at = 0
    if eds[active].pane != Text or not hits_title.starts_with("problems")
        live_problems = false
        return
    mut keep := ""
    if hit_sel < hits.len()
        keep = problem_key(hits[hit_sel])
    found := collect_problems()
    hits = found
    hits_title = problems_title(found)
    mut sel := hit_sel.min(found.len() - 1).max(0)
    for i in 0..found.len()
        if problem_key(found[i]) == keep
            sel = i
    hit_sel = sel
    fill_hits()

# ---- Ask bar, call hierarchy, symbols, tokens (features/ask, plan S8) -------

## The rows of an answer as hits; heading rows have line 0 and don't jump.
fn ask_hits(rows List[ask.Site]) List[Hit]
    mut out := List[Hit]()
    for s in rows
        out.push(Hit(loc: Loc(path: s.file, line: s.line, col: s.col), text: s.text))
    out

## The file `ail` should read for the active tab: the saved file, or a copy
## beside it when the buffer has unsaved changes (so imports still resolve).
fn Workspace.ask_source(mut self) str?
    ed := eds[active]
    if not ed.dirty
        return ed.path
    file := "{ed.path}.edit-check.ail"
    fs.write_text(file, ed.text()) else err
        message = "can't write {err.path}: {err.kind}"
        return none
    file

fn Workspace.ask_release(mut self, file str)
    if file != eds[active].path
        fs.remove(file) else err
            message = "can't remove {err.path}: {err.kind}"

fn Workspace.askbar_event(mut self, ev ui.Event)
    match ev
        Key(k, ctrl, _, _) =>
            if ctrl
                return
            if askbar.key(k) == "run"
                askbar_run()
        Close => quit_all()
        Resize(_, _) => on_resize(ev)
        Mouse(_, _, _, _) | Scroll(_) => return

## Enter in the bar: asks the question, or searches the symbols.
fn Workspace.askbar_run(mut self)
    q := askbar.text.trim()
    if q == ""
        return
    if askbar.mode == 1
        go_symbols(q)
        return
    if eds[active].path == ""
        message = "ask needs a saved file"
        return
    file := ask_source() else return
    got := ask.query(ail_command(), file, eds[active].path, q)
    ask_release(file)
    if got.problem != ""
        message = got.problem
        return
    if not ask.has_sites(got.rows)
        message = "no answers for `{q}`"
        return
    show_list("ask `{q}`", ask_hits(got.rows))

## Declarations matching `q` in every `.ail` file under the directory.
fn Workspace.go_symbols(mut self, q str)
    mut found := List[ask.Site]()
    for f in list_files(tree_root, 4, 300)
        if not f.ends_with(".ail") or f.ends_with(".edit-check.ail")
            continue
        r := proc.run(ail_command(), ["api", "--text", f]) else continue
        for s in ask.symbol_rows(r.out, f, q)
            if found.len() < 200
                found.push(s)
    if found.len() == 0
        message = "no declaration matches `{q}`"
        return
    show_list("symbols `{q}`: {found.len()}", ask_hits(found))

## Ctrl-Shift-Y: callers, then callees, of the function under the cursor.
fn Workspace.show_hierarchy(mut self)
    name := eds[active].word_here()
    if name == "" or eds[active].path == ""
        message = "call hierarchy: put the cursor on a function name in a saved file"
        return
    file := ask_source() else return
    cmd := ail_command()
    path := eds[active].path
    callers := ask.hierarchy(cmd, file, path, name, true, 3)
    callees := ask.hierarchy(cmd, file, path, name, false, 3)
    ask_release(file)
    mut found := List[Hit]()
    found.push(Hit(loc: Loc(path: "", line: 0, col: 0), text: "-- who calls {name}"))
    for h in ask_hits(callers)
        found.push(h)
    found.push(Hit(loc: Loc(path: "", line: 0, col: 0), text: "-- what {name} calls"))
    for h in ask_hits(callees)
        found.push(h)
    show_list("call hierarchy of `{name}`", found)

## The tokens of `text`, through a temporary file beside `path`.
fn Workspace.count_text(mut self, path str, text str) int
    file := "{path}.edit-tokens.ail"
    fs.write_text(file, text) else err
        message = "can't write {err.path}: {err.kind}"
        return -1
    mut n := -1
    if t := ask.tokens_of(ail_command(), file)
        n = t
    fs.remove(file) else err
        message = "can't remove {err.path}: {err.kind}"
    n

## Ctrl-Shift-K: counts the buffer as edited and the selection.
fn Workspace.token_report(mut self)
    ed := eds[active]
    whole := count_text(ed.path, ed.text())
    if whole < 0
        return
    mut picked := -1
    sel := ed.selected_text()
    if sel != ""
        picked = count_text(ed.path, sel)
    askbar.counted(ed.path, ed.saves, whole)
    askbar.selected(picked)
    if picked >= 0
        message = "tokens: {whole} in the file, {picked} selected"
    else
        message = "tokens: {whole} in the file"

## After an event: counts the saved file again when the tab or the save
## count changed. Files that don't exist yet aren't counted.
fn Workspace.askbar_refresh(mut self)
    ed := eds[active]
    if not askbar.stale(ed.path, ed.saves)
        return
    mut n := -1
    if ed.path != "" and fs.exists(ed.path)
        if t := ask.tokens_of(ail_command(), ed.path)
            n = t
    askbar.counted(ed.path, ed.saves, n)

## The prompt on the tab bar while the bar is open, and the token count at
## the right end of the status row.
fn Workspace.render_askbar(self, mut s Screen)
    if askbar.open
        head := askbar.prompt()
        s.put(0, 0, "{head}{askbar.text} ".pad_right(cols, ' '), STATUS_FG, SELECT_BG)
        s.cursor_row = 0
        s.cursor_col = head.chars().len() + askbar.text.chars().len()
        return
    seg := askbar.segment()
    if seg != ""
        s.put(1 + eds[active].text_rows(), cols - seg.chars().len(), seg, STATUS_FG, STATUS_BG)

## Called while the window waits: refreshes the live problems list once
## 500 ms have passed since the last edit.
fn Workspace.idle(mut self, now int)
    if live_problems and typed_at > 0 and now - typed_at >= 500
        refresh_problems()

@test fn sessions_round_trip()
    mut a := Editor.new("src/a,b.ail", "x\nyz", 40, 10)
    a.jump_to(Loc(path: "", line: 2, col: 3))
    b := Editor.new("b.ail", "", 40, 10)
    v := session_value([b, a], 1)
    assert_eq(v, "2,3,src/a,b.ail|1,1,b.ail")
    at := session_places("{v}|junk")
    assert_eq(at.len(), 2)
    assert_eq(at[0].path, "src/a,b.ail")
    assert_eq(at[0].line, 2)
    assert_eq(at[0].col, 3)
    assert_eq(session_key("/p"), "open:/p")

@test fn problem_rows_from_check_json()
    out := "\{\"severity\":\"error\",\"rule\":\"expr.name.1\",\"file\":\"a.ail.edit-check.ail\",\"line\":3,\"col\":5,\"message\":\"unknown name\"}\nnot json\n"
    mut seen := Set[str]()
    hits := problem_hits("/w", out, mut seen)
    assert_eq(hits.len(), 1)
    assert_eq(hits[0].text, "a.ail:3:5: error[expr.name.1] unknown name")
    assert_eq(hits[0].loc.line, 3)
    assert_eq(problem_hits("/w", out, mut seen).len(), 0)

# ---- The file picker (Ctrl-P) ---------------------------------------------

## The files under `dir`, to `depth` levels, skipping hidden and build
## directories, at most `limit` of them.
fn list_files(dir str, depth int, limit int) List[str]
    mut out := List[str]()
    names := fs.list_dir(dir) else return out
    for n in names
        if out.len() >= limit
            break
        if n.starts_with(".") or n == "target"
            continue
        mut path := n
        if dir != "."
            path = "{dir}/{n}"
        if sub := fs.list_dir(path)
            if depth > 0 and sub.len() >= 0
                for f in list_files(path, depth - 1, limit - out.len())
                    out.push(f)
        else
            out.push(path)
    out

## Whether the characters of `q` appear in `s` in order, ignoring case.
fn fuzzy(s str, q str) bool
    cs := s.chars()
    mut i := 0
    for c in q.chars()
        while i < cs.len() and cs[i].to_lower() != c.to_lower()
            i += 1
        if i == cs.len()
            return false
        i += 1
    true

fn Workspace.matches(self) List[str]
    mut out := List[str]()
    for f in files
        if fuzzy(f, field.text)
            out.push(f)
    out

fn Workspace.start_picking(mut self)
    picking = true
    commanding = false
    field = widgets.TextField.new("open: ", "")
    list = picker_list()
    files = list_files(".", 4, 2000)

fn Workspace.pick_event(mut self, ev ui.Event)
    match ev
        Key(k, ctrl, _, _) =>
            if ctrl
                return
            if k == "escape"
                picking = false
                commanding = false
            elif k == "enter"
                choose()
                return
            elif k == "up" or k == "down"
                list.items = choices()
                list.on_event(ev, picker_rect(list.items.len()))
            elif k == "backspace" or k.chars().len() == 1
                field.on_event(ev)
                list.selected = 0
                list.top = 0
        Close => quit_all()
        Resize(_, _) =>
            picking = false
            on_event(ev)
        Mouse(_, _, _, _) | Scroll(_) => return
    list.selected = list.selected.min((choices().len() - 1).max(0))

## The screen: the tab bar, the active editor below it, and the picker over
## it when open.
fn Workspace.render(self) Screen
    mut s := Screen.new(cols, rows)
    s.band(0, PANE_BG)
    labels := tab_labels()
    mut x := 0
    for i in 0..labels.len()
        mut bg := PANE_BG
        mut fg := GUTTER_FG
        if i == active
            bg = BG
            fg = FG
        s.put(0, x, labels[i], fg, bg)
        x += labels[i].chars().len() + 1
    if message != ""
        s.put(0, x + 1, message, FG, PANE_BG)
    inner := eds[active].render()
    x0 := left()
    for sp in inner.spans
        s.spans.push(Span(row: sp.row + 1, col: sp.col + x0, text: sp.text, fg: sp.fg, bg: sp.bg))
    for r in 0..inner.text.len()
        if r + 1 < rows
            s.text[r + 1] = inner.text[r]
    s.text[0] = labels.join(" ")
    if inner.cursor_row >= 0
        s.cursor_row = inner.cursor_row + 1
        s.cursor_col = inner.cursor_col + x0
    if tree_open
        render_tree(mut s)
    render_search(mut s)
    render_askbar(mut s)
    if picking
        render_picker(mut s)
    s

fn Workspace.render_picker(self, mut s Screen)
    found := choices()
    r := picker_rect(found.len())
    head := widgets.Rect(col: r.col, row: 1, cols: r.cols, rows: 1)
    s.runs(field.render(head, {"status_fg": STATUS_FG, "select_bg": SELECT_BG}))
    mut shown := list
    shown.items = found
    s.runs(shown.render(r, {
        "fg": FG,
        "pane_bg": PANE_BG,
        "select_bg": LINE_BG,
        "gutter_fg": GUTTER_FG,
    }))
    s.cursor_row = 1
    s.cursor_col = field.caret_col(head)

## A fresh list for the picker or the palette.
fn picker_list() widgets.ListView
    mut l := widgets.ListView.new([])
    l.empty = "nothing matches"
    l

## Where the picker's list goes: centred, up to 70 columns wide, below its
## query line, as many rows as there are choices (at least 1, at most 12).
fn Workspace.picker_rect(self, n int) widgets.Rect
    w := (cols - 4).min(70).max(10)
    widgets.Rect(col: (cols - w) / 2, row: 2, cols: w, rows: n.min(12).max(1))

## Adds widget runs without their trailing padding, for a pane whose band
## already fills the row.
fn Screen.runs_unpadded(mut self, runs List[widgets.Run])
    for r in runs
        cs := r.text.chars()
        mut end := cs.len()
        while end > 0 and cs[end - 1] == ' '
            end -= 1
        if end > 0
            put(r.row, r.col, cs[..end].join(""), r.fg, r.bg)

## Adds widget runs to the screen (std.ui.widgets).
fn Screen.runs(mut self, runs List[widgets.Run])
    for r in runs
        put(r.row, r.col, r.text, r.fg, r.bg)

## The event loop: wait for an event, apply it and any others already
## pending, then draw once. The title shows the file and its unsaved mark.
fn Workspace.window(mut self) ! ui.UiError
    mut w := ui.open("edit", cols, rows)?
    size := w.size()
    on_event(Resize(cols: size.cols, rows: size.rows))
    mut title := ""
    while not quit
        ed := eds[active]
        mut t := "{ed.path} - edit"
        if ed.dirty
            t = "* {t}"
        if t != title
            w.set_title(t)
            title = t
        if font != w.font_size()
            w.set_font_size(font)
            font = w.font_size()
        draw_themed(mut w, render(), pal)
        if live_problems and typed_at > 0
            # Wait for an event without blocking, so the idle refresh runs.
            if ev := w.poll_event()
                on_window_event(ev, w.modifiers())
            else
                idle(time.now_ms())
                time.sleep_ms(25)
            continue
        on_window_event(w.next_event(), w.modifiers())
        while not quit
            ev := w.poll_event() else break
            on_window_event(ev, w.modifiers())
    if remember
        save_session()
    w.close()

## An event with the modifiers held when it happened (std.ui.14): a
## Shift-click extends the selection to the clicked place.
fn Workspace.on_window_event(mut self, ev ui.Event, m ui.Modifiers)
    shift_click := match ev
        Mouse(c, r, button, kind) =>
            if m.shift and not picking and button == "left" and kind == "down" and r > 0
                eds[active].extend_to(c - left(), r - 1)
                true
            else
                false
        Key(_, _, _, _) | Resize(_, _) | Close | Scroll(_) => false
    if not shift_click
        on_event(ev)

# ---- Window front end (std.app, S1) --------------------------------------

## The `std.app` window: the workspace drawn on a canvas (`window/`), pixel
## events turned back into the cell events the workspace takes. The cell
## `Screen` and every `--print` test are unchanged.
struct Shell
    ws Workspace
    m win.Metrics
    pw float
    ph float
    cellw float
    cellh float
    held bool
    menu app.Popup?
    sent List[str]
    ready bool

fn Shell.new(w Workspace) Shell
    Shell(
        ws: w,
        m: win.metrics(1000.0, 700.0, 8.0, 16.0, 13.0, false),
        pw: 1000.0,
        ph: 700.0,
        cellw: 8.0,
        cellh: 16.0,
        held: false,
        menu: none,
        sent: [],
        ready: false,
    )

## The code's font size in points: the workspace's cell height, scaled.
fn Shell.size(self) float
    ws.font.to_float() * 0.65

## Lays the grid out for the canvas and tells the workspace its new size.
fn Shell.relayout(mut self)
    next := win.metrics(pw, ph, cellw, cellh, size(), ws.minimap)
    if not ready or next.cols != m.cols or next.rows != m.rows
        ws.on_event(Resize(cols: next.cols, rows: next.rows))
    m = next
    ready = true

## The tabs of the strip.
fn Shell.tabs(self) List[win.Tab]
    mut out := List[win.Tab]()
    for i in 0..ws.eds.len()
        e := ws.eds[i]
        out.push(win.Tab(
            name: base_name(e.path),
            active: i == ws.active,
            dirty: e.dirty,
            errors: e.diag_count("error"),
            warnings: e.diag_count("warning"),
        ))
    out

## Everything one frame shows, from the workspace's `Screen`.
fn Shell.frame(self) win.Frame
    s := ws.render()
    e := ws.eds[ws.active]
    p := ws.pal
    colors := win.Colors(
        bg: p.bg_of(BG),
        fg: p.fg_of(FG),
        pane_bg: p.bg_of(PANE_BG),
        line_bg: p.bg_of(LINE_BG),
        status_bg: p.bg_of(STATUS_BG),
        status_fg: p.fg_of(STATUS_FG),
        gutter_fg: p.fg_of(GUTTER_FG),
        select_bg: p.bg_of(SELECT_BG),
        error_fg: p.fg_of(ERROR_FG),
        warn_fg: p.fg_of(WARN_FG),
    )
    runs := [
        win.Run(row: sp.row, col: sp.col, text: sp.text, fg: p.fg_of(sp.fg), bg: p.bg_of(sp.bg))
        for sp in s.spans
    ]
    srow := 1 + e.text_rows()
    mut status := ""
    if srow < s.text.len()
        cs := s.text[srow].chars()
        if cs.len() > ws.left()
            status = cs[ws.left()..].join("")
    mut marks := List[win.Mark]()
    for d in e.diags
        marks.push(win.Mark(line: (d.line - 1).max(0), kind: d.severity))
    mut lens := List[int]()
    if ws.minimap
        for l in e.lines
            lens.push(l.chars().len())
    win.Frame(
        colors: colors,
        runs: runs,
        tabs: tabs(),
        cols: s.cols,
        rows: s.rows,
        status_row: srow,
        status: status,
        cursor_col: s.cursor_col,
        cursor_row: s.cursor_row,
        left: ws.left(),
        bar_from: 1,
        bar_to: srow,
        bar: win.Bar(top: e.top, total: e.lines.len(), visible: e.text_rows(), marks: marks),
        minimap: ws.minimap,
        zen: ws.zen,
        lens: lens,
    )

## A key as the workspace takes it.
fn Shell.press_key(mut self, spec win.KeySpec)
    before := ws.eds[ws.active].clip
    ws.on_event(Key(key: spec.key, ctrl: spec.ctrl, alt: spec.alt, shift: spec.shift))
    after := ws.eds[ws.active].clip
    if after != before
        sent.push(app.clipboard(after))

## A click on the scrollbar: the buffer scrolls to that fraction.
fn Shell.click_bar(mut self, y float)
    y0 := win.row_y(m, 1)
    span := (win.row_y(m, 1 + ws.eds[ws.active].text_rows()) - y0).max(1.0)
    total := ws.eds[ws.active].lines.len()
    at := (((y - y0) / span).max(0.0).min(1.0) * total.to_float()).to_int()
    ws.eds[ws.active].top = at.min(total - 1).max(0)

## A press on the canvas: the tab strip, the scrollbar, a right-click menu,
## or a cell of the grid.
fn Shell.pointer_down(mut self, ev app.Event)
    cell := win.cell_at(m, ev.x, ev.y)
    if cell.row == 0
        hit := win.tab_hit(tabs(), win.chrome_size(m), ev.x)
        if hit.index >= 0 and ev.text == "left"
            ws.active = hit.index
            if hit.close
                ws.close_tab()
        return
    if ev.x >= m.w - win.SCROLL_W
        click_bar(ev.y)
        return
    if ev.text == "right"
        menu = app.Popup(id: "ctx", x: ev.x, y: ev.y, items: win.MENU)
        return
    held = ev.text == "left"
    ws.on_event(Mouse(col: cell.col, row: cell.row, button: "left", kind: "down"))

impl app.App for Shell
    fn update(mut self, ev app.Event)
        match ev.kind
            "resize" =>
                if ev.id == "edit"
                    pw = ev.dx
                    ph = ev.dy
                    cellw = ev.cell_w
                    cellh = ev.cell_h
            "key" =>
                press_key(win.key_spec(ev.text, ev.ctrl, ev.meta, ev.alt, ev.shift))
            "paste" =>
                if ws.picking or ws.searching
                    for c in ev.text.chars()
                        ws.on_event(press("{c}"))
                else
                    ws.eds[ws.active].clip = ev.text
                    ws.on_event(key_event("ctrl+v"))
            "down" =>
                pointer_down(ev)
            "move" =>
                if held
                    cell := win.cell_at(m, ev.x, ev.y)
                    ws.on_event(Mouse(col: cell.col, row: cell.row, button: "left", kind: "drag"))
            "up" =>
                if held
                    held = false
                    cell := win.cell_at(m, ev.x, ev.y)
                    ws.on_event(Mouse(col: cell.col, row: cell.row, button: "left", kind: "up"))
            "scroll" =>
                n := win.wheel_lines(ev.dy, m.ch)
                if n != 0
                    ws.on_event(Scroll(lines: n))
            "popup" =>
                menu = none
                k := win.menu_key(ev.text)
                if k != ""
                    ws.on_event(key_event(k))
            "close" =>
                ws.on_event(Close)
            _ => held = held
        ws.idle(time.now_ms())
        relayout()
        if ws.quit
            if ws.remember
                ws.save_session()
            io.exit(0)

    fn view(self) app.Node
        app.canvas("edit", 0.0, 0.0, win.canvas_ops(frame(), m))

    fn title(self) str
        e := ws.eds[ws.active]
        "{base_name(e.path)}{if e.dirty then " *" else ""} - edit"

    fn popup(self) app.Popup?
        menu

    fn lines(mut self) List[str]
        out := sent
        sent = []
        out

    fn edge(self) bool
        false

@test fn the_app_shell_draws_and_edits_without_a_window()
    mut sh := Shell.new(Workspace.new(Editor.new("t.ail", "fn main()\n", 100, 32)))
    mut size := app.event("resize")
    size.id = "edit"
    size.dx = 800.0
    size.dy = 500.0
    size.cell_w = 8.0
    size.cell_h = 16.0
    mut kp := app.key("x")
    kp.id = "edit"
    shots := app.script(mut sh, [size, kp, kp])
    assert(shots[2].contains("canvas #edit"))
    assert_eq(sh.ws.eds[0].lines[0], "xxfn main()")
    assert(sh.ws.eds[0].dirty)
    assert_eq(sh.ws.cols, sh.m.cols)
    assert_eq(sh.title(), "t.ail * - edit")
    mut cp := app.key("c")
    cp.meta = true
    sh.update(cp)
    assert_eq(sh.lines().len(), 0)

## Opens the `std.app` window, or prints one screen when there is no host.
fn app_main(mut ed Editor, flags List[str])
    ed.index()
    mut ws := Workspace.new(ed)
    ws.font = font_flag(flags)
    ws.remember = true
    ws.restore_session()
    mut name := saved_theme()
    at := flags.index_of("--theme") else -1
    if at >= 0 and at + 1 < flags.len()
        name = flags[at + 1]
    if not ws.set_theme(name)
        ws.message = "no theme `{name}`: try {themes.NAMES.join(", ")}"
    mut sh := Shell.new(ws)
    app.run(mut sh) else err
        print("edit: no window ({err.kind}: {err.message}); printing the screen instead")
        print_screen(ed, flags)

## Opens the window, or prints one screen when there's no display.
fn window_main(mut ed Editor, flags List[str])
    ed.index()
    mut ws := Workspace.new(ed)
    ws.font = font_flag(flags)
    ws.remember = true
    ws.restore_session()
    mut name := saved_theme()
    at := flags.index_of("--theme") else -1
    if at >= 0 and at + 1 < flags.len()
        name = flags[at + 1]
    if not ws.set_theme(name)
        ws.message = "no theme `{name}`: try {themes.NAMES.join(", ")}"
    ws.window() else err
        print("edit: no window ({err.kind}: {err.message}); printing the screen instead")
        print_screen(ed, flags)

## `--font N`: the font size to start with; 20 when absent or not a number.
fn font_flag(flags List[str]) int
    at := flags.index_of("--font") else return 20
    if at + 1 >= flags.len()
        return 20
    flags[at + 1].to_int() else 20

## `--print`: runs the flags in order, then prints the screen as text, so
## an agent or a test can drive the editor without a window:
## `--check`, `--outline`, `--explain`; `--at=LINE:COL` (1-based) moves the
## cursor; `--type=TEXT` types; `--key=SPEC` presses a key such as `f2`,
## `enter`, `ctrl+space` or `shift+f5` (`ctrl+`, `alt+`, `shift+`
## prefixes); `--idle` acts as if the window had waited a second. Keys go through the workspace, as in the window.
fn print_screen(ed Editor, flags List[str])
    mut ws := Workspace.new(ed)
    for f in flags
        if f == "--check"
            ws.eds[ws.active].run(Check)
        elif f == "--outline"
            ws.eds[ws.active].run(Outline)
        elif f == "--explain"
            ws.eds[ws.active].run(Explain)
        elif at := f.strip_prefix("--at=")
            parts := at.split(":")
            mut e := ws.eds[ws.active]
            e.line = ((parts[0].to_int() else 1) - 1).max(0).min(e.lines.len() - 1)
            e.set_col(((parts[parts.len() - 1].to_int() else 1) - 1).max(0).min(e.cur().len()))
            e.scroll()
            ws.eds[ws.active] = e
        elif t := f.strip_prefix("--type=")
            for c in t.chars()
                ws.on_event(press("{c}"))
        elif spec := f.strip_prefix("--key=")
            ws.on_event(key_event(spec))
        elif f == "--idle"
            ws.idle(time.now_ms() + 1000)
        elif f == "--task-json"
            print(ws.task_json())
            return
    shown := ws.render()
    if flags.contains("--screen")
        runs := [
            widgets.Run(col: sp.col, row: sp.row, text: sp.text, fg: sp.fg, bg: sp.bg, bold: false)
            for sp in shown.spans
        ]
        print(
            scells
                .of_cells(shown.cols, shown.rows, runs, shown.cursor_col, shown.cursor_row)
                .describe(0.0, 0.0, shown.cols.to_float(), shown.rows.to_float(), 3000),
        )
        return
    for row in shown.text
        print(row)

## `--bench`: the time to render one screen, averaged over 20 renders at
## the middle of the buffer.
fn bench(mut ed Editor)
    ed.line = ed.lines.len() / 2
    ed.scroll()
    start := time.now_ms()
    mut cells := 0
    for _ in 0..20
        for sp in ed.render().spans
            cells += sp.text.len()
    ms := (time.now_ms() - start).to_float() / 20.0
    print("{ed.lines.len()} lines, {ed.cols}x{ed.rows} screen: {ms:.1} ms per render ({cells / 20} cells drawn)")
    t := time.now_ms()
    for _ in 0..20
        ed.apply(Insert("x"))
        ed.apply(Newline)
    keys_ms := (time.now_ms() - t).to_float() / 40.0
    print("{keys_ms:.1} ms per edit (insert or newline)")

fn main() !
    args := env.args()
    if args.len() == 0
        print("usage: ail run edit.ail [--font N] [--keys] [--grid] [--print [--screen] [--check] [--outline] [--explain] [--at=L:C] [--type=TEXT] [--key=KEY]...] FILE")
        return
    if args.contains("--keys")
        for l in key_table()
            print(l)
        return
    path := args[args.len() - 1]
    mut text := ""
    if fs.exists(path)
        text = fs.read_text(path)?
    mut ed := Editor.new(path, text, 100, 32)
    flags := args[..args.len() - 1]
    if flags.contains("--bench")
        bench(mut ed)
        return
    if flags.contains("--print")
        print_screen(ed, flags)
        return
    if flags.contains("--grid")
        window_main(mut ed, flags)
    else
        app_main(mut ed, flags)
