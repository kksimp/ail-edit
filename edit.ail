## The README's key table (`--keys`).
fn key_table() List[str]
    mut out := ["| Key | Does |", "|---|---|"]
    for r in key_rows()
        out.push("| {r.keys} | {r.does} |")
    out

## The key event a spec such as `ctrl+shift+f`, `f2` or `ctrl+space` names.
fn key_event(spec str) ui.Event
    mut parts := spec.split("+")
    mut key := parts.pop() else ""
    if key == "space"
        key = " "
    Key(
        key: ui.key_code(key),
        ctrl: parts.contains("ctrl"),
        alt: parts.contains("alt"),
        shift: parts.contains("shift"),
    )

## The key of a key event without Ctrl or Alt.
fn pressed(ev ui.Event) str?
    match ev
        Key(k, ctrl, alt, _) =>
            if ctrl or alt
                return none
            k.name()
        Resize(_, _) | Close | Mouse(_, _, _, _) | Scroll(_) => none

@test fn key_specs_round_trip_through_key_codes()
    assert(key_event("f5") == Key(key: F(5), ctrl: false, alt: false, shift: false))
    assert(key_event("space") == Key(key: Text(" "), ctrl: false, alt: false, shift: false))
    for spec in ["pagedown", "escape", "a", "f12", "["]
        assert_eq(pressed(key_event(spec)) else "", spec)

## Keys the workspace handles itself, before the active tab sees them.
enum WsKey
    NextTab
    PreviousTab
    CloseTab
    QuitAll
    OpenFile
    Palette
    Search
    NextHit
    Tree
    Theme
    Trace
    FailurePaths
    Coverage
    Card
    Probes(spec str)
    Problems
    References
    ReplaceInFiles
    TestOnSave
    Settings
    NewProject
    Split
    Sem(key str)
    TestTool(mode str)
    TaskPanel
    AffectedTests
    TaskVerify
    AgentPack
    AgentApply
    AskBar
    Symbols
    Hierarchy
    Zoom(key str)
    Diff(kind str)

fn workspace_key(k str, ctrl bool, alt bool, shift bool) WsKey?
    if alt and shift and not ctrl
        return match k
            "c" | "C" => AgentPack
            "v" | "V" => AgentApply
            "h" | "H" => Hierarchy
            _ => none
    if not alt
        if spec := probes.key_spec(k, ctrl, shift)
            return Probes(spec)
    if not ctrl
        if k == "f4" and not shift
            return NextHit
        if k == "f5" and shift
            return Trace
        if k == "f6" and shift
            return TestTool("one")
        if k == "f7" and not shift
            return TaskVerify
        if k == "f8" and not shift
            return AffectedTests
        if k == "f12" and shift
            return References
        return none
    if k == "tab"
        if shift
            return PreviousTab
        return NextTab
    if k == "=" or k == "+" or k == "-" or k == "0"
        return Zoom(k)
    if k == "\\"
        return Split
    if shift
        return match k
            "." | ">" => Sem("x")
            "p" | "P" => Palette
            "f" | "F" => Search
            "t" | "T" => Theme
            "e" | "E" => FailurePaths
            "c" | "C" => Coverage
            "i" | "I" => Card
            "m" | "M" => Problems
            "h" | "H" => ReplaceInFiles
            "u" | "U" => TestOnSave
            "n" | "N" => NewProject
            "d" | "D" => Diff("diff")
            "v" | "V" => Diff("verify")
            "j" | "J" => TestTool("tree")
            "y" | "Y" => TestTool("replay")
            "z" | "Z" => TestTool("shrink")
            "x" | "X" => TestTool("contracts")
            "k" | "K" => TaskPanel
            "a" | "A" => AskBar
            _ => none
    match k
        "b" | "B" => Tree
        "w" | "W" => CloseTab
        "q" | "Q" => QuitAll
        "p" | "P" => OpenFile
        "," => Settings
        "t" | "T" => Symbols
        _ => none

## The palette's rows matching what is typed: those that run a command
## (a key, or a palette-only row: spec "" and a name, run by `run_command`).
fn Workspace.commands(self) List[KeyRow]
    mut out := List[KeyRow]()
    for r in key_rows()
        if r.name != "" and fuzzy(r.name, self.field.text)
            out.push(r)
    out

fn Workspace.start_palette(mut self)
    self.picking = true
    self.commanding = true
    self.field = widgets.TextField.new("command: ", "")
    self.list = picker_list()

## What the open list shows: commands with their keys, or file paths.
fn Workspace.choices(self) List[str]
    if self.picker_mode == "settings"
        mut shown_rows := List[str]()
        for r in workspace.rows(themes.NAMES)
            shown_rows.push(workspace.shown(r, self.value_of(r.key)))
        return shown_rows
    if self.picker_mode == "new"
        return ["Enter creates NAME/ with ail.pkg and main.ail (ail new); Esc cancels"]
    if self.picker_mode == "bind"
        return ["NEWKEY as COMMAND, e.g. ctrl+alt+t as Next theme; Esc cancels"]
    if not self.commanding
        return self.matches()
    mut out := List[str]()
    for r in self.commands()
        out.push("{r.name.pad_right(28, ' ')} {r.keys}")
    out

## Enter in the open list: runs the command, or opens the file.
fn Workspace.choose(mut self)
    if self.picker_mode == "settings"
        self.cycle_setting(self.list.selected)
        return
    self.picking = false
    m := self.picker_mode
    self.picker_mode = ""
    if m == "new"
        self.new_project(self.field.text)
        return
    if m == "bind"
        self.add_binding(self.field.text)
        return
    if self.commanding
        found := self.commands()
        self.commanding = false
        if self.list.selected < found.len()
            row := found[self.list.selected]
            if row.spec == ""
                self.run_command(row.name)
            else
                self.on_event(key_event(row.spec))
        return
    found := self.matches()
    if self.list.selected < found.len()
        self.open(found[self.list.selected])
    elif self.field.text.trim() != ""
        self.new_file(self.field.text.trim())

## Ctrl-P, Enter on a path nothing matches: creates that file (empty) and
## opens it (S10).
fn Workspace.new_file(mut self, path str)
    if not fs.exists(path)
        fs.write_text(path, "") else err
            self.message = "can't create {err.path}: {err.kind}"
            return
    self.open(path)
    self.message = "created {path}"

## Palette-only commands: a `key_row("palette", NAME, "", DOES)` in
## `key_rows()` and one arm here, which a slice adds for its own command.
fn Workspace.run_command(mut self, name str)
    match name
        "Trace tree" => self.probe_key("tree")
        "Schedule sanitizer" => self.probe_key("sanitize")
        "Race detector" => self.probe_key("race")
        "Leak report" => self.probe_key("leak")
        "Rebind a key" => self.start_mode("bind", "rebind: ")
        "Welcome screen" => self.welcome = true
        "New file" => self.start_new_file()
        "Toggle minimap" => self.minimap = not self.minimap
        "Toggle zen mode" => self.zen = not self.zen
        "Font larger" => self.zoom("+")
        "Font smaller" => self.zoom("-")
        "Font reset" => self.zoom("0")
        "API diff" => self.diff_view("api")
        "Git change gutter" => self.diff_view("gutter")
        "Select all occurrences" => self.eds[self.active].run(Depth("all"))
        "Fold all" => self.eds[self.active].run(Depth("fold_all"))
        "Semantic layer" => self.eds[self.active].layer_key("l")
        "Fix with ail fix" => self.eds[self.active].layer_key("y")
        "Update preview" => self.test_tool("preview")
        "Apply test update" => self.test_tool("apply")
        "Record tests" => self.test_tool("record")
        "Trace replay" => self.test_tool("trace")
        "Agent changes" => self.agent_changes()
        "Toggle agent marks" =>
            self.watch.hidden = not self.watch.hidden
            self.message = "agent marks {on_off(not self.watch.hidden)}"
        "Count tokens" => self.token_report()
        "Toggle token meter" => self.askbar.toggle()
        "Stop the running job" => self.stop_job()
        "Run again" => self.run_again()
        "Show jobs" => self.show_jobs()
        "Select word" => self.eds[self.active].run(Depth("word"))
        "Select line" => self.eds[self.active].run(Depth("line"))
        _ => self.message = "no command `{name}`"

## The "New file" palette row: the file picker, with a hint.
fn Workspace.start_new_file(mut self)
    self.start_picking()
    self.message = "type a path; Enter on a path nothing matches creates the file"

# ---- Tabs ---------------------------------------------------------------

## Several files, one tab each, and the Ctrl-P file picker. The editor in
## each tab gets every row but the tab bar.
struct Workspace
    eds List[Editor]
    active int
    cols int
    rows int
    picking bool
    ## The open list is the command palette, not the file picker.
    commanding bool
    ## Ctrl-P and Ctrl-Shift-P: what is typed, and the choices it leaves
    ## (std.ui.widgets).
    field widgets.TextField
    list widgets.ListView
    files List[str]
    ## Ctrl-Shift-F: the query being typed, the hits, and whether Up/Down
    ## and Enter go to them.
    searching bool
    search str
    ## Replace in files (ADR 0339): 0 off, 1 typing what to find, 2 typing
    ## the replacement, 3 the preview is showing.
    repl_step int
    repl_with str
    ## Preview rows the person skipped (ADR 0354).
    repl_skip Set[int]
    hits List[Hit]
    hits_title str
    hit_sel int
    hit_top int
    browsing bool
    ## Ctrl-B: the file tree, whether it has the keys, and which directories
    ## are expanded.
    ## The directory the tree shows: the working directory.
    tree_root str
    tree_open bool
    tree_focus bool
    tree List[TreeRow]
    tree_sel int
    expanded Set[str]
    quit_armed bool
    quit bool
    message str
    ## The font size, as a cell height in pixels (std.ui.15).
    font int
    ## The theme's name and colors (ADR 0295); `remember` saves changes to
    ## `~/.ail-edit` (off in tests).
    theme str
    pal Palette
    remember bool
    ## The problems list refreshes while shown (ADR 0353): after a save,
    ## and 500 ms after the last edit (`typed_at`, in ms; 0 when none).
    live_problems bool
    ## Ctrl-Shift-U: run the tab's tests after each save (ADR 0354).
    test_on_save bool
    typed_at int
    ## The trace tree behind the list while it is shown (plan S7).
    probe_view probes.View
    ## S10: what the picker is for ("" files or commands, "settings", "new",
    ## "bind"), the settings file's text, the key rebindings read from it,
    ## git marks of changed files in the tree, and the welcome screen.
    picker_mode str
    prefs str
    binds List[workspace.Bind]
    gitmarks bool
    git Map[str, str]
    welcome bool
    ## Ctrl-\\: show the next tab beside this one (features/ split view).
    splitting bool
    ## Palette toggles of the window: the minimap and zen mode.
    minimap bool
    zen bool
    ## Agent co-editing (S9): file stamps, agent marks, a pending edit preview.
    watch agent.State
    ## The ask bar and the token meter (features/ask, plan S8).
    askbar ask.Bar
    ## Background jobs: F5, F6, Shift-F5 and tests on save (features/jobs, X1).
    jobs jb.Jobs
    ## The tree width and pane height the person dragged them to (parity P7).
    ptr pointer.Sizes

fn Workspace.new(ed Editor) Workspace
    Workspace(
        eds: [ed],
        active: 0,
        cols: ed.cols,
        rows: ed.rows + 1,
        picking: false,
        commanding: false,
        field: widgets.TextField.new("open: ", ""),
        list: widgets.ListView.new([]),
        files: [],
        searching: false,
        search: "",
        repl_step: 0,
        repl_with: "",
        repl_skip: Set[int](),
        hits: [],
        hits_title: "",
        hit_sel: 0,
        hit_top: 0,
        browsing: false,
        tree_root: ".",
        tree_open: false,
        tree_focus: false,
        tree: [],
        tree_sel: 0,
        expanded: Set[str](),
        quit_armed: false,
        quit: false,
        message: "",
        font: 20,
        theme: "dark",
        pal: palette(Map[str, int]()),
        remember: false,
        live_problems: false,
        test_on_save: false,
        typed_at: 0,
        probe_view: probes.View.new(),
        picker_mode: "",
        prefs: "",
        binds: [],
        gitmarks: false,
        git: Map[str, str](),
        welcome: false,
        splitting: false,
        minimap: false,
        zen: false,
        watch: agent.new_state(),
        askbar: ask.Bar.new(),
        jobs: jb.Jobs.new(),
        ptr: pointer.Sizes(treew: 0, paneh: 0),
    )

## The file name a tab shows: the path after its last `/`.
fn base_name(path str) str
    parts := path.split("/")
    parts[parts.len() - 1]

## `path` as a list row shows it: relative to `root` when it lies inside,
## unchanged when it is already relative, else its base name.
fn shown_path(root str, path str) str
    if rel := path.strip_prefix("{root}/")
        return rel
    if path.starts_with("/")
        return base_name(path)
    path

@test fn shown_paths_stay_short()
    assert_eq(shown_path("/w", "/w/src/a.ail"), "src/a.ail")
    assert_eq(shown_path("/w", "/var/folders/x/T/ail-edit-1/agent.ail"), "agent.ail")
    assert_eq(shown_path("/w", "src/a.ail"), "src/a.ail")

## Opens `path` in a new tab, or switches to it if it is open.
fn Workspace.open(mut self, path str)
    for i in 0..self.eds.len()
        if self.eds[i].path == path
            self.active = i
            return
    mut text := ""
    if fs.exists(path)
        got := fs.read_text(path) else err
            self.message = "can't open {err.path}: {err.kind}"
            return
        text = got
    mut ed := Editor.new(path, text, (self.cols - self.left()).max(10), (self.rows - 1).max(1))
    ed.index()
    ed.pane_h = self.ptr.paneh
    self.eds.push(ed)
    self.active = self.eds.len() - 1

## Closes the active tab, asking first if it has unsaved changes. The
## workspace quits when the last tab closes.
fn Workspace.close_tab(mut self)
    self.eds[self.active].apply(Quit)
    if not self.eds[self.active].quit
        return
    mut rest := List[Editor]()
    for i in 0..self.eds.len()
        if i != self.active
            rest.push(self.eds[i])
    self.eds = rest
    if self.eds.len() == 0
        self.quit = true
        return
    self.active = self.active.min(self.eds.len() - 1)

## Ctrl-Q (or its rebinding): it must not disarm its own second press.
fn is_quit_key(ev ui.Event) bool
    match ev
        Key(k, ctrl, alt, shift) =>
            wk := workspace_key(k.name(), ctrl, alt, shift) else return false
            wk == QuitAll
        Close | Resize(_, _) | Mouse(_, _, _, _) | Scroll(_) => false

## Ctrl-Q: quit, asking first if any tab has unsaved changes.
fn Workspace.quit_all(mut self)
    mut unsaved := 0
    for ed in self.eds
        if ed.dirty
            unsaved += 1
    if unsaved > 0 and not self.quit_armed
        self.quit_armed = true
        self.message = "{unsaved} unsaved tab(s): Ctrl-Q again quits without saving"
        return
    self.quit = true

fn Workspace.on_event(mut self, ev ui.Event)
    if self.binds.len() > 0
        if spec := event_spec(ev)
            if orig := workspace.translate(self.binds, spec)
                self.dispatch(key_event(orig))
                return
    self.dispatch(ev)

## The spec (`ctrl+shift+t` form) of a key event; none for other events.
fn event_spec(ev ui.Event) str?
    match ev
        Key(k, ctrl, alt, shift) => workspace.spec_of(k.name(), ctrl, alt, shift)
        Resize(_, _) | Close | Mouse(_, _, _, _) | Scroll(_) => none

fn Workspace.dispatch(mut self, ev ui.Event)
    if self.welcome
        if self.welcome_event(ev)
            return
    if self.picking
        self.pick_event(ev)
        return
    if self.searching
        self.search_event(ev)
        return
    if self.askbar.open
        self.askbar_event(ev)
        return
    if self.browsing and self.repl_step == 3
        if ev == Key(key: Enter, ctrl: true, alt: false, shift: false)
            self.apply_replace()
            return
        if k := pressed(ev)
            if k == " " or k == "a" or k == "A"
                self.mark_rows(k != " ")
                return
    if self.browsing
        if k := pressed(ev)
            if self.hits_key(k)
                return
    self.repl_step = 0
    if self.tree_focus
        if k := pressed(ev)
            if self.tree_key(k)
                return
    # A message stays up through a resize, which a font change causes.
    resize := match ev
        Resize(_, _) => true
        Key(_, _, _, _) | Close | Mouse(_, _, _, _) | Scroll(_) => false
    if ev != Close and not resize and not is_quit_key(ev)
        self.quit_armed = false
        self.message = ""
    match ev
        Key(k, ctrl, alt, shift) =>
            if self.job_key(k.name(), ctrl, alt, shift)
                return
            if wk := workspace_key(k.name(), ctrl, alt, shift)
                n := self.eds.len()
                match wk
                    NextTab => self.active = (self.active + 1) % n
                    PreviousTab => self.active = (self.active + n - 1) % n
                    CloseTab => self.close_tab()
                    QuitAll => self.quit_all()
                    OpenFile => self.start_picking()
                    Palette => self.start_palette()
                    Zoom(z) => self.zoom(z)
                    Split => self.split_view()
                    Sem(z) => self.eds[self.active].layer_key(z)
                    Search => self.start_search()
                    NextHit => self.next_hit()
                    Tree => self.toggle_tree()
                    Theme => self.next_theme()
                    Settings => self.start_mode("settings", "settings: ")
                    NewProject => self.start_mode("new", "new project: ")
                    Trace => self.trace_run()
                    Probes(spec) => self.probe_key(spec)
                    FailurePaths => self.failure_paths()
                    Coverage => self.eds[self.active].coverage()
                    TestTool(m) => self.test_tool(m)
                    Card => self.card_view()
                    Diff(w) => self.diff_view(w)
                    Problems => self.problems()
                    References => self.show_references()
                    ReplaceInFiles => self.start_replace()
                    TaskPanel => self.task_panel()
                    AffectedTests => self.eds[self.active].affected_tests()
                    TaskVerify => self.task_action("verify")
                    AgentPack => self.agent_pack()
                    AgentApply => self.agent_apply()
                    AskBar => self.askbar.start(0)
                    Symbols => self.askbar.start(1)
                    Hierarchy => self.show_hierarchy()
                    TestOnSave =>
                        self.test_on_save = not self.test_on_save
                        if self.test_on_save
                            self.quiet_tests()
                        else
                            self.eds[self.active].tests = ""
                return
            saves := self.eds[self.active].saves
            self.eds[self.active].on_event(ev)
            if self.eds[self.active].saves != saves
                self.watch.saved(self.eds[self.active].path)
                self.refresh_git()
                self.check_other_tabs()
                self.eds[self.active].impact_refresh()
                if self.hits_title.starts_with("program card")
                    self.card_view()
                if self.live_problems
                    self.refresh_problems()
                if self.test_on_save
                    self.quiet_tests()
            elif self.live_problems and self.eds[self.active].dirty
                self.typed_at = time.now_ms()
        Resize(_, _) => self.on_resize(ev)
        Close => self.quit_all()
        Mouse(c, r, button, kind) =>
            if r == 0
                if kind == Down
                    self.click_tab(c)
                return
            if c < self.left()
                if kind == Down and button == Left
                    self.click_tree(r)
                return
            self.tree_focus = false
            if self.splitting and c >= self.left() + self.split_half()
                return
            if kind == Down and button == Left
                ed := self.eds[self.active]
                if loc := ed.pane_location(r - 1 - ed.text_rows() - 1)
                    if loc.path != ed.path
                        self.open(loc.path)
                        self.eds[self.active].jump_to(loc)
                        return
            self.eds[self.active].on_event(Mouse(
                col: c - self.left(),
                row: r - 1,
                button: button,
                kind: kind,
            ))
        Scroll(_) => self.eds[self.active].on_event(ev)
    if self.eds[self.active].quit
        self.close_tab()
        return
    self.askbar_refresh()

## Ctrl-\\: shows the next tab beside this one, or closes the split.
fn Workspace.split_view(mut self)
    if self.eds.len() < 2
        self.message = "open a second file (Ctrl-P) to split the view"
        return
    self.splitting = not self.splitting
    self.message = "split view {on_off(self.splitting)}: the next tab is on the right"

## The columns the left pane gets when the view is split.
fn Workspace.split_half(self) int
    ((self.cols - self.left()) / 2).max(10)

## After a save, checks every other open tab too, since a change can break
## a file that uses it; each tab's label shows its counts (ADR 0293).
fn Workspace.check_other_tabs(mut self)
    for i in 0..self.eds.len()
        if i != self.active
            self.eds[i].run(Check)

## Ctrl-+ (or Ctrl-=) and Ctrl-- step the font size; Ctrl-0 resets it.
fn Workspace.zoom(mut self, k str)
    if k == "0"
        self.font = 20
        return
    mut at := FONT_SIZES.len() - 1
    for i in 0..FONT_SIZES.len()
        if FONT_SIZES[i] >= self.font
            at = i
            break
    if k == "-"
        at = (at - 1).max(0)
    elif FONT_SIZES[at] == self.font
        at = (at + 1).min(FONT_SIZES.len() - 1)
    self.font = FONT_SIZES[at]
    self.message = "font size {self.font}"

## The columns each tab's label covers on the tab bar.
fn Workspace.tab_labels(self) List[str]
    mut out := List[str]()
    for ed in self.eds
        mut flag := ""
        if ed.dirty
            flag = " *"
        e := ed.diag_count("error")
        w := ed.diag_count("warning")
        if e > 0
            flag = "{flag} E{e}"
        if w > 0
            flag = "{flag} W{w}"
        out.push(" {base_name(ed.path)}{flag} ")
    out

## Moves tab `from` to place `to`, keeping the same tab active.
fn Workspace.move_tab(mut self, from int, to int)
    n := self.eds.len()
    if from < 0 or from >= n or to < 0 or to >= n
        return
    order := win.order_after_move(n, from, to)
    mut moved := List[Editor]()
    for i in order
        moved.push(self.eds[i])
    self.active = order.index_of(self.active) else 0
    self.eds = moved

fn Workspace.click_tab(mut self, c int)
    mut x := 0
    labels := self.tab_labels()
    for i in 0..labels.len()
        w := labels[i].chars().len()
        if c >= x and c < x + w
            self.active = i
            return
        x += w + 1

# ---- Rename (F2) ----------------------------------------------------------

## What F2 renames: every place of `name`, found through `ail api --refs` when
## `semantic`, else every whole-word occurrence in the buffer.
struct RenamePlan
    name str
    at List[Range]
    semantic bool

## The range of `name` at a 1-based line and column from `ail api`.
fn place(l int, c int, name str) Range
    Range(line: l - 1, col: c - 1, end_line: l - 1, end_col: c - 1 + name.chars().len())

fn Editor.holds_at(self, r Range, name str) bool
    if r.line < 0 or r.line >= self.lines.len()
        return false
    cs := self.lines[r.line].chars()
    r.col >= 0 and r.end_col <= cs.len() and cs[r.col..r.end_col].join("") == name

## Every whole-word occurrence of `name`.
fn Editor.word_places(self, name str) List[Range]
    n := name.chars().len()
    mut out := List[Range]()
    for l in 0..self.lines.len()
        cs := self.lines[l].chars()
        mut c := 0
        while c + n <= cs.len()
            if cs[c..c + n].join("") == name
                and (c == 0 or not is_word(cs[c - 1]))
                and (c + n == cs.len() or not is_word(cs[c + n]))
                out.push(Range(line: l, col: c, end_line: l, end_col: c + n))
                c += n
            else
                c += 1
    out

## Whether `name` can be a new name: a word that isn't a keyword.
fn valid_name(name str) bool
    cs := name.chars()
    if cs.len() == 0 or cs[0].is_digit() or KEYWORDS.contains(name)
        return false
    for c in cs
        if not is_word(c)
            return false
    true

## Replaces each place with `new`, as one undo step; the cursor stays on
## its word.
fn Editor.rename_all(mut self, at List[Range], new str)
    self.snapshot()
    for l in 0..self.lines.len()
        mut starts := List[int]()
        mut n := 0
        for a in at
            if a.line == l
                starts.push(a.col)
                n = a.end_col - a.col
        if starts.len() == 0
            continue
        cs := self.lines[l].chars()
        mut out := ""
        mut from := 0
        mut shift := 0
        for c in starts.sorted()
            out = "{out}{cs[from..c].join("")}{new}"
            from = c + n
            if l == self.line and c + n <= self.col
                shift += new.chars().len() - n
        self.lines[l] = "{out}{cs[from..].join("")}"
        if l == self.line
            self.set_col((self.col + shift).min(self.lines[l].chars().len()))

## Passes a resize to every tab while a prompt stays open.
fn Workspace.on_resize(mut self, ev ui.Event)
    match ev
        Resize(c, r) =>
            self.cols = c
            self.rows = r
            self.resize_tabs()
        Key(_, _, _, _) | Close | Mouse(_, _, _, _) | Scroll(_) => return

# ---- The file tree (Ctrl-B) -----------------------------------------------

## A row of the file tree: a file or directory under the working directory.
struct TreeRow
    path str
    name str
    depth int
    dir bool

## The tree's width in columns, the separator included; 0 when closed.
fn Workspace.left(self) int
    if not self.tree_open or self.eds[self.active].zen
        return 0
    self.tree_w() + 1

## The entries of `dir` as rows: `.ail` files first, then directories, then
## other files, each group by name; hidden and build directories skipped.
## Expanded directories list their entries below them.
fn Workspace.tree_rows(self, dir str, depth int) List[TreeRow]
    names := fs.list_dir(dir) else return List[TreeRow]()
    mut ail := List[TreeRow]()
    mut dirs := List[TreeRow]()
    mut rest := List[TreeRow]()
    for n in names.sorted()
        if n.starts_with(".") or n == "target"
            continue
        mut path := n
        if dir != "."
            path = "{dir}/{n}"
        if sub := fs.list_dir(path)
            if sub.len() >= 0
                dirs.push(TreeRow(path: path, name: "{n}/", depth: depth, dir: true))
        elif n.ends_with(".ail")
            ail.push(TreeRow(path: path, name: n, depth: depth, dir: false))
        else
            rest.push(TreeRow(path: path, name: n, depth: depth, dir: false))
    mut out := ail
    for d in dirs
        out.push(d)
        if self.expanded.contains(d.path)
            out.extend(self.tree_rows(d.path, depth + 1))
    out.extend(rest)
    out

## Ctrl-B: opens the tree and focuses it; focused, closes it; open but not
## focused, focuses it.
fn Workspace.toggle_tree(mut self)
    if self.tree_open and self.tree_focus
        self.tree_open = false
        self.tree_focus = false
    else
        if not self.tree_open
            self.refresh_git()
            self.tree = self.tree_rows(self.tree_root, 0)
            self.tree_sel = 0
        self.tree_open = true
        self.tree_focus = true
    self.resize_tabs()

## Gives every tab the columns the tree leaves.
fn Workspace.resize_tabs(mut self)
    c := (self.cols - self.left()).max(10)
    r := (self.rows - 1).max(1)
    for mut ed in self.eds
        ed.apply(Command.Resize(cols: c, rows: r))

## Enter or a click on a row: a directory expands or collapses, a file
## opens in a tab and takes the focus.
fn Workspace.activate_tree_row(mut self)
    if self.tree_sel >= self.tree.len()
        return
    t := self.tree[self.tree_sel]
    if t.dir
        if self.expanded.contains(t.path)
            self.expanded.remove(t.path)
        else
            self.expanded.add(t.path)
        self.tree = self.tree_rows(self.tree_root, 0)
        return
    self.open(t.path)
    self.tree_focus = false

## Keys while the tree has the focus: Up/Down select, Enter or Right opens,
## Left collapses (or goes to the parent), Escape gives the focus back.
## Other keys go to the editor. True if `k` was used here.
fn Workspace.tree_key(mut self, k str) bool
    if k == "up"
        self.tree_sel = (self.tree_sel - 1).max(0)
    elif k == "down"
        self.tree_sel = (self.tree_sel + 1).min((self.tree.len() - 1).max(0))
    elif k == "enter" or k == "right"
        self.activate_tree_row()
    elif k == "left"
        if self.tree_sel < self.tree.len()
            t := self.tree[self.tree_sel]
            if t.dir and self.expanded.contains(t.path)
                self.activate_tree_row()
            else
                mut i := self.tree_sel
                while i > 0 and self.tree[i].depth >= t.depth
                    i -= 1
                if self.tree[i].depth < t.depth
                    self.tree_sel = i
    elif k == "escape"
        self.tree_focus = false
    else
        self.tree_focus = false
        return false
    true

## Draws the tree down the left side, the selection kept in view.
fn Workspace.render_tree(self, mut s Screen)
    tw := self.tree_w()
    n := self.rows - 1
    top := (self.tree_sel - n + 1).max(0)
    for r in 1..self.rows
        s.put(r, 0, " ".repeat(tw), FG, PANE_BG)
        s.put(r, tw, " ", FG, BG)
        i := top + r - 1
        mut text := ""
        if i < self.tree.len()
            t := self.tree[i]
            mut bg := PANE_BG
            if i == self.tree_sel
                bg = LINE_BG
                if self.tree_focus
                    bg = SELECT_BG
            mut fg := FG
            if t.dir
                fg = KEYWORD_FG
            elif not t.name.ends_with(".ail")
                fg = GUTTER_FG
            indent := "  ".repeat(t.depth)
            cs := "{indent}{t.name}".chars()
            text = cs[..cs.len().min(tw - 1)].join("")
            if self.gitmarks
                m := workspace.mark(self.git, t.path, t.dir)
                if m != ""
                    fg = WARN_FG
                    text = "{text.slice(0, text.len().min(tw - 4)).pad_right(tw - 4, ' ')} {m}"
            s.put(r, 0, " {text}".pad_right(tw, ' '), fg, bg)
        shown := " {text}".pad_right(tw + 1, ' ')
        s.text[r] = "{shown}{s.text[r]}"
    if self.tree_focus
        s.cursor_row = 1 + self.tree_sel - top
        s.cursor_col = 1

## A click in the tree selects that row and activates it.
fn Workspace.click_tree(mut self, r int)
    top := (self.tree_sel - (self.rows - 1) + 1).max(0)
    i := top + r - 1
    if i >= 0 and i < self.tree.len()
        self.tree_sel = i
        self.tree_focus = true
        self.activate_tree_row()

# ---- Project search (Ctrl-Shift-F) ----------------------------------------

## A match of a project search: where, and its line's text.
struct Hit
    loc Loc
    text str

## Every line of `text` containing `query`, as hits in `path` (1-based).
fn search_text(path str, text str, query str) List[Hit]
    mut out := List[Hit]()
    if query == ""
        return out
    ls := text.lines()
    for l in 0..ls.len()
        if c := ls[l].find(query)
            out.push(Hit(
                loc: Loc(path: path, line: l + 1, col: c + 1),
                text: "{path}:{l + 1}:{c + 1}: {ls[l].trim()}",
            ))
    out

## Searches every `.ail` file under the directory, open tabs as they are in
## the editor (unsaved changes included), at most `limit` hits.
fn Workspace.search_project(self, q str, limit int) List[Hit]
    mut out := List[Hit]()
    for f in list_files(".", 8, 5000)
        if not f.ends_with(".ail")
            or f.ends_with(".edit-check.ail")
            or f.ends_with(".edit-query.ail")
            continue
        mut text := ""
        mut open := false
        for ed in self.eds
            if ed.path == f or ed.path == "./{f}"
                text = ed.text()
                open = true
        if not open
            got := fs.read_text(f) else continue
            text = got
        for h in search_text(f, text, q)
            if out.len() >= limit
                return out
            out.push(h)
    out

fn Workspace.start_search(mut self)
    self.searching = true
    self.search = ""
    ed := self.eds[self.active]
    if w := ed.word_at()
        self.search = ed.lines[ed.line].slice(w.col, w.end_col)

## Typing the query: Enter searches, Escape cancels.
fn Workspace.search_event(mut self, ev ui.Event)
    match ev
        Key(code, ctrl, _, _) =>
            if ctrl
                return
            k := code.name()
            if k == "escape"
                self.searching = false
                self.repl_step = 0
            elif k == "enter" and self.repl_step == 1
                if self.search == ""
                    self.searching = false
                    self.repl_step = 0
                else
                    self.repl_step = 2
                    self.repl_with = ""
            elif k == "enter" and self.repl_step == 2
                self.searching = false
                self.preview_replace()
            elif k == "enter"
                self.searching = false
                self.show_hits(self.search_project(self.search, 1000))
            elif k == "backspace" and self.repl_step == 2
                self.repl_with = drop_last(self.repl_with)
            elif k == "backspace"
                self.search = drop_last(self.search)
            elif k.chars().len() == 1 and self.repl_step == 2
                self.repl_with = "{self.repl_with}{k}"
            elif k.chars().len() == 1
                self.search = "{self.search}{k}"
        Close => self.quit_all()
        Resize(_, _) => self.on_resize(ev)
        Mouse(_, _, _, _) | Scroll(_) => return

## Puts the hits in the active tab's pane and focuses them: Up/Down
## select, Enter (or F4, the next one) jumps, Escape closes.
fn Workspace.show_hits(mut self, found List[Hit])
    mut more := ""
    if found.len() >= 1000
        more = " (first 1000)"
    if found.len() == 0
        self.message = "no match for `{self.search}`"
        return
    self.show_list("search `{self.search}`: {found.len()} matches{more}", found)

## Puts rows in the active tab's pane under `title` and focuses them:
## Up/Down select, Enter (or F4, the next) jumps to a row's position,
## Escape closes. Search, trace and failure paths all use it.
fn Workspace.show_list(mut self, title str, found List[Hit])
    self.hits = found
    self.hits_title = title
    self.hit_sel = 0
    self.hit_top = 0
    self.browsing = true
    self.live_problems = false
    self.fill_hits()

## Writes the visible part of the hits into the active tab's pane, keeping
## the selection in view.
fn Workspace.fill_hits(mut self)
    mut ed := self.eds[self.active]
    ed.pane = Text
    room := (ed.pane_rows() - 1).max(1)
    self.hit_top = self.hit_top.min(self.hit_sel).max(self.hit_sel - room + 1).max(0)
    ed.pane_text = ["{self.hits_title}; Up/Down, Enter jumps, F4 next, Esc closes"]
    for i in self.hit_top..(self.hit_top + room).min(self.hits.len())
        ed.pane_text.push(self.hits[i].text)
    self.eds[self.active] = ed

## Opens the selected hit's file in a tab, moves there, and shows the hits
## in that tab's pane.
fn Workspace.jump_to_hit(mut self)
    if self.hit_sel >= self.hits.len()
        return
    loc := self.hits[self.hit_sel].loc
    if loc.line == 0
        return
    self.open(loc.path)
    self.eds[self.active].jump_to(loc)
    self.fill_hits()

## Keys while the hits are focused; others go to the editor.
fn Workspace.hits_key(mut self, k str) bool
    if self.probe_fold(k)
        return true
    if self.hits.len() == 0
        self.browsing = false
        return false
    if self.hits_title.starts_with("task") and tp.action_for(k) != ""
        self.task_action(tp.action_for(k))
        return true
    if self.hits_title.starts_with("jobs: ") and k == "enter"
        self.browsing = false
        self.open_job(self.hit_sel)
        return true
    if k == "up"
        self.hit_sel = (self.hit_sel - 1).max(0)
    elif k == "down"
        self.hit_sel = (self.hit_sel + 1).min(self.hits.len() - 1)
    elif k == "enter"
        self.jump_to_hit()
        self.browsing = false
        return true
    elif k == "escape"
        self.browsing = false
        return false
    else
        self.browsing = false
        return false
    self.fill_hits()
    true

## F4: the next hit, from anywhere, wrapping to the first.
fn Workspace.next_hit(mut self)
    if self.hits.len() == 0
        self.message = "no search results: Ctrl-Shift-F searches the project"
        return
    if not self.browsing
        self.hit_sel = (self.hit_sel + 1) % self.hits.len()
    self.jump_to_hit()
    self.browsing = false

## The search prompt on the tab bar, or the selected hit's pane row.
fn Workspace.render_search(self, mut s Screen)
    if self.searching
        mut head := " search the project: "
        mut entry := self.search
        if self.repl_step == 1
            head = " replace in files, find: "
        elif self.repl_step == 2
            head = " replace `{self.search}` with: "
            entry = self.repl_with
        s.put(0, 0, "{head}{entry} ".pad_right(self.cols, ' '), STATUS_FG, SELECT_BG)
        s.text[0] = "{head}{entry}"
        s.cursor_row = 0
        s.cursor_col = head.chars().len() + entry.chars().len()
    elif self.browsing
        ed := self.eds[self.active]
        r := 1 + ed.text_rows() + 2 + self.hit_sel - self.hit_top
        if r < self.rows and ed.pane == Text
            x := self.left()
            s.put(r, x, " ".repeat(self.cols - x), FG, SELECT_BG)
            s.put(r, x + 1, ed.pane_text[1 + self.hit_sel - self.hit_top], FG, SELECT_BG)

# ---- Probes and diagnosis (plan S7; the rows come from features/probes) ----

fn hits_of(path str, rows List[probes.Row]) List[Hit]
    mut out := List[Hit]()
    for r in rows
        out.push(Hit(loc: Loc(path: path, line: r.line, col: r.col), text: r.text))
    out

## Left/Right fold or open the trace tree's selected call and `f` cycles its
## filter, while the tree is the list shown.
fn Workspace.probe_fold(mut self, k str) bool
    if not self.probe_view.on or not self.hits_title.starts_with("trace tree")
        return false
    if k == "left" or k == "right"
        self.probe_view.fold(self.hit_sel, k == "right")
    elif k == "f"
        self.probe_view.next_filter()
    else
        return false
    self.hits = hits_of(self.eds[self.active].path, self.probe_view.rows())
    self.hits_title = self.probe_view.title()
    self.hit_sel = self.hit_sel.min(self.hits.len() - 1).max(0)
    self.fill_hits()
    true

## The key of a probe command (`probes.key_spec`): runs the `ail` command it
## names on the buffer and shows its rows in the list; probes, watches and
## trap values also leave a note after the line.
fn Workspace.probe_key(mut self, spec str)
    path := self.eds[self.active].path
    at := self.eds[self.active].line
    # The file `ail_on_buffer` runs, so `--at` names it.
    file := if self.eds[self.active].dirty then "{path}.edit-check.ail" else path
    self.probe_view.on = false
    if spec == "next"
        self.next_hit()
    elif spec == "probe"
        names := probes.names_of(
            self.eds[self.active].lines[at],
            self.eds[self.active].selected_text(),
        )
        if names.len() == 0
            self.message = "probe: select the variable names to show (a, b), or put the cursor on a line that uses some"
            return
        r := self.eds[self.active].ail_on_buffer(probes.probe_args(file, at + 1, names)) else return
        found := probes.probe_hits(r.err)
        self.eds[self.active].notes = Map[int, str]()
        if found.len() == 0
            self.message = "probe: line {at + 1} never ran (exit {r.status})"
            return
        self.eds[self.active].notes[at] = probes.probe_note(found)
        self.show_list(
            "probe {names.join(", ")} at line {at + 1}: {found.len()} hits",
            hits_of(path, probes.probe_rows(found)),
        )
    elif spec == "watch"
        mut name := self.eds[self.active].selected_text().trim()
        if name == ""
            name = self.eds[self.active].word_here()
        if name == ""
            self.message = "watch: put the cursor on a variable"
            return
        r := self.eds[self.active].ail_on_buffer(probes.watch_args(name)) else return
        writes := probes.watch_writes(r.err)
        self.eds[self.active].notes = probes.watch_notes(writes)
        if writes.len() == 0
            self.message = "watch: `{name}` was never written (exit {r.status})"
            return
        self.show_list(
            "watch {name}: {writes.len()} writes",
            hits_of(path, probes.watch_rows(writes)),
        )
    elif spec == "values"
        r := self.eds[self.active].ail_on_buffer(probes.values_args()) else return
        t := probes.trap_of(r.err)
        if t.rule == ""
            self.message = "trap values: the run did not trap (exit {r.status})"
            return
        self.eds[self.active].notes = probes.trap_notes(t)
        self.show_list("trap values", hits_of(path, probes.trap_rows(t)))
    elif spec == "tree"
        r := self.eds[self.active].ail_on_buffer(probes.trace_args()) else return
        self.probe_view = probes.tree_of(r.err, r.out)
        self.probe_view.on = true
        self.show_list(self.probe_view.title(), hits_of(path, self.probe_view.rows()))
    elif spec == "sanitize" or spec == "race"
        race := spec == "race"
        r := self.eds[self.active].ail_on_buffer(probes.sanitize_args(race)) else return
        mut found_rows := probes.sanitize_rows(r.out)
        if race
            found_rows = probes.race_rows(r.err)
        if found_rows.len() == 0
            self.message = "sanitize: nothing to report (exit {r.status})"
            return
        self.show_list(
            if race then "race report" else "schedule sanitizer",
            hits_of(path, found_rows),
        )
    else
        r := self.eds[self.active].ail_on_buffer(probes.leak_args()) else return
        found_rows := probes.leak_rows(r.err)
        if found_rows.len() == 0
            self.message = "leak: no report (exit {r.status})"
            return
        self.show_list("leak report", hits_of(path, found_rows))

# ---- The agent panel: trace, failure paths, coverage ----------------------

## A JSON value as short text: strings as they are, others as JSON.
fn jtext(j Json) str
    if s := j.as_str()
        return s
    j.to_text()

## `name: value, ...` from a JSON object such as a frame's `locals`.
fn json_pairs(j Json) str
    mut out := List[str]()
    for m in j.as_obj() else List[JsonMember]()
        out.push("{m.key} = {jtext(m.value)}")
    out.join(", ")

## A native trap is text on standard error (trace.run.1): `FILE:L:C: trap[RULE]: MESSAGE`, then
## one `  at L:C in NAME(ARGS); LOCALS` line per frame, the values shown by `--values` (ADR 0886).
fn trap_text_hits(path str, l str) List[Hit]
    mut hits := List[Hit]()
    if l.contains(": trap[")
        parts := l.split(": trap[")
        place := parts[0].split(":")
        if place.len() < 3
            return hits
        at := Loc(
            path: path,
            line: place[place.len() - 2].to_int() else 0,
            col: place[place.len() - 1].to_int() else 0,
        )
        rest := parts[1].split("]: ")
        message := if rest.len() > 1 then rest[1] else ""
        hits.push(Hit(loc: at, text: "trap[{rest[0]}] {message}  {at.line}:{at.col}"))
    elif l.starts_with("  at ") and l.contains(" in ")
        body := l.slice(5, l.len())
        head := body.split(" in ")[0].split(":")
        if head.len() != 2
            return hits
        floc := Loc(path: path, line: head[0].to_int() else 0, col: head[1].to_int() else 0)
        frame := body.slice(body.split(" in ")[0].len() + 4, body.len())
        mut locals := ""
        mut call := frame
        if i := frame.find("); ")
            call = frame.slice(0, i + 1)
            locals = frame.slice(i + 3, frame.len())
        open := call.find("(") else call.len()
        name := call.slice(0, open)
        mut args := ""
        if open < call.len() - 1
            args = call.slice(open + 1, call.len() - 1)
        if args == ".."
            args = ""
        mut row := "  in {name} {floc.line}:{floc.col}"
        if args != ""
            row = "{row}  args: {args}"
        if locals != ""
            row = "{row}  locals: {locals}"
        hits.push(Hit(loc: floc, text: row))
    hits

## The rows of `ail run --trace=all --json` (standard error): calls indented
## by depth, returns, contracts, and a trap with every frame's locals; then
## the program's output. Rows with a position jump there (ADR 0312).
fn trace_hits(path str, err str, out str) List[Hit]
    mut hits := List[Hit]()
    for l in err.lines()
        j := parse_json(l) else
            hits.extend(trap_text_hits(path, l))
            continue
        at := Loc(path: path, line: jint(j, "line"), col: jint(j, "col"))
        pad := "  ".repeat((jint(j, "depth") - 1).max(0))
        kind := jstr(j, "trace")
        if kind == "call"
            hits.push(Hit(
                loc: at,
                text: "{pad}call {jstr(j, "fn")}({json_pairs(j.get("args") else Json.Null)})  {at.line}:{at.col}",
            ))
        elif kind == "return"
            hits.push(Hit(
                loc: at,
                text: "{pad}return {jstr(j, "fn")} = {jtext(j.get("value") else Json.Null)}",
            ))
        elif kind == "contract"
            mut held := "held"
            if (j.get("held") else Json.Null) != Json.Bool(true)
                held = "FAILED"
            hits.push(Hit(
                loc: at,
                text: "{pad}{jstr(j, "kind")} {jstr(j, "cond")} {held}  {at.line}:{at.col}",
            ))
        elif kind == "summary"
            hits.push(Hit(
                loc: Loc(path: path, line: 0, col: 0),
                text: "{jint(j, "shown")} events, {jint(j, "dropped")} dropped",
            ))
        elif kind != ""
            hits.push(Hit(loc: at, text: "{pad}{kind} {jstr(j, "fn")}  {at.line}:{at.col}"))
        elif jstr(j, "severity") == "trap"
            hits.push(Hit(
                loc: at,
                text: "trap[{jstr(j, "rule")}] {jstr(j, "message")}  {at.line}:{at.col}",
            ))
            for f in jarr(j, "stack")
                floc := Loc(path: path, line: jint(f, "line"), col: jint(f, "col"))
                mut row := "  in {jstr(f, "fn")} {floc.line}:{floc.col}"
                args := json_pairs(f.get("args") else Json.Null)
                if args != ""
                    row = "{row}  args: {args}"
                locals := json_pairs(f.get("locals") else Json.Null)
                if locals != ""
                    row = "{row}  locals: {locals}"
                hits.push(Hit(loc: floc, text: row))
    for l in out.lines()
        hits.push(Hit(loc: Loc(path: path, line: 0, col: 0), text: "> {l}"))
    hits

## The rows of `ail check --errors` (err.api.1): each function with the
## errors it can fail with, then each failure path (return, propagate,
## handle) at its position (ADR 0312).
fn failure_hits(path str, out str) List[Hit]
    mut hits := List[Hit]()
    j := parse_json(out.trim()) else return hits
    for f in jarr(j, "functions")
        mut fails := List[str]()
        for e in jarr(f, "fails_with")
            fails.push(jtext(e))
        mut head := "fn {jstr(f, "name")}"
        if fails.len() > 0
            head = "{head} fails with {fails.join(" | ")}"
        else
            head = "{head} fails with nothing"
        hits.push(Hit(loc: Loc(path: path, line: jint(f, "line"), col: 1), text: head))
        for p in jarr(f, "paths")
            mut errs := List[str]()
            for e in jarr(p, "errors")
                errs.push(jtext(e))
            mut what := jstr(p, "kind")
            if jstr(p, "how") != ""
                what = "{what} ({jstr(p, "how")})"
            if jstr(p, "call") != ""
                what = "{what} {jstr(p, "call")}()"
            hits.push(Hit(
                loc: Loc(path: path, line: jint(p, "line"), col: jint(p, "col")),
                text: "  {jint(p, "line")}:{jint(p, "col")} {what}: {errs.join(" | ")}",
            ))
    hits

## Shift-F5: runs the buffer with every trace event; the events fill the
## pane and take Up/Down and Enter.
fn Workspace.trace_run(mut self)
    self.foreground("trace")

## Ctrl-Shift-E: the file's failure paths from `ail check --errors`.
fn Workspace.failure_paths(mut self)
    r := self.eds[self.active].ail_on_buffer(["check", "--errors"]) else return
    if r.status != 0
        self.message = "failure paths need a program without errors: Ctrl-K shows them"
        return
    self.show_list("failure paths", failure_hits(self.eds[self.active].path, r.out))

# ---- Test tools (S6) --------------------------------------------------------

## Ctrl-Shift-J and its neighbours (features/tests): runs the tool `mode`
## names and lists its rows like search hits. Replay, trace and shrink act
## on the selected FAIL row of the test tree.
fn Workspace.test_tool(mut self, mode str)
    mut sel := ""
    if self.hit_sel < self.hits.len()
        sel = self.hits[self.hit_sel].text
    if mode == "one"
        name := ttree.test_at(self.eds[self.active].lines, self.eds[self.active].line) else
            self.message = "the caret is not in a test"
            return
        sel = name
    p := ttree.plan(mode, sel, self.eds[self.active].dirty)
    if p.problem != ""
        self.message = p.problem
        return
    mut st := 0
    mut so := ""
    mut se := ""
    if p.on_file
        r := self.eds[self.active].ail_on_buffer(p.args) else return
        st = r.status
        so = r.out
        se = r.err
    else
        r := proc.run(ail_command(), p.args, none, jb.timeout_for(p.args)) else e
            self.message = jb.failure(e, jb.timeout_for(p.args))
            return
        st = r.status
        so = r.out
        se = r.err
    path := self.eds[self.active].path
    mut found := List[Hit]()
    for row in ttree.result_rows(mode, path, sel, so, se)
        found.push(Hit(loc: Loc(path: row.path, line: row.line, col: row.col), text: row.text))
    if mode == "apply" and st == 0
        got := fs.read_text(path) else e2
            self.message = "updated {path}, but can't reload it"
            return
        mut ed := Editor.new(path, got, (self.cols - self.left()).max(10), (self.rows - 1).max(1))
        ed.index()
        self.eds[self.active] = ed
    if found.len() == 0
        self.message = "{p.title}: no output (exit {st})"
        return
    self.show_list("{p.title}: exit {st}", found)

@test fn test_tool_keys_map_to_modes()
    assert_eq(workspace_key("j", true, false, true), TestTool("tree"))
    assert_eq(workspace_key("z", true, false, true), TestTool("shrink"))
    assert_eq(workspace_key("f6", false, false, true), TestTool("one"))
    assert_eq(workspace_key("j", true, false, false), none)

@test fn test_tools_refuse_without_a_failed_row()
    mut ws := Workspace.new(typed("fn main()\n    print(1)\n", []))
    ws.test_tool("replay")
    assert(ws.message.starts_with("select a FAIL row"))
    ws.eds[0].dirty = true
    ws.test_tool("apply")
    assert(ws.message.starts_with("save first"))

## The lines `ail test --coverage=lines --json` reports as never run,
## 0-based, and its summary line.
fn parse_coverage(out str) Set[int]
    mut missed := Set[int]()
    for l in out.lines()
        j := parse_json(l) else continue
        if (j.get("coverage") else Json.Null) != Json.Bool(true)
            continue
        for r in jarr(j, "missed")
            span := r.as_arr() else continue
            if span.len() == 2
                a := ((span[0].as_num() else 0.0).to_int())
                b := ((span[1].as_num() else 0.0).to_int())
                for n in a..b + 1
                    missed.add(n - 1)
    missed

## Ctrl-Shift-C: runs the tests with line coverage and marks the lines
## they never ran in the gutter until the next edit (ADR 0313).
fn Editor.coverage(mut self)
    r := self.ail_on_buffer(["test", "--coverage=lines", "--json"]) else return
    self.missed = parse_coverage(r.out)
    for l in r.out.lines()
        j := parse_json(l) else continue
        if (j.get("coverage") else Json.Null) == Json.Bool(true)
            self.message = "coverage: lines {jint(j, "lines_hit")}/{jint(j, "lines")}, functions {jint(j, "functions_hit")}/{jint(j, "functions")}; unrun lines are marked; an edit clears them"
            return
    self.message = "no coverage: does the file have @test functions? (exit {r.status})"

# ---- The task panel and impact gutter (S4, features/taskpanel) ---------------

## The open task, from `.ail-task` in the working directory (task.state.1).
fn task_job() tp.Job
    text := fs.read_text(".ail-task") else return tp.parse_job("")
    tp.parse_job(text)

## `ail ask FILE --affected --json` against `rev` (api.impact.3-4).
fn impact_of(file str, rev str) tp.Impact
    r := proc.run(ail_command(), [
        "ask",
        file,
        "--affected",
        "--rev",
        rev,
        "--json",
    ], none, jb.QUERY_MS) else return tp.parse_impact("")
    tp.parse_impact(r.out)

## After a save: marks the affected declarations in the gutter. Nothing is
## marked when the file can't be compared (no git revision, or errors).
fn Editor.impact_refresh(mut self)
    if self.dirty
        return
    job := task_job()
    mut rev := "HEAD"
    if job.open and job.program == self.path
        rev = job.rev
    imp := impact_of(self.path, rev)
    mut ids := List[str]()
    mut at := List[int]()
    for sym in self.symbols
        ids.push(sym.id)
        at.push(sym.line)
    self.impact = tp.marked_lines(ids, at, imp)

## Ctrl-Shift-Y: only the tests the changes can reach (test.affected.1).
fn Editor.affected_tests(mut self)
    if self.dirty
        self.message = "affected tests compare the saved file: save first"
        return
    job := task_job()
    mut args := ["test", self.path, "--affected"]
    if job.open and job.program == self.path
        args.push("--since")
        args.push(job.rev)
    r := proc.run(ail_command(), args, none, jb.CHECK_MS) else err
        self.message = jb.failure(err, jb.CHECK_MS)
        return
    self.show_output("test --affected", r)

## The panel's task and impact: the open task's program, else the active tab.
fn Workspace.task_impact(self, job tp.Job) tp.Impact
    if job.open
        return impact_of(job.program, job.rev)
    if self.eds[self.active].dirty
        return tp.parse_impact("")
    impact_of(self.eds[self.active].path, "HEAD")

## `--print --task-json`: the panel for agents (plan D4).
fn Workspace.task_json(self) str
    job := task_job()
    tp.panel_json(job, self.task_impact(job))

## Ctrl-Shift-K: the task panel as a list; a row with a declaration jumps to it.
fn Workspace.task_panel(mut self)
    job := task_job()
    ed := self.eds[self.active]
    mut found := List[Hit]()
    for r in tp.panel_rows(job, self.task_impact(job))
        mut loc := Loc(path: "", line: 0, col: 0)
        for sym in ed.symbols
            if r.id != "" and sym.id == r.id
                loc = Loc(path: ed.path, line: sym.line, col: 1)
        found.push(Hit(loc: loc, text: r.text))
    self.show_list("task", found)

## V, F or X in the panel: `ail task verify|finish|abort`, answer shown as rows.
fn Workspace.task_action(mut self, sub str)
    mut args := ["task", sub]
    if sub != "abort"
        args.push("--json")
    r := proc.run(ail_command(), args, none, jb.CHECK_MS) else err
        self.message = jb.failure(err, jb.CHECK_MS)
        return
    mut found := List[Hit]()
    for l in tp.answer_rows("{r.out}{r.err}")
        found.push(Hit(loc: Loc(path: "", line: 0, col: 0), text: l))
    self.show_list("task {sub}", found)

@test fn the_task_panel_has_its_keys_and_marks_the_gutter()
    kk := workspace_key("k", true, false, true) else Zoom("")
    assert(kk == TaskPanel)
    ky := workspace_key("f8", false, false, false) else Zoom("")
    assert(ky == AffectedTests)
    kv := workspace_key("f7", false, false, false) else Zoom("")
    assert(kv == TaskVerify)
    mut ed := typed("fn a()\n    1\n", [])
    ed.impact = Set[int]()
    ed.impact.add(0)
    mut mark := ""
    for sp in ed.render().spans
        if sp.row == 0 and sp.col == 0
            mark = sp.text
    assert(mark.ends_with("~"))
    ed.apply(Insert("x"))
    assert_eq(ed.impact.len(), 0)

# ---- The program card (Ctrl-Shift-I) --------------------------------------

## A source file's lines, for finding where a card item is declared.
struct Source
    path str
    lines List[str]

## Where `signature` is declared: the first line that is it (after `pub `
## and indentation) or starts with it, else for a constant the line that
## assigns its name; none when no line matches.
fn declared_at(sources List[Source], signature str) Loc?
    for src in sources
        for i in 0..src.lines.len()
            mut t := src.lines[i].trim()
            if p := t.strip_prefix("pub ")
                t = p
            if t == signature or t.starts_with("{signature} ")
                return Loc(path: src.path, line: i + 1, col: indent_of(src.lines[i]) + 1)
    # A constant's card shows its value, not its source text.
    if at := signature.find(" := ")
        name := signature.slice(0, at)
        for src in sources
            for i in 0..src.lines.len()
                if src.lines[i].starts_with("{name} := ")
                    or src.lines[i].starts_with("pub {name} := ")
                    return Loc(path: src.path, line: i + 1, col: 1)
    none

## The rows of `ail api --card --json` (lane 67): the entry point and
## tests, then each module's items with their signatures, effects,
## contracts and error sets, members indented below; each declaration row
## jumps to where it is declared in `sources` (ADR 0331).
fn card_hits(j Json, sources List[Source]) List[Hit]
    nowhere := Loc(path: "", line: 0, col: 0)
    mut hits := List[Hit]()
    if jstr(j, "entry") != ""
        hits.push(Hit(loc: nowhere, text: "entry: {jstr(j, "entry")}"))
    mut tests := List[str]()
    for t in jarr(j, "tests")
        tests.push(jtext(t))
    if tests.len() > 0
        hits.push(Hit(loc: nowhere, text: "tests: {tests.join(", ")}"))
    for m in jarr(j, "modules")
        mut name := jstr(m, "module")
        if name == ""
            name = "(root)"
        hits.push(Hit(loc: nowhere, text: "module {name}: {jint(m, "count")} items"))
        for it in jarr(m, "items")
            card_item(mut hits, it, sources, 1, nowhere)
    for d in jarr(j, "dropped")
        hits.push(Hit(loc: nowhere, text: "(dropped to fit: {jtext(d)})"))
    hits

fn card_item(mut hits List[Hit], it Json, sources List[Source], depth int, parent Loc)
    pad := "  ".repeat(depth)
    sig := jstr(it, "signature")
    mut effects := List[str]()
    for e in jarr(it, "effects")
        effects.push(jtext(e))
    mut row := "{pad}{sig}"
    if effects.len() > 0
        row = "{row}  [{effects.join(" ")}]"
    # api.card.2 gives the position; an older `ail` without it falls back to
    # finding the signature in the sources.
    mut at := Loc(path: jstr(it, "file"), line: jint(it, "line"), col: jint(it, "col"))
    if at.line == 0 or at.path == ""
        at = declared_at(sources, sig) else parent
    hits.push(Hit(loc: at, text: row))
    for f in facts_of(it)
        if not f.starts_with("effects:")
            hits.push(Hit(loc: at, text: "{pad}    {f}"))
    # A variant's signature already shows its fields.
    if jstr(it, "kind") != "variant"
        for sub in jarr(it, "members")
            card_item(mut hits, sub, sources, depth + 1, at)

## Ctrl-Shift-I: the program card of the file's program (the file, the
## modules beside it), as a list whose declarations Enter jumps to;
## refreshed on save while it shows.
fn Workspace.card_view(mut self)
    path := self.eds[self.active].path
    card_args := ["api", "--card", "--json", "--budget", "100000", path]
    r := proc.run(ail_command(), card_args, none, jb.QUERY_MS) else err
        self.message = jb.failure(err, jb.QUERY_MS)
        return
    if r.status != 0
        self.message = "no program card: the program has errors (Ctrl-K shows them)"
        return
    j := parse_json(r.out.trim()) else
        self.message = "can't read the card"
        return
    # The file first, so its declarations win over same-named ones in
    # other programs in the same directory.
    parts := path.split("/")
    mut dir := "."
    if parts.len() > 1
        dir = parts[..parts.len() - 1].join("/")
    mut paths := [path]
    for f in list_files(dir, 4, 2000)
        if f.ends_with(".ail") and f != path and "./{f}" != path
            paths.push(f)
    mut sources := List[Source]()
    for f in paths
        mut text := ""
        for ed in self.eds
            if ed.path == f
                text = ed.text()
        if text == ""
            text = fs.read_text(f) else ""
        sources.push(Source(path: f, lines: text.lines()))
    self.show_list("program card {jstr(j, "card")}", card_hits(j, sources))

# ---- Semantic diff (Ctrl-Shift-D, Ctrl-Shift-V, palette) ----------------------

## The saved file against git HEAD, three ways (`ail diff`, `ail api --diff`,
## `ail verify --diff`) as a list whose rows jump to the declaration, or the
## `+` marks of `git diff -U0` in the gutter (S5, features/diff).
fn Workspace.diff_view(mut self, kind str)
    path := self.eds[self.active].path
    if self.eds[self.active].dirty
        self.message = "the diff is of the saved file: save with Ctrl-S first"
        return
    if kind == "gutter"
        g := proc.run("git", ["diff", "-U0", "HEAD", "--", path], none, jb.QUERY_MS) else err
            self.message = jb.failure(err, jb.QUERY_MS)
            return
        self.eds[self.active].git_marks = sdiff.changed_lines(g.out)
        self.message = "{self.eds[self.active].git_marks.len()} lines differ from HEAD; an edit clears the marks"
        return
    mut args := ["diff", "--no-tests", "--json", "--rev", "HEAD", path]
    mut title := "semantic diff vs HEAD"
    if kind == "api"
        args = ["api", "--diff", "--json", "--rev", "HEAD", path]
        title = "API diff vs HEAD"
    elif kind == "verify"
        args = ["verify", "--diff", "--json", "--rev", "HEAD", path]
        title = "verify vs HEAD"
    r := proc.run(ail_command(), args, none, jb.timeout_for(args)) else err
        self.message = jb.failure(err, jb.timeout_for(args))
        return
    if r.status > 1 and r.out.trim() == ""
        why := r.err.trim().lines()
        self.message = "{title}: {if why.is_empty() then "failed" else why[0]}"
        return
    report := if kind == "verify" then sdiff.verify_rows(r.out) else sdiff.diff_rows(r.out)
    if report.is_empty()
        self.message = "{title}: no changes"
        return
    self.eds[self.active].index()
    mut found := List[Hit]()
    for row in report
        mut line := 0
        if sym := self.eds[self.active].symbol(row.id)
            line = sym.line
        found.push(Hit(loc: Loc(path: path, line: line, col: 1), text: row.text))
    self.show_list("{title}: {sdiff.change_count(report)} changes", found)

# ---- Replace in files (Ctrl-Shift-H) ---------------------------------------

## Ctrl-Shift-H: asks what to find (the word at the cursor to start), then
## the replacement.
fn Workspace.start_replace(mut self)
    self.start_search()
    self.repl_step = 1

## The preview: one row per changed line, `PATH:L:C: old -> new`.
fn Workspace.preview_replace(mut self)
    found := self.search_project(self.search, 1000)
    if found.len() == 0
        self.repl_step = 0
        self.message = "no match for `{self.search}`"
        return
    mut preview := List[Hit]()
    for h in found
        old := h.text.split(": ")[1..].join(": ")
        preview.push(Hit(
            loc: h.loc,
            text: "[x] {h.loc.path}:{h.loc.line}:{h.loc.col}: {old} -> {old.replace(self.search, self.repl_with)}",
        ))
    self.repl_skip = Set[int]()
    self.show_list("", preview)
    self.repl_step = 3
    self.retitle_replace()

## The preview's title: what, and how many rows and files are accepted.
fn Workspace.retitle_replace(mut self)
    mut touched := Set[str]()
    for i in 0..self.hits.len()
        if not self.repl_skip.contains(i)
            touched.add(self.hits[i].loc.path)
    n := self.hits.len() - self.repl_skip.len()
    self.hits_title = "replace `{self.search}` with `{self.repl_with}`: {n} of {self.hits.len()} lines, {touched.len()} files; Space skips, A all, Ctrl-Enter applies"
    self.fill_hits()

## Space on a preview row: skip it, or accept it again; `all` (A) accepts
## every row.
fn Workspace.mark_rows(mut self, all bool)
    if all
        self.repl_skip = Set[int]()
    elif self.repl_skip.contains(self.hit_sel)
        self.repl_skip.remove(self.hit_sel)
    else
        self.repl_skip.add(self.hit_sel)
    for i in 0..self.hits.len()
        mut mark := "[x] "
        if self.repl_skip.contains(i)
            mark = "[ ] "
        self.hits[i].text = "{mark}{self.hits[i].text.chars()[4..].join("")}"
    self.retitle_replace()

## Ctrl-Enter on the preview: replaces on the accepted rows' lines in
## each file's buffer, opening it as a tab; nothing is saved, and Ctrl-Z
## undoes each tab.
fn Workspace.apply_replace(mut self)
    back := self.eds[self.active].path
    mut done := Set[str]()
    for i in 0..self.hits.len()
        p := self.hits[i].loc.path
        if self.repl_skip.contains(i) or done.contains(p)
            continue
        done.add(p)
        mut at_lines := List[int]()
        for j in i..self.hits.len()
            if self.hits[j].loc.path == p and not self.repl_skip.contains(j)
                at_lines.push(self.hits[j].loc.line - 1)
        mut at := -1
        for e in 0..self.eds.len()
            if self.eds[e].path == p or self.eds[e].path == "./{p}"
                at = e
        if at < 0
            self.open(p)
            at = self.active
        self.eds[at].replace_on(self.search, self.repl_with, at_lines)
    self.open(back)
    self.browsing = false
    self.repl_step = 0
    self.hits = []
    self.eds[self.active].pane = Diags
    self.eds[self.active].message = "replaced `{self.search}` in {done.len()} files, not saved; Ctrl-Z undoes per tab"

# ---- References (Shift-F12) ----------------------------------------------

## The rows of `ail api --refs` output: each place of the name, with
## `declaration` or `reference`, shown relative to `root` (ADR 0489). The
## buffer's own temporary copy counts as its file.
fn refs_hits(root str, j Json) List[Hit]
    mut out := List[Hit]()
    for r in jarr(j, "refs")
        mut file := jstr(r, "file")
        if f := file.strip_suffix(".edit-query.ail")
            file = f
        mut what := "reference"
        if d := (r.get("def") else Json.Null).as_bool()
            if d
                what = "declaration"
        at := Loc(path: file, line: jint(r, "line"), col: jint(r, "col"))
        out.push(Hit(loc: at, text: "{shown_path(root, file)}:{at.line}:{at.col}: {what}"))
    out

## Shift-F12: the references of the name under the cursor in the pane,
## Enter jumps to one (ADR 0489). Names the cursor isn't on say so.
fn Workspace.show_references(mut self)
    j := self.eds[self.active].api_at(
        "--refs",
        self.eds[self.active].text(),
        self.eds[self.active].line + 1,
        self.eds[self.active].col + 1,
    ) else
        self.eds[self.active].message = "references: put the cursor on a name"
        return
    found := refs_hits(env.cwd(), j)
    if found.len() == 0
        self.eds[self.active].message = "no references found"
        return
    self.show_list("references: {found.len()}", found)

# ---- Agent co-editing (Ctrl-Shift-A, L, D; S9) -----------------------------

## The token budget of "Copy for agent".
PACK_BUDGET := 1500

## Called while the window waits: reloads open files an agent changed on
## disk (marking the changed lines; a tab with unsaved edits keeps its buffer),
## and once a second notes changed `.ail` files that are not open.
fn Workspace.agent_poll(mut self, now int)
    for i in 0..self.eds.len()
        p := self.watch.poll(self.eds[i].path, self.eds[i].lines, self.eds[i].dirty) else continue
        if p.reload
            mut e := self.eds[i]
            e.lines = p.lines
            e.line = e.line.min(e.lines.len() - 1)
            e.set_col(e.col.min(e.cur().len()))
            e.indexed = false
            e.diags = []
            e.scroll()
            self.eds[i] = e
        self.message = p.note
    if now - self.watch.scanned < 1000
        return
    self.watch.scanned = now
    mut open := List[str]()
    for e in self.eds
        open.push(e.path)
    mut names := List[str]()
    for f in list_files(self.tree_root, 3, 300)
        if f.ends_with(".ail") and not open.contains(f)
            names.push(f)
    found := self.watch.changed_files(names)
    if found.len() > 0
        self.message = "agent changed {found.join(", ")}; Ctrl-Shift-D lists"

## The gutter mark of lines an agent changed: `+` after the line number.
fn Workspace.agent_marks(self, mut s Screen)
    if self.watch.hidden
        return
    ed := self.eds[self.active]
    x0 := self.left()
    for r in 0..ed.text_rows()
        l := ed.top + r
        if r + 1 < self.rows and self.watch.marked(ed.path, l)
            mut bg := BG
            if l == ed.line
                bg = LINE_BG
            s.put(r + 1, x0 + ed.gutter_width() - 1, "+", COMMENT_FG, bg)

## Ctrl-Shift-A: the selection (else the cursor's line), the diagnostics on
## it and the card entries it touches, to the clipboard under the budget.
fn Workspace.agent_pack(mut self)
    ed := self.eds[self.active]
    mut a := ed.line
    mut b := ed.line
    if r := ed.selection()
        a = r.line
        b = r.end_line
    mut rows_out := List[str]()
    for d in ed.diags
        if d.line - 1 >= a and d.line - 1 <= b
            rows_out.push("{ed.path}:{d.line}:{d.col}: {d.severity}[{d.rule}] {d.message}")
    mut facts := List[str]()
    for sy in ed.symbols
        if sy.line - 1 >= a and sy.line - 1 <= b
            facts.push(sy.signature)
            for f in sy.facts
                facts.push("  {f}")
    text := agent.pack(ed.path, a, ed.lines[a..b + 1], rows_out, facts, PACK_BUDGET)
    self.eds[self.active].clip = text
    ui.clipboard_set(text)
    self.message = "copied for agent: {agent.tokens(text)} tokens"

fn text_lines(text str) List[str]
    mut out := text.split("\n")
    if out.len() > 1 and out[out.len() - 1] == ""
        out.pop()
    out

fn Workspace.agent_rows(self, report str) List[Hit]
    mut out := List[Hit]()
    for l in report.lines()
        out.push(Hit(loc: Loc(path: self.eds[self.active].path, line: 0, col: 0), text: l))
    out

## Ctrl-Shift-L: previews the `ail edit` hunks on the clipboard (else in
## `.agent-edit`) as a diff; pressed again, applies them to the buffer as one
## undoable edit. A refused edit applies nothing.
fn Workspace.agent_apply(mut self)
    ed := self.eds[self.active]
    if self.watch.pending != "" and self.hits_title.starts_with("agent edit preview")
        out := agent.apply_buffer(ail_command(), ed.path, ed.text(), self.watch.pending, false)
        self.watch.pending = ""
        if not out.ok
            self.show_list("agent edit refused; nothing applied", self.agent_rows(out.report))
            return
        mut e := self.eds[self.active]
        old := e.lines
        e.snapshot()
        e.lines = text_lines(out.text)
        e.line = e.line.min(e.lines.len() - 1)
        e.set_col(e.col.min(e.cur().len()))
        e.pane = Diags
        e.scroll()
        self.eds[self.active] = e
        self.watch.mark(e.path, agent.changed_lines(old, e.lines))
        self.browsing = false
        self.message = "applied agent edit; Ctrl-Z undoes"
        return
    mut hunks := ""
    if t := ui.clipboard_get()
        hunks = t
    if not agent.looks_like_edit(hunks)
        hunks = ""
        file := "{self.tree_root}/.agent-edit"
        if fs.exists(file)
            hunks = fs.read_text(file) else ""
    if not agent.looks_like_edit(hunks)
        self.message = "no edit hunks on the clipboard or in .agent-edit"
        return
    out := agent.apply_buffer(ail_command(), ed.path, ed.text(), hunks, true)
    if not out.ok
        self.show_list("agent edit refused", self.agent_rows(out.report))
        return
    if out.report.trim() == ""
        self.message = "the agent edit changes nothing"
        return
    self.watch.pending = hunks
    self.show_list("agent edit preview; Ctrl-Shift-L applies", self.agent_rows(out.report))

## Ctrl-Shift-D: open tabs with agent marks and files changed on disk, as a
## list Enter jumps from.
fn Workspace.agent_changes(mut self)
    mut found := List[Hit]()
    for e in self.eds
        n := self.watch.marked_count(e.path)
        if n > 0
            at := Loc(path: e.path, line: self.watch.first_mark(e.path) + 1, col: 1)
            found.push(Hit(loc: at, text: "{e.path}: {n} line(s) changed by an agent"))
    for f in self.watch.recent
        found.push(Hit(loc: Loc(path: f, line: 1, col: 1), text: "{f}: changed on disk"))
    if found.len() == 0
        self.message = "no agent changes seen"
        return
    self.show_list("agent changes: {found.len()}", found)

## The active tab's pane as JSON (`--print --json`, D4): what a person sees,
## for an agent.
fn Workspace.panel_json(self) str
    ed := self.eds[self.active]
    mut title := "none"
    mut found := List[str]()
    if ed.pane == Text
        title = self.hits_title
        if title == ""
            title = "text"
        found = ed.pane_text
    elif ed.pane == Diags
        title = "diagnostics"
        for d in ed.diags
            found.push("{ed.path}:{d.line}:{d.col}: {d.severity}[{d.rule}] {d.message}")
    else
        title = "outline"
        for o in ed.outline
            found.push("{o.line}: {o.text}")
    agent.json_panel(title, found)

# ---- Problems (Ctrl-Shift-M) ----------------------------------------------

## The rows of `ail check --json` output (standard error), one per
## diagnostic not already in `seen`: `FILE:LINE:COL: severity[rule]
## message`. A check copy of an unsaved buffer counts as its file. The
## row shows the file relative to `root` (the working directory), or its
## base name when it lies elsewhere, so a long absolute path (macOS's
## temporary directory, say) doesn't push the message off the row.
fn problem_hits(root str, err str, mut seen Set[str]) List[Hit]
    mut hits := List[Hit]()
    for l in err.lines()
        j := parse_json(l) else continue
        if jstr(j, "rule") == ""
            continue
        mut file := jstr(j, "file")
        if f := file.strip_suffix(".edit-check.ail")
            file = f
        at := Loc(path: file, line: jint(j, "line"), col: jint(j, "col"))
        row := "{shown_path(root, file)}:{at.line}:{at.col}: {jstr(j, "severity")}[{jstr(j, "rule")}] {jstr(j, "message")}"
        if seen.contains(row)
            continue
        seen.add(row)
        hits.push(Hit(loc: at, text: row))
    hits

## Every diagnostic of the programs of the open tabs (each checked whole,
## modules included, buffers as edited), errors first.
fn Workspace.collect_problems(mut self) List[Hit]
    mut seen := Set[str]()
    mut errors := List[Hit]()
    mut others := List[Hit]()
    for i in 0..self.eds.len()
        r := self.eds[i].ail_on_buffer(["check", "--json"]) else continue
        for h in problem_hits(env.cwd(), r.err, mut seen)
            if h.text.contains(": error[")
                errors.push(h)
            else
                others.push(h)
    errors.extend(others)
    errors

## The list's title: the counts by severity.
fn problems_title(found List[Hit]) str
    mut errors := 0
    for h in found
        if h.text.contains(": error[")
            errors += 1
    "problems: {errors} errors, {found.len() - errors} others"

## What identifies a diagnostic across edits: its file and message, not
## its position, which moves as lines are added above it.
fn problem_key(h Hit) str
    "{h.loc.path} {h.text.split(": ")[1..].join(": ")}"

## Ctrl-Shift-M: the problems as a list Enter jumps from (ADR 0339),
## kept live while shown (ADR 0353).
fn Workspace.problems(mut self)
    found := self.collect_problems()
    if found.len() == 0
        self.message = "no problems in {self.eds.len()} open file(s)"
        return
    self.show_list(problems_title(found), found)
    self.live_problems = true
    self.typed_at = 0

## Rebuilds the shown problems list from the buffers, keeping the
## selection on the same diagnostic when it still exists and the focus
## where it is (ADR 0353).
fn Workspace.refresh_problems(mut self)
    self.typed_at = 0
    if self.eds[self.active].pane != Text or not self.hits_title.starts_with("problems")
        self.live_problems = false
        return
    mut keep := ""
    if self.hit_sel < self.hits.len()
        keep = problem_key(self.hits[self.hit_sel])
    found := self.collect_problems()
    self.hits = found
    self.hits_title = problems_title(found)
    mut sel := self.hit_sel.min(found.len() - 1).max(0)
    for i in 0..found.len()
        if problem_key(found[i]) == keep
            sel = i
    self.hit_sel = sel
    self.fill_hits()

# ---- Ask bar, call hierarchy, symbols, tokens (features/ask, plan S8) -------

## The rows of an answer as hits; heading rows have line 0 and don't jump.
fn ask_hits(rows List[ask.Site]) List[Hit]
    mut out := List[Hit]()
    for s in rows
        out.push(Hit(loc: Loc(path: s.file, line: s.line, col: s.col), text: s.text))
    out

## The file `ail` should read for the active tab: the saved file, or a copy
## beside it when the buffer has unsaved changes (so imports still resolve).
fn Workspace.ask_source(mut self) str?
    ed := self.eds[self.active]
    if not ed.dirty
        return ed.path
    file := "{ed.path}.edit-check.ail"
    fs.write_text(file, ed.text()) else err
        self.message = "can't write {err.path}: {err.kind}"
        return none
    file

fn Workspace.ask_release(mut self, file str)
    if file != self.eds[self.active].path
        fs.remove(file) else err
            self.message = "can't remove {err.path}: {err.kind}"

fn Workspace.askbar_event(mut self, ev ui.Event)
    match ev
        Key(k, ctrl, _, _) =>
            if ctrl
                return
            if self.askbar.key(k.name()) == "run"
                self.askbar_run()
        Close => self.quit_all()
        Resize(_, _) => self.on_resize(ev)
        Mouse(_, _, _, _) | Scroll(_) => return

## Enter in the bar: asks the question, or searches the symbols.
fn Workspace.askbar_run(mut self)
    q := self.askbar.text.trim()
    if q == ""
        return
    if self.askbar.mode == 1
        self.go_symbols(q)
        return
    if self.eds[self.active].path == ""
        self.message = "ask needs a saved file"
        return
    file := self.ask_source() else return
    got := ask.query(ail_command(), file, self.eds[self.active].path, q)
    self.ask_release(file)
    if got.problem != ""
        self.message = got.problem
        return
    if not ask.has_sites(got.rows)
        self.message = "no answers for `{q}`"
        return
    self.show_list("ask `{q}`", ask_hits(got.rows))

## Declarations matching `q` in every `.ail` file under the directory.
fn Workspace.go_symbols(mut self, q str)
    mut found := List[ask.Site]()
    for f in list_files(self.tree_root, 4, 300)
        if not f.ends_with(".ail") or f.ends_with(".edit-check.ail")
            continue
        r := proc.run(ail_command(), ["api", "--text", f], none, jb.QUERY_MS) else err
            if err.kind == TimedOut
                self.message = jb.failure(err, jb.QUERY_MS)
            continue
        for s in ask.symbol_rows(r.out, f, q)
            if found.len() < 200
                found.push(s)
    if found.len() == 0
        self.message = "no declaration matches `{q}`"
        return
    self.show_list("symbols `{q}`: {found.len()}", ask_hits(found))

## Ctrl-Shift-Y: callers, then callees, of the function under the cursor.
fn Workspace.show_hierarchy(mut self)
    name := self.eds[self.active].word_here()
    if name == "" or self.eds[self.active].path == ""
        self.message = "call hierarchy: put the cursor on a function name in a saved file"
        return
    file := self.ask_source() else return
    cmd := ail_command()
    path := self.eds[self.active].path
    callers := ask.hierarchy(cmd, file, path, name, true, 3)
    callees := ask.hierarchy(cmd, file, path, name, false, 3)
    self.ask_release(file)
    mut found := List[Hit]()
    found.push(Hit(loc: Loc(path: "", line: 0, col: 0), text: "-- who calls {name}"))
    for h in ask_hits(callers)
        found.push(h)
    found.push(Hit(loc: Loc(path: "", line: 0, col: 0), text: "-- what {name} calls"))
    for h in ask_hits(callees)
        found.push(h)
    self.show_list("call hierarchy of `{name}`", found)

## The tokens of `text`, through a temporary file beside `path`.
fn Workspace.count_text(mut self, path str, text str) int
    file := "{path}.edit-tokens.ail"
    fs.write_text(file, text) else err
        self.message = "can't write {err.path}: {err.kind}"
        return -1
    mut n := -1
    if t := ask.tokens_of(ail_command(), file)
        n = t
    fs.remove(file) else err
        self.message = "can't remove {err.path}: {err.kind}"
    n

## Ctrl-Shift-K: counts the buffer as edited and the selection.
fn Workspace.token_report(mut self)
    ed := self.eds[self.active]
    whole := self.count_text(ed.path, ed.text())
    if whole < 0
        return
    mut picked := -1
    sel := ed.selected_text()
    if sel != ""
        picked = self.count_text(ed.path, sel)
    self.askbar.counted(ed.path, ed.saves, whole)
    self.askbar.selected(picked)
    if picked >= 0
        self.message = "tokens: {whole} in the file, {picked} selected"
    else
        self.message = "tokens: {whole} in the file"

## After an event: counts the saved file again when the tab or the save
## count changed. Files that don't exist yet aren't counted.
fn Workspace.askbar_refresh(mut self)
    ed := self.eds[self.active]
    if not self.askbar.stale(ed.path, ed.saves)
        return
    mut n := -1
    if ed.path != "" and fs.exists(ed.path)
        if t := ask.tokens_of(ail_command(), ed.path)
            n = t
    self.askbar.counted(ed.path, ed.saves, n)

## The prompt on the tab bar while the bar is open, and the token count at
## the right end of the status row.
fn Workspace.render_askbar(self, mut s Screen)
    if self.askbar.open
        head := self.askbar.prompt()
        s.put(0, 0, "{head}{self.askbar.text} ".pad_right(self.cols, ' '), STATUS_FG, SELECT_BG)
        s.cursor_row = 0
        s.cursor_col = head.chars().len() + self.askbar.text.chars().len()
        return
    seg := self.askbar.segment()
    if seg != ""
        s.put(
            1 + self.eds[self.active].text_rows(),
            self.cols - seg.chars().len(),
            seg,
            STATUS_FG,
            STATUS_BG,
        )

## Called while the window waits: refreshes the live problems list once
## 500 ms have passed since the last edit.
fn Workspace.idle(mut self, now int)
    self.agent_poll(now)
    self.jobs.tick(now)
    if self.live_problems and self.typed_at > 0 and now - self.typed_at >= 500
        self.refresh_problems()

@test fn sessions_round_trip()
    mut a := Editor.new("src/a,b.ail", "x\nyz", 40, 10)
    a.jump_to(Loc(path: "", line: 2, col: 3))
    b := Editor.new("b.ail", "", 40, 10)
    v := session_value([b, a], 1)
    assert_eq(v, "2,3,src/a,b.ail|1,1,b.ail")
    at := session_places("{v}|junk")
    assert_eq(at.len(), 2)
    assert_eq(at[0].path, "src/a,b.ail")
    assert_eq(at[0].line, 2)
    assert_eq(at[0].col, 3)
    assert_eq(session_key("/p"), "open:/p")

@test fn problem_rows_from_check_json()
    out := "\{\"severity\":\"error\",\"rule\":\"expr.name.1\",\"file\":\"a.ail.edit-check.ail\",\"line\":3,\"col\":5,\"message\":\"unknown name\"}\nnot json\n"
    mut seen := Set[str]()
    hits := problem_hits("/w", out, mut seen)
    assert_eq(hits.len(), 1)
    assert_eq(hits[0].text, "a.ail:3:5: error[expr.name.1] unknown name")
    assert_eq(hits[0].loc.line, 3)
    assert_eq(problem_hits("/w", out, mut seen).len(), 0)

# ---- The file picker (Ctrl-P) ---------------------------------------------

## The files under `dir`, to `depth` levels, skipping hidden and build
## directories, at most `limit` of them.
# test.sandbox.2: it writes a directory beside the program, and opening an
# .ail file runs ail for highlighting and checks.
@needs(fs, proc) @test fn agent_changes_reload_and_mark_lines()
    d := "edit-agent-test.tmp"
    fs.make_dir(d) else err
        assert(false)
    p := "{d}/a.ail"
    fs.write_text(p, "fn a()\n    1\n") else err
        assert(false)
    mut ws := Workspace.new(Editor.new(p, "fn a()\n    1\n", 40, 10))
    ws.tree_root = d
    ws.idle(time.now_ms())
    # Pretend the file was last seen long ago, so the write below counts as a change.
    ws.watch.stamps = [agent.Stamp(path: p, ms: 1)]
    fs.write_text(p, "fn a()\n    2\n    3\n") else err
        assert(false)
    ws.idle(time.now_ms())
    assert_eq(ws.eds[0].lines, ["fn a()", "    2", "    3"])
    assert(not ws.eds[0].dirty)
    assert(ws.watch.marked(p, 1) and ws.watch.marked(p, 2))
    assert(not ws.watch.marked(p, 0))
    assert(ws.message.contains("agent changed"))
    shown := ws.render()
    assert(shown.text[2].starts_with("  2+"))
    assert(not shown.text[1].starts_with("  1+"))
    ws.start_palette()
    for c in "agent changes".chars()
        ws.on_event(press("{c}"))
    ws.on_event(press("enter"))
    assert(ws.hits_title.starts_with("agent changes: 1"))
    assert(ws.hits[0].text.contains("2 line(s)"))
    assert_eq(ws.hits[0].loc.line, 2)
    # Unsaved edits are kept when the file changes under them.
    ws.on_event(press("Z"))
    ws.watch.stamps = [agent.Stamp(path: p, ms: 1)]
    fs.write_text(p, "fn a()\n    9\n") else err
        assert(false)
    ws.idle(time.now_ms() + 2000)
    assert(ws.message.contains("unsaved edits kept"))
    assert_eq(ws.eds[0].lines[0], "Zfn a()")
    ws.run_command("Toggle agent marks")
    assert(not ws.render().text[2].starts_with("  2+"))
    ws.run_command("Toggle agent marks")
    # A human save makes the file the baseline.
    ws.watch.saved(p)
    assert(not ws.watch.marked(p, 1))
    for f in ["a.ail", ""]
        fs.remove("{d}/{f}") else err
            assert(false)

@test fn copy_for_agent_packs_the_selection_and_its_diagnostics()
    mut ed := Editor.new("t.ail", "fn main()\n    print(1)\n", 40, 10)
    ed.diags = parse_diags("\{\"severity\":\"error\",\"rule\":\"type.x.1\",\"line\":2,\"col\":5,\"end_line\":2,\"end_col\":10,\"message\":\"bad\"}")
    mut ws := Workspace.new(ed)
    ws.eds[0].line = 1
    ws.on_event(key_event("alt+shift+c"))
    clip := ws.eds[0].clip
    assert_eq(clip.split("\n")[0], "t.ail:2")
    assert(clip.contains("    print(1)"))
    assert(not clip.contains("fn main()"))
    assert(clip.contains("t.ail:2:5: error[type.x.1] bad"))
    assert(ws.message.contains("copied for agent"))

@test fn apply_agent_edit_needs_hunks_and_panels_print_json()
    mut ws := Workspace.new(typed("x", []))
    ws.on_event(key_event("alt+shift+v"))
    assert(ws.message.contains("no edit hunks"))
    ws.eds[0].pane = Text
    ws.eds[0].pane_text = ["a", "b"]
    ws.hits_title = "demo"
    assert_eq(ws.panel_json(), "\{\"panel\":\"demo\",\"rows\":[\"a\",\"b\"]}")
    assert_eq(text_lines("a\nb\n"), ["a", "b"])

fn list_files(dir str, depth int, limit int) List[str]
    mut out := List[str]()
    names := fs.list_dir(dir) else return out
    for n in names
        if out.len() >= limit
            break
        if n.starts_with(".") or n == "target"
            continue
        mut path := n
        if dir != "."
            path = "{dir}/{n}"
        if sub := fs.list_dir(path)
            if depth > 0 and sub.len() >= 0
                for f in list_files(path, depth - 1, limit - out.len())
                    out.push(f)
        else
            out.push(path)
    out

## Whether the characters of `q` appear in `s` in order, ignoring case.
fn fuzzy(s str, q str) bool
    cs := s.chars()
    mut i := 0
    for c in q.chars()
        while i < cs.len() and cs[i].to_lower() != c.to_lower()
            i += 1
        if i == cs.len()
            return false
        i += 1
    true

fn Workspace.matches(self) List[str]
    mut out := List[str]()
    for f in self.files
        if fuzzy(f, self.field.text)
            out.push(f)
    out

fn Workspace.start_picking(mut self)
    self.picking = true
    self.commanding = false
    self.field = widgets.TextField.new("open: ", "")
    self.list = picker_list()
    self.files = list_files(".", 4, 2000)

fn Workspace.pick_event(mut self, ev ui.Event)
    match ev
        Key(code, ctrl, _, _) =>
            if ctrl
                return
            k := code.name()
            if k == "escape"
                self.picking = false
                self.commanding = false
                self.picker_mode = ""
            elif k == "enter"
                self.choose()
                return
            elif k == "up" or k == "down"
                self.list.items = self.choices()
                self.list.on_event(ev, self.picker_rect(self.list.items.len()))
            elif k == "backspace" or k.chars().len() == 1
                self.field.on_event(ev)
                self.list.selected = 0
                self.list.top = 0
        Close => self.quit_all()
        Resize(_, _) =>
            self.picking = false
            self.on_event(ev)
        Mouse(_, _, _, _) | Scroll(_) => return
    self.list.selected = self.list.selected.min((self.choices().len() - 1).max(0))

# ---- Workspace and settings (S10) ---------------------------------------

## Starts the picker in a mode: `settings`, `new` (project name) or `bind`.
fn Workspace.start_mode(mut self, m str, label str)
    self.picking = true
    self.commanding = false
    self.picker_mode = m
    self.field = widgets.TextField.new(label, "")
    self.list = picker_list()

## A setting's value: the live theme and font, else the settings text, else
## its default.
fn Workspace.value_of(self, key str) str
    if key == "theme"
        return self.theme
    if key == "font"
        return "{self.font}"
    setting(self.prefs, key) else workspace.default_of(key)

## Keeps a setting in this session and, in the window, in `~/.ail-edit`.
fn Workspace.set_pref(mut self, key str, value str)
    self.prefs = with_setting(self.prefs, key, value)
    self.binds = workspace.binds(self.prefs)
    if not self.remember
        return
    path := settings_path() else return
    mut text := ""
    if fs.exists(path)
        text = fs.read_text(path) else ""
    fs.write_text(path, with_setting(text, key, value)) else err
        self.message = "can't write {err.path}: {err.kind}"

## Enter on row `i` of the settings list: the next value of that setting.
fn Workspace.cycle_setting(mut self, i int)
    rs := workspace.rows(themes.NAMES)
    if i >= rs.len()
        return
    r := rs[i]
    chosen := workspace.next_choice(r, self.value_of(r.key))
    if r.key == "theme"
        self.set_theme(chosen)
    elif r.key == "font"
        self.font = chosen.to_int() else self.font
    elif r.key == "gitmarks"
        self.gitmarks = chosen == "on"
        self.refresh_git()
    self.set_pref(r.key, chosen)
    self.message = "{r.label}: {chosen}"

## Loads the settings file's text: rebindings, git marks, and the font
## unless the start flags gave one.
fn Workspace.load_prefs(mut self)
    path := settings_path() else return
    if not fs.exists(path)
        return
    self.prefs = fs.read_text(path) else ""
    self.binds = workspace.binds(self.prefs)
    self.gitmarks = self.value_of("gitmarks") == "on"
    self.load_sizes()

## The marks `git status` gives the tree's files; empty when marks are off
## or this isn't a git checkout.
fn Workspace.refresh_git(mut self)
    self.git = Map[str, str]()
    if not self.gitmarks
        return
    p := proc.run("git", ["rev-parse", "--show-prefix"], none, jb.QUERY_MS) else err
        if err.kind == TimedOut
            self.message = jb.failure(err, jb.QUERY_MS)
        return
    if p.status != 0
        return
    r := proc.run("git", ["status", "--porcelain"], none, jb.QUERY_MS) else err
        if err.kind == TimedOut
            self.message = jb.failure(err, jb.QUERY_MS)
        return
    if r.status != 0
        return
    self.git = workspace.parse(r.out, p.out.trim())

## Enter in the new-project prompt: `ail new NAME`, then opens `main.ail`.
fn Workspace.new_project(mut self, name str)
    if not workspace.valid_name(name)
        self.message = "`{name}` isn't a project name: lowercase letters, digits, _ and -, starting with a letter"
        return
    r := proc.run(ail_command(), ["new", name], none, jb.QUERY_MS) else err
        self.message = jb.failure(err, jb.QUERY_MS)
        return
    if r.status != 0
        self.message = "ail new: {r.err.trim()}"
        return
    self.welcome = false
    self.open("{name}/main.ail")
    self.message = "created {name}/: ail run {name}, ail test {name}/main.ail"

## Enter in the rebind prompt: `NEWKEY as COMMAND`, saved as `bind.NEWKEY`.
fn Workspace.add_binding(mut self, text str)
    if not workspace.valid_input(text)
        self.message = "type NEWKEY as COMMAND, e.g. ctrl+alt+t as Next theme"
        return
    b := workspace.parse_input(text) else return
    want := b.from.to_lower()
    mut spec := ""
    for r in key_rows()
        if r.spec != "" and (r.spec == want or r.name.to_lower() == want)
            spec = r.spec
    if spec == ""
        self.message = "no command `{b.from}`: Ctrl-Shift-P lists them"
        return
    self.set_pref(workspace.bind_key(b.to), spec)
    self.message = "{b.to} now acts as {spec}"

## The welcome screen's keys: a digit reopens that recent project's tabs;
## any other key dismisses it and goes on to the editor. True if used here.
fn Workspace.welcome_event(mut self, ev ui.Event) bool
    match ev
        Key(k, ctrl, alt, _) =>
            self.welcome = false
            if ctrl or alt
                return false
            dirs := workspace.recent(self.prefs)
            n := k.name().to_int() else return false
            if n < 1 or n > dirs.len().min(9)
                return false
            value := setting(self.prefs, session_key(dirs[n - 1])) else return true
            places := session_places(value)
            if places.len() > 0 and fs.exists(places[0].path)
                self.open(places[0].path)
                self.eds[self.active].jump_to(places[0])
            true
        Resize(_, _) | Close | Mouse(_, _, _, _) | Scroll(_) => false

## Draws the welcome screen over the editor area.
fn Workspace.render_welcome(self, mut s Screen)
    ls := workspace.lines(workspace.recent(self.prefs))
    x := self.left() + 2
    top := ((self.rows - ls.len()) / 2).max(1)
    w := (self.cols - x - 1).max(10)
    for r in 1..self.rows
        s.put(r, x - 1, " ".repeat(w + 1), FG, BG)
    for i in 0..ls.len()
        mut fg := FG
        if i == 0
            fg = KEYWORD_FG
        elif ls[i] == "Start" or ls[i].starts_with("Recent")
            fg = TYPE_FG
        s.put(top + i, x, ls[i], fg, BG)
    s.cursor_row = -1
    s.cursor_col = -1

## The screen: the tab bar, the active editor below it, and the picker over
## it when open.
fn Workspace.render(self) Screen
    mut s := Screen.new(self.cols, self.rows)
    s.band(0, PANE_BG)
    labels := self.tab_labels()
    mut x := 0
    for i in 0..labels.len()
        mut bg := PANE_BG
        mut fg := GUTTER_FG
        if i == self.active
            bg = BG
            fg = FG
        s.put(0, x, labels[i], fg, bg)
        x += labels[i].chars().len() + 1
    if self.message != ""
        s.put(0, x + 1, self.message, FG, PANE_BG)
    x0 := self.left()
    mut shown := self.eds[self.active]
    if self.splitting and self.eds.len() > 1
        shown.cols = self.split_half() - 1
    inner := shown.render()
    for sp in inner.spans
        s.spans.push(Span(row: sp.row + 1, col: sp.col + x0, text: sp.text, fg: sp.fg, bg: sp.bg))
    for r in 0..inner.text.len()
        if r + 1 < self.rows
            s.text[r + 1] = inner.text[r]
    if self.splitting and self.eds.len() > 1
        half := self.split_half()
        mut beside := self.eds[(self.active + 1) % self.eds.len()]
        beside.cols = (self.cols - x0 - half).max(10)
        second := beside.render()
        for sp in second.spans
            s.put(sp.row + 1, sp.col + x0 + half, sp.text, sp.fg, sp.bg)
        for r in 1..self.rows
            s.mark(r, x0 + half - 1, "|", GUIDE_FG, PANE_BG)
    s.text[0] = labels.join(" ")
    if inner.cursor_row >= 0
        s.cursor_row = inner.cursor_row + 1
        s.cursor_col = inner.cursor_col + x0
    self.agent_marks(mut s)
    self.render_jobs(mut s)
    if self.tree_open
        self.render_tree(mut s)
    self.render_search(mut s)
    if self.welcome
        self.render_welcome(mut s)
    self.render_askbar(mut s)
    if self.picking
        self.render_picker(mut s)
    s

fn Workspace.render_picker(self, mut s Screen)
    found := self.choices()
    r := self.picker_rect(found.len())
    head := widgets.Rect(col: r.col, row: 1, cols: r.cols, rows: 1)
    s.runs(self.field.render(head, {"status_fg": STATUS_FG, "select_bg": SELECT_BG}))
    mut shown := self.list
    shown.items = found
    s.runs(shown.render(r, {
        "fg": FG,
        "pane_bg": PANE_BG,
        "select_bg": LINE_BG,
        "gutter_fg": GUTTER_FG,
    }))
    s.cursor_row = 1
    s.cursor_col = self.field.caret_col(head)

## A fresh list for the picker or the palette.
fn picker_list() widgets.ListView
    mut l := widgets.ListView.new([])
    l.empty = "nothing matches"
    l

## Where the picker's list goes: centred, up to 70 columns wide, below its
## query line, as many rows as there are choices (at least 1, at most 12).
fn Workspace.picker_rect(self, n int) widgets.Rect
    w := (self.cols - 4).min(70).max(10)
    widgets.Rect(col: (self.cols - w) / 2, row: 2, cols: w, rows: n.min(12).max(1))

## Adds widget runs without their trailing padding, for a pane whose band
## already fills the row.
fn Screen.runs_unpadded(mut self, runs List[widgets.Run])
    for r in runs
        cs := r.text.chars()
        mut end := cs.len()
        while end > 0 and cs[end - 1] == ' '
            end -= 1
        if end > 0
            self.put(r.row, r.col, cs[..end].join(""), r.fg, r.bg)

## Adds widget runs to the screen (std.ui.widgets).
fn Screen.runs(mut self, runs List[widgets.Run])
    for r in runs
        self.put(r.row, r.col, r.text, r.fg, r.bg)

## The event loop: wait for an event, apply it and any others already
## pending, then draw once. The title shows the file and its unsaved mark.
fn Workspace.window(mut self) ! ui.UiError
    mut w := ui.open("edit", self.cols, self.rows)?
    size := w.size()
    self.on_event(Resize(cols: size.cols, rows: size.rows))
    mut title := ""
    mut redraw := true
    while not self.quit
        ed := self.eds[self.active]
        mut t := "{ed.path} - edit"
        if ed.dirty
            t = "* {t}"
        if t != title
            w.set_title(t)
            title = t
        if self.font != w.font_size()
            w.set_font_size(self.font)
            self.font = w.font_size()
        if redraw
            draw_themed(mut w, self.render(), self.pal)
        redraw = true
        # Wait for events without blocking, so the idle work runs: the
        # problems refresh and the agent file watch (S9).
        if ev := w.poll_event()
            self.on_window_event(ev, w.modifiers())
        else
            before := self.message
            self.idle(time.now_ms())
            redraw = self.message != before or self.live_problems
            time.sleep_ms(50)
    if self.remember
        self.save_session()
    w.close()

## An event with the modifiers held when it happened (std.ui.14): a
## Shift-click extends the selection to the clicked place.
fn Workspace.on_window_event(mut self, ev ui.Event, m ui.Modifiers)
    shift_click := match ev
        Mouse(c, r, button, kind) =>
            if m.alt and not self.picking and button == Left and kind == Down and r > 0
                self.eds[self.active].add_caret_at(c - self.left(), r - 1)
                true
            elif m.shift and not self.picking and button == Left and kind == Down and r > 0
                self.eds[self.active].extend_to(c - self.left(), r - 1)
                true
            else
                false
        Key(_, _, _, _) | Resize(_, _) | Close | Scroll(_) => false
    if not shift_click
        self.on_event(ev)

# ---- Editing depth tests (features/) ------------------------------------

DEPTH_SAMPLE := "fn main()\n    x := 1\n    if x > 0\n        print(x)\n\nfn other()\n    y := 2\n"

@test fn breadcrumbs_and_enclosing_scopes()
    ls := DEPTH_SAMPLE.split("\n")
    assert_eq(scope.chain(ls, 3), [0, 2])
    assert_eq(scope.crumbs(ls, 3), "main")
    assert_eq(scope.crumbs(ls, 0), "main")
    assert_eq(scope.crumbs(ls, 4), "main")
    assert_eq(scope.crumbs(ls, 6), "other")
    assert_eq(scope.name_of("pub fn Editor.go(self, d Dir)"), "Editor.go")
    assert_eq(scope.name_of("@test fn t()"), "t")
    assert_eq(scope.name_of("struct Point"), "Point")
    assert_eq(scope.name_of("x := 1"), "")
    h := scope.sticky(ls, 3) else -1
    assert_eq(h, 0)
    assert(scope.sticky(ls, 0) == none)

@test fn sticky_header_and_crumbs_render()
    mut text := "fn big()\n"
    for _ in 0..20
        text = "{text}    x := 1\n"
    mut ed := typed(text, [Command.Resize(cols: 100, rows: 12), Go(Bottom)])
    assert(ed.top > 0)
    s := ed.render()
    assert_eq(s.text[0].trim(), "fn big()")
    assert(s.text[ed.text_rows()].contains("big"))

@test fn folding_hides_a_block_and_survives_undo()
    mut ed := typed(DEPTH_SAMPLE, [])
    ed.apply(Depth("fold"))
    assert(ed.folded.contains(0))
    assert_eq(fold.end_of(ed.lines, 0), 3)
    s := ed.render()
    assert(s.text[0].starts_with("  1>fn main()"))
    assert(s.text[0].contains("3 lines"))
    assert(s.text[1].starts_with("  5 "))
    assert(s.text[2].starts_with("  6 fn other()"))
    ed.apply(Go(Down))
    assert_eq(ed.line, 4)
    ed.apply(Insert("x"))
    assert(ed.folded.contains(0))
    ed.apply(Depth("unfold_all"))
    assert_eq(ed.folded.len(), 0)
    ed.apply(Undo)
    assert(ed.folded.contains(0))
    ed.apply(Depth("fold_all"))
    assert(ed.folded.contains(0) and ed.folded.contains(5))

@test fn folds_move_with_their_text()
    mut ed := typed("x := 0\nfn main()\n    y := 1\n", [])
    ed.apply(Go(Down))
    ed.apply(Depth("fold"))
    assert(ed.folded.contains(1))
    ed.apply(Go(Top))
    ed.apply(Go(End))
    ed.apply(Newline)
    assert(ed.folded.contains(2))
    assert_eq(ed.folded.len(), 1)
    ed.apply(Go(Bottom))
    assert(not ed.folded.contains(2))

@test fn multi_cursor_types_at_every_occurrence()
    mut ed := typed("a1 a1\nb a1\n", [])
    ed.apply(Depth("next"))
    assert_eq(ed.selected_text(), "a1")
    ed.apply(Depth("next"))
    ed.apply(Depth("next"))
    assert_eq(ed.extra.len(), 2)
    ed.apply(Insert("zz"))
    assert_eq(ed.lines, ["zz zz", "b zz"])
    ed.apply(Insert("!"))
    assert_eq(ed.lines, ["zz! zz!", "b zz!"])
    ed.apply(Backspace)
    assert_eq(ed.lines, ["zz zz", "b zz"])
    ed.apply(Go(Left))
    assert_eq(ed.lines, ["zz zz", "b zz"])
    assert_eq(ed.extra.len(), 2)
    ed.apply(Escape)
    assert_eq(ed.extra.len(), 0)

@test fn multi_cursor_lines_and_undo()
    mut ed := typed("a\nb\nc\n", [])
    ed.apply(Depth("below"))
    ed.apply(Depth("below"))
    assert_eq(ed.extra.len(), 2)
    ed.apply(Insert("-"))
    assert_eq(ed.lines, ["-a", "-b", "-c"])
    ed.apply(Newline)
    assert_eq(ed.lines.len(), 6)
    ed.apply(Undo)
    assert_eq(ed.lines, ["-a", "-b", "-c"])
    ed.apply(Depth("all"))
    assert_eq(ed.extra.len(), 0)

@test fn multi_core_edits()
    ls := ["ab", "cd"]
    cs := multi.prepare(multi.span(0, 1, 0, 2, 1), [multi.at(1, 0, 0), multi.at(0, 1, 0)])
    assert_eq(cs.len(), 3)
    e := multi.replace_all(ls, cs, "XY")
    assert_eq(e.lines, ["aXYXY", "XYcd"])
    assert_eq(e.carets[0].col, 3)
    assert_eq(e.carets[1].col, 5)
    assert_eq(e.carets[2].line, 1)
    assert_eq(e.carets[1].tag, 1)
    back := multi.grow_back(["ab", "cd"], [multi.at(1, 0, 1), multi.at(0, 2, 0)])
    assert_eq(multi.replace_all(["ab", "cd"], back, "").lines, ["acd"])
    assert_eq(multi.occurrences(["abab"], "ab").len(), 2)

@test fn bracket_pairs_are_colored_by_depth()
    sc := pairs.scan("f(a[1], \"(\")", 0)
    assert_eq(sc.levels[1], 1)
    assert_eq(sc.levels[3], 2)
    assert_eq(sc.levels[5], 2)
    assert_eq(sc.levels[9], 0)
    assert_eq(sc.levels[11], 1)
    assert_eq(sc.depth, 0)
    assert_eq(pairs.scan("x(  # (", 0).depth, 1)

@test fn zen_and_split_view_and_their_keys()
    mut ed := typed("x", [])
    ed.apply(Depth("zen"))
    assert_eq(ed.pane_rows(), 0)
    assert_eq(key_command("d", false, true, false), Depth("next"))
    assert_eq(key_command("f11", false, false, false), Depth("zen"))
    assert_eq(key_command("[", true, false, true), Depth("fold"))
    assert_eq(key_command("up", false, true, true), Depth("above"))
    assert_eq(key_command("up", false, true, false), MoveLine(false))
    mut ws := Workspace.new(typed("alpha", []))
    ws.eds.push(typed("beta", []))
    ws.on_event(key_event("ctrl+\\"))
    assert(ws.splitting)
    s := ws.render()
    assert(s.text[1].contains("alpha"))
    assert(s.text[1].contains("beta"))

# ---- Background jobs (parity X1) ------------------------------------------

## The title a job of `kind` shows in the pane, the status row and the list.
fn job_title(kind str) str
    match kind
        "test" => "ail test"
        "trace" => "ail run --trace"
        "quiet" => "ail test (on save)"
        _ => "ail run"

## The key that starts a job of `kind`, as a message names it.
fn job_key_name(kind str) str
    match kind
        "test" => "F6"
        "trace" => "Shift-F5"
        _ => "F5"

## The file a job runs `ail` on: the tab's file when saved, else a copy beside
## it (as `ail_on_buffer` makes), which the job removes when it ends.
fn Editor.job_file(mut self) str?
    if not self.dirty
        return self.path
    copy := "{self.path}.edit-check.ail"
    fs.write_text(copy, self.text()) else err
        self.message = "can't write {err.path}: {err.kind}"
        return none
    copy

## The tab showing `path`.
fn Workspace.tab_of(self, path str) int?
    for i in 0..self.eds.len()
        if self.eds[i].path == path
            return i
    none

## F5, F6 and Shift-F5 start jobs instead of blocking runs; any other key
## disarms the second press `foreground` asks for.
fn Workspace.job_key(mut self, k str, ctrl bool, alt bool, shift bool) bool
    mut kind := ""
    if k == "f5"
        kind = if shift then "trace" else "run"
    elif k == "f6" and not shift
        kind = "test"
    if ctrl or alt or kind == ""
        self.jobs.armed = ""
        return false
    self.foreground(kind)
    true

## Runs the active tab as a job of `kind` (`run`, `test` or `trace`). While
## one of those runs, the first press says so and the second stops it and
## starts the new one.
fn Workspace.foreground(mut self, kind str)
    if busy := self.jobs.live(["run", "test", "trace"])
        if self.jobs.armed != kind
            self.jobs.armed = kind
            j := self.jobs.find(busy) else return
            self.message = "{j.title} is still running: {job_key_name(kind)} again stops it and starts {job_title(kind)}"
            return
        _ := self.jobs.cancel(busy, time.now_ms())
        self.job_ended(busy)
    self.jobs.armed = ""
    words := match kind
        "trace" => ["run", "--trace=all", "--json", "--values"]
        "test" => ["test"]
        _ => ["run"]
    _ := self.start_ail_job(self.active, kind, words)

## Tests on save (ADR 0354) as a quiet job: the counts reach the status row
## when it ends; an older one still running is stopped first.
fn Workspace.quiet_tests(mut self)
    if busy := self.jobs.live(["quiet"])
        _ := self.jobs.cancel(busy, time.now_ms())
        self.job_ended(busy)
    _ := self.start_ail_job(self.active, "quiet", ["test", "--json"])

## Starts `ail WORDS FILE` for tab `tab` as a job of `kind`: in the
## background in the std.app window, else run to completion now. A run or a
## test shows its pane at once. Returns the job's id, or -1.
fn Workspace.start_ail_job(mut self, tab int, kind str, words List[str]) int
    target := self.eds[tab].job_file() else return -1
    mut args := words
    args.push(target)
    mut sp := jb.spec(job_title(kind), kind, ail_command(), args)
    sp.path = self.eds[tab].path
    sp.words = words
    if target != sp.path
        sp.copy = target
    if kind == "trace"
        sp.limit = 50000
    id := self.jobs.start(sp, time.now_ms())
    if kind == "run" or kind == "test"
        self.show_job(tab, id)
    if self.jobs.submit(id)
        return id
    self.run_job_now(id)
    id

## Runs job `id` to completion (no window runner: `--print`, tests, the
## std.ui window) through the same state changes the runner's events make.
fn Workspace.run_job_now(mut self, id int)
    j := self.jobs.find(id) else return
    ms := if j.timeout_ms > 0 then j.timeout_ms else jb.RUN_MS
    r := proc.run(j.command, j.args, none, ms) else err
        _ := self.jobs.failed(id, jb.failure(err, ms), time.now_ms())
        self.job_ended(id)
        return
    for l in r.out.lines()
        self.jobs.line(id, "out", l)
    for l in r.err.lines()
        self.jobs.line(id, "err", l)
    _ := self.jobs.exited(id, r.status, time.now_ms())
    self.job_ended(id)

## Shows job `id`'s output in tab `tab`'s pane, its end in view.
fn Workspace.show_job(mut self, tab int, id int)
    i := self.jobs.at(id)
    if i < 0
        return
    self.eds[tab].pane = Text
    room := (self.eds[tab].pane_rows() - 1).max(1)
    self.eds[tab].pane_text = self.jobs.list[i].pane_rows(room)

## An inbox event from the runner (the std.app window).
fn Workspace.job_event(mut self, text str)
    step := self.jobs.apply(text, time.now_ms())
    if step.id < 0
        return
    if step.ended
        self.job_ended(step.id)
        return
    i := self.jobs.at(step.id)
    tab := self.tab_of(self.jobs.list[i].path) else return
    if self.following(tab, step.id)
        self.show_job(tab, step.id)

## Whether tab `tab`'s pane shows running job `id` (Escape hides it, and
## another pane replaces it; then new lines stay in the job).
fn Workspace.following(self, tab int, id int) bool
    i := self.jobs.at(id)
    if i < 0 or self.eds[tab].pane != Text or self.eds[tab].pane_text.len() == 0
        return false
    self.jobs.list[i].follows(self.eds[tab].pane_text[0])

## What a job leaves when it ends: the pane and message of a run or test, the
## trace list, or the test counts of tests on save; the buffer copy goes.
fn Workspace.job_ended(mut self, id int)
    j := self.jobs.find(id) else return
    if j.copy != "" and fs.exists(j.copy)
        fs.remove(j.copy) else err
            self.message = "can't remove {err.path}: {err.kind}"
    tab := self.tab_of(j.path) else return
    if j.kind == "quiet"
        if j.state != Cancelled
            self.eds[tab].tests = test_counts(j.out_text())
        return
    if j.kind == "trace"
        if j.state == Cancelled or j.note != "" or tab != self.active
            self.message = j.header()
            return
        self.show_list("trace (exit {j.status})", trace_hits(j.path, j.err_text(), j.out_text()))
        return
    what := j.words.first() else "run"
    if not self.following(tab, id)
        self.message = "{j.header()}; Show jobs (palette) has its output"
        return
    mut outcome := "exit {j.status}"
    if j.state == Cancelled
        outcome = "cancelled"
    elif j.note != ""
        outcome = j.note
    self.show_job(tab, id)
    self.eds[tab].message = "{what}: {outcome}; click a location to jump, Esc closes"

## "Stop the running job": stops the newest one; its output so far stays.
fn Workspace.stop_job(mut self)
    ids := self.jobs.running()
    id := ids.last() else
        self.message = "no job is running"
        return
    _ := self.jobs.cancel(id, time.now_ms())
    self.job_ended(id)
    j := self.jobs.find(id) else return
    self.message = "stopped {j.title}"

## "Run again": the last run, test, trace or tests-on-save job, on its file.
fn Workspace.run_again(mut self)
    j := self.jobs.last(["run", "test", "trace", "quiet"]) else
        self.message = "nothing has run yet: F5 runs the file"
        return
    tab := self.tab_of(j.path) else
        self.message = "{j.path} is no longer open"
        return
    self.active = tab
    if j.kind == "quiet"
        self.quiet_tests()
    else
        self.foreground(j.kind)

## "Show jobs": one row per job, newest first; Enter shows its output.
fn Workspace.show_jobs(mut self)
    shown_rows := self.jobs.rows()
    if shown_rows.len() == 0
        self.message = "no jobs yet: F5 runs the file, F6 its tests"
        return
    mut found := List[Hit]()
    for t in shown_rows
        found.push(Hit(loc: Loc(path: "", line: 0, col: 0), text: t))
    self.show_list("jobs: {found.len()}", found)

## Enter on row `n` of the jobs list: that job's output in its file's tab.
fn Workspace.open_job(mut self, n int)
    ids := self.jobs.ids()
    if n < 0 or n >= ids.len()
        return
    j := self.jobs.find(ids[n]) else return
    tab := self.tab_of(j.path) else self.active
    self.active = tab
    self.show_job(tab, ids[n])
    self.message = "{j.title}: Esc closes"

## The running jobs' summary at the right of the active tab's status row.
fn Workspace.render_jobs(self, mut s Screen)
    note := self.jobs.summary()
    if note == ""
        return
    at_row := 1 + self.eds[self.active].text_rows()
    width := note.chars().len() + 2
    at_col := (self.cols - width).max(self.left())
    s.put(at_row, at_col, " {note} ", STATUS_FG, STATUS_BG)

@test fn f5_while_a_run_is_live_asks_then_the_palette_stops_it()
    mut ws := Workspace.new(typed("fn main()\n", []))
    mut sp := jb.spec("ail run", "run", "ail", ["run", "t.ail"])
    sp.path = "t.ail"
    sp.words = ["run"]
    id := ws.jobs.start(sp, 1000)
    ws.show_job(0, id)
    assert(ws.following(0, id))
    # Lines from the runner stream into the pane, the end in view.
    ws.job_event("lines|{id}|out|one\ntwo")
    assert_eq(ws.eds[0].pane_text[ws.eds[0].pane_text.len() - 1], "two")
    ws.jobs.tick(13500)
    assert(ws.render().text[1 + ws.eds[0].text_rows()].contains("running: ail run (12 s)"))
    ws.on_event(key_event("f5"))
    assert(ws.message.contains("F5 again stops it"))
    assert_eq(ws.jobs.armed, "run")
    assert_eq(ws.jobs.list.len(), 1)
    ws.on_event(press("left"))
    assert_eq(ws.jobs.armed, "")
    ws.run_command("Stop the running job")
    assert(ws.jobs.find(id)?.state == Cancelled)
    assert_eq(ws.eds[0].pane_text[0], "ail run: cancelled")
    assert_eq(ws.eds[0].pane_text[1], "one")
    assert_eq(ws.jobs.summary(), "")
    ws.run_command("Stop the running job")
    assert_eq(ws.message, "no job is running")
    ws.run_command("Show jobs")
    assert(ws.hits_title.starts_with("jobs: 1"))
    assert(ws.eds[0].pane_text[1].starts_with("cancelled ail run  t.ail"))
    ws.on_event(press("enter"))
    assert_eq(ws.eds[0].pane_text[0], "ail run: cancelled")

@test fn escape_leaves_a_job_running_and_its_pane_hidden()
    mut ws := Workspace.new(typed("fn main()\n", []))
    mut sp := jb.spec("ail test", "test", "ail", ["test", "t.ail"])
    sp.path = "t.ail"
    sp.words = ["test"]
    id := ws.jobs.start(sp, 0)
    ws.show_job(0, id)
    ws.on_event(press("escape"))
    assert(not ws.following(0, id))
    ws.job_event("lines|{id}|out|ok a")
    assert(ws.eds[0].pane != Text)
    assert_eq(ws.jobs.find(id)?.lines.len(), 1)
    ws.job_event("exit|{id}|0")
    assert(ws.jobs.find(id)?.state == Done)
    assert(ws.message.contains("Show jobs"))
    # Tests on save end in the status counts, not the pane.
    mut q := jb.spec("ail test (on save)", "quiet", "ail", ["test", "--json", "t.ail"])
    q.path = "t.ail"
    qid := ws.jobs.start(q, 0)
    ws.job_event("lines|{qid}|out|\{\"summary\":true,\"passed\":2,\"failed\":0}")
    ws.job_event("exit|{qid}|0")
    assert_eq(ws.eds[0].tests, "tests 2/2 pass")

# test.sandbox.2: it writes a program beside the editor and runs `ail run` on it.
@needs(fs, proc) @test fn f5_in_a_headless_workspace_runs_to_the_end_and_shows_output()
    d := "edit-jobs-test.tmp"
    fs.make_dir(d) else err
        assert(false)
    path := "{d}/hello.ail"
    src := "fn main()\n    print(\"hi from a job\")\n"
    fs.write_text(path, src) else err
        assert(false)
    mut ws := Workspace.new(Editor.new(path, src, 60, 20))
    ws.on_event(key_event("f5"))
    assert_eq(ws.eds[0].pane, Text)
    assert_eq(ws.eds[0].pane_text[0], "ail run: exit 0")
    assert(ws.eds[0].pane_text.contains("hi from a job"))
    assert(ws.eds[0].message.starts_with("run: exit 0"))
    assert_eq(ws.jobs.list.len(), 1)
    assert(ws.jobs.list[0].state == Done)
    assert_eq(ws.jobs.summary(), "")
    fs.remove(path) else err
        assert(false)
    fs.remove(d) else err
        assert(false)
# ---- Pointer (parity P7) ---------------------------------------------------

## Double-click and the palette's Select word: the word under the caret.
fn Editor.select_word(mut self)
    w := self.word_at() else return
    self.extra = []
    self.selecting = true
    self.anchor_line = w.line
    self.anchor_col = w.col
    self.line = w.end_line
    self.set_col(w.end_col)

## Triple-click and the palette's Select line: the caret's line, up to the
## start of the next one.
fn Editor.select_line(mut self)
    s := pointer.line_sel(self.lines.len(), self.line, self.lines[self.line].chars().len())
    self.extra = []
    self.selecting = true
    self.anchor_line = s.line
    self.anchor_col = s.col
    self.line = s.end_line
    self.set_col(s.end_col)

## A selection from a word or line drag (`pointer.extend`).
fn Editor.select_ends(mut self, e pointer.Ends)
    self.extra = []
    self.selecting = true
    self.anchor_line = e.anchor_line
    self.anchor_col = e.anchor_col
    self.line = e.line
    self.set_col(e.col)
    self.scroll()

## The buffer line on text row `r` of the view, folds skipped; -1 past the end.
fn Editor.row_line(self, r int) int
    if r < 0
        return -1
    if self.folded.len() == 0
        if self.top + r < self.lines.len()
            return self.top + r
        return -1
    ht := fold.hidden(self.lines, self.folded)
    fold.nth(ht, fold.rank(ht, self.top) + r)

## The diagnostic whose span covers (`l`, `c`), 0-based.
fn Editor.diag_at(self, l int, c int) Diag?
    for d in self.diags
        if pointer.in_span(l, c, d.line, d.col, d.end_line, d.end_col)
            return d
    none

## The first diagnostic that starts on line `l`, 0-based.
fn Editor.diag_on_line(self, l int) Diag?
    for d in self.diags
        if d.line - 1 == l
            return d
    none

## A diagnostic's message and help in the pane, as F1 shows its explanation.
fn Editor.show_diag(mut self, d Diag)
    self.pane_text = pointer.diag_rows(d.severity, d.rule, d.message, d.help)
    self.pane = Text
    self.message = "Esc closes"

## Ctrl-I's info for the name at (`l`, `c`), keeping the caret, the
## selection and the view where they were.
fn Editor.info_at(mut self, l int, c int)
    at_line := self.line
    at_col := self.col
    at_goal := self.goal
    at_top := self.top
    at_left := self.left
    was_selecting := self.selecting
    self.line = l
    self.col = c
    self.run(Hover)
    self.line = at_line
    self.col = at_col
    self.goal = at_goal
    self.top = at_top
    self.left = at_left
    self.selecting = was_selecting

## A pane as a number, to keep in `pointer.Gesture`, and back.
fn pane_number(p Pane) int
    match p
        Diags => 0
        Text => 1
        Outline => 2

fn pane_of(n int) Pane
    if n == 1
        return Pane.Text
    if n == 2
        return Pane.Outline
    Pane.Diags

## The tree's columns: the dragged width when set, else `TREE_W`.
fn Workspace.tree_w(self) int
    pointer.tree_width(self.ptr.treew, TREE_W, self.cols)

## Sets the tree width and the pane height (cells, 0 automatic) and gives
## every tab its share.
fn Workspace.set_sizes(mut self, treew int, paneh int)
    self.ptr = pointer.Sizes(treew: treew, paneh: paneh)
    for mut ed in self.eds
        ed.pane_h = paneh
    self.resize_tabs()

## The saved sizes (`treew`, `paneh` in the settings file).
fn Workspace.load_sizes(mut self)
    got := pointer.sizes_of(
        (setting(self.prefs, "treew") else ""),
        (setting(self.prefs, "paneh") else ""),
    )
    self.set_sizes(got.treew, got.paneh)

## Saves the sizes after a splitter drag.
fn Workspace.save_sizes(mut self)
    self.set_pref("treew", "{self.ptr.treew}")
    self.set_pref("paneh", "{self.ptr.paneh}")

## The palette row called `name`, when the palette has it.
fn command_named(name str) KeyRow?
    for r in key_rows()
        if r.name == name
            return r
    none

## Runs the palette command `name`: its key, else `run_command`; nothing
## when there is no such command.
fn Workspace.run_named(mut self, name str)
    r := command_named(name) else return
    if r.spec == ""
        self.run_command(r.name)
    else
        self.on_event(key_event(r.spec))

## Closes the tabs other than `at`, or only those right of it; a tab with
## unsaved changes stays and says so, as Ctrl-W does.
fn Workspace.close_others(mut self, at int, right bool)
    if at < 0 or at >= self.eds.len()
        return
    keep := self.eds[at].path
    mut i := self.eds.len() - 1
    while i >= 0
        if i != at and (i > at or not right)
            self.active = i
            self.close_tab()
        i -= 1
    for k in 0..self.eds.len()
        if self.eds[k].path == keep
            self.active = k

## The tree row under grid row `r`, as `click_tree` finds it, or -1.
fn Workspace.tree_row_at(self, r int) int
    top := (self.tree_sel - (self.rows - 1) + 1).max(0)
    i := top + r - 1
    if i >= 0 and i < self.tree.len()
        return i
    -1

## What `pointer.place` needs from the window and the active tab.
fn Shell.layout(self) pointer.Layout
    e := self.ws.eds[self.ws.active]
    pointer.Layout(
        m: self.m,
        left: self.ws.left(),
        gutter: e.gutter_width(),
        status_row: 1 + e.text_rows(),
        pane_rows: e.pane_rows(),
        minimap: self.ws.minimap,
    )

## A key for the pointer (a menu item, a status segment, Cmd-click): as a
## typed key, with a changed clipboard sent to the host.
fn Shell.press_spec(mut self, spec str)
    before := self.ws.eds[self.ws.active].clip
    self.ws.on_event(key_event(spec))
    after := self.ws.eds[self.ws.active].clip
    if after != before
        self.sent.push(app.clipboard(after))

## The active tab's selection as a `pointer.Sel`; the caret when empty.
fn Shell.selected_sel(self) pointer.Sel
    e := self.ws.eds[self.ws.active]
    r := e.selection() else
        return pointer.Sel(line: e.line, col: e.col, end_line: e.line, end_col: e.col)
    pointer.Sel(line: r.line, col: r.col, end_line: r.end_line, end_col: r.end_col)

## A press on the tab strip: left selects or closes (or starts a drag),
## right opens the tab's menu, the middle button closes the tab.
fn Shell.tab_down(mut self, ev app.Event)
    hit := win.tab_hit(self.tabs(), win.chrome_size(self.m), ev.x)
    if hit.index < 0
        return
    if ev.text == "left"
        self.ws.active = hit.index
        if hit.close
            self.ws.close_tab()
        else
            self.tab_drag = hit.index
            self.tab_drop = hit.index
    elif ev.text == "right"
        self.pt.menu_tab = hit.index
        reveal := command_named("Reveal in tree") != none
        self.menu = app.Popup(id: "tab", x: ev.x, y: ev.y, items: pointer.tab_menu(reveal))
    else
        self.ws.active = hit.index
        self.ws.close_tab()

## A left press on the text: Cmd- or Ctrl-click goes to the definition, a
## double-click selects the word and a triple-click the line (a drag then
## extends by words or lines), else the caret goes there and a drag selects.
fn Shell.text_down(mut self, ev app.Event, cell win.Cell)
    self.ws.on_event(Mouse(col: cell.col, row: cell.row, button: Left, kind: Down))
    if ev.ctrl or ev.meta
        self.press_spec("f12")
        return
    if ev.clicks == 2
        self.ws.eds[self.ws.active].run(Depth("word"))
        self.pt.anchor = self.selected_sel()
        self.pt.drag = pointer.Drag.ByWords
    elif ev.clicks >= 3
        self.ws.eds[self.ws.active].run(Depth("line"))
        self.pt.anchor = self.selected_sel()
        self.pt.drag = pointer.Drag.ByLines
    else
        self.held = true

## A left press on the gutter: fold or unfold, show the line's diagnostic,
## run the test that starts there (Shift-F6), or select the line.
fn Shell.gutter_click(mut self, cell win.Cell)
    e := self.ws.eds[self.ws.active]
    l := e.row_line(cell.row - 1)
    if l < 0
        return
    self.ws.on_event(Mouse(col: cell.col, row: cell.row, button: Left, kind: Down))
    d := e.diag_on_line(l)
    act := pointer.gutter_act(
        e.folded.contains(l),
        d != none,
        pointer.starts_test(e.lines, l),
        scope.opens(e.lines, l),
    )
    match act
        ToggleFold => self.ws.eds[self.ws.active].run(Depth("fold"))
        ShowDiag =>
            if found := d
                self.ws.eds[self.ws.active].show_diag(found)
        RunTest => self.press_spec("shift+f6")
        SelectLine =>
            self.ws.eds[self.ws.active].run(Depth("line"))
            self.pt.anchor = self.selected_sel()
            self.pt.drag = pointer.Drag.ByLines

## The scrollbar's track (also the minimap's): its top and height in points.
fn Shell.track_y0(self) float
    win.row_y(self.m, 1)

fn Shell.track_h(self) float
    e := self.ws.eds[self.ws.active]
    (win.row_y(self.m, 1 + e.text_rows()) - self.track_y0()).max(1.0)

## A press on the scrollbar: grab the thumb, or page above or below it.
fn Shell.bar_down(mut self, y float)
    e := self.ws.eds[self.ws.active]
    t := pointer.thumb(self.track_y0(), self.track_h(), e.top, e.lines.len(), e.text_rows())
    match pointer.bar_press(y, t)
        Grab(off) =>
            self.pt.grab = off
            self.pt.drag = pointer.Drag.ThumbDrag
        PageAbove => self.ws.on_event(Scroll(lines: -e.text_rows()))
        PageBelow => self.ws.on_event(Scroll(lines: e.text_rows()))

## The minimap scrolls the line at `y` into the middle of the view.
fn Shell.map_to(mut self, y float)
    e := self.ws.eds[self.ws.active]
    at := pointer.map_top(y, self.track_y0(), self.track_h(), e.lines.len(), e.text_rows())
    self.ws.eds[self.ws.active].top = at

## A move during a pointer drag.
fn Shell.pointer_drag(mut self, ev app.Event)
    match self.pt.drag
        NoDrag => return
        ByWords | ByLines => self.select_drag(ev)
        ThumbDrag =>
            e := self.ws.eds[self.ws.active]
            at := pointer.thumb_top(
                ev.y,
                self.pt.grab,
                self.track_y0(),
                self.track_h(),
                e.lines.len(),
                e.text_rows(),
            )
            self.ws.eds[self.ws.active].top = at
        MapDrag => self.map_to(ev.y)
        TreeDrag =>
            w := pointer.tree_from_x(ev.x, self.m.x0, self.m.cw)
            self.ws.set_sizes(pointer.tree_width(w, TREE_W, self.ws.cols), self.ws.ptr.paneh)
        PaneDrag =>
            cell := win.cell_at(self.m, ev.x, ev.y)
            rows := self.ws.eds[self.ws.active].rows
            h := pointer.pane_from_row(rows, cell.row)
            self.ws.set_sizes(self.ws.ptr.treew, pointer.pane_height(h, rows))

## A word or line drag: the clicked word or line and the one under the pointer.
fn Shell.select_drag(mut self, ev app.Event)
    cell := win.cell_at(self.m, ev.x, ev.y)
    e := self.ws.eds[self.ws.active]
    p := e.position_at(cell.col - self.ws.left(), cell.row - 1) else return
    mut at := pointer.line_sel(e.lines.len(), p.line, e.lines[p.line].chars().len())
    if self.pt.drag == pointer.Drag.ByWords
        at = pointer.Sel(line: p.line, col: p.col, end_line: p.line, end_col: p.col)
        if w := e.word_around(p.line, p.col)
            at = pointer.Sel(line: w.line, col: w.col, end_line: w.end_line, end_col: w.end_col)
    self.ws.eds[self.ws.active].select_ends(pointer.extend(self.pt.anchor, at))

## The release that ends a pointer drag; a splitter's size is saved.
fn Shell.pointer_up(mut self)
    if self.pt.drag == pointer.Drag.TreeDrag or self.pt.drag == pointer.Drag.PaneDrag
        self.ws.save_sizes()
    self.pt.drag = pointer.Drag.NoDrag

## The status text as the window draws it (trimmed, the tree's columns cut).
fn Shell.status_text(self) str
    s := self.ws.render()
    srow := 1 + self.ws.eds[self.ws.active].text_rows()
    if srow >= s.text.len()
        return ""
    cs := s.text[srow].chars()
    if cs.len() <= self.ws.left()
        return ""
    cs[self.ws.left()..].join("").trim()

## A click on the status bar: the position opens Go to line, the counts the
## problems list.
fn Shell.status_click(mut self, x float)
    if self.ws.zen
        return
    at := pointer.status_at(x, win.chrome_size(self.m))
    spec := pointer.segment_spec(pointer.status_segment(self.status_text(), at))
    if spec != ""
        self.press_spec(spec)

## A right press: the menu for the place. On the text the caret moves to the
## clicked cell first, unless the click is inside the selection.
fn Shell.context_menu(mut self, ev app.Event, at pointer.Place)
    cell := win.cell_at(self.m, ev.x, ev.y)
    match at
        OnText | OnGutter =>
            e := self.ws.eds[self.ws.active]
            mut on_diag := false
            if p := e.position_at(cell.col - self.ws.left(), cell.row - 1)
                on_diag = e.diag_at(p.line, p.col) != none
                if sel_bg(e.selection(), p.line, p.col, BG) != SELECT_BG
                    self.ws.on_event(Mouse(col: cell.col, row: cell.row, button: Left, kind: Down))
            self.menu = app.Popup(id: "text", x: ev.x, y: ev.y, items: pointer.text_menu(on_diag))
        OnTree =>
            i := self.ws.tree_row_at(cell.row)
            if i < 0
                return
            self.ws.tree_sel = i
            self.ws.tree_focus = true
            mut present := List[str]()
            for name in pointer.TREE_COMMANDS
                if command_named(name) != none
                    present.push(name)
            self.menu = app.Popup(id: "tree", x: ev.x, y: ev.y, items: pointer.tree_menu(present))
        OnTabs | OnActivity | OnBar | OnMap | OnTreeEdge | OnPaneEdge | OnStatus | OnPane => return

## The host's answer to a menu (`id` is the menu: text, tab or tree): a tab
## action, Open on the tree, a key, or a palette command by name.
fn Shell.menu_pick(mut self, id str, label str)
    if label == ""
        return
    if id == "tab" and self.tab_action(label)
        return
    if id == "tree" and label == "Open"
        self.ws.activate_tree_row()
        return
    spec := pointer.menu_spec(label)
    if spec != ""
        self.press_spec(spec)
        return
    self.ws.run_named(label)

## A tab menu item on the tab it was opened on; false for another label.
fn Shell.tab_action(mut self, label str) bool
    at := self.pt.menu_tab
    if at < 0 or at >= self.ws.eds.len()
        return false
    match label
        "Close" =>
            self.ws.active = at
            self.ws.close_tab()
        "Close others" => self.ws.close_others(at, false)
        "Close to the right" => self.ws.close_others(at, true)
        "Copy path" =>
            path := self.ws.eds[at].path
            self.ws.eds[self.ws.active].clip = path
            self.sent.push(app.clipboard(path))
            self.ws.message = "copied {path}"
        "Reveal in tree" =>
            self.ws.active = at
            self.ws.run_named(label)
        _ => return false
    true

## The wheel: Ctrl (or Cmd) zooms the font, a sideways wheel or Shift
## scrolls sideways, else the lines scroll.
fn Shell.on_wheel(mut self, ev app.Event)
    if ev.ctrl or ev.meta
        z := pointer.zoom_step(ev.dy)
        if z != ""
            self.ws.zoom(z)
        return
    w := pointer.wheel(ev.dx, ev.dy, ev.shift)
    n_cols := win.wheel_lines(w.h, self.m.cw)
    if n_cols != 0
        self.side_scroll(n_cols)
    n := win.wheel_lines(w.v, self.m.ch)
    if n != 0
        self.ws.on_event(Scroll(lines: n))

## Scrolls the view `n` columns sideways while the visible lines are wider.
fn Shell.side_scroll(mut self, n int)
    e := self.ws.eds[self.ws.active]
    mut longest := 0
    for r in 0..e.text_rows()
        l := e.row_line(r)
        if l < 0
            break
        longest = longest.max(e.lines[l].chars().len())
    view := (e.cols - e.gutter_width()).max(1)
    self.ws.eds[self.ws.active].left = pointer.hscroll(e.left, n, longest, view)

## A move: a new cell starts a new rest and hides a shown hover.
fn Shell.pointer_move(mut self, ev app.Event)
    cell := win.cell_at(self.m, ev.x, ev.y)
    if self.pt.rest(cell.col, cell.row, time.now_ms())
        self.hide_hover()

## The pointer left the canvas: no rest, no hover.
fn Shell.pointer_leave(mut self)
    self.hide_hover()
    self.pt.rest_col = -1
    self.pt.rest_row = -1

## A key: typing holds the hover off for a second, and hides a shown one.
fn Shell.pointer_key(mut self)
    self.pt.key_at = time.now_ms()
    self.hide_hover()

## On each blink tick: once the pointer has rested on the text, shows the
## diagnostic there, else (AIL files only) Ctrl-I's info for the name there,
## in the pane, remembering what the pane showed.
fn Shell.hover_tick(mut self, now int)
    if not pointer.hover_due(self.pt, now) or self.hover_x < 0.0
        return
    self.pt.fired = true
    if self.held or self.pt.drag != pointer.Drag.NoDrag or self.menu != none
        return
    if self.ws.picking or self.ws.searching or self.ws.welcome or self.ws.askbar.open
        return
    if pointer.place(self.layout(), self.hover_x, self.hover_y) != pointer.Place.OnText
        return
    cell := win.cell_at(self.m, self.hover_x, self.hover_y)
    a := self.ws.active
    e := self.ws.eds[a]
    if e.prompt != NoPrompt or e.completing or e.extra.len() > 0 or e.pane == Outline
        return
    p := e.position_at(cell.col - self.ws.left(), cell.row - 1) else return
    if d := e.diag_at(p.line, p.col)
        self.ws.eds[a].show_diag(d)
    elif e.path.ends_with(".ail") and p.col < e.lines[p.line].chars().len()
        if e.word_around(p.line, p.col) == none
            return
        self.ws.eds[a].info_at(p.line, p.col)
    else
        return
    after := self.ws.eds[a]
    if after.pane == e.pane and after.pane_text == e.pane_text
        return
    self.pt.shown = true
    self.pt.tab = a
    self.pt.prev_pane = pane_number(e.pane)
    self.pt.prev_text = e.pane_text
    self.pt.shown_text = after.pane_text

## Takes a shown hover away, giving the pane back what it showed, unless
## something else has replaced the hover since.
fn Shell.hide_hover(mut self)
    if not self.pt.shown
        return
    self.pt.shown = false
    a := self.pt.tab
    if a < 0 or a >= self.ws.eds.len()
        return
    if self.ws.eds[a].pane == Text and self.ws.eds[a].pane_text == self.pt.shown_text
        self.ws.eds[a].pane = pane_of(self.pt.prev_pane)
        self.ws.eds[a].pane_text = self.pt.prev_text

## The window's gutter mark `T` on each visible line that starts a test (a
## click there runs it), where the gutter has no other mark.
fn Shell.test_marks(self) List[win.Run]
    e := self.ws.eds[self.ws.active]
    p := self.ws.pal
    gw := e.gutter_width()
    mut out := List[win.Run]()
    for r in 0..e.text_rows()
        l := e.row_line(r)
        if l < 0
            break
        if r == 0 and e.top > 0
            continue
        if not pointer.starts_test(e.lines, l)
            continue
        if e.missed.contains(l)
            or e.folded.contains(l)
            or e.git_marks.contains(l)
            or e.impact.contains(l)
            continue
        bg := if l == e.line then p.bg_of(LINE_BG) else p.bg_of(BG)
        out.push(win.Run(
            row: r + 1,
            col: self.ws.left() + gw - 1,
            text: "T",
            fg: win.accent_for(p.bg_of(BG)),
            bg: bg,
        ))
    out

## A window event at grid cell (`c`, `r`) of the shell's layout, left button.
fn cell_event(sh Shell, kind app.EventKind, c int, r int) app.Event
    mut ev := app.event(kind)
    ev.id = "edit"
    ev.x = sh.m.x0 + c.to_float() * sh.m.cw + 1.0
    ev.y = win.row_y(sh.m, r) + 2.0
    ev.text = "left"
    ev.clicks = 1
    ev

## A shell on an 800 by 500 point canvas: 93 columns, 21 rows, 40 points of
## activity bar, cells 8 points wide.
fn sized_shell(w Workspace) Shell
    mut sh := Shell.new(w)
    mut size := app.event(Resize)
    size.id = "edit"
    size.dx = 800.0
    size.dy = 500.0
    size.cell_w = 8.0
    size.cell_h = 16.0
    sh.update(size)
    sh

@test fn double_and_triple_clicks_select_words_and_lines()
    ed := Editor.new("t.ail", "fn main()\n    print(hello_world)\n", 40, 10)
    mut sh := sized_shell(Workspace.new(ed))
    gw := sh.ws.eds[0].gutter_width()
    mut two := cell_event(sh, Down, gw + 12, 2)
    two.clicks = 2
    sh.update(two)
    sh.update(cell_event(sh, Up, gw + 12, 2))
    assert_eq(sh.ws.eds[0].selected_text(), "hello_world")
    mut three := cell_event(sh, Down, gw + 12, 2)
    three.clicks = 3
    sh.update(three)
    sh.update(cell_event(sh, Up, gw + 12, 2))
    assert_eq(sh.ws.eds[0].selected_text(), "    print(hello_world)")
    mut on_main := cell_event(sh, Down, gw + 4, 1)
    on_main.clicks = 2
    sh.update(on_main)
    assert_eq(sh.ws.eds[0].selected_text(), "main")
    sh.update(cell_event(sh, Move, gw + 12, 2))
    assert_eq(sh.ws.eds[0].selected_text(), "main()\n    print(hello_world")
    sh.update(cell_event(sh, Up, gw + 12, 2))
    assert_eq(sh.pt.drag, pointer.Drag.NoDrag)
    sh.ws.eds[0].selecting = false
    sh.ws.run_command("Select line")
    assert_eq(sh.ws.eds[0].selected_text(), "    print(hello_world)")

@needs(fs, proc) @test fn cmd_click_goes_to_the_definition()
    mut sh := sized_shell(Workspace.new(indexed([])))
    gw := sh.ws.eds[0].gutter_width()
    mut click := cell_event(sh, Down, gw + 11, 10)
    click.meta = true
    sh.update(click)
    sh.update(cell_event(sh, Up, gw + 11, 10))
    assert_eq([sh.ws.eds[0].line, sh.ws.eds[0].col], [4, 3])
    assert(not sh.held)

@test fn the_scrollbar_thumb_drags_and_the_track_pages()
    mut text := ""
    for i in 0..200
        text = "{text}line {i}\n"
    mut sh := sized_shell(Workspace.new(Editor.new("t.ail", text, 40, 10)))
    rows := sh.ws.eds[0].text_rows()
    mut down := cell_event(sh, Down, 0, 1)
    down.x = sh.m.w - 4.0
    down.y = win.row_y(sh.m, 1) + 3.0
    sh.update(down)
    assert_eq(sh.pt.drag, pointer.Drag.ThumbDrag)
    mut mv := down
    mv.kind = Move
    mv.y = win.row_y(sh.m, 1) + sh.track_h() * 0.4
    sh.update(mv)
    mid := sh.ws.eds[0].top
    assert(mid > 50 and mid < 100, "top {mid}")
    mv.y = win.row_y(sh.m, 1) + sh.track_h() * 0.6
    sh.update(mv)
    assert(sh.ws.eds[0].top > mid)
    mut up := mv
    up.kind = Up
    sh.update(up)
    assert_eq(sh.pt.drag, pointer.Drag.NoDrag)
    sh.ws.eds[0].top = 0
    mut page := down
    page.y = win.row_y(sh.m, 1) + sh.track_h() - 2.0
    sh.update(page)
    assert_eq(sh.ws.eds[0].top, rows)
    assert_eq(sh.pt.drag, pointer.Drag.NoDrag)

@test fn the_tree_and_pane_edges_drag_to_resize()
    mut sh := sized_shell(Workspace.new(Editor.new("t.ail", "fn main()\n", 40, 10)))
    sh.ws.tree_open = true
    sh.ws.resize_tabs()
    assert_eq(sh.ws.left(), TREE_W + 1)
    sh.update(cell_event(sh, Down, TREE_W, 3))
    assert_eq(sh.pt.drag, pointer.Drag.TreeDrag)
    sh.update(cell_event(sh, Move, 35, 3))
    assert_eq(sh.ws.ptr.treew, 35)
    assert_eq(sh.ws.left(), 36)
    assert_eq(sh.ws.eds[0].cols, sh.ws.cols - 36)
    sh.update(cell_event(sh, Up, 35, 3))
    assert_eq(setting(sh.ws.prefs, "treew") else "", "35")
    srow := 1 + sh.ws.eds[0].text_rows()
    mut edge := cell_event(sh, Down, 60, srow)
    edge.y = win.row_y(sh.m, srow) + 1.0
    sh.update(edge)
    assert_eq(sh.pt.drag, pointer.Drag.PaneDrag)
    sh.update(cell_event(sh, Move, 60, 12))
    assert_eq(sh.ws.eds[0].pane_rows(), sh.ws.eds[0].rows - 12)
    assert_eq(1 + sh.ws.eds[0].text_rows(), 12)
    sh.update(cell_event(sh, Up, 60, 12))
    assert_eq(setting(sh.ws.prefs, "paneh") else "", "{sh.ws.eds[0].rows - 12}")

## A warning on the `x` of line 2 of "fn main()\n    x := 1\n".
fn warned_editor() Editor
    mut ed := Editor.new("t.ail", "fn main()\n    x := 1\n", 40, 10)
    ed.diags = [Diag(
        severity: "warning",
        rule: "r.1",
        line: 2,
        col: 5,
        end_line: 2,
        end_col: 6,
        message: "unused x",
        help: "",
        fix_title: "",
        fix: [],
    )]
    ed

@test fn the_text_menu_offers_fixes_only_over_a_diagnostic()
    mut sh := sized_shell(Workspace.new(warned_editor()))
    gw := sh.ws.eds[0].gutter_width()
    mut right := cell_event(sh, Down, gw + 4, 2)
    right.text = "right"
    sh.update(right)
    pm := sh.menu else app.Popup(id: "", x: 0.0, y: 0.0, items: [])
    assert_eq(pm.id, "text")
    assert_eq(pm.items, pointer.text_menu(true))
    assert_eq([sh.ws.eds[0].line, sh.ws.eds[0].col], [1, 4])
    mut pick := app.event(Popup)
    pick.id = "text"
    pick.text = ""
    sh.update(pick)
    assert(sh.menu == none)
    mut plain := cell_event(sh, Down, gw + 1, 1)
    plain.text = "right"
    sh.update(plain)
    pm2 := sh.menu else app.Popup(id: "", x: 0.0, y: 0.0, items: [])
    assert_eq(pm2.items, pointer.text_menu(false))
    assert(not pm2.items.contains("Quick fix"))
    assert_eq([sh.ws.eds[0].line, sh.ws.eds[0].col], [0, 1])
    pick.text = "Command palette"
    sh.update(pick)
    assert(sh.ws.picking and sh.ws.commanding)

@test fn the_tab_menu_closes_the_others_and_middle_click_closes()
    mut ws := Workspace.new(Editor.new("a.ail", "a\n", 40, 10))
    ws.eds.push(Editor.new("b.ail", "b\n", 40, 10))
    ws.eds.push(Editor.new("c.ail", "c\n", 40, 10))
    ws.eds.push(Editor.new("d.ail", "d\n", 40, 10))
    mut sh := sized_shell(ws)
    size := win.chrome_size(sh.m)
    second := win.tab_x(sh.tabs(), size, 1) + 4.0
    mut right := app.event(Down)
    right.id = "edit"
    right.x = second
    right.y = 4.0
    right.text = "right"
    sh.update(right)
    pm := sh.menu else app.Popup(id: "", x: 0.0, y: 0.0, items: [])
    assert_eq(pm.id, "tab")
    assert(pm.items.contains("Close others"))
    mut pick := app.event(Popup)
    pick.id = "tab"
    pick.text = "Close to the right"
    sh.update(pick)
    assert_eq(sh.ws.eds.len(), 2)
    assert_eq(sh.ws.eds[sh.ws.active].path, "b.ail")
    mut middle := right
    middle.x = win.tab_x(sh.tabs(), size, 0) + 4.0
    middle.text = "other"
    sh.update(middle)
    assert_eq(sh.ws.eds.len(), 1)
    assert_eq(sh.ws.eds[0].path, "b.ail")

@test fn gutter_clicks_fold_and_show_diagnostics()
    ed := Editor.new("t.ail", "fn main()\n    x := 1\n    y := 2\nfn b()\n    z\n", 40, 10)
    mut sh := sized_shell(Workspace.new(ed))
    sh.update(cell_event(sh, Down, 1, 1))
    sh.update(cell_event(sh, Up, 1, 1))
    assert(sh.ws.eds[0].folded.contains(0))
    assert_eq(sh.ws.eds[0].row_line(1), 3)
    sh.update(cell_event(sh, Down, 1, 1))
    sh.update(cell_event(sh, Up, 1, 1))
    assert(not sh.ws.eds[0].folded.contains(0))
    mut warned := sized_shell(Workspace.new(warned_editor()))
    warned.update(cell_event(warned, Down, 1, 2))
    assert_eq(warned.ws.eds[0].pane, Pane.Text)
    assert_eq(warned.ws.eds[0].pane_text[0], "warning[r.1] unused x")

@test fn resting_on_a_diagnostic_shows_it_until_the_pointer_moves()
    mut sh := sized_shell(Workspace.new(warned_editor()))
    gw := sh.ws.eds[0].gutter_width()
    sh.update(cell_event(sh, Move, gw + 4, 2))
    sh.hover_tick(time.now_ms() + 2000)
    assert_eq(sh.ws.eds[0].pane, Pane.Text)
    assert_eq(sh.ws.eds[0].pane_text[0], "warning[r.1] unused x")
    assert(sh.pt.fired)
    sh.update(cell_event(sh, Move, gw + 7, 2))
    assert_eq(sh.ws.eds[0].pane, Pane.Diags)
    assert_eq(sh.ws.eds[0].pane_text.len(), 0)

@test fn status_clicks_open_go_to_line_and_the_wheel_scrolls_and_zooms()
    long := "x".repeat(200)
    mut sh := sized_shell(Workspace.new(Editor.new("t.txt", "{long}\nb\n", 40, 10)))
    srow := 1 + sh.ws.eds[0].text_rows()
    at := sh.status_text().chars().index_of('L') else 0
    mut click := cell_event(sh, Down, 0, srow)
    click.x = pointer.STATUS_X + (at.to_float() + 0.5) * win.chrome_size(sh.m) * 0.56
    click.y = win.row_y(sh.m, srow) + sh.m.ch / 2.0
    sh.update(click)
    assert_eq(sh.ws.eds[0].prompt, Prompt.LineNumber)
    sh.update(key_ev_escape())
    mut side := app.event(Scroll)
    side.id = "edit"
    side.dx = sh.m.cw * 5.0
    sh.update(side)
    assert_eq(sh.ws.eds[0].left, 5)
    mut shifted := app.event(Scroll)
    shifted.id = "edit"
    shifted.dy = sh.m.cw * 2.0
    shifted.shift = true
    sh.update(shifted)
    assert_eq(sh.ws.eds[0].left, 7)
    mut zoom := app.event(Scroll)
    zoom.id = "edit"
    zoom.dy = -10.0
    zoom.ctrl = true
    sh.update(zoom)
    assert_eq(sh.ws.font, 24)

## Escape as the host sends it.
fn key_ev_escape() app.Event
    mut k := app.key("escape")
    k.id = "edit"
    k

# ---- Window front end (std.app, S1) --------------------------------------

## The `std.app` window: the workspace drawn on a canvas (`window/`), pixel
## events turned back into the cell events the workspace takes. The cell
## `Screen` and every `--print` test are unchanged.
struct Shell
    ws Workspace
    m win.Metrics
    pw float
    ph float
    cellw float
    cellh float
    held bool
    menu app.Popup?
    sent List[str]
    ready bool
    ## The pointer over the canvas (-1 when it left), and a tab being dragged.
    hover_x float
    hover_y float
    tab_drag int
    tab_drop int
    ## The caret's blink (530 ms on, 530 ms off): visible now, and solid until
    ## this time (ms) after any key.
    caret_on bool
    solid_until int
    ## Drags, context menus and the hover (features/pointer, parity P7).
    pt pointer.Gesture

fn Shell.new(w Workspace) Shell
    Shell(
        ws: w,
        m: win.metrics(1000.0, 700.0, 8.0, 16.0, 13.0, false, win.ACT_W),
        pw: 1000.0,
        ph: 700.0,
        cellw: 8.0,
        cellh: 16.0,
        held: false,
        menu: none,
        sent: [],
        ready: false,
        hover_x: -1.0,
        hover_y: -1.0,
        tab_drag: -1,
        tab_drop: -1,
        caret_on: true,
        solid_until: 0,
        pt: pointer.gesture(),
    )

## The code's font size in points: the workspace's cell height, scaled.
fn Shell.size(self) float
    self.ws.font.to_float() * 0.65

## The grid's left edge: the activity bar, hidden in zen mode.
fn Shell.x0(self) float
    if self.ws.zen
        return 0.0
    win.ACT_W

## Lays the grid out for the canvas and tells the workspace its new size.
fn Shell.relayout(mut self)
    next := win.metrics(
        self.pw,
        self.ph,
        self.cellw,
        self.cellh,
        self.size(),
        self.ws.minimap,
        self.x0(),
    )
    if not self.ready or next.cols != self.m.cols or next.rows != self.m.rows
        self.ws.on_event(Resize(cols: next.cols, rows: next.rows))
    self.m = next
    self.ready = true

## The tabs of the strip.
fn Shell.tabs(self) List[win.Tab]
    mut out := List[win.Tab]()
    for i in 0..self.ws.eds.len()
        e := self.ws.eds[i]
        out.push(win.Tab(
            name: base_name(e.path),
            active: i == self.ws.active,
            dirty: e.dirty,
            errors: e.diag_count("error"),
            warnings: e.diag_count("warning"),
        ))
    out

## Everything one frame shows, from the workspace's `Screen`.
fn Shell.frame(self) win.Frame
    s := self.ws.render()
    e := self.ws.eds[self.ws.active]
    p := self.ws.pal
    colors := win.Colors(
        bg: p.bg_of(BG),
        fg: p.fg_of(FG),
        pane_bg: p.bg_of(PANE_BG),
        line_bg: p.bg_of(LINE_BG),
        status_bg: p.bg_of(STATUS_BG),
        status_fg: p.fg_of(STATUS_FG),
        gutter_fg: p.fg_of(GUTTER_FG),
        select_bg: p.bg_of(SELECT_BG),
        error_fg: p.fg_of(ERROR_FG),
        warn_fg: p.fg_of(WARN_FG),
        guide_fg: GUIDE_FG,
        accent: win.accent_for(p.bg_of(BG)),
        border: win.mix(p.fg_of(FG), p.bg_of(BG), 0.12),
        muted: win.mix(p.fg_of(FG), p.bg_of(BG), 0.55),
    )
    mut runs := [
        win.Run(row: sp.row, col: sp.col, text: sp.text, fg: p.fg_of(sp.fg), bg: p.bg_of(sp.bg))
        for sp in s.spans
    ]
    runs.extend(self.test_marks())
    srow := 1 + e.text_rows()
    mut status := ""
    if srow < s.text.len()
        cs := s.text[srow].chars()
        if cs.len() > self.ws.left()
            status = cs[self.ws.left()..].join("")
    mut marks := List[win.Mark]()
    for d in e.diags
        marks.push(win.Mark(line: (d.line - 1).max(0), kind: d.severity))
    mut lens := List[int]()
    if self.ws.minimap
        for l in e.lines
            lens.push(l.chars().len())
    mut hover_tab := -1
    mut hover_close := false
    if self.hover_x >= 0.0 and self.hover_y >= 0.0 and self.hover_y < self.m.tab_h
        hit := win.tab_hit(self.tabs(), win.chrome_size(self.m), self.hover_x)
        hover_tab = hit.index
        hover_close = hit.close
    win.Frame(
        colors: colors,
        runs: runs,
        tabs: self.tabs(),
        cols: s.cols,
        rows: s.rows,
        status_row: srow,
        status: status,
        cursor_col: s.cursor_col,
        cursor_row: s.cursor_row,
        left: self.ws.left(),
        bar_from: 1,
        bar_to: srow,
        bar: win.Bar(top: e.top, total: e.lines.len(), visible: e.text_rows(), marks: marks),
        minimap: self.ws.minimap,
        zen: self.ws.zen,
        lens: lens,
        hover_tab: hover_tab,
        hover_close: hover_close,
        drag_tab: self.tab_drag,
        drop_tab: self.tab_drop,
        hover_act: win.activity_hit(self.m, self.hover_x, self.hover_y),
        caret_on: self.caret_on,
    )

## A key as the workspace takes it.
fn Shell.press_key(mut self, spec win.KeySpec)
    before := self.ws.eds[self.ws.active].clip
    self.ws.on_event(Key(
        key: ui.key_code(spec.key),
        ctrl: spec.ctrl,
        alt: spec.alt,
        shift: spec.shift,
    ))
    after := self.ws.eds[self.ws.active].clip
    if after != before
        self.sent.push(app.clipboard(after))

## A press on the canvas, by the place under it (features/pointer): the tab
## strip, the scrollbar or minimap, a splitter, the status bar, the gutter,
## the text, or a right-click menu for that place.
fn Shell.pointer_down(mut self, ev app.Event)
    cell := win.cell_at(self.m, ev.x, ev.y)
    if cell.row == 0
        self.tab_down(ev)
        return
    act := win.activity_hit(self.m, ev.x, ev.y)
    if act >= 0
        self.ws.on_event(key_event(win.ACTIVITY_KEYS[act]))
        return
    self.hide_hover()
    at := pointer.place(self.layout(), ev.x, ev.y)
    if ev.text == "right"
        self.context_menu(ev, at)
        return
    if ev.text != "left"
        return
    match at
        OnTabs | OnActivity => return
        OnBar => self.bar_down(ev.y)
        OnMap =>
            self.pt.drag = pointer.Drag.MapDrag
            self.map_to(ev.y)
        OnTreeEdge => self.pt.drag = pointer.Drag.TreeDrag
        OnPaneEdge => self.pt.drag = pointer.Drag.PaneDrag
        OnStatus => self.status_click(ev.x)
        OnGutter => self.gutter_click(cell)
        OnTree | OnPane =>
            self.held = true
            self.ws.on_event(Mouse(col: cell.col, row: cell.row, button: Left, kind: Down))
        OnText => self.text_down(ev, cell)

## The caret after a blink tick: it flips, except within 500 ms of a key.
fn Shell.caret_on_now(self) bool
    if time.now_ms() < self.solid_until
        return true
    not self.caret_on

## Posts a blink tick every 530 ms until `stop` holds 1.
fn blinker(inbox app.Inbox, stop Mutex[int])
    while true
        time.sleep_ms(530)
        if stop.get() == 1
            break
        inbox.post(app.external("blink", ""))

impl app.App for Shell
    fn attach(mut self, inbox app.Inbox)
        self.ws.jobs.attach(inbox)

    fn update(mut self, ev app.Event)
        match ev.kind
            Resize =>
                if ev.id == "edit"
                    self.pw = ev.dx
                    self.ph = ev.dy
                    self.cellw = ev.cell_w
                    self.cellh = ev.cell_h
            External =>
                if ev.id == "blink"
                    self.caret_on = self.caret_on_now()
                    self.hover_tick(time.now_ms())
                elif ev.id == jb.SOURCE
                    self.ws.job_event(ev.text)
            Key =>
                self.pointer_key()
                self.solid_until = time.now_ms() + 500
                self.caret_on = true
                self.press_key(win.key_spec(ev.text, ev.ctrl, ev.meta, ev.alt, ev.shift))
            Paste =>
                if self.ws.picking or self.ws.searching
                    for c in ev.text.chars()
                        self.ws.on_event(press("{c}"))
                else
                    self.ws.eds[self.ws.active].clip = ev.text
                    self.ws.on_event(key_event("ctrl+v"))
            Down =>
                self.pointer_down(ev)
            Move =>
                self.hover_x = ev.x
                self.hover_y = ev.y
                self.pointer_move(ev)
                if self.tab_drag >= 0
                    self.tab_drop = win.tab_drop(self.tabs(), win.chrome_size(self.m), ev.x)
                elif self.pt.drag != pointer.Drag.NoDrag
                    self.pointer_drag(ev)
                elif self.held
                    cell := win.cell_at(self.m, ev.x, ev.y)
                    self.ws.on_event(Mouse(col: cell.col, row: cell.row, button: Left, kind: Drag))
            Leave =>
                self.hover_x = -1.0
                self.hover_y = -1.0
                self.pointer_leave()
            Up =>
                if self.tab_drag >= 0
                    if self.tab_drop >= 0 and self.tab_drop != self.tab_drag
                        self.ws.move_tab(self.tab_drag, self.tab_drop)
                    self.tab_drag = -1
                    self.tab_drop = -1
                elif self.pt.drag != pointer.Drag.NoDrag
                    self.pointer_up()
                elif self.held
                    self.held = false
                    cell := win.cell_at(self.m, ev.x, ev.y)
                    self.ws.on_event(Mouse(col: cell.col, row: cell.row, button: Left, kind: Up))
            Scroll => self.on_wheel(ev)
            Popup =>
                self.menu = none
                self.menu_pick(ev.id, ev.text)
            Close =>
                self.ws.on_event(Close)
            Start | Press | Edit | Submit | Toggle | Click | KeyUp | Appearance | Picked | PickError | Pad | Vsync | Measured | Exited | Other => self.held = self.held
        self.ws.idle(time.now_ms())
        self.relayout()
        if self.ws.quit
            if self.ws.remember
                self.ws.save_session()
            io.exit(0)

    fn view(self) app.Node
        app.canvas("edit", 0.0, 0.0, win.canvas_ops(self.frame(), self.m))

    fn title(self) str
        e := self.ws.eds[self.ws.active]
        "{base_name(e.path)}{if e.dirty then " *" else ""} - edit"

    fn popup(self) app.Popup?
        self.menu

    fn lines(mut self) List[str]
        out := self.sent
        self.sent = []
        out

    fn edge(self) bool
        false

    fn hover(self) bool
        true

@test fn the_app_shell_draws_and_edits_without_a_window()
    mut sh := Shell.new(Workspace.new(Editor.new("t.ail", "fn main()\n", 100, 32)))
    mut size := app.event(Resize)
    size.id = "edit"
    size.dx = 800.0
    size.dy = 500.0
    size.cell_w = 8.0
    size.cell_h = 16.0
    mut kp := app.key("x")
    kp.id = "edit"
    shots := app.script(mut sh, [size, kp, kp])
    assert(shots[2].contains("canvas #edit"))
    assert_eq(sh.ws.eds[0].lines[0], "xxfn main()")
    assert(sh.ws.eds[0].dirty)
    assert_eq(sh.ws.cols, sh.m.cols)
    assert_eq(sh.title(), "t.ail * - edit")
    mut cp := app.key("c")
    cp.meta = true
    sh.update(cp)
    assert_eq(sh.lines().len(), 0)

## What both windows do first (S10): remember settings, take the font
## (`--font`, else the saved one), reopen the last tabs unless starting on
## the welcome screen, and show that screen when asked or when no file was given.
fn Workspace.start_up(mut self, flags List[str])
    self.font = font_flag(flags)
    self.remember = true
    self.load_prefs()
    if not flags.contains("--font")
        self.font = self.value_of("font").to_int() else 20
    if self.value_of("restore") == "on" and not flags.contains("--start")
        self.restore_session()
    self.welcome = flags.contains("--welcome")
    if flags.contains("--start") and self.value_of("welcome") == "on"
        self.welcome = true

## Opens the `std.app` window, or prints one screen when there is no host.
fn app_main(mut ed Editor, flags List[str])
    ed.index()
    mut ws := Workspace.new(ed)
    ws.start_up(flags)
    mut name := saved_theme()
    at := flags.index_of("--theme") else -1
    if at >= 0 and at + 1 < flags.len()
        name = flags[at + 1]
    if not ws.set_theme(name)
        ws.message = "no theme `{name}`: try {themes.NAMES.join(", ")}"
    mut sh := Shell.new(ws)
    host := app.host_path() else err
        print("edit: no window ({err.kind}: {err.message}); printing the screen instead")
        print_screen(ed, flags)
        return
    inbox := app.new_inbox()
    stop := Mutex(0)
    reqs := Channel[jb.Request](16)
    sh.ws.jobs.serve_with(reqs)
    g := TaskGroup()
    g.add(spawn blinker(inbox, stop))
    g.add(spawn jb.serve(reqs))
    app.run_with(mut sh, host, [], inbox) else err
        print("edit: no window ({err.kind}: {err.message}); printing the screen instead")
        stop.set(1)
        sh.ws.jobs.cancel_all(time.now_ms())
        reqs.close()
        print_screen(ed, flags)
        return
    stop.set(1)
    sh.ws.jobs.cancel_all(time.now_ms())
    reqs.close()

## Opens the window, or prints one screen when there's no display.
fn window_main(mut ed Editor, flags List[str])
    ed.index()
    mut ws := Workspace.new(ed)
    ws.start_up(flags)
    mut name := saved_theme()
    at := flags.index_of("--theme") else -1
    if at >= 0 and at + 1 < flags.len()
        name = flags[at + 1]
    if not ws.set_theme(name)
        ws.message = "no theme `{name}`: try {themes.NAMES.join(", ")}"
    ws.window() else err
        print("edit: no window ({err.kind}: {err.message}); printing the screen instead")
        print_screen(ed, flags)

## `--font N`: the font size to start with; 20 when absent or not a number.
fn font_flag(flags List[str]) int
    at := flags.index_of("--font") else return 20
    if at + 1 >= flags.len()
        return 20
    flags[at + 1].to_int() else 20

## `--print`: runs the flags in order, then prints the screen as text, so
## an agent or a test can drive the editor without a window:
## `--check`, `--outline`, `--explain`; `--at=LINE:COL` (1-based) moves the
## cursor; `--type=TEXT` types; `--key=SPEC` presses a key such as `f2`,
## `enter`, `ctrl+space` or `shift+f5` (`ctrl+`, `alt+`, `shift+`
## prefixes); `--idle` acts as if the window had waited a second. Keys go through the workspace, as in the window.
fn print_screen(ed Editor, flags List[str])
    mut ws := Workspace.new(ed)
    for f in flags
        if f == "--check"
            ws.eds[ws.active].run(Check)
        elif f == "--outline"
            ws.eds[ws.active].run(Outline)
        elif f == "--explain"
            ws.eds[ws.active].run(Explain)
        elif at := f.strip_prefix("--at=")
            parts := at.split(":")
            mut e := ws.eds[ws.active]
            e.line = ((parts[0].to_int() else 1) - 1).max(0).min(e.lines.len() - 1)
            e.set_col(((parts[parts.len() - 1].to_int() else 1) - 1).max(0).min(e.cur().len()))
            e.scroll()
            ws.eds[ws.active] = e
        elif t := f.strip_prefix("--type=")
            for c in t.chars()
                ws.on_event(press("{c}"))
        elif spec := f.strip_prefix("--key=")
            ws.on_event(key_event(spec))
        elif f == "--idle"
            ws.idle(time.now_ms() + 1000)
        elif f == "--welcome"
            ws.load_prefs()
            ws.welcome = true
        elif f == "--git"
            ws.gitmarks = true
            ws.refresh_git()
        elif f == "--task-json"
            print(ws.task_json())
            return
    if flags.contains("--json")
        print(ws.panel_json())
        return
    shown := ws.render()
    if flags.contains("--screen")
        runs := [
            widgets.Run(col: sp.col, row: sp.row, text: sp.text, fg: sp.fg, bg: sp.bg, bold: false)
            for sp in shown.spans
        ]
        print(
            scells
                .of_cells(shown.cols, shown.rows, runs, shown.cursor_col, shown.cursor_row)
                .describe(0.0, 0.0, shown.cols.to_float(), shown.rows.to_float(), 3000),
        )
        return
    for row in shown.text
        print(row)

## `--bench`: the time to render one screen, averaged over 20 renders at
## the middle of the buffer.
fn bench(mut ed Editor)
    ed.line = ed.lines.len() / 2
    ed.scroll()
    start := time.now_ms()
    mut cells := 0
    for _ in 0..20
        for sp in ed.render().spans
            cells += sp.text.len()
    ms := (time.now_ms() - start).to_float() / 20.0
    print("{ed.lines.len()} lines, {ed.cols}x{ed.rows} screen: {ms:.1} ms per render ({cells / 20} cells drawn)")
    t := time.now_ms()
    for _ in 0..20
        ed.apply(Insert("x"))
        ed.apply(Newline)
    keys_ms := (time.now_ms() - t).to_float() / 40.0
    print("{keys_ms:.1} ms per edit (insert or newline)")

fn main() !
    args := env.args()
    if args.contains("--help")
        print("usage: ail run edit.ail [--font N] [--keys] [--grid] [--welcome] [--git] [--print [--screen] [--check] [--outline] [--explain] [--at=L:C] [--type=TEXT] [--key=KEY]... [--idle] [--json]] [FILE]")
        return
    if args.contains("--keys")
        for l in key_table()
            print(l)
        return
    # With no FILE the window opens on the welcome screen (S10).
    mut path := "untitled.ail"
    mut flags := args
    if args.len() == 0
        flags = ["--start"]
    elif not args[args.len() - 1].starts_with("--")
        path = args[args.len() - 1]
        flags = args[..args.len() - 1]
    mut text := ""
    if fs.exists(path)
        text = fs.read_text(path)?
    mut ed := Editor.new(path, text, 100, 32)
    if flags.contains("--bench")
        bench(mut ed)
        return
    if flags.contains("--print")
        print_screen(ed, flags)
        return
    if flags.contains("--grid")
        window_main(mut ed, flags)
    else
        app_main(mut ed, flags)
