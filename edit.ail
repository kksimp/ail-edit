## edit: a code editor for AIL, written in AIL (ADR 0180).
##
## The core is headless: an `Editor` value, `Command`s that change it, and a
## pure `render` from the editor to a `Screen` of colored text runs. Front
## ends feed commands in and draw the screen: the `@test`s below, `--print`,
## and the window front end on `std.ui`.

use std.fs
use std.env
use std.proc
use std.regex
use std.time
use std.ui
use std.app
use std.io
use std.ui.widgets
use std.screen.cells as scells
use themes
use features.probes as probes
use features.workspace
use window as win
use features.diff as sdiff
use features.scope
use features.fold
use features.multi
use features.pairs
use features.semantic as sem
use features.tests as ttree
use features.taskpanel as tp
use features.agent
use features.ask
use features.jobs as jb
use features.pointer

# Colors, 0xRRGGBB.
BG := 0x1e1e1e
FG := 0xd4d4d4
LINE_BG := 0x2a2a2a
GUTTER_FG := 0x858585
STATUS_BG := 0x007acc
STATUS_FG := 0xffffff
## The font sizes Ctrl-+ and Ctrl-- step through: those std.ui has (std.ui.15).
FONT_SIZES := [10, 12, 13, 14, 15, 18, 20, 24, 26, 28, 30, 36, 40]
PANE_BG := 0x252526
## The file tree's width in columns (Ctrl-B).
TREE_W := 28
KEYWORD_FG := 0x569cd6
TYPE_FG := 0x4ec9b0
STRING_FG := 0xce9178
NUMBER_FG := 0xb5cea8
COMMENT_FG := 0x6a9955
ATTR_FG := 0xc586c0
OP_FG := 0xd4d4d4
ERROR_BG := 0x5a1d1d
WARN_BG := 0x4d4a1d
SELECT_BG := 0x264f78
BRACKET_BG := 0x3b514d
OCCUR_BG := 0x343a40
GUIDE_FG := 0x404040
## Bracket pair colors by depth (features/pairs).
PAIR_FGS := [0xffd700, 0xda70d6, 0x179fff]
## Colors of the semantic layer (slice S3): functions, constants, fields, variants.
FN_FG := 0xdcdcaa
CONST_FG := 0x4fc1ff
FIELD_FG := 0x9cdcfe
VARIANT_FG := 0xd7ba7d
ERROR_FG := 0xf48771
WARN_FG := 0xcca700

## The color kinds a theme can change (themes, ADR 0295). OP_FG
## is FG, so it follows "fg".
FG_KINDS := {
    "fg": FG,
    "gutter_fg": GUTTER_FG,
    "status_fg": STATUS_FG,
    "keyword": KEYWORD_FG,
    "type": TYPE_FG,
    "string": STRING_FG,
    "number": NUMBER_FG,
    "comment": COMMENT_FG,
    "attr": ATTR_FG,
    "fn": FN_FG,
    "const": CONST_FG,
    "field": FIELD_FG,
    "variant": VARIANT_FG,
    "error_fg": ERROR_FG,
    "warn_fg": WARN_FG,
}

BG_KINDS := {
    "bg": BG,
    "line_bg": LINE_BG,
    "status_bg": STATUS_BG,
    "pane_bg": PANE_BG,
    "error_bg": ERROR_BG,
    "warn_bg": WARN_BG,
    "select_bg": SELECT_BG,
    "bracket_bg": BRACKET_BG,
    "occur_bg": OCCUR_BG,
}

UNDO_LIMIT := 200
INDENT := 4

# ---- Buffer -------------------------------------------------------------

## One edit of a fix from `ail check --json`: replace the text from
## (line, col) up to, not including, (end_line, end_col). 1-based columns.
struct TextEdit
    line int
    col int
    end_line int
    end_col int
    text str

impl Ord for TextEdit

## A diagnostic from `ail check --json` (docs/design/semantic-api.md).
struct Diag
    severity str
    rule str
    line int
    col int
    end_line int
    end_col int
    message str
    help str
    fix_title str
    fix List[TextEdit]

## A declaration from `ail api --text`.
struct OutlineItem
    line int
    text str

struct Snapshot
    lines List[str]
    line int
    col int
    ## The folded header lines, so undo and redo bring folds back (S2).
    folded Set[int]

## What typing goes to while a prompt is open on the status line.
enum Prompt
    NoPrompt
    FindText
    ReplaceText
    LineNumber
    RenameTo

## A declaration from `ail api --symbols` (docs/design/semantic-api.md).
struct Symbol
    id str
    name str
    kind str
    line int
    col int
    signature str
    doc str
    ## Contracts, effects and the error set, one per line (`requires x > 0`).
    facts List[str]

## A use of a declaration: `{id, line, col}` from `ail api --symbols`.
struct SymbolRef
    id str
    line int
    col int

## One entry of the completion popup; sorted by text.
struct Completion
    text str
    detail str

impl Ord for Completion

enum Pane
    Diags
    Text
    Outline

## The whole editor state. `line` and `col` are 0-based; `col` counts
## characters. `top` and `left` scroll the view.
struct Editor
    path str
    lines List[str]
    line int
    col int
    goal int
    top int
    left int
    cols int
    rows int
    dirty bool
    message str
    quit_armed bool
    quit bool
    undo List[Snapshot]
    redo List[Snapshot]
    diags List[Diag]
    pane Pane
    pane_text List[str]
    outline List[OutlineItem]
    outline_sel int
    prompt Prompt
    input str
    selecting bool
    anchor_line int
    anchor_col int
    clip str
    query str
    regex_find bool
    symbols List[Symbol]
    refs List[SymbolRef]
    indexed bool
    completing bool
    completions List[Completion]
    locals List[Completion]
    member_of str
    rename RenamePlan
    ## Lines the tests never ran (Ctrl-Shift-C), 0-based; cleared by an edit.
    missed Set[int]
    ## Values a probe, watch or trap showed at the end of a line (0-based line
    ## to text); cleared by an edit (plan S7).
    notes Map[int, str]
    ## Lines that differ from git HEAD (Ctrl-Shift-G, S5), 0-based; cleared by an edit.
    git_marks Set[int]
    ## Lines of declarations the edit since the base revision affects (S4), 0-based; cleared by an edit.
    impact Set[int]
    ## Successful saves, so the workspace can check the other tabs.
    saves int
    ## The last tests-on-save result for the status line, or "" (ADR 0354).
    tests str
    comp_sel int
    ## Editing depth (features/): folded header lines (0-based), the carets
    ## besides the main one, and zen mode (no panes, no tree).
    folded Set[int]
    extra List[multi.Caret]
    zen bool
    ## The semantic layer (Ctrl-Shift-L): kind colors, code lens, inlay hints, pending fix preview.
    layer sem.State
    ## The bottom pane's rows the person dragged it to (parity P7), 0 for automatic.
    pane_h int

fn Editor.new(path str, text str, cols int, rows int) Editor
    mut lines := text.split("\n")
    if lines.len() > 1 and lines[lines.len() - 1] == ""
        lines.pop()
    if lines.len() == 0
        lines.push("")
    Editor(
        path: path,
        lines: lines,
        line: 0,
        col: 0,
        goal: 0,
        top: 0,
        left: 0,
        cols: cols,
        rows: rows,
        dirty: false,
        message: "",
        quit_armed: false,
        quit: false,
        undo: [],
        redo: [],
        diags: [],
        pane: Pane.Diags,
        pane_text: [],
        outline: [],
        outline_sel: 0,
        prompt: Prompt.NoPrompt,
        input: "",
        query: "",
        regex_find: false,
        symbols: [],
        refs: [],
        indexed: false,
        completing: false,
        completions: [],
        locals: [],
        member_of: "",
        rename: RenamePlan(name: "", at: [], semantic: false),
        missed: Set[int](),
        notes: Map[int, str](),
        git_marks: Set[int](),
        impact: Set[int](),
        saves: 0,
        tests: "",
        comp_sel: 0,
        folded: Set[int](),
        extra: [],
        zen: false,
        layer: sem.State.new(),
        selecting: false,
        anchor_line: 0,
        anchor_col: 0,
        clip: "",
        pane_h: 0,
    )

## The buffer as file text: lines joined with `\n`, ending with one.
fn Editor.text(self) str
    "{self.lines.join("\n")}\n"

fn Editor.cur(self) List[char]
    self.lines[self.line].chars()

fn Editor.snapshot(mut self)
    self.undo.push(Snapshot(lines: self.lines, line: self.line, col: self.col, folded: self.folded))
    if self.undo.len() > UNDO_LIMIT
        self.undo = self.undo[1..]
    self.redo = []
    self.dirty = true
    self.indexed = false
    self.diags = []
    self.missed = Set[int]()
    self.notes = Map[int, str]()
    self.git_marks = Set[int]()
    self.impact = Set[int]()

fn Editor.set_col(mut self, c int)
    self.col = c
    self.goal = c

## `xs[..from]`, then `mid`, then `xs[to..]`.
fn splice(xs List[str], from int, to int, mid List[str]) List[str]
    mut out := xs[..from]
    out.extend(mid)
    out.extend(xs[to..])
    out

## Replaces the text from (l1, c1) up to (l2, c2), all 0-based, with `s`,
## which may hold newlines, and puts the cursor at the end of the new text.
fn Editor.replace(mut self, l1 int, c1 int, l2 int, c2 int, s str)
    self.snapshot()
    self.edit(l1, c1, l2, c2, s)

## `replace` without an undo snapshot.
fn Editor.edit(mut self, l1 int, c1 int, l2 int, c2 int, s str)
    old_n := self.lines.len()
    before := self.lines[l1].slice(0, c1)
    after := self.lines[l2].slice(c2, self.lines[l2].len())
    mut parts := s.split("\n")
    end := parts.len() - 1
    mut end_col := parts[end].len()
    if end == 0
        end_col += c1
    parts[0] = "{before}{parts[0]}"
    parts[end] = "{parts[end]}{after}"
    tail := self.lines[l2 + 1..]
    self.lines = self.lines[..l1]
    self.lines.extend(parts)
    self.lines.extend(tail)
    self.line = l1 + end
    self.set_col(end_col)
    if self.folded.len() > 0 and self.lines.len() != old_n
        self.folded = fold.shift(self.folded, l2, self.lines.len() - old_n)

fn Editor.insert(mut self, s str)
    self.replace(self.line, self.col, self.line, self.col, s)

## Spaces at the start of a line.
fn indent_of(s str) int
    mut n := 0
    for c in s.chars()
        if c != ' '
            break
        n += 1
    n

BLOCK_WORDS := "fn if elif else while for par with match select unsafe struct enum trait impl error unique"

## The words just before an `if` or `match` whose value a line binds, assigns,
## returns, yields or gives to an arm, so that it opens a block there
## (expr.if.1, expr.match.1, expr.yield.2).
VALUE_LEADS := ":= = += -= *= /= %= &= |= ^= <<= >>= => return yield"

## The index of a line's own first word, past its attributes, `pub`, `defer`
## (own.defer.1) and a loop's label (expr.loop.9).
fn head_word(words List[str]) int
    n := words.len()
    mut k := 0
    while k + 1 < n
        w := words[k]
        label := w.ends_with(":") and (words[k + 1] == "for" or words[k + 1] == "while")
        if not (w.starts_with("@") or w == "pub" or w == "defer" or label)
            break
        k += 1
    k

## Whether `word` (`if` or `match`) opens a block on the line of `words`: as
## the line's own first word, or as the value of a binding, an assignment, a
## `return`, a `yield` or an arm.
fn opens_with(words List[str], word str) bool
    # `if c then a else b` is one expression (expr.if.2) and opens nothing.
    if words.contains("then")
        return false
    if words[head_word(words)] == word
        return true
    leads := VALUE_LEADS.split(" ")
    for i in 1..words.len()
        if words[i] == word and leads.contains(words[i - 1])
            return true
    false

## Whether `w` is a plain name: not a keyword, a number or other text.
fn is_name(w str) bool
    cs := w.chars()
    if cs.len() == 0 or cs[0].is_digit() or KEYWORDS.contains(w)
        return false
    for c in cs
        if not is_word(c)
            return false
    true

## Whether a line opens an indented block (lex.block.1): a declaration or a
## control-flow header, a `match` or `select` arm, an `if` or `match` value,
## or `else` and `else err` (err.else.2-3).
fn opens_block(s str) bool
    t := s.trim()
    if t == "" or t.starts_with("#")
        return false
    words := t.split(" ")
    n := words.len()
    if words.contains("then")
        return false
    # `par for` (conc.par.5), `with m as mut x` (conc.share.6), `select` (conc.select.2)
    # and `unsafe` (unsafe.block.1) open blocks; contract lines do not.
    if t.ends_with("=>") or BLOCK_WORDS.split(" ").contains(words[head_word(words)])
        return true
    if opens_with(words, "if") or opens_with(words, "match")
        return true
    # `x := f() else 0` is a whole line (err.else.6); `else err` goes on in a block.
    words[n - 1] == "else" or n >= 2 and words[n - 2] == "else" and is_name(words[n - 1])

fn Editor.newline(mut self)
    head := self.lines[self.line].slice(0, self.col)
    mut n := indent_of(head).min(self.col)
    if opens_block(head)
        n += INDENT
    self.insert("\n{" ".repeat(n)}")

fn Editor.backspace(mut self)
    if self.col > 0
        head := self.lines[self.line].slice(0, self.col)
        mut n := 1
        if head.trim() == "" and self.col % INDENT == 0
            n = INDENT
        self.replace(self.line, self.col - n, self.line, self.col, "")
    elif self.line > 0
        prev := self.lines[self.line - 1].len()
        self.replace(self.line - 1, prev, self.line, 0, "")

fn Editor.delete(mut self)
    if self.col < self.lines[self.line].len()
        self.replace(self.line, self.col, self.line, self.col + 1, "")
    elif self.line + 1 < self.lines.len()
        self.replace(self.line, self.col, self.line + 1, 0, "")

fn Editor.undo_last(mut self)
    s := self.undo.pop() else
        self.message = "nothing to undo"
        return
    self.redo.push(Snapshot(lines: self.lines, line: self.line, col: self.col, folded: self.folded))
    self.restore(s)

fn Editor.redo_last(mut self)
    s := self.redo.pop() else
        self.message = "nothing to redo"
        return
    self.undo.push(Snapshot(lines: self.lines, line: self.line, col: self.col, folded: self.folded))
    self.restore(s)

fn Editor.restore(mut self, s Snapshot)
    self.selecting = false
    self.lines = s.lines
    self.folded = s.folded
    self.extra = []
    self.line = s.line
    self.set_col(s.col)
    self.diags = []
    self.dirty = true

# ---- Selection ----------------------------------------------------------

## A stretch of the buffer from (line, col) up to, not including,
## (end_line, end_col); all 0-based.
struct Range
    line int
    col int
    end_line int
    end_col int

## The selection in buffer order, or `none` when nothing is selected.
fn Editor.selection(self) Range?
    if not self.selecting or self.anchor_line == self.line and self.anchor_col == self.col
        return none
    if self.anchor_line < self.line or self.anchor_line == self.line and self.anchor_col < self.col
        return Range(
            line: self.anchor_line,
            col: self.anchor_col,
            end_line: self.line,
            end_col: self.col,
        )
    Range(line: self.line, col: self.col, end_line: self.anchor_line, end_col: self.anchor_col)

fn Editor.selected_text(self) str
    r := self.selection() else return ""
    if r.line == r.end_line
        return self.lines[r.line].slice(r.col, r.end_col)
    mut parts := [self.lines[r.line].slice(r.col, self.lines[r.line].len())]
    for l in r.line + 1..r.end_line
        parts.push(self.lines[l])
    parts.push(self.lines[r.end_line].slice(0, r.end_col))
    parts.join("\n")

## Copies the selection to the editor's clipboard; false if there is none.
fn Editor.copy(mut self) bool
    if self.selection() == none
        self.message = "nothing selected"
        return false
    self.clip = self.selected_text()
    true

## Deletes the selection, if any, and ends selecting. True if it deleted.
fn Editor.cut_selection(mut self) bool
    r := self.selection() else
        self.selecting = false
        return false
    self.selecting = false
    self.replace(r.line, r.col, r.end_line, r.end_col, "")
    true

## The background of a selected character, else `bg`.
fn sel_bg(sel Range?, l int, c int, bg int) int
    r := sel else return bg
    if l < r.line
        or l > r.end_line
        or l == r.line and c < r.col
        or l == r.end_line and c >= r.end_col
        return bg
    SELECT_BG

# ---- Editing helpers ----------------------------------------------------

OPENERS := "([\{\""
CLOSERS := ")]}\""

fn all_digits(s str) bool
    for c in s.chars()
        if not c.is_digit()
            return false
    true

## Whether typing `t` should step over the same closer already at the cursor.
fn Editor.over_closer(self, t str) bool
    cs := self.cur()
    t.chars().len() == 1 and CLOSERS.contains(t) and self.col < cs.len() and "{cs[self.col]}" == t

## Inserts `t`, closing a bracket or quote typed before a space, a closer
## or the end of the line: `(` gives `()` with the cursor inside.
fn Editor.insert_paired(mut self, t str)
    ts := t.chars()
    if ts.len() != 1 or not OPENERS.contains(t)
        self.insert(t)
        return
    cs := self.cur()
    next_ok := self.col >= cs.len() or cs[self.col].is_space() or CLOSERS.contains(cs[self.col])
    prev_word := self.col > 0 and is_word(cs[self.col - 1])
    if not next_ok or t == "\"" and prev_word
        self.insert(t)
        return
    k := OPENERS.chars().index_of(ts[0]) else 0
    closer := CLOSERS.chars()[k]
    self.insert("{t}{closer}")
    self.set_col(self.col - 1)

## Backspace between an empty pair, `(|)`, deletes both; true if it did.
fn Editor.delete_pair(mut self) bool
    cs := self.cur()
    if self.col == 0 or self.col >= cs.len()
        return false
    i := OPENERS.chars().index_of(cs[self.col - 1]) else return false
    if CLOSERS.chars()[i] != cs[self.col]
        return false
    self.replace(self.line, self.col - 1, self.line, self.col + 1, "")
    true

## The lines a line command acts on: the selection's, else the cursor's.
fn Editor.line_span(self) Range
    if r := self.selection()
        mut end := r.end_line
        if r.end_col == 0 and end > r.line
            end -= 1
        return Range(line: r.line, col: 0, end_line: end, end_col: 0)
    Range(line: self.line, col: 0, end_line: self.line, end_col: 0)

## Comments the lines out with `# ` at their least indentation, or, when
## every non-blank one is already commented, removes the comments.
fn Editor.toggle_comment(mut self)
    span := self.line_span()
    mut ind := 1000000
    mut all_commented := true
    for l in span.line..=span.end_line
        t := self.lines[l]
        if t.trim() == ""
            continue
        ind = ind.min(indent_of(t))
        if not t.trim().starts_with("#")
            all_commented = false
    if ind == 1000000
        return
    self.snapshot()
    for l in span.line..=span.end_line
        cs := self.lines[l].chars()
        if self.lines[l].trim() == ""
            continue
        i := indent_of(self.lines[l])
        if all_commented
            mut n := 1
            if i + 1 < cs.len() and cs[i + 1] == ' '
                n = 2
            self.lines[l] = "{cs[..i].join("")}{cs[i + n..].join("")}"
        else
            self.lines[l] = "{cs[..ind].join("")}# {cs[ind..].join("")}"
    self.set_col(self.col.min(self.cur().len()))

fn Editor.duplicate_line(mut self)
    span := self.line_span()
    copy := self.lines[span.line..span.end_line + 1]
    self.snapshot()
    self.lines = splice(self.lines, span.end_line + 1, span.end_line + 1, copy)
    self.line += copy.len()
    self.selecting = false

## Moves the cursor's line (or the selected lines) up or down one line.
fn Editor.move_line(mut self, down bool)
    span := self.line_span()
    if not down and span.line == 0 or down and span.end_line + 1 >= self.lines.len()
        return
    block := self.lines[span.line..span.end_line + 1]
    self.snapshot()
    if down
        other := self.lines[span.end_line + 1]
        mut mid := [other]
        for b in block
            mid.push(b)
        self.lines = splice(self.lines, span.line, span.end_line + 2, mid)
        self.line += 1
        self.anchor_line += 1
    else
        other := self.lines[span.line - 1]
        mut mid := block
        mid.push(other)
        self.lines = splice(self.lines, span.line - 1, span.end_line + 1, mid)
        self.line -= 1
        self.anchor_line -= 1

## The word under the cursor when it is worth marking elsewhere: two or
## more characters, not a keyword or a number; else "".
fn Editor.word_here(self) str
    w := self.word_at() else return ""
    text := self.lines[self.line].slice(w.col, w.end_col)
    if text.len() < 2 or KEYWORDS.contains(text) or text.chars()[0].is_digit()
        return ""
    text

## For each character of `cs`, whether it is in a whole-word occurrence
## of `word`.
fn word_marks(cs List[char], word str) List[bool]
    mut out := List[bool]()
    for _ in cs
        out.push(false)
    if word == ""
        return out
    q := word.chars()
    mut i := 0
    while i < cs.len()
        c := find_in(cs, q, i) else break
        e := c + q.len()
        if (c == 0 or not is_word(cs[c - 1])) and (e >= cs.len() or not is_word(cs[e]))
            for k in c..e
                out[k] = true
        i = c + 1
    out

## After typing, a line that now reads `else` or `elif` moves back one level
## to line up with its `if`, also an `if` that is a value or deferred (lex.block.1).
fn Editor.dedent_else(mut self)
    t := self.lines[self.line].trim()
    if t != "else" and t != "elif"
        return
    ind := indent_of(self.lines[self.line])
    if ind < INDENT
        return
    mut l := self.line - 1
    while l >= 0 and (self.lines[l].trim() == "" or indent_of(self.lines[l]) >= ind)
        l -= 1
    if l < 0 or indent_of(self.lines[l]) != ind - INDENT
        return
    head := self.lines[l].trim()
    if head.starts_with("elif ") or opens_with(head.split(" "), "if")
        c := self.col
        self.edit(self.line, 0, self.line, INDENT, "")
        self.set_col(c - INDENT)

## The bracket matching the one at or just before the cursor, as a
## position, searching at most 500 lines away.
fn Editor.bracket_match(self) Range?
    cs := self.cur()
    mut c := self.col
    if c >= cs.len() or not "()[]\{}".contains(cs[c])
        c -= 1
    if c < 0 or c >= cs.len()
        return none
    ch := cs[c]
    brackets := "()[]\{}".chars()
    i := brackets.index_of(ch) else return none
    other := brackets[i + 1 - 2 * (i % 2)]
    mut step := 1
    if i % 2 == 1
        step = -1
    mut depth := 0
    mut l := self.line
    mut k := c
    mut row := cs
    while l >= 0 and l < self.lines.len() and (l - self.line).abs() <= 500
        while k >= 0 and k < row.len()
            if row[k] == ch
                depth += 1
            elif row[k] == other
                depth -= 1
                if depth == 0
                    return Range(line: self.line, col: c, end_line: l, end_col: k)
            k += step
        l += step
        if l < 0 or l >= self.lines.len()
            break
        row = self.lines[l].chars()
        if step == 1
            k = 0
        else
            k = row.len() - 1
    none

# ---- Code intelligence: `ail api`, `ail fmt` --------------------------

struct ApiIndex
    symbols List[Symbol]
    refs List[SymbolRef]

## Every declaration (nested ones too) and every reference in
## `ail api --symbols` output.
## What a declaration's `ail api` entry adds to its signature: contracts,
## effects (capabilities included) and the error set (err.api.1).
fn facts_of(it Json) List[str]
    mut out := List[str]()
    for key in ["requires", "ensures"]
        for c in jarr(it, key)
            out.push("{key} {jtext(c)}")
    mut effects := List[str]()
    for e in jarr(it, "effects")
        effects.push(jtext(e))
    if effects.len() > 0
        out.push("effects: {effects.join(", ")}")
    mut errs := List[str]()
    for e in jarr(it, "fails_with")
        errs.push(jtext(e))
    if errs.len() > 0
        out.push("fails with {errs.join(" | ")}")
    out

fn parse_api(text str) ApiIndex
    mut syms := List[Symbol]()
    mut refs := List[SymbolRef]()
    j := parse_json(text.trim()) else return ApiIndex(symbols: syms, refs: refs)
    mut pending := jarr(j, "items")
    while pending.len() > 0
        it := pending.pop() else break
        syms.push(Symbol(
            id: jstr(it, "id"),
            name: jstr(it, "name"),
            kind: jstr(it, "kind"),
            line: jint(it, "line"),
            col: jint(it, "col"),
            signature: jstr(it, "signature"),
            doc: jstr(it, "doc"),
            facts: facts_of(it),
        ))
        for key in ["fields", "variants", "methods"]
            for sub in jarr(it, key)
                pending.push(sub)
    for r in jarr(j, "references")
        refs.push(SymbolRef(id: jstr(r, "id"), line: jint(r, "line"), col: jint(r, "col")))
    ApiIndex(symbols: syms, refs: refs)

## Refreshes `symbols` and `refs` from `ail api --symbols` unless they are
## current. A program with errors has no outline (api.out.5): the last good
## index is kept, so its positions may be a little out of date.
fn Editor.index(mut self)
    if self.indexed
        return
    r := self.ail_on_buffer(["api", "--symbols"]) else return
    if r.status == 0
        api := parse_api(r.out)
        self.symbols = api.symbols
        self.refs = api.refs
    self.indexed = true

## The word under (or just before) the cursor: its start and end columns.
fn Editor.word_at(self) Range?
    self.word_around(self.line, self.col)

## The word under (or just before) column `c` of line `l`.
fn Editor.word_around(self, l int, c int) Range?
    cs := self.lines[l].chars()
    mut a := c.min(cs.len())
    while a > 0 and is_word(cs[a - 1])
        a -= 1
    mut b := c.min(cs.len())
    while b < cs.len() and is_word(cs[b])
        b += 1
    if a == b
        return none
    Range(line: l, col: a, end_line: l, end_col: b)

fn Editor.symbol(self, id str) Symbol?
    for sym in self.symbols
        if sym.id == id
            return sym
    none

## The declaration the word under the cursor names: through a reference at
## the cursor, a declaration at the cursor, or else the first declaration
## with that name.
fn Editor.symbol_here(self) Symbol?
    w := self.word_at() else return none
    for r in self.refs
        if r.line - 1 == self.line and r.col - 1 == w.col
            if sym := self.symbol(r.id)
                return sym
    name := self.cur()[w.col..w.end_col].join("")
    mut by_name := List[Symbol]()
    for sym in self.symbols
        if sym.line - 1 == self.line and sym.col - 1 == w.col
            return sym
        if sym.name == name
            by_name.push(sym)
    if by_name.len() > 0
        return by_name[0]
    none

fn Editor.go_to_definition(mut self)
    sym := self.symbol_here() else
        self.message = "no declaration found here"
        return
    self.selecting = false
    self.line = (sym.line - 1).max(0).min(self.lines.len() - 1)
    self.set_col((sym.col - 1).max(0).min(self.cur().len()))
    self.message = sym.signature

fn Editor.hover(mut self)
    sym := self.symbol_here() else
        self.message = "nothing known about this name"
        return
    self.pane_text = [sym.signature]
    if sym.doc != ""
        for d in sym.doc.split("\n")
            self.pane_text.push("## {d}")
    self.pane_text.push("{sym.kind} {sym.id}, line {sym.line}")
    self.pane = Text
    self.message = "Esc closes"

## Formats the buffer with `ail fmt`, keeping the cursor on its line. A
## program with errors isn't formatted (fmt.safe).
fn Editor.format(mut self) bool
    r := self.ail_on_buffer(["fmt", "--stdout"]) else return false
    if r.status != 0
        self.message = "not formatted: fix the errors first (Ctrl-K)"
        return false
    if r.out == self.text()
        return true
    self.snapshot()
    mut new := r.out.split("\n")
    if new.len() > 1 and new[new.len() - 1] == ""
        new.pop()
    self.lines = new
    self.line = self.line.min(self.lines.len() - 1)
    self.set_col(self.col.min(self.cur().len()))
    self.message = "formatted"
    true

## Names to complete the word before the cursor: after a `.`, the fields,
## variants and methods the file declares and the words that follow a `.`
## in the buffer; otherwise keywords, the file's declarations and the words
## in the buffer. Sorted, at most 50.
fn Editor.candidates(self) List[Completion]
    cs := self.cur()
    mut a := self.col
    while a > 0 and is_word(cs[a - 1])
        a -= 1
    prefix := cs[a..self.col].join("")
    member := a > 0 and cs[a - 1] == '.'
    mut seen := Set[str]()
    seen.add(prefix)
    mut out := List[Completion]()
    if not member
        for c in self.locals
            if c.text.starts_with(prefix) and seen.add(c.text)
                out.push(c)
    for sym in self.symbols
        nested := sym.kind == "field" or sym.kind == "variant" or sym.kind == "method"
        owned := self.member_of == "" or sym.id.starts_with("{sym.kind}:{self.member_of}.")
        if nested == member and owned and sym.name.starts_with(prefix) and seen.add(sym.name)
            out.push(Completion(text: sym.name, detail: sym.signature))
    if not member
        for k in KEYWORDS.sorted()
            if k.starts_with(prefix) and seen.add(k)
                out.push(Completion(text: k, detail: "keyword"))
    for l in self.lines
        ls := l.chars()
        mut i := 0
        while i < ls.len()
            if not is_word(ls[i]) or ls[i].is_digit()
                i += 1
                continue
            mut j := i
            while j < ls.len() and is_word(ls[j])
                j += 1
            if j - i >= 3
                and j - i > prefix.chars().len()
                and (not member or i > 0 and ls[i - 1] == '.')
                w := ls[i..j].join("")
                if w.starts_with(prefix) and seen.add(w)
                    out.push(Completion(text: w, detail: ""))
            i = j
    # The locals come first, then everything else by name.
    mut sorted := List[Completion]()
    mut rest := List[Completion]()
    for c in out
        if self.locals.contains(c)
            sorted.push(c)
        else
            rest.push(c)
    sorted.extend(rest.sorted())
    sorted[..sorted.len().min(50)]

## After a `.`, opens the completion popup when the index knows members.
fn Editor.auto_complete_members(mut self)
    cs := self.cur()
    if self.symbols.len() == 0
        or self.col < 2
        or not is_word(cs[self.col - 2])
        or cs[self.col - 2].is_digit()
        return
    self.open_completion()
    if self.completing
        self.message = ""

## Shows the signature popup for the call the cursor is inside: after a
## `(`, while typing its arguments, and on Ctrl-Shift-Space. It walks back
## to the call's unmatched `(`, finds the function or method named before
## it in the `--symbols` index, and marks the current argument; the rows add
## the contracts, effects and error set from the same index entry. Closed
## when the cursor leaves the call.
fn Editor.signature_help(mut self)
    self.layer.sig = sem.View(rows: [], from: 0, to: 0)
    cs := self.cur()
    call := sem.call_at(cs, self.col)
    if call.open < 0
        return
    mut b := call.open
    while b > 0 and cs[b - 1] == ' '
        b -= 1
    mut a := b
    while a > 0 and is_word(cs[a - 1])
        a -= 1
    if a == b
        return
    name := cs[a..b].join("")
    for sym in self.symbols
        if sym.name == name and (sym.kind == "fn" or sym.kind == "method")
            self.layer.sig = sem.sig_view(
                sym.signature,
                sym.facts,
                call.arg,
                a > 0 and cs[a - 1] == '.',
            )
            return

fn Editor.open_completion(mut self)
    self.completions = self.candidates()
    self.comp_sel = 0
    self.completing = self.completions.len() > 0
    if not self.completing
        self.message = "no completions"

## Keys while the completion popup is open: Up and Down choose, Enter or
## Tab accepts, word characters and Backspace edit the word and refilter,
## anything else closes it. True if `cmd` was used here.
fn Editor.complete_key(mut self, cmd Command) bool
    if cmd == Go(Up)
        self.comp_sel = (self.comp_sel - 1).max(0)
        return true
    if cmd == Go(Down)
        self.comp_sel = (self.comp_sel + 1).min(self.completions.len() - 1)
        return true
    if cmd == Newline or cmd == Tab
        self.accept_completion()
        return true
    if cmd == Escape
        self.completing = false
        return true
    if cmd == Backspace
        self.backspace()
        self.open_completion()
        return true
    if t := typed_word(cmd)
        self.insert(t)
        self.open_completion()
        return true
    self.completing = false
    false

## The text of an `Insert` of word characters, else `none`.
fn typed_word(cmd Command) str?
    match cmd
        Insert(t) =>
            for c in t.chars()
                if not is_word(c)
                    return none
            t
        Newline | Tab | Backspace | Delete | Go(_) | Select(_) | SelectAll | Copy | Cut => none
        Paste | Undo | Redo | Find | FindNext | Fix | Escape | Quit | Resize(_, _) => none
        Replace | ReplaceAll | GoToLine | ToggleComment | DuplicateLine | MoveLine(_) | Depth(_) => none
        Complete | GoToDefinition | Hover | Format | Rename | Save | Check | Explain | Outline | ToggleRegex => none

fn Editor.accept_completion(mut self)
    self.completing = false
    if self.comp_sel >= self.completions.len()
        return
    cs := self.cur()
    mut a := self.col
    while a > 0 and is_word(cs[a - 1])
        a -= 1
    self.replace(self.line, a, self.line, self.col, self.completions[self.comp_sel].text)

# ---- Position queries: `ail api --locals/--type/--refs` (api.loc, api.type, api.refs)

## Runs `ail api MODE FILE LINE COL` on `text` (the buffer, maybe with the
## word being typed taken out) and parses its one JSON object; `none` when
## there's nothing at the position or the program doesn't parse.
fn Editor.api_at(mut self, mode str, text str, l int, c int) Json?
    file := "{self.path}.edit-query.ail"
    fs.write_text(file, text) else return none
    r := proc.run(ail_command(), ["api", mode, file, "{l}", "{c}"], none, jb.QUERY_MS) else err
        if err.kind == TimedOut
            self.message = jb.failure(err, jb.QUERY_MS)
        return none
    fs.remove(file) else err
        self.message = "can't remove {err.path}: {err.kind}"
    if r.status != 0
        return none
    j := parse_json(r.out.trim()) else return none
    j

## The buffer with columns `a..b` of the cursor's line taken out.
fn Editor.text_without(self, a int, b int) str
    mut ls := self.lines
    ls[self.line] = "{self.lines[self.line].slice(0, a)}{self.lines[self.line].slice(b, self.lines[self.line].len())}"
    "{ls.join("\n")}\n"

## Before completing, asks `ail` what is in scope at the cursor: the type
## before a `.` (so only its members are offered), or the locals with
## their types.
fn Editor.query_context(mut self)
    self.locals = []
    self.member_of = ""
    cs := self.cur()
    mut a := self.col
    while a > 0 and is_word(cs[a - 1])
        a -= 1
    if a > 0 and cs[a - 1] == '.'
        dot := a - 1
        if dot < 1
            return
        j := self.api_at("--type", self.text_without(dot, self.col), self.line + 1, dot) else return
        self.member_of = parse_type_name(jstr(j, "type"))
        return
    j := self.api_at("--locals", self.text_without(a, self.col), self.line + 1, a + 1) else return
    self.locals = parse_locals(j)

## `Point` from `Point`, `List[Point]` stays `List` (its members are built in).
fn parse_type_name(t str) str
    cs := t.chars()
    mut n := 0
    while n < cs.len() and is_word(cs[n])
        n += 1
    cs[..n].join("")

fn parse_locals(j Json) List[Completion]
    mut out := List[Completion]()
    for v in jarr(j, "locals")
        out.push(Completion(text: jstr(v, "name"), detail: "{jstr(v, "type")} ({jstr(v, "kind")})"))
    out

## Hover and go to definition through `--type` and `--refs`, which know
## locals and types; false when `ail` has no answer, so the outline index
## is used instead.
fn Editor.query_at(mut self, hover bool) bool
    if hover
        t := self.api_at("--type", self.text(), self.line + 1, self.col + 1) else Json.Null
        uses := self.api_at("--refs", self.text(), self.line + 1, self.col + 1) else Json.Null
        if t == Json.Null and uses == Json.Null
            return false
        self.show_info(t, uses)
        return true
    j := self.api_at("--refs", self.text(), self.line + 1, self.col + 1) else return false
    for r in jarr(j, "refs")
        if (r.get("def") else Json.Null) == Json.Bool(true)
            self.selecting = false
            self.line = (jint(r, "line") - 1).max(0).min(self.lines.len() - 1)
            self.set_col((jint(r, "col") - 1).max(0).min(self.cur().len()))
            self.message = "definition of {jstr(j, "symbol")}"
            return true
    false

## Ctrl-I: everything `ail api` knows about the name under the cursor: the
## expression's type (`--type`), the declaration's signature, contracts,
## effects, error set and doc (from the call or the `--symbols` index), and
## how many uses `--refs` finds in this file (ADR 0312).
fn Editor.show_info(mut self, t Json, found Json)
    self.pane_text = []
    if t != Json.Null
        self.pane_text.push("{jstr(t, "text")}: {jstr(t, "type")}")
    callee := t.get("callee") else Json.Null
    mut id := jstr(t, "symbol")
    if id == ""
        id = jstr(found, "symbol")
    mut doc := ""
    if sym := self.symbol(id)
        self.pane_text.push(sym.signature)
        for f in sym.facts
            self.pane_text.push("    {f}")
        doc = sym.doc
    elif callee != Json.Null
        self.pane_text.push(jstr(callee, "signature"))
        for f in facts_of(callee)
            self.pane_text.push("    {f}")
        doc = jstr(callee, "doc")
    if doc != ""
        for d in doc.split("\n")
            self.pane_text.push("## {d}")
    if found != Json.Null
        mut uses := 0
        for r in jarr(found, "refs")
            if (r.get("def") else Json.Null) != Json.Bool(true)
                uses += 1
        self.pane_text.push("{id}: {uses} uses in this file (F12 goes to the definition)")
    self.pane = Text
    self.message = "Esc closes"

## F2: finds every place of the name under the cursor and asks for the
## new name; the prompt shows how many places and how they were found,
## which is the confirmation (ADR 0244).
fn Editor.start_rename(mut self)
    w := self.word_at() else
        self.message = "F2 renames: put the cursor on a name"
        return
    name := self.lines[self.line].slice(w.col, w.end_col)
    if name.chars()[0].is_digit() or KEYWORDS.contains(name)
        self.message = "F2 renames: put the cursor on a name"
        return
    self.rename = self.rename_plan(name, self.api_at(
        "--refs",
        self.text(),
        self.line + 1,
        w.col + 1,
    ))
    self.prompt = RenameTo
    self.input = name
    self.show_prompt()

## The places to rename `name`, the word under the cursor. Through `ail api
## --refs` (declarations, references and locals) when it answers, names this
## place, and every place still holds the name; else every whole word that
## matches. Uses in other files are left alone.
fn Editor.rename_plan(self, name str, refs_json Json?) RenamePlan
    if j := refs_json
        file := "{self.path}.edit-query.ail"
        mut at := List[Range]()
        mut here := false
        mut holds := true
        for r in jarr(j, "refs")
            if jstr(r, "file") == file
                a := place(jint(r, "line"), jint(r, "col"), name)
                at.push(a)
                if a.line == self.line and a.col <= self.col and self.col <= a.end_col
                    here = true
                if not self.holds_at(a, name)
                    holds = false
        if here and holds
            return RenamePlan(name: name, at: at, semantic: true)
    RenamePlan(name: name, at: self.word_places(name), semantic: false)

## Enter on the rename prompt: renames every place as one undo step, or
## keeps the prompt open when the new name isn't one.
fn Editor.rename_to(mut self, new str)
    if not valid_name(new)
        self.message = "`{new}` isn't a name"
        return
    self.prompt = NoPrompt
    self.message = ""
    if new == self.rename.name
        return
    self.rename_all(self.rename.at, new)
    mut how := "by word"
    if self.rename.semantic
        how = "via ail api"
    self.message = "renamed {self.rename.at.len()} `{self.rename.name}` to `{new}` ({how}); Ctrl-Z undoes"

# ---- Movement -----------------------------------------------------------

enum Dir
    Left
    Right
    Up
    Down
    WordLeft
    WordRight
    Home
    End
    PageUp
    PageDown
    Top
    Bottom

fn is_word(c char) bool
    c.is_alnum() or c == '_'

## The text rows the buffer gets: the window minus the status line and pane.
fn Editor.text_rows(self) int
    (self.rows - 1 - self.pane_rows()).max(1)

fn Editor.pane_rows(self) int
    if self.rows < 10 or self.zen
        return 0
    if self.pane_h > 0
        return pointer.pane_height(self.pane_h, self.rows)
    if self.pane == Outline or self.pane == Text
        return (self.rows / 3).max(4)
    4

fn Editor.move_to_line(mut self, l int)
    self.line = l.max(0).min(self.lines.len() - 1)
    self.col = self.goal.min(self.lines[self.line].len())

fn Editor.go(mut self, d Dir)
    n := self.lines[self.line].len()
    match d
        Left =>
            if self.col > 0
                self.set_col(self.col - 1)
            elif self.line > 0
                self.line -= 1
                self.set_col(self.lines[self.line].len())
        Right =>
            if self.col < n
                self.set_col(self.col + 1)
            elif self.line + 1 < self.lines.len()
                self.line += 1
                self.set_col(0)
        Up => self.move_to_line(self.visible_step(-1))
        Down => self.move_to_line(self.visible_step(1))
        PageUp => self.move_to_line(self.line - self.text_rows())
        PageDown => self.move_to_line(self.line + self.text_rows())
        Top =>
            self.line = 0
            self.set_col(0)
        Bottom =>
            self.line = self.lines.len() - 1
            self.set_col(self.lines[self.line].len())
        Home =>
            ind := indent_of(self.lines[self.line])
            if self.col == ind
                self.set_col(0)
            else
                self.set_col(ind)
        End => self.set_col(n)
        WordLeft =>
            cs := self.cur()
            mut c := self.col
            while c > 0 and not is_word(cs[c - 1])
                c -= 1
            while c > 0 and is_word(cs[c - 1])
                c -= 1
            self.set_col(c)
        WordRight =>
            cs := self.cur()
            mut c := self.col
            while c < n and not is_word(cs[c])
                c += 1
            while c < n and is_word(cs[c])
                c += 1
            self.set_col(c)

## Scrolls so the cursor is inside the view.
fn Editor.scroll(mut self)
    h := self.text_rows()
    if self.folded.len() > 0
        self.folded = fold.reveal(self.lines, fold.prune(self.lines, self.folded), self.line)
        ht := fold.hidden(self.lines, self.folded)
        rt := fold.rank(ht, self.top)
        rl := fold.rank(ht, self.line)
        if rl < rt
            self.top = fold.nth(ht, rl)
        if rl >= rt + h
            self.top = fold.nth(ht, rl - h + 1)
    else
        if self.line < self.top
            self.top = self.line
        if self.line >= self.top + h
            self.top = self.line - h + 1
    w := (self.cols - self.gutter_width()).max(1)
    if self.col < self.left
        self.left = self.col
    if self.col >= self.left + w
        self.left = self.col - w + 1

fn Editor.gutter_width(self) int
    "{self.lines.len()}".len().max(3) + 1

# ---- Syntax highlighting ------------------------------------------------

## The reserved words of lex.kw.1, plus the literals `true`, `false` and
## `none`, which are keywords there too.
KEYWORDS := {
    "and",
    "any",
    "as",
    "break",
    "continue",
    "defer",
    "elif",
    "else",
    "ensures",
    "enum",
    "error",
    "extern",
    "false",
    "fn",
    "for",
    "if",
    "impl",
    "in",
    "invariant",
    "match",
    "move",
    "mut",
    "none",
    "not",
    "or",
    "par",
    "pub",
    "ref",
    "requires",
    "return",
    "select",
    "self",
    "spawn",
    "struct",
    "todo",
    "trait",
    "true",
    "unique",
    "unsafe",
    "use",
    "while",
    "with",
    "yield",
}

## The end of a quoted literal that starts at `q` (the opening quote),
## just past its closing quote; `raw` literals have no escapes (lex.str).
fn quoted_end(cs List[char], q int, raw bool) int
    quote := cs[q]
    n := cs.len()
    mut j := q + 1
    while j < n and cs[j] != quote
        if not raw and cs[j] == '\\'
            j += 1
        j += 1
    (j + 1).min(n)

## Just past the `"` that closes the string starting at `q`, skipping escapes
## and each `{expression}`, whose code may hold strings and chars of its own
## (lex.str.2), and its format specification (lex.str.7).
fn string_end(cs List[char], q int) int
    n := cs.len()
    mut j := q + 1
    while j < n and cs[j] != '"'
        if cs[j] == '\\'
            j += 1
        elif cs[j] == '{'
            j = interp_close(cs, j)
        j += 1
    (j + 1).min(n)

## The `}` that closes the interpolation opened at `open`, or the end of the
## line when it never closes (lex.str.2).
fn interp_close(cs List[char], open int) int
    n := cs.len()
    mut depth := 0
    mut k := open
    while k < n
        c := cs[k]
        if c == '{'
            depth += 1
        elif c == '}'
            depth -= 1
            if depth == 0
                return k
        elif c == '"'
            k = string_end(cs, k) - 1
        elif c == '\''
            k = quoted_end(cs, k, false) - 1
        k += 1
    n

## Just past the number that starts at `i`: digits, letters and `_` (`0x1f`,
## `1_000`), a fraction, and an exponent's sign (`1e-3`, lex.num.1-2). After
## `0x`, `0b` or `0o` a sign is an operator: `0x1e-3` is a subtraction.
fn number_end(cs List[char], i int) int
    n := cs.len()
    prefixed := cs[i] == '0' and i + 1 < n and "xbo".contains(cs[i + 1])
    mut j := i + 1
    while j < n
        c := cs[j]
        digit_next := j + 1 < n and cs[j + 1].is_digit()
        if is_word(c) or c == '.' and digit_next
            j += 1
        elif not prefixed and "+-".contains(c) and "eE".contains(cs[j - 1]) and digit_next
            j += 1
        else
            break
    j

## Whether a `r"` or `b"` string starts at `i`, not inside a longer name.
fn prefixed_quote(cs List[char], i int) bool
    if i + 1 >= cs.len() or cs[i + 1] != '"' or i > 0 and is_word(cs[i - 1])
        return false
    cs[i] == 'r' or cs[i] == 'b'

## Whether `"""` starts at `i`.
fn starts_triple(cs List[char], i int) bool
    i + 2 < cs.len() and cs[i] == '"' and cs[i + 1] == '"' and cs[i + 2] == '"'

TRIPLE := "\"\"\""

## Just past the `"""` that closes a multi-line string (lex.str.3), searching
## from `from`, or the end of the line.
fn triple_end(cs List[char], from int) int
    k := find_in(cs, TRIPLE.chars(), from) else return cs.len()
    k + 3

## Whether a line ends inside a `"""` string, given whether it starts in
## one: each `"""` outside a comment opens or closes one.
fn ends_in_triple(cs List[char], inside bool) bool
    mut state := inside
    mut i := 0
    while i < cs.len()
        if not state and cs[i] == '#'
            break
        if i + 2 < cs.len() and cs[i] == '"' and cs[i + 1] == '"' and cs[i + 2] == '"'
            state = not state
            i += 3
        else
            i += 1
    state

## The foreground colors of a line that may start inside a `"""` string.
fn line_colors(cs List[char], inside bool) List[int]
    if not inside
        return colors(cs)
    k := triple_end(cs, 0)
    mut out := List[int]()
    for _ in 0..k
        out.push(STRING_FG)
    out.extend(colors(cs[k..]))
    out

## Whether a line is a `requires` or `ensures` line (contract.decl.1).
fn is_contract_line(cs List[char]) bool
    t := cs.join("").trim()
    t.starts_with("requires ") or t.starts_with("ensures ")

## The foreground color of each character of one line of AIL source, which
## starts outside any `"""` string (see `line_colors`).
fn colors(cs List[char]) List[int]
    mut out := List[int]()
    n := cs.len()
    contract := is_contract_line(cs)
    mut i := 0
    while i < n
        c := cs[i]
        mut j := i + 1
        mut fg := OP_FG
        if c == '#'
            j = n
            fg = COMMENT_FG
        elif c == '"' and i + 2 < n and cs[i + 1] == '"' and cs[i + 2] == '"'
            j = triple_end(cs, i + 3)
            fg = STRING_FG
        elif c == '"'
            j = string_end(cs, i)
            fg = STRING_FG
        elif c == '\''
            j = quoted_end(cs, i, false)
            fg = STRING_FG
        elif prefixed_quote(cs, i)
            # `r"..."` and `r"""` are raw (lex.str.6); `b"..."` is `bytes` (lex.bytes.1)
            j = quoted_end(cs, i + 1, c == 'r')
            if c == 'r' and starts_triple(cs, i + 1)
                j = triple_end(cs, i + 4)
            fg = STRING_FG
        elif c.is_digit()
            j = number_end(cs, i)
            fg = NUMBER_FG
        elif is_word(c) or c == '@'
            while j < n and is_word(cs[j])
                j += 1
            word := cs[i..j].join("")
            if word == "uhwhatnow" and j < n and cs[j] == '?'
                # the hole that asks (expr.hole.3), shown like `todo`
                j += 1
                fg = KEYWORD_FG
            elif c == '@'
                fg = ATTR_FG
            elif KEYWORDS.contains(word)
                fg = KEYWORD_FG
            elif contract
                and (word == "then" or word == "result" or word == "old" and j < n and cs[j] == '(')
                # contextual words of contracts (contract.decl.1, contract.ens.*)
                fg = KEYWORD_FG
            elif c.is_upper()
                fg = TYPE_FG
            else
                fg = FG
        for _ in i..j
            out.push(fg)
        i = j
    out

# ---- View ---------------------------------------------------------------

## A run of text on one row of the screen. Runs are drawn in order, so a
## later run covers an earlier one.
struct Span
    row int
    col int
    text str
    fg int
    bg int

## What a front end draws: colored runs, the plain text of each row (for
## tests and agents), and where the caret goes.
struct Screen
    cols int
    rows int
    text List[str]
    spans List[Span]
    cursor_col int
    cursor_row int

fn Screen.new(cols int, rows int) Screen
    mut text := List[str]()
    for _ in 0..rows
        text.push("")
    Screen(cols: cols, rows: rows, text: text, spans: [], cursor_col: -1, cursor_row: -1)

## Fills a whole row with `bg`.
fn Screen.band(mut self, row int, bg int)
    self.spans.push(Span(row: row, col: 0, text: " ".repeat(self.cols), fg: bg, bg: bg))

## Writes `s` at `col` of `row`, clipped to the screen.
## Restyles `s` at `col` of `row` without changing the row's plain text.
fn Screen.mark(mut self, row int, col int, s str, fg int, bg int)
    if row < 0 or row >= self.rows or col < 0 or col >= self.cols
        return
    self.spans.push(Span(row: row, col: col, text: s, fg: fg, bg: bg))

fn Screen.put(mut self, row int, col int, s str, fg int, bg int)
    if row < 0 or row >= self.rows or col >= self.cols
        return
    shown := s.slice(0, s.len().min(self.cols - col))
    self.spans.push(Span(row: row, col: col, text: shown, fg: fg, bg: bg))
    have := self.text[row]
    pad := " ".repeat((col - have.len()).max(0))
    old_tail := have.slice((col + shown.len()).min(have.len()), have.len())
    self.text[row] = "{have.slice(0, col.min(have.len()))}{pad}{shown}{old_tail}"

## The background of character `c` (0-based) of line `l` (0-based): a
## diagnostic's span if one covers it, else `bg`.
fn diag_bg(diags List[Diag], l int, c int, bg int) int
    for d in diags
        start := d.line - 1
        end := d.end_line - 1
        mut sc := d.col - 1
        mut ec := d.end_col - 1
        if start == end and sc == ec
            ec = sc + 1
        if l < start or l > end
            continue
        if l == start and c < sc or l == end and c >= ec
            continue
        if d.severity == "error"
            return ERROR_BG
        return WARN_BG
    bg

fn Editor.diag_count(self, severity str) int
    mut n := 0
    for d in self.diags
        if d.severity == severity
            n += 1
    n

## The diagnostic under the cursor, or the first one on the cursor's line.
fn Editor.diag_here(self) Diag?
    mut found := List[Diag]()
    for d in self.diags
        if d.line - 1 <= self.line and self.line <= d.end_line - 1
            if d.line - 1 == self.line
                and self.col + 1 >= d.col
                and (self.col + 1 < d.end_col or d.end_line - 1 > self.line)
                return d
            found.push(d)
    if found.len() == 0
        return none
    found[found.len() - 1]

## What a probe, watch or trap showed (plan S7) follows the line.
fn Editor.render_notes(self, mut s Screen, h int, gw int)
    if self.notes.len() == 0
        return
    for row in 0..h
        at := self.top + row
        note := self.notes.get(at) else continue
        if at >= self.lines.len()
            continue
        col_at := (gw + self.lines[at].len() - self.left + 3).max(gw)
        if col_at < self.cols
            s.put(row, col_at, "=> {note}", GUTTER_FG, BG)

fn Editor.render(self) Screen
    mut s := Screen.new(self.cols, self.rows)
    h := self.text_rows()
    gw := self.gutter_width()
    w := (self.cols - gw).max(0)
    sel := self.selection()
    here := self.word_here()
    mut brackets := List[Range]()
    if b := self.bracket_match()
        brackets = [b]
    mut inside := false
    for l in 0..self.top.min(self.lines.len())
        if self.lines[l].contains(TRIPLE)
            inside = ends_in_triple(self.lines[l].chars(), inside)
    ht := fold.hidden(self.lines, self.folded)
    first_row := fold.rank(ht, self.top)
    mut scanned := 0
    mut depth := 0
    mut extra_sel := List[Range]()
    for c in self.extra
        extra_sel.push(Range(
            line: multi.start_line(c),
            col: multi.start_col(c),
            end_line: multi.end_line(c),
            end_col: multi.end_col(c),
        ))
    for r in 0..h
        l := fold.nth(ht, first_row + r)
        if l < 0
            break
        starts_inside := inside
        if self.lines[l].contains(TRIPLE)
            inside = ends_in_triple(self.lines[l].chars(), inside)
        mut bg := BG
        if l == self.line
            bg = LINE_BG
            s.band(r, bg)
        num := "{l + 1}"
        if self.missed.contains(l)
            s.put(r, 0, "{num.pad_left(gw - 1, ' ')}!", ERROR_FG, bg)
        elif self.folded.contains(l)
            s.put(r, 0, "{num.pad_left(gw - 1, ' ')}>", GUTTER_FG, bg)
        elif self.git_marks.contains(l)
            s.put(r, 0, "{num.pad_left(gw - 1, ' ')}+", COMMENT_FG, bg)
        elif self.impact.contains(l)
            s.put(r, 0, "{num.pad_left(gw - 1, ' ')}~", WARN_FG, bg)
        else
            s.put(r, 0, "{num.pad_left(gw - 1, ' ')} ", GUTTER_FG, bg)
        cs := self.lines[l].chars()
        while scanned < l
            depth = pairs.scan(self.lines[scanned], depth).depth
            scanned += 1
        sc := pairs.scan(self.lines[l], depth)
        depth = sc.depth
        scanned = l + 1
        if self.folded.contains(l)
            hidden_n := fold.end_of(self.lines, l) - l
            s.put(r, (gw + cs.len() - self.left + 1).max(gw), "... {hidden_n} lines", GUTTER_FG, bg)
        if self.left >= cs.len()
            continue
        mut fgs := line_colors(cs, starts_inside)
        if self.layer.level > 0
            fgs = sem.recolor(cs, fgs, self.layer.kinds, layer_colors())
        end := cs.len().min(self.left + w)
        marks := word_marks(cs, here)
        mut bgs := List[int]()
        for k in self.left..end
            mut cell := bg
            if marks[k]
                cell = OCCUR_BG
            mut shade := sel_bg(sel, l, k, diag_bg(self.diags, l, k, cell))
            for xr in extra_sel
                shade = sel_bg(xr, l, k, shade)
            bgs.push(shade)
            if sc.levels[k] > 0
                fgs[k] = PAIR_FGS[(sc.levels[k] - 1) % PAIR_FGS.len()]
        mut i := self.left
        while i < end
            fg := fgs[i]
            b := bgs[i - self.left]
            mut j := i + 1
            while j < end and fgs[j] == fg and bgs[j - self.left] == b
                j += 1
            s.put(r, gw + i - self.left, cs[i..j].join(""), fg, b)
            i = j
        # Indent guides: styled cells only, so the row's text is unchanged.
        if cs.len() > 0 and cs[0] == ' '
            mut g := 0
            while g < indent_of(self.lines[l])
                if g >= self.left and gw + g - self.left < self.cols
                    s.mark(r, gw + g - self.left, "|", GUIDE_FG, bg)
                g += INDENT
    # The bracket at the cursor and its match.
    for b in brackets
        self.mark_bracket(mut s, b.line, b.col)
        self.mark_bracket(mut s, b.end_line, b.end_col)
    if self.completing
        self.render_popup(mut s)
    elif self.layer.sig.rows.len() > 0
        self.render_sig(mut s)
    self.render_notes(mut s, h, gw)
    # A diagnostic at the end of a line shows as one marked cell, and the
    # first diagnostic of each line shows its message after the line.
    mut shown := Set[int]()
    for d in self.diags
        r := d.line - 1 - self.top
        if r < 0 or r >= h
            continue
        n := self.lines[d.line - 1].len()
        if d.col - 1 >= n
            c := gw + d.col - 1 - self.left
            if c >= gw and c < self.cols
                s.put(r, c, " ", FG, diag_bg([d], d.line - 1, d.col - 1, BG))
        if shown.add(d.line)
            mut fg := ERROR_FG
            if d.severity != "error"
                fg = WARN_FG
            mut line_bg := BG
            if d.line - 1 == self.line
                line_bg = LINE_BG
            x := (gw + n - self.left + 3).max(gw)
            if x < self.cols
                s.put(r, x, "-- {d.message}", fg, line_bg)
    # Extra carets are drawn as inverted cells.
    for c in self.extra
        xr := c.line - self.top
        if xr >= 0 and xr < h and not ht[c.line]
            n_chars := self.lines[c.line].len()
            mut ch := self.lines[c.line].slice(c.col.min(n_chars), (c.col + 1).min(n_chars))
            if ch == ""
                ch = " "
            xc := gw + c.col - self.left
            if xc >= gw and xc < self.cols
                s.mark(xr, xc, ch, BG, FG)
    # The enclosing declaration stays on the first row once its line scrolls off.
    if self.top > 0 and self.top < self.lines.len() and first_row == self.top
        if hd := scope.sticky(self.lines, self.top)
            s.put(0, 0, " ".repeat(gw), GUTTER_FG, PANE_BG)
            s.put(
                0,
                gw,
                self.lines[hd].pad_right((self.cols - gw).max(0), ' '),
                KEYWORD_FG,
                PANE_BG,
            )
    if self.layer.level > 0 or self.layer.hints_on
        self.render_ghosts(mut s, h, gw, shown)
    status_row := h
    s.band(status_row, STATUS_BG)
    mut flag := ""
    if self.dirty
        flag = " *"
    mut counts := "{self.diag_count("error")} errors, {self.diag_count("warning")} warnings"
    if self.tests != ""
        counts = "{counts}, {self.tests}"
    mut left_part := " {self.path}{flag}  Ln {self.line + 1}, Col {self.col + 1}  {counts}"
    # A long path (a temporary directory on macOS) would push the counts or
    # the message off the line: show the file's name instead.
    if left_part.chars().len() + 4 + self.message.chars().len() > self.cols
        left_part = " {base_name(self.path)}{flag}  Ln {self.line + 1}, Col {self.col + 1}  {counts}"
    s.put(status_row, 0, left_part, STATUS_FG, STATUS_BG)
    if self.message != ""
        s.put(status_row, left_part.len() + 2, "| {self.message}", STATUS_FG, STATUS_BG)
    # The breadcrumbs sit at the right when there is room.
    mut trail := scope.crumbs(self.lines, self.line)
    used := left_part.chars().len() + 4 + self.message.chars().len()
    if self.extra.len() > 0
        trail = "{self.extra.len() + 1} carets  {trail}"
    if trail != "" and used + trail.chars().len() + 2 < self.cols
        s.put(status_row, self.cols - trail.chars().len() - 1, trail, STATUS_FG, STATUS_BG)
    self.render_pane(mut s, status_row + 1)
    if self.line >= self.top and self.line < self.top + h
        s.cursor_row = self.line - self.top
        s.cursor_col = gw + self.col - self.left
    s

fn Editor.mark_bracket(self, mut s Screen, l int, c int)
    r := l - self.top
    x := self.gutter_width() + c - self.left
    if r >= 0 and r < self.text_rows() and x >= self.gutter_width() and x < self.cols
        s.put(r, x, "{self.lines[l].chars()[c]}", FG, BRACKET_BG)

## The completion popup: below the cursor (above it near the bottom), at
## the start of the word, at most 8 entries around the selected one.
## The signature popup: above the cursor's line (below it near the top),
## the current argument on a selected background.
fn Editor.render_sig(self, mut s Screen)
    v := self.layer.sig
    mut width := 0
    for row in v.rows
        width = width.max(row.chars().len() + 2)
    width = width.min(self.cols).max(1)
    n := v.rows.len()
    x := self.gutter_width().min((self.cols - width).max(0))
    mut y := self.line - self.top - n
    if y < 0
        y = self.line - self.top + 1
    for k in 0..n
        bg := PANE_BG
        s.put(y + k, x, " ".repeat(width), FG, bg)
        if k == 0
            cs := v.rows[0].chars()
            s.put(y, x + 1, cs[..v.from].join(""), FG, bg)
            s.put(y, x + 1 + v.from, cs[v.from..v.to].join(""), FG, SELECT_BG)
            s.put(y, x + 1 + v.to, cs[v.to..].join(""), FG, bg)
        else
            s.put(y + k, x + 1, v.rows[k], GUTTER_FG, bg)

fn Editor.render_popup(self, mut s Screen)
    n := self.completions.len().min(8)
    cs := self.cur()
    mut a := self.col
    while a > 0 and is_word(cs[a - 1])
        a -= 1
    mut width := 0
    for c in self.completions
        width = width.max(c.text.chars().len() + c.detail.chars().len() + 3)
    width = width.min(60).min(self.cols)
    x := (self.gutter_width() + a - self.left).max(0).min((self.cols - width).max(0))
    mut y := self.line - self.top + 1
    if y + n > self.text_rows()
        y = self.line - self.top - n
    first := (self.comp_sel - n + 1).max(0)
    for k in 0..n
        i := first + k
        mut bg := PANE_BG
        if i == self.comp_sel
            bg = SELECT_BG
        c := self.completions[i]
        s.put(y + k, x, " ".repeat(width), FG, bg)
        s.put(y + k, x + 1, c.text, FG, bg)
        s.put(y + k, x + 2 + c.text.chars().len(), c.detail, GUTTER_FG, bg)

fn Editor.render_pane(self, mut s Screen, first int)
    n := self.pane_rows()
    for r in first..first + n
        s.band(r, PANE_BG)
    match self.pane
        Diags =>
            if self.diags.len() == 0
                s.put(
                    first,
                    1,
                    "No diagnostics. Ctrl-K checks, F1 explains, Ctrl-O outline.",
                    GUTTER_FG,
                    PANE_BG,
                )
            mut r := first
            for d in self.diags
                if r >= first + n
                    break
                mut fix := ""
                if d.fix.len() > 0
                    fix = "  [Ctrl-. {d.fix_title}]"
                s.put(r, 1, "{d.line}:{d.col} {d.severity}[{d.rule}] {d.message}{fix}", FG, PANE_BG)
                r += 1
        Text =>
            # Run output, hover and explanations, through std.ui.widgets.
            mut p := widgets.Pane.new(self.pane_text)
            p.cursor = -1
            s.runs_unpadded(p.render(
                widgets.Rect(col: 1, row: first, cols: self.cols - 1, rows: n),
                {"fg": FG, "pane_bg": PANE_BG},
            ))
        Outline =>
            # Scroll the outline so the selection stays visible.
            start := (self.outline_sel - n + 1).max(0)
            mut r := first
            for i in start..self.outline.len()
                if r >= first + n
                    break
                item := self.outline[i]
                mut bg := PANE_BG
                if i == self.outline_sel
                    bg = SELECT_BG
                    s.band(r, bg)
                s.put(r, 1, "{item.line:>5}  {item.text}", FG, bg)
                r += 1

# ---- Editing depth (features/; editor plan S2) ----------------------------

## The line `d` (-1 or 1) rows from the cursor in the folded view.
fn Editor.visible_step(self, d int) int
    if self.folded.len() == 0
        return self.line + d
    ht := fold.hidden(self.lines, self.folded)
    n := self.lines.len()
    mut l := self.line + d
    while l > 0 and l < n - 1 and ht[l]
        l += d
    l = l.max(0).min(n - 1)
    if ht[l]
        return self.line
    l

## The main caret as a `multi.Caret`, with the selection when there is one.
fn Editor.main_caret(self) multi.Caret
    if self.selecting
        return multi.span(self.anchor_line, self.anchor_col, self.line, self.col, 1)
    multi.at(self.line, self.col, 1)

## Takes carets back from `features/multi`: the one tagged 1 is the main caret.
fn Editor.set_carets(mut self, cs List[multi.Caret])
    mut rest := List[multi.Caret]()
    for c in cs
        if c.tag == 1
            self.line = c.line
            self.set_col(c.col)
            self.selecting = not multi.empty(c)
            self.anchor_line = c.anchor_line
            self.anchor_col = c.anchor_col
        else
            rest.push(multi.span(c.anchor_line, c.anchor_col, c.line, c.col, 0))
    self.extra = rest

## Makes the result of a multi-caret edit the buffer, as one undo step.
fn Editor.multi_apply(mut self, e multi.Edited)
    self.snapshot()
    self.lines = e.lines
    self.set_carets(e.carets)
    self.folded = fold.prune(self.lines, self.folded)

fn dir_name(d Dir) str
    match d
        Left => "left"
        Right => "right"
        Up => "up"
        Down => "down"
        WordLeft => "word_left"
        WordRight => "word_right"
        Home => "home"
        End => "end"
        PageUp | PageDown | Top | Bottom => ""

## Keys while there are extra carets: typing, deleting and moving happen at
## every caret. True if `cmd` was handled; anything else drops the extras.
fn Editor.multi_key(mut self, cmd Command) bool
    all := multi.prepare(self.main_caret(), self.extra)
    match cmd
        Insert(t) => self.multi_apply(multi.replace_all(self.lines, all, t))
        Paste => self.multi_apply(multi.replace_all(self.lines, all, self.clip))
        Tab =>
            mut texts := List[str]()
            for c in all
                texts.push(" ".repeat(INDENT - multi.start_col(c) % INDENT))
            self.multi_apply(multi.replace_each(self.lines, all, texts))
        Newline =>
            mut texts := List[str]()
            for c in all
                head := self.lines[multi.start_line(c)].slice(0, multi.start_col(c))
                mut n := indent_of(head).min(multi.start_col(c))
                if opens_block(head)
                    n += INDENT
                texts.push("\n{" ".repeat(n)}")
            self.multi_apply(multi.replace_each(self.lines, all, texts))
        Backspace => self.multi_apply(multi.replace_all(
            self.lines,
            multi.grow_back(self.lines, all),
            "",
        ))
        Delete => self.multi_apply(multi.replace_all(
            self.lines,
            multi.grow_forward(self.lines, all),
            "",
        ))
        Go(d) =>
            name := dir_name(d)
            if name == ""
                self.extra = []
                return false
            self.set_carets(multi.move_each(self.lines, all, name, false))
        Select(d) =>
            name := dir_name(d)
            if name == ""
                self.extra = []
                return false
            self.set_carets(multi.move_each(self.lines, all, name, true))
        Escape =>
            self.extra = []
            self.selecting = false
        Depth(_) | Resize(_, _) | Quit => return false
        SelectAll | Copy | Cut | Undo | Redo | Find | FindNext | ToggleRegex | Fix | Replace | ReplaceAll | GoToLine | ToggleComment | DuplicateLine | MoveLine | Complete | GoToDefinition | Hover | Format | Rename | Save | Check | Explain | Outline =>
            self.extra = []
            return false
    true

## Alt-D: select the word under the cursor, then each next occurrence of the
## selection as another caret (the newest is the main one).
fn Editor.add_next(mut self)
    if self.selection() == none
        w := self.word_at() else
            self.message = "no word here"
            return
        self.selecting = true
        self.anchor_line = w.line
        self.anchor_col = w.col
        self.line = w.end_line
        self.set_col(w.end_col)
        return
    word := self.selected_text()
    if word.contains("\n")
        self.message = "select within one line to add the next one"
        return
    all := multi.prepare(self.main_caret(), self.extra)
    last := all[all.len() - 1]
    found := multi.occurrence_after(
        self.lines,
        word,
        multi.end_line(last),
        multi.end_col(last),
    ) else
        self.message = "no other `{word}`"
        return
    for c in all
        if multi.start_line(c) == multi.start_line(found)
            and multi.start_col(c) == multi.start_col(found)
            self.message = "all {all.len()} `{word}` are selected"
            return
    mut cs := List[multi.Caret]()
    for c in all
        cs.push(multi.span(c.anchor_line, c.anchor_col, c.line, c.col, 0))
    cs.push(multi.span(found.anchor_line, found.anchor_col, found.line, found.col, 1))
    self.set_carets(cs)
    self.message = "{cs.len()} carets"

## Alt-A: a caret on every occurrence of the selection (or the word here).
fn Editor.select_occurrences(mut self)
    mut word := self.selected_text()
    if self.selection() == none
        w := self.word_at() else
            self.message = "no word here"
            return
        word = self.lines[w.line].slice(w.col, w.end_col)
    if word == "" or word.contains("\n")
        self.message = "select a word first"
        return
    found := multi.occurrences(self.lines, word)
    mut cs := List[multi.Caret]()
    for k in 0..found.len()
        c := found[k]
        mut tag := 0
        if k == found.len() - 1
            tag = 1
        cs.push(multi.span(c.anchor_line, c.anchor_col, c.line, c.col, tag))
    self.set_carets(cs)
    self.message = "{cs.len()} carets on `{word}`"

## Alt-Shift-Up and Alt-Shift-Down: another caret one line above or below.
fn Editor.add_vertical(mut self, d int)
    all := multi.prepare(self.main_caret(), self.extra)
    mut base := all[0]
    if d > 0
        base = all[all.len() - 1]
    c := multi.vertical(self.lines, base, d) else
        self.message = "no line there"
        return
    mut cs := List[multi.Caret]()
    for o in all
        cs.push(multi.span(o.anchor_line, o.anchor_col, o.line, o.col, 0))
    cs.push(multi.span(c.anchor_line, c.anchor_col, c.line, c.col, 1))
    self.set_carets(cs)
    self.message = "{cs.len()} carets"

## Alt-click: a caret at the clicked place.
fn Editor.add_caret_at(mut self, c int, r int)
    p := self.position_at(c, r) else return
    mut cs := List[multi.Caret]()
    for o in multi.prepare(self.main_caret(), self.extra)
        cs.push(multi.span(o.anchor_line, o.anchor_col, o.line, o.col, 0))
    cs.push(multi.at(p.line, p.col, 1))
    self.set_carets(cs)

## Folds the block at the cursor, or unfolds it.
fn Editor.toggle_fold(mut self)
    h := fold.header_for(self.lines, self.line) else
        self.message = "nothing to fold here"
        return
    if self.folded.contains(h)
        self.folded.remove(h)
        self.message = "unfolded line {h + 1}"
        return
    self.folded.add(h)
    self.line = h
    self.col = self.col.min(self.lines[h].len())
    self.message = "folded line {h + 1}: {fold.end_of(self.lines, h) - h} lines (Ctrl-Shift-[ opens)"

## The editing-depth commands: one dispatch for `features/`.
fn Editor.depth(mut self, act str)
    if act == "next"
        self.add_next()
    elif act == "all"
        self.select_occurrences()
    elif act == "above"
        self.add_vertical(-1)
    elif act == "below"
        self.add_vertical(1)
    elif act == "fold"
        self.toggle_fold()
    elif act == "unfold_all"
        self.folded = Set[int]()
        self.message = "all folds open"
    elif act == "fold_all"
        self.folded = fold.top_level(self.lines)
        ht := fold.hidden(self.lines, self.folded)
        while self.line > 0 and ht[self.line]
            self.line -= 1
        self.col = self.col.min(self.lines[self.line].len())
        self.message = "folded {self.folded.len()} blocks (Ctrl-Shift-] opens them)"
    elif act == "zen"
        self.zen = not self.zen
        self.message = "zen mode {on_off(self.zen)}"
    elif act == "word"
        self.select_word()
    elif act == "line"
        self.select_line()

# ---- Commands -----------------------------------------------------------

enum Command
    Insert(text str)
    Newline
    Tab
    Backspace
    Delete
    Go(dir Dir)
    Select(dir Dir)
    SelectAll
    Copy
    Cut
    Paste
    Undo
    Redo
    Find
    FindNext
    ToggleRegex
    Fix
    Escape
    Quit
    Resize(cols int, rows int)
    Replace
    ReplaceAll
    GoToLine
    ToggleComment
    DuplicateLine
    MoveLine(down bool)
    ## Editing depth (features/): next, all, above, below, fold, unfold_all,
    ## fold_all or zen.
    Depth(act str)
    # These reach the file system or run `ail`; `Editor.run` handles them.
    Complete
    GoToDefinition
    Hover
    Format
    Rename
    Save
    Check
    Explain
    Outline

## Applies a command that needs nothing outside the editor. `Save`,
## `Check`, `Explain` and `Outline` do nothing here: see `Editor.run`.
fn Editor.apply(mut self, cmd Command)
    if cmd != Quit
        self.quit_armed = false
    if self.prompt == NoPrompt
        self.message = ""
    if self.pane == Outline and self.outline_key(cmd)
        self.scroll()
        return
    if self.completing and self.complete_key(cmd)
        self.scroll()
        return
    if self.prompt != NoPrompt and self.prompt_key(cmd)
        self.scroll()
        return
    if self.extra.len() > 0 and self.multi_key(cmd)
        self.scroll()
        return
    match cmd
        Insert(t) =>
            if not self.cut_selection() and self.over_closer(t)
                self.set_col(self.col + 1)
            else
                self.insert_paired(t)
            self.dedent_else()
            if t == "."
                self.auto_complete_members()
            elif t == "("
                self.signature_help()
        Newline =>
            self.cut_selection()
            self.newline()
        Tab =>
            self.cut_selection()
            self.insert(" ".repeat(INDENT - self.col % INDENT))
        Backspace =>
            if not self.cut_selection() and not self.delete_pair()
                self.backspace()
        Delete =>
            if not self.cut_selection()
                self.delete()
        Go(d) =>
            self.selecting = false
            self.go(d)
        Select(d) =>
            if not self.selecting
                self.selecting = true
                self.anchor_line = self.line
                self.anchor_col = self.col
            self.go(d)
        SelectAll =>
            self.selecting = true
            self.anchor_line = 0
            self.anchor_col = 0
            self.go(Bottom)
        Copy => self.copy()
        Cut =>
            if self.copy()
                self.cut_selection()
        Paste =>
            self.cut_selection()
            self.insert(self.clip)
        Undo => self.undo_last()
        Redo => self.redo_last()
        Find => self.open_prompt(FindText)
        ToggleRegex =>
            self.regex_find = not self.regex_find
            self.message = "find: regex {on_off(self.regex_find)}"
        FindNext => self.find(true)
        Replace =>
            if self.query == ""
                self.open_prompt(FindText)
                self.message = "find what? type it, then Ctrl-R"
            else
                self.open_prompt(ReplaceText)
        ReplaceAll => self.replace_all()
        GoToLine => self.open_prompt(LineNumber)
        ToggleComment => self.toggle_comment()
        DuplicateLine => self.duplicate_line()
        MoveLine(down) => self.move_line(down)
        Depth(act) => self.depth(act)
        Complete => self.open_completion()
        GoToDefinition => self.go_to_definition()
        Hover => self.hover()
        Fix => self.apply_fix()
        Escape =>
            self.pane = Diags
            self.message = ""
            self.selecting = false
            self.layer.sig = sem.View(rows: [], from: 0, to: 0)
        Quit =>
            if self.dirty and not self.quit_armed
                self.quit_armed = true
                self.message = "unsaved changes: Ctrl-Q again quits without saving"
            else
                self.quit = true
        Resize(c, r) =>
            self.cols = c
            self.rows = r
        Format | Rename | Save | Check | Explain | Outline => return
    if self.layer.sig.rows.len() > 0
        self.signature_help()
    self.scroll()

## Up, Down and Enter in the outline pane; true if `cmd` was one of them.
fn Editor.outline_key(mut self, cmd Command) bool
    if cmd == Go(Up)
        self.outline_sel = (self.outline_sel - 1).max(0)
    elif cmd == Go(Down)
        self.outline_sel = (self.outline_sel + 1).min(self.outline.len() - 1).max(0)
    elif cmd == Newline
        if self.outline_sel < self.outline.len()
            self.line = (self.outline[self.outline_sel].line - 1).max(0).min(self.lines.len() - 1)
            self.set_col(indent_of(self.lines[self.line]))
            self.top = self.line
        self.pane = Diags
    else
        return false
    true

## Applies the first fix of the diagnostic under the cursor (semantic-api
## fixes: edits in source order, applied last to first).
fn Editor.apply_fix(mut self)
    d := self.diag_here() else
        self.message = "no diagnostic here"
        return
    if d.fix.len() == 0
        self.message = "no fix for {d.rule}"
        return
    self.snapshot()
    mut i := d.fix.len() - 1
    while i >= 0
        e := d.fix[i]
        self.edit(e.line - 1, e.col - 1, e.end_line - 1, e.end_col - 1, e.text)
        i -= 1
    self.message = "applied: {d.fix_title}; Ctrl-K checks again"

## Opens a prompt on the status line.
fn Editor.open_prompt(mut self, p Prompt)
    self.completing = false
    self.prompt = p
    self.input = ""
    if p == FindText
        self.query = ""
    self.show_prompt()

fn Editor.show_prompt(mut self)
    self.message = match self.prompt
        NoPrompt => ""
        FindText =>
            if self.message.ends_with("(not found)")
                "{find_label(self.regex_find)}{self.query}_   (not found)"
            else
                "{find_label(self.regex_find)}{self.query}_   (Enter/F3 next, Alt-R regex, Ctrl-R replace, Esc)"
        ReplaceText => "replace `{self.query}` with: {self.input}_   (Enter one, Ctrl-Enter all, Esc)"
        LineNumber => "go to line: {self.input}_"
        RenameTo =>
            mut how := "every whole word in this file"
            if self.rename.semantic
                how = "found by ail api"
            "rename `{self.rename.name}` ({self.rename.at.len()} places, {how}) to: {self.input}_   (Enter, Esc)"

## Typing while a prompt is open: characters and Backspace edit it; Enter
## acts (find the next match, replace this match, go to the line); Escape
## and any other command close it. True if `cmd` was used here.
fn Editor.prompt_key(mut self, cmd Command) bool
    match cmd
        Insert(t) =>
            if self.prompt == FindText
                self.query = "{self.query}{t}"
                self.find(false)
                self.show_prompt()
                return true
            if self.prompt == LineNumber and not all_digits(t)
                return true
            self.input = "{self.input}{t}"
            self.show_prompt()
        ToggleRegex =>
            if self.prompt != FindText
                return self.close_prompt()
            self.regex_find = not self.regex_find
            self.find(false)
            self.show_prompt()
        Backspace =>
            if self.prompt == FindText
                self.query = drop_last(self.query)
                self.find(false)
            else
                self.input = drop_last(self.input)
            self.show_prompt()
        Newline =>
            match self.prompt
                NoPrompt => return false
                FindText =>
                    self.find(true)
                    self.show_prompt()
                ReplaceText => self.replace_one()
                RenameTo => self.rename_to(self.input)
                LineNumber =>
                    n := self.input.to_int() else 0
                    self.prompt = NoPrompt
                    self.message = ""
                    if n > 0
                        self.selecting = false
                        self.line = (n - 1).min(self.lines.len() - 1)
                        self.set_col(indent_of(self.lines[self.line]))
        FindNext =>
            self.find(true)
            self.show_prompt()
        Replace =>
            if self.prompt == FindText and self.query != ""
                self.prompt = ReplaceText
                self.input = ""
                self.show_prompt()
        ReplaceAll =>
            if self.prompt == ReplaceText
                self.replace_all()
        Escape =>
            self.prompt = NoPrompt
            self.message = ""
        Tab | Delete | Go(_) | Select(_) | SelectAll | Copy | Cut | Paste => return self.close_prompt()
        Undo | Redo | Find | Fix | GoToLine | ToggleComment | DuplicateLine => return self.close_prompt()
        MoveLine(_) | Depth(_) | Complete | GoToDefinition | Hover | Format | Rename => return self.close_prompt()
        Quit | Resize(_, _) | Save | Check | Explain | Outline => return self.close_prompt()
    true

fn Editor.close_prompt(mut self) bool
    self.prompt = NoPrompt
    false

fn drop_last(s str) str
    s.slice(0, (s.len() - 1).max(0))

## Replaces the match at the cursor, if the cursor is on one, then finds
## the next.
fn Editor.replace_one(mut self)
    q := self.query.chars()
    cs := self.cur()
    if self.col + q.len() <= cs.len() and cs[self.col..self.col + q.len()] == q
        self.replace(self.line, self.col, self.line, self.col + q.len(), self.input)
        self.prompt = ReplaceText
    self.find(false)
    self.show_prompt()

## Replaces every match of `query` with `input`, as one undo step.
fn Editor.replace_all(mut self)
    q := self.query.chars()
    if q.len() == 0
        return
    mut count := 0
    mut out := List[str]()
    for l in self.lines
        cs := l.chars()
        mut parts := List[str]()
        mut i := 0
        mut last := 0
        while i + q.len() <= cs.len()
            if cs[i..i + q.len()] == q
                parts.push(cs[last..i].join(""))
                parts.push(self.input)
                i += q.len()
                last = i
                count += 1
            else
                i += 1
        parts.push(cs[last..].join(""))
        out.push(parts.join(""))
    if count > 0
        self.snapshot()
        self.lines = out
        self.set_col(self.col.min(self.cur().len()))
    self.prompt = NoPrompt
    self.message = "replaced {count}"

## Replaces `q` by `by` on the lines `at` (0-based) as one undo step.
fn Editor.replace_on(mut self, q str, by str, at List[int])
    mut out := self.lines
    mut changed := false
    for l in at
        if l < out.len() and out[l].contains(q)
            out[l] = out[l].replace(q, by)
            changed = true
    if changed
        self.snapshot()
        self.lines = out
        self.set_col(self.col.min(self.cur().len()))

## Where `q` occurs in `cs` at or after `start`, or `none`.
fn find_in(cs List[char], q List[char], start int) int?
    mut i := start
    while i + q.len() <= cs.len()
        if cs[i..i + q.len()] == q
            return i
        i += 1
    none

## Moves the cursor to the next match of `query`: at the cursor, or after it
## when `next`, wrapping around the end of the buffer.
fn Editor.find(mut self, next bool)
    q := self.query.chars()
    if q.len() == 0
        self.message = "find: "
        return
    mut start := self.col
    if next
        start += 1
    n := self.lines.len()
    for k in 0..n + 1
        l := (self.line + k) % n
        mut from := 0
        if k == 0
            from = start
        cs := self.lines[l].chars()
        if from > cs.len()
            continue
        if c := match_from(cs, q, from, self.regex_find)
            self.line = l
            self.set_col(c)
            self.message = "{find_label(self.regex_find)}{self.query}"
            return
    self.message = "{find_label(self.regex_find)}{self.query} (not found)"

## Where `q` first matches in `cs` from column `from`: its characters, or
## with `rx` the regex `q` (std.regex, leftmost, ADR 0490), or none.
fn match_from(cs List[char], q List[char], from int, rx bool) int?
    if not rx
        return find_in(cs, q, from)
    re := regex.compile(q.join("")) else return none
    m := regex.find(re, cs[from..cs.len()].join("")) else return none
    from + m.start

## The find bar's label: `find: ` or `find (regex): `.
fn find_label(rx bool) str
    if rx
        return "find (regex): "
    "find: "

fn on_off(on bool) str
    if on
        return "on"
    "off"

## Moving with Shift held selects.
fn go_or_select(d Dir, shift bool) Command
    if shift
        return Select(d)
    Go(d)

## Alt-Up and Alt-Down move the line; with Shift they add a caret there.
fn alt_vertical(down bool, shift bool) Command
    if shift and down
        return Depth("below")
    if shift
        return Depth("above")
    MoveLine(down)

## The command for a key from `std.ui` (`Event.Key`), or `none`.
fn key_command(key str, ctrl bool, alt bool, shift bool) Command?
    if alt and shift and (key == "f" or key == "F")
        return Format
    if alt and (key == "r" or key == "R")
        return ToggleRegex
    if ctrl
        return match key
            "s" | "S" => Save
            "q" | "Q" => Quit
            "k" | "K" => Check
            "z" | "Z" => Undo
            "y" | "Y" => Redo
            "f" | "F" => Find
            "a" | "A" => SelectAll
            "c" | "C" => Copy
            "x" | "X" => Cut
            "v" | "V" => Paste
            "." => Fix
            "o" | "O" => Command.Outline
            "r" | "R" => Replace
            "g" | "G" => GoToLine
            "d" | "D" => DuplicateLine
            "i" | "I" => Hover
            "[" | "\{" => Depth("fold")
            "]" | "}" => Depth("unfold_all")
            "/" => ToggleComment
            " " => Complete
            "enter" => ReplaceAll
            "home" => go_or_select(Top, shift)
            "end" => go_or_select(Bottom, shift)
            "left" => go_or_select(WordLeft, shift)
            "right" => go_or_select(WordRight, shift)
            _ => none
    if alt
        return match key
            "up" => alt_vertical(false, shift)
            "down" => alt_vertical(true, shift)
            "d" | "D" => Depth("next")
            _ => none
    match key
        "enter" => Newline
        "tab" => Tab
        "backspace" => Backspace
        "delete" => Delete
        "escape" => Escape
        "left" => go_or_select(Left, shift)
        "right" => go_or_select(Right, shift)
        "up" => go_or_select(Up, shift)
        "down" => go_or_select(Down, shift)
        "home" => go_or_select(Home, shift)
        "end" => go_or_select(End, shift)
        "pageup" => go_or_select(PageUp, shift)
        "pagedown" => go_or_select(PageDown, shift)
        "f1" => Explain
        "f3" => FindNext
        "f12" => GoToDefinition
        "f11" => Depth("zen")
        "f2" => Rename
        _ =>
            if key.len() == 1
                return Insert(key)
            none

# ---- Running `ail` ------------------------------------------------------

## The `ail` command (tool.path.1, ADR 1058): `$AIL`, which the `ail`
## launcher sets for the programs it runs, else `./ail` when run from the
## root of an ail clone, else `ail` on `PATH`. On Windows `proc.run` finds
## `ail.cmd` for either (std.proc.3); `proc.which` skips a directory or a
## file that isn't a program named `ail`.
fn ail_command() str
    pick_ail(env.get("AIL") else "", proc.which("./ail") != none)

## `ail_command` from what it found: an empty `$AIL` counts as unset.
fn pick_ail(given str, here bool) str
    if given != ""
        return given
    if here
        return "./ail"
    "ail"

@test fn ail_is_the_launchers_then_the_clones_then_the_one_on_path()
    assert_eq(pick_ail("/opt/ail/ail.cmd", true), "/opt/ail/ail.cmd")
    assert_eq(pick_ail("", true), "./ail")
    assert_eq(pick_ail("", false), "ail")

fn jstr(j Json, key str) str
    (j.get(key) else Json.Null).as_str() else ""

fn jint(j Json, key str) int
    ((j.get(key) else Json.Null).as_num() else 0.0).to_int()

fn jarr(j Json, key str) List[Json]
    (j.get(key) else Json.Null).as_arr() else List[Json]()

## The diagnostics in `ail check --json` output: one JSON object per line.
## Lines that aren't diagnostics are skipped.
fn parse_diags(text str) List[Diag]
    mut out := List[Diag]()
    for l in text.lines()
        j := parse_json(l) else continue
        if jstr(j, "rule") == ""
            continue
        mut fix := List[TextEdit]()
        mut title := ""
        fixes := jarr(j, "fixes")
        if fixes.len() > 0
            title = jstr(fixes[0], "title")
            for e in jarr(fixes[0], "edits")
                fix.push(TextEdit(
                    line: jint(e, "line"),
                    col: jint(e, "col"),
                    end_line: jint(e, "end_line"),
                    end_col: jint(e, "end_col"),
                    text: jstr(e, "text"),
                ))
        out.push(Diag(
            severity: jstr(j, "severity"),
            rule: jstr(j, "rule"),
            line: jint(j, "line"),
            col: jint(j, "col"),
            end_line: jint(j, "end_line"),
            end_col: jint(j, "end_col"),
            message: jstr(j, "message"),
            help: jstr(j, "help"),
            fix_title: title,
            fix: fix,
        ))
    out

## The declarations in `ail api --text` output: `LINE  signature` per line;
## doc lines (`##`) are skipped.
fn parse_outline(text str) List[OutlineItem]
    mut out := List[OutlineItem]()
    for l in text.lines()
        t := l.trim()
        words := t.split(" ")
        n := words[0].to_int() else continue
        rest := l.slice(7.min(l.len()), l.len())
        if rest.trim().starts_with("##")
            continue
        out.push(OutlineItem(line: n, text: rest))
    out

## Runs `ail ARGS... FILE` on the buffer: on the file itself when it's
## saved, else on a copy beside it, so relative imports still resolve.
fn Editor.ail_on_buffer(mut self, args List[str]) proc.Output?
    mut file := self.path
    if self.dirty
        file = "{self.path}.edit-check.ail"
        fs.write_text(file, self.text()) else err
            self.message = "can't write {err.path}: {err.kind}"
            return none
    mut all := args
    all.push(file)
    ms := jb.timeout_for(args)
    r := proc.run(ail_command(), all, none, ms) else err
        self.message = jb.failure(err, ms)
        return none
    if self.dirty
        fs.remove(file) else err
            self.message = "can't remove {err.path}: {err.kind}"
    r

fn Editor.check(mut self)
    r := self.ail_on_buffer(["check", "--json"]) else return
    self.diags = parse_diags(r.err)
    if self.diag_count("error") == 0
        self.index()
    self.pane = Diags
    self.message = "checked"

## Formats (when the program has no errors), writes the file, and checks it.
fn Editor.save(mut self)
    self.format()
    fs.write_text(self.path, self.text()) else err
        self.message = "can't save {err.path}: {err.kind}"
        return
    self.dirty = false
    self.saves += 1
    self.check()
    self.refresh_layer()
    self.message = "saved; {self.message}"

fn Editor.explain(mut self)
    d := self.diag_here() else
        self.message = "no diagnostic here to explain"
        return
    r := proc.run(ail_command(), ["explain", d.rule], none, jb.QUERY_MS) else err
        self.message = jb.failure(err, jb.QUERY_MS)
        return
    self.pane_text = [d.message]
    if d.help != ""
        self.pane_text.push("help: {d.help}")
    for l in r.out.lines()
        self.pane_text.push(l)
    self.explain_extras(d)
    self.pane = Text
    self.message = "explain {d.rule}; Esc closes"

fn Editor.toggle_outline(mut self)
    if self.pane == Outline
        self.pane = Diags
        return
    r := self.ail_on_buffer(["api", "--text"]) else return
    if r.status != 0
        if r.err.starts_with("usage:")
            self.message = "no outline: this `ail` has no `api` command"
        else
            self.message = "no outline: `ail api` needs a program without errors"
        return
    self.outline = parse_outline(r.out)
    self.outline_sel = 0
    for i in 0..self.outline.len()
        if self.outline[i].line - 1 <= self.line
            self.outline_sel = i
    self.pane = Outline
    self.message = "outline: Up/Down select, Enter jumps, Esc closes"

## Applies any command, running `ail` or touching the file when it must.
fn Editor.run(mut self, cmd Command)
    if cmd == Complete or cmd == Insert(".") and not self.completing
        self.index()
        self.query_context()
        self.apply(cmd)
        self.scroll()
        return
    if cmd == GoToDefinition or cmd == Hover or cmd == Rename
        self.index()
        self.prompt = NoPrompt
        self.completing = false
        if cmd == Rename
            self.start_rename()
        elif not self.query_at(cmd == Hover)
            self.apply(cmd)
        self.scroll()
        return
    if cmd == Fix
        self.layer_key("f")
        self.scroll()
        return
    if cmd == Save or cmd == Check or cmd == Explain or cmd == Outline or cmd == Format
        self.prompt = NoPrompt
        self.completing = false
    if cmd == Format
        self.format()
    elif cmd == Save
        self.save()
    elif cmd == Check
        self.check()
    elif cmd == Explain
        self.explain()
    elif cmd == Outline
        self.toggle_outline()
    else
        self.apply(cmd)
    self.scroll()

# ---- Semantic layer (slice S3) ------------------------------------------

## How many `ail api --locals` questions one refresh may ask.
HINT_QUERIES := 30

fn layer_colors() sem.Colors
    sem.Colors(
        plain: FG,
        type_fg: TYPE_FG,
        fn_fg: FN_FG,
        const_fg: CONST_FG,
        field_fg: FIELD_FG,
        variant_fg: VARIANT_FG,
    )

## The effects of a declaration's facts (`effects: io, fs`), or "".
fn effects_text(facts List[str]) str
    for f in facts
        if e := f.strip_prefix("effects: ")
            return e
    ""

## Whether the declaration on 1-based line `n` is a test.
fn Editor.test_at(self, n int) bool
    i := n - 1
    if i < 0 or i >= self.lines.len()
        return false
    self.lines[i].contains("@test") or i > 0 and self.lines[i - 1].trim() == "@test"

## The index of the next line after `l` that holds code, or -1.
fn Editor.next_code_line(self, l int) int
    mut m := l + 1
    while m < self.lines.len()
        t := self.lines[m].trim()
        if t != "" and not t.starts_with("#")
            return m
        m += 1
    -1

## Rebuilds what the layer shows from `ail api`: kind colors and the code
## lens from `--symbols`, and at level 2 the inlay hints.
fn Editor.refresh_layer(mut self)
    if self.layer.level == 0 and not self.layer.hints_on
        return
    self.index()
    mut names := List[str]()
    mut kinds := List[str]()
    mut decls := List[sem.Decl]()
    for sym in self.symbols
        names.push(sym.name)
        kinds.push(sym.kind)
        decls.push(sem.Decl(
            id: sym.id,
            kind: sym.kind,
            line: sym.line,
            effects: effects_text(sym.facts),
            test: self.test_at(sym.line),
        ))
    mut uses := Map[str, int]()
    for r in self.refs
        uses[r.id] = (uses.get(r.id) else 0) + 1
    self.layer.kinds = sem.kind_index(names, kinds)
    self.layer.lens = sem.lens_rows(decls, uses)
    self.layer.hints = Map[int, str]()
    if self.layer.hints_on
        self.compute_hints()

## Inlay hints for the bindings on the visible lines: a local is in scope
## from the line after its binding, so `--locals` is asked at the next code
## line. Bottom to top, so one answer also holds the bindings above it in
## the same block; at most HINT_QUERIES questions.
fn Editor.compute_hints(mut self)
    mut found := Map[int, str]()
    mut answers := List[Json]()
    mut cands := List[int]()
    last := (self.top + self.text_rows()).min(self.lines.len())
    for l in self.top..last
        if sem.binding_name(self.lines[l]) != ""
            cands.push(l)
    mut asked := 0
    mut i := cands.len() - 1
    while i >= 0
        l := cands[i]
        i -= 1
        name := sem.binding_name(self.lines[l])
        mut hit := ""
        for old in answers
            hit = sem.hint_in(old, name, l + 1)
            if hit != ""
                break
        if hit == "" and asked < HINT_QUERIES
            m := self.next_code_line(l)
            if m >= 0
                asked += 1
                if ans := self.api_at("--locals", self.text(), m + 1, indent_of(self.lines[m]) + 1)
                    answers.push(ans)
                    hit = sem.hint_in(ans, name, l + 1)
        if hit != ""
            found[l] = hit
    self.layer.hints = found

## The layer's text after each visible line, where no diagnostic message is.
fn Editor.render_ghosts(self, mut s Screen, h int, gw int, shown Set[int])
    for r in 0..h
        l := self.top + r
        if l >= self.lines.len()
            break
        if shown.contains(l + 1)
            continue
        t := sem.ghost(self.layer, l)
        if t == ""
            continue
        mut bg := BG
        if l == self.line
            bg = LINE_BG
        x := (gw + self.lines[l].len() - self.left + 2).max(gw)
        s.put(r, x, t, GUTTER_FG, bg)

## The layer's commands: "l" cycles the kind colors and code lens (palette),
## "h" toggles inlay hints (Alt-I), "x" is fix-all (Ctrl-Shift-.), "y" is
## the `ail fix` preview (palette), "f" previews the first fix (Ctrl-.).
fn Editor.layer_key(mut self, k str)
    self.layer.pending = false
    self.layer.proposed = []
    if k == "l"
        if self.layer.level == 0
            self.layer.level = 1
        else
            self.layer.level = 0
        self.refresh_layer()
        if self.layer.level == 0
            self.message = "semantic layer: off"
        else
            self.message = "semantic layer: kind colors and code lens"
    elif k == "h"
        self.layer.hints_on = not self.layer.hints_on
        self.layer.hints = Map[int, str]()
        self.refresh_layer()
        if self.layer.hints_on
            self.message = "inlay hints: on (refreshed on save)"
        else
            self.message = "inlay hints: off"
    elif k == "f"
        self.fix_preview()
    elif k == "x"
        self.fix_all_preview()
    else
        self.ail_fix_preview()

## The edits of a diagnostic's first fix, for the semantic module.
fn sem_edits(fix List[TextEdit]) List[sem.Edit]
    mut out := List[sem.Edit]()
    for e in fix
        out.push(sem.Edit(
            line: e.line,
            col: e.col,
            end_line: e.end_line,
            end_col: e.end_col,
            text: e.text,
        ))
    out

## Shows `title` and the changes from the buffer to `next`; Enter applies
## them, any other key cancels.
fn Editor.propose(mut self, title str, next List[str])
    diff := sem.diff_rows(self.lines, next, (self.pane_rows() - 2).max(1))
    self.layer.pending = true
    self.layer.proposed = next
    self.pane_text = [title]
    for row in diff
        self.pane_text.push(row)
    self.pane = Text
    self.message = "Enter applies, any other key cancels"

## Ctrl-.: the first fix of the diagnostic under the cursor, as a preview.
fn Editor.fix_preview(mut self)
    d := self.diag_here() else
        self.message = "no diagnostic here"
        return
    if d.fix.len() == 0
        self.message = "no fix for {d.rule}"
        return
    self.propose("fix: {d.fix_title}", sem.apply_edits(self.lines, reversed_edits(d.fix)))

fn Editor.fix_all_preview(mut self)
    mut fixes := List[sem.Fix]()
    for d in self.diags
        if d.fix.len() > 0
            fixes.push(sem.Fix(rule: d.rule, title: d.fix_title, edits: sem_edits(d.fix)))
    if fixes.len() == 0
        self.message = "no fixes: Ctrl-K checks, and not every diagnostic has one"
        return
    plan := sem.fix_all(fixes)
    self.propose("fix all: {plan.titles.len()} fixes", sem.apply_edits(self.lines, plan.edits))

## `ail fix` on a copy of the buffer: the text it leaves, or none.
fn Editor.fixed_text(mut self) str?
    file := "{self.path}.edit-fix.ail"
    fs.write_text(file, self.text()) else err
        self.message = "can't write {err.path}: {err.kind}"
        return none
    r := proc.run(ail_command(), ["fix", file], none, jb.CHECK_MS) else err
        self.message = jb.failure(err, jb.CHECK_MS)
        return none
    mut out := ""
    if r.status < 2
        out = fs.read_text(file) else ""
    fs.remove(file) else err
        self.message = "can't remove {err.path}: {err.kind}"
    if out == ""
        return none
    out

fn Editor.ail_fix_preview(mut self)
    fixed := self.fixed_text() else
        if self.message == ""
            self.message = "ail fix gave no result"
        return
    mut next := fixed.split("\n")
    if next.len() > 1 and next[next.len() - 1] == ""
        next.pop()
    if next == self.lines
        self.message = "ail fix: nothing to fix"
        return
    self.propose("ail fix", next)

## While a preview is pending: Enter applies it, any other key cancels it
## (and is handled as usual). True if the event was used up.
fn Editor.layer_confirm(mut self, ev ui.Event) bool
    match ev
        Key(k, ctrl, alt, shift) =>
            if k == Enter and not ctrl and not alt
                self.snapshot()
                self.lines = self.layer.proposed
                self.line = self.line.min(self.lines.len() - 1)
                self.set_col(self.col.min(self.cur().len()))
                self.layer.pending = false
                self.layer.proposed = []
                self.pane = Diags
                self.scroll()
                self.message = "applied; Ctrl-K checks again"
                return true
            self.layer.pending = false
            self.layer.proposed = []
            self.pane = Diags
            false
        Resize(_, _) | Close | Mouse(_, _, _, _) | Scroll(_) => false

## What F1 adds under a rule's text: its spec chapter, and the first fix as
## a change.
fn Editor.explain_extras(mut self, d Diag)
    spec := sem.spec_line(d.rule)
    if spec != ""
        self.pane_text.push(spec)
    if d.fix.len() > 0
        self.pane_text.push("fix: {d.fix_title}")
        for row in sem.diff_rows(self.lines, sem.apply_edits(self.lines, reversed_edits(d.fix)), 6)
            self.pane_text.push(row)

## A fix's edits last to first, as `apply_fix` applies them.
fn reversed_edits(fix List[TextEdit]) List[sem.Edit]
    mut out := List[sem.Edit]()
    mut i := fix.len() - 1
    while i >= 0
        out.push(sem_edits([fix[i]])[0])
        i -= 1
    out

# ---- Tests (headless) ---------------------------------------------------

fn typed(text str, cmds List[Command]) Editor
    mut ed := Editor.new("t.ail", text, 40, 12)
    for c in cmds
        ed.apply(c)
    ed

fn keys(s str) List[Command]
    mut out := List[Command]()
    for c in s.chars()
        if c == '\n'
            out.push(Newline)
        else
            out.push(Insert("{c}"))
    out

@test fn typing_and_auto_indent()
    ed := typed("", keys("fn main()\nprint(1)\n"))
    assert_eq(ed.lines, ["fn main()", "    print(1)", "    "])
    assert_eq(ed.line, 2)
    assert_eq(ed.col, 4)
    assert(ed.dirty)

@test fn block_openers()
    assert(opens_block("    if x := f()"))
    assert(opens_block("x := match c"))
    assert(opens_block("    Red =>"))
    assert(opens_block("n := parse(s) else err"))
    assert(opens_block("@test fn t()"))
    assert(not opens_block("x := 1"))
    assert(not opens_block("# fn"))

@test fn backspace_dedents_and_joins()
    mut ed := typed("fn f()\n        x", [])
    ed.apply(Go(Down))
    ed.apply(Go(Home))
    assert_eq(ed.col, 8)
    ed.apply(Backspace)
    assert_eq(ed.lines[1], "    x")
    ed.apply(Go(Home))
    ed.apply(Backspace)
    assert_eq(ed.lines, ["fn f()    x"])
    assert_eq(ed.col, 6)

@test fn delete_and_undo()
    mut ed := typed("ab\ncd", [])
    ed.apply(Go(End))
    ed.apply(Delete)
    assert_eq(ed.lines, ["abcd"])
    ed.apply(Insert("X"))
    ed.apply(Undo)
    ed.apply(Undo)
    assert_eq(ed.lines, ["ab", "cd"])
    assert_eq(ed.col, 2)
    ed.apply(Undo)
    assert_eq(ed.message, "nothing to undo")

@test fn paste_with_newlines()
    mut ed := typed("<>", [Go(Right)])
    ed.apply(Insert("a\nbc\nd"))
    assert_eq(ed.lines, ["<a", "bc", "d>"])
    assert_eq(ed.line, 2)
    assert_eq(ed.col, 1)

@test fn word_and_line_moves()
    mut ed := typed("foo.bar(baz)\nx", [Go(WordRight)])
    assert_eq(ed.col, 3)
    ed.apply(Go(WordRight))
    assert_eq(ed.col, 7)
    ed.apply(Go(WordLeft))
    assert_eq(ed.col, 4)
    ed.apply(Go(Down))
    assert_eq(ed.col, 1)
    ed.apply(Go(Up))
    assert_eq(ed.col, 4)
    ed.apply(Go(Bottom))
    assert_eq(ed.line, 1)
    ed.apply(Go(Right))
    assert_eq(ed.line, 1)

@test fn tab_inserts_spaces()
    ed := typed("ab", [Go(Right), Tab])
    assert_eq(ed.lines[0], "a   b")

@test fn render_rows()
    ed := typed("fn main()\n    print(\"hi\")", [Insert("x")])
    s := ed.render()
    assert_eq(s.text[0], "  1 xfn main()")
    assert_eq(s.text[1], "  2     print(\"hi\")")
    assert_eq(s.text[7], " t.ail *  Ln 1, Col 2  0 errors, 0 warni")
    assert_eq(s.cursor_row, 0)
    assert_eq(s.cursor_col, 5)
    assert_eq(s.rows, 12)

@test fn highlighting()
    fgs := colors("fn f(x Int) # c".chars())
    assert_eq(fgs[0], KEYWORD_FG)
    assert_eq(fgs[3], FG)
    assert_eq(fgs[7], TYPE_FG)
    assert_eq(fgs[14], COMMENT_FG)
    s := colors("@test \"a\\\"b\" 'c' 0x1f r\"\\d\"".chars())
    assert_eq(s[0], ATTR_FG)
    assert_eq(s[6], STRING_FG)
    assert_eq(s[11], STRING_FG)
    assert_eq(s[12], OP_FG)
    assert_eq(s[13], STRING_FG)
    assert_eq(s[17], NUMBER_FG)
    assert_eq(s[20], NUMBER_FG)
    assert_eq(s[22], STRING_FG)
    assert_eq(s[26], STRING_FG)

@test fn new_keywords_are_highlighted()
    for w in ["requires", "ensures", "invariant", "par", "with"]
        assert(KEYWORDS.contains(w))
    assert_eq(colors("par for i in 0..3".chars())[0], KEYWORD_FG)
    c := colors("ensures result > old(x) then".chars())
    assert_eq(c[8], KEYWORD_FG)
    assert_eq(c[24], KEYWORD_FG)
    h := colors("x := uhwhatnow?".chars())
    assert_eq(h[5], KEYWORD_FG)
    assert_eq(h[14], KEYWORD_FG)
    # `result` outside a contract is a plain name
    assert_eq(colors("result := 1".chars())[0], FG)

@test fn par_and_with_open_blocks()
    assert(opens_block("par for i in 0..n"))
    assert(opens_block("with m as mut x"))
    assert(not opens_block("requires b != 0"))
    ed := typed("", keys("par for i in 0..3\nx\n"))
    assert_eq(ed.lines, ["par for i in 0..3", "    x", "    "])
    ed2 := typed("", keys("with m as mut x\nx\n"))
    assert_eq(ed2.lines, ["with m as mut x", "    x", "    "])

@test fn select_and_yield_are_keywords()
    for w in ["select", "yield"]
        assert(KEYWORDS.contains(w))
    assert_eq(KEYWORDS.len(), 43)
    assert_eq(colors("select".chars())[0], KEYWORD_FG)
    y := colors("    yield n".chars())
    assert_eq(y[4], KEYWORD_FG)
    assert_eq(y[10], FG)
    mut texts := List[str]()
    for c in typed("yi", [Go(End)]).candidates()
        texts.push(c.text)
    assert(texts.contains("yield"))

@test fn bit_operators_are_highlighted()
    # expr.bit.3: `&`, `^`, `~`, `<<`, `>>` and their assignments color as operators
    b := colors("m := (a & 0xff) ^ ~b << 2 >> 1".chars())
    for k in [8, 16, 18, 21, 22, 26, 27]
        assert_eq(b[k], OP_FG)
    for k in [10, 13, 24, 29]
        assert_eq(b[k], NUMBER_FG)
    assert_eq(b[19], FG)
    a := colors("x <<= 1 # c".chars())
    assert_eq(a[2], OP_FG)
    assert_eq(a[4], OP_FG)
    assert_eq(a[6], NUMBER_FG)
    assert_eq(a[8], COMMENT_FG)

@test fn literal_forms_are_highlighted()
    # a string inside `\{...}` doesn't end the outer one (lex.str.2), nor a format spec (lex.str.7)
    s := colors("p(\"\{xs.join(\", \")} \{n:08}\") # c".chars())
    for k in [2, 13, 14, 17, 22, 25]
        assert_eq(s[k], STRING_FG)
    assert_eq(s[28], COMMENT_FG)
    # `b"..."` is a `bytes` literal with no interpolation (lex.bytes.1)
    bs := colors("x := b\"a\{\" # c".chars())
    assert_eq(bs[5], STRING_FG)
    assert_eq(bs[9], STRING_FG)
    assert_eq(bs[11], COMMENT_FG)
    # `r"""` opens a raw multi-line string (lex.str.6)
    assert_eq(colors("r\"\"\"a\"b".chars())[6], STRING_FG)
    # an exponent keeps its sign; after `0x` the `-` subtracts (lex.num.1-2)
    e := colors("1e-3 + 2.5E+8 - 0x1e-3".chars())
    for k in [2, 3, 11, 12, 19, 21]
        assert_eq(e[k], NUMBER_FG)
    for k in [5, 14, 20]
        assert_eq(e[k], OP_FG)
    n := colors("0b1010_0101 1_000".chars())
    assert_eq(n[10], NUMBER_FG)
    assert_eq(n[16], NUMBER_FG)

@test fn select_unsafe_and_value_blocks_indent()
    assert(opens_block("select"))
    assert(opens_block("    v := ch.recv() =>"))
    assert(opens_block("    after 100 =>"))
    assert(not opens_block("    closed => break"))
    assert(opens_block("unsafe"))
    assert(opens_block("unsafe fn poke(p *int)"))
    assert(opens_block("pub fn f()"))
    assert(opens_block("pub unique struct File"))
    assert(opens_block("defer if done"))
    assert(opens_block("outer: for x in xs"))
    assert(opens_block("return match s"))
    assert(opens_block("total += if big"))
    assert(opens_block("    Red => if c"))
    assert(not opens_block("x := if c then 1 else 2"))
    assert(not opens_block("x := f() else 0"))
    assert(not opens_block("yield n * 2"))
    assert(not opens_block("extern c fn abs(x int) int"))
    ed := typed("", keys("select\nv := ch.recv() =>\nprint(v)\n"))
    assert_eq(ed.lines, ["select", "    v := ch.recv() =>", "        print(v)", "        "])
    ed2 := typed("", keys("total += if big\n1\nelse"))
    assert_eq(ed2.lines, ["total += if big", "    1", "else"])

@test fn horizontal_and_vertical_scroll()
    mut ed := typed("", [])
    for _ in 0..30
        ed.apply(Newline)
    assert_eq(ed.line, 30)
    s := ed.render()
    assert_eq(s.cursor_row, ed.text_rows() - 1)
    ed.apply(Insert("y".repeat(50)))
    assert(ed.left > 0)
    assert_eq(ed.render().cursor_col, 39)

@test fn keys_map_to_commands()
    assert_eq(key_command("s", true, false, false), Save)
    assert_eq(key_command("Q", true, false, true), Quit)
    assert_eq(key_command("left", true, false, false), Go(WordLeft))
    assert_eq(key_command("A", false, false, true), Insert("A"))
    assert_eq(key_command("f1", false, false, false), Explain)
    assert_eq(key_command("enter", false, false, false), Newline)
    assert_eq(key_command("x", false, true, false), none)
    assert_eq(key_command("f5", false, false, false), none)

@test fn quit_asks_when_dirty()
    mut ed := typed("", [Insert("a"), Quit])
    assert(not ed.quit)
    assert(ed.quit_armed)
    ed.apply(Go(Left))
    ed.apply(Quit)
    assert(not ed.quit)
    ed.apply(Quit)
    assert(ed.quit)
    clean := typed("", [Quit])
    assert(clean.quit)

DIAG_JSON := "\{\"api\":1,\"severity\":\"error\",\"rule\":\"expr.name.1\",\"file\":\"t.ail\",\"line\":2,\"col\":5,\"message\":\"unknown name `prnt`\",\"help\":\"did you mean `print`?\",\"end_line\":2,\"end_col\":9,\"fixes\":[\{\"title\":\"replace `prnt` with `print`\",\"edits\":[\{\"line\":2,\"col\":5,\"end_line\":2,\"end_col\":9,\"text\":\"print\"}]}]}"

@test fn diagnostics_parse_show_and_fix()
    ds := parse_diags("noise\n{DIAG_JSON}\n")
    assert_eq(ds.len(), 1)
    assert_eq(ds[0].rule, "expr.name.1")
    assert_eq(ds[0].fix[0].text, "print")
    mut ed := typed("fn main()\n    prnt(1)", [])
    ed.diags = ds
    ed.cols = 100
    s := ed.render()
    assert_eq(
        s.text[8],
        " 2:5 error[expr.name.1] unknown name `prnt`  [Ctrl-. replace `prnt` with `print`]",
    )
    mut marked := 0
    for sp in s.spans
        if sp.bg == ERROR_BG
            marked += 1
            assert_eq(sp.text, "prnt")
    assert_eq(marked, 1)
    ed.apply(Fix)
    assert_eq(ed.message, "no diagnostic here")
    ed.apply(Go(Down))
    ed.apply(Fix)
    assert_eq(ed.lines[1], "    print(1)")
    assert_eq(ed.diags.len(), 0)
    ed.apply(Undo)
    assert_eq(ed.lines[1], "    prnt(1)")

@test fn redo_after_undo()
    mut ed := typed("", [Insert("a"), Insert("b"), Undo])
    assert_eq(ed.lines[0], "a")
    ed.apply(Redo)
    assert_eq(ed.lines[0], "ab")
    ed.apply(Undo)
    ed.apply(Insert("c"))
    ed.apply(Redo)
    assert_eq(ed.message, "nothing to redo")
    assert_eq(ed.lines[0], "ac")
    assert_eq(key_command("y", true, false, false), Redo)

@test fn find_as_you_type()
    mut ed := typed("alpha\nbeta\nalpha beta", [Go(Down), Find])
    for c in ["b", "e"]
        ed.apply(Insert(c))
    assert_eq([ed.line, ed.col], [1, 0])
    ed.apply(Newline)
    assert_eq([ed.line, ed.col], [2, 6])
    ed.apply(Newline)
    assert_eq([ed.line, ed.col], [1, 0])
    ed.apply(Backspace)
    ed.apply(Insert("x"))
    assert(ed.message.ends_with("(not found)"))
    ed.apply(Escape)
    assert_eq(ed.prompt, NoPrompt)
    ed.apply(Insert("Z"))
    assert_eq(ed.lines[1], "Zbeta")
    ed.apply(Find)
    ed.apply(Insert("a"))
    ed.apply(Go(Right))
    assert_eq(ed.prompt, NoPrompt)
    assert_eq(key_command("f3", false, false, false), FindNext)

@test fn regex_find_matches_patterns()
    mut ed := typed("ids 12 and 2026\nnone here", [Find])
    ed.apply(Insert("\\d\{4}"))
    assert(ed.message.ends_with("(not found)"))
    ed.apply(ToggleRegex)
    assert_eq(ed.regex_find, true)
    assert_eq([ed.line, ed.col], [0, 11])
    assert(ed.message.starts_with("find (regex): "))
    ed.apply(Escape)
    assert_eq(ed.prompt, NoPrompt)

@test fn regex_find_reports_no_match()
    mut ed := typed("alpha\nbeta", [Find, ToggleRegex])
    ed.apply(Insert("z+"))
    assert(ed.message.ends_with("(not found)"))
    assert_eq(match_from(["a".chars()[0]], ["x".chars()[0]], 0, true), none)

@test fn select_copy_cut_paste()
    mut ed := typed("one two\nthree", [Go(WordRight)])
    for _ in 0..4
        ed.apply(key_command("right", false, false, true) else Escape)
    assert_eq(ed.selected_text(), " two")
    ed.apply(Select(Down))
    assert_eq(ed.selected_text(), " two\nthree")
    ed.apply(Cut)
    assert_eq(ed.lines, ["one"])
    ed.apply(Go(Home))
    ed.apply(Paste)
    assert_eq(ed.lines, [" two", "threeone"])
    ed.apply(SelectAll)
    ed.apply(Copy)
    assert_eq(ed.clip, " two\nthreeone")
    ed.apply(Insert("x"))
    assert_eq(ed.lines, ["x"])
    ed.apply(Copy)
    assert_eq(ed.message, "nothing selected")

@test fn selection_is_drawn()
    mut ed := typed("abcdef", [Go(Right), Select(Right), Select(Right)])
    mut shown := ""
    for sp in ed.render().spans
        if sp.bg == SELECT_BG
            shown = sp.text
    assert_eq(shown, "bc")
    ed.apply(Backspace)
    assert_eq(ed.lines[0], "adef")
    assert(not ed.selecting)

@test fn window_events_drive_the_editor()
    mut ed := typed("", [])
    mut evs := List[ui.Event]()
    evs.push(Key(key: Text("h"), ctrl: false, alt: false, shift: false))
    evs.push(Key(key: Text("I"), ctrl: false, alt: false, shift: true))
    evs.push(Key(key: Left, ctrl: false, alt: false, shift: true))
    evs.push(Key(key: Text("c"), ctrl: true, alt: false, shift: false))
    evs.push(Key(key: End, ctrl: false, alt: false, shift: false))
    evs.push(Key(key: Text("v"), ctrl: true, alt: false, shift: false))
    evs.push(Resize(cols: 60, rows: 20))
    evs.push(Close)
    for ev in evs
        ed.on_event(ev)
    assert_eq(ed.lines, ["hII"])
    assert_eq([ed.cols, ed.rows], [60, 20])
    assert(ed.quit_armed)
    ed.on_event(Close)
    assert(ed.quit)

API_SRC := "struct P\n    x int\n\n## Adds.\nfn add(a int, b int) int\n    a + b\n\nfn main()\n    p := P(x: 1)\n    print(add(p.x, 2))"
API_JSON := "\{\"api\":1,\"file\":\"t.ail\",\"items\":[\{\"kind\":\"struct\",\"name\":\"P\",\"id\":\"type:P\",\"line\":1,\"col\":8,\"doc\":null,\"signature\":\"struct P\",\"error\":false,\"fields\":[\{\"kind\":\"field\",\"name\":\"x\",\"id\":\"field:P.x\",\"line\":2,\"col\":5,\"doc\":null,\"signature\":\"x int\",\"type\":\"int\"}],\"methods\":[]},\{\"kind\":\"fn\",\"name\":\"add\",\"id\":\"fn:add\",\"line\":5,\"col\":4,\"doc\":\"Adds.\",\"signature\":\"fn add(a int, b int) int\",\"params\":[\{\"name\":\"a\",\"type\":\"int\",\"mut\":false},\{\"name\":\"b\",\"type\":\"int\",\"mut\":false}],\"returns\":\"int\",\"effects\":[]},\{\"kind\":\"fn\",\"name\":\"main\",\"id\":\"fn:main\",\"line\":8,\"col\":4,\"doc\":null,\"signature\":\"fn main()\",\"params\":[],\"returns\":null,\"effects\":[\"io\"]}],\"references\":[\{\"id\":\"type:P\",\"line\":9,\"col\":10},\{\"id\":\"field:P.x\",\"line\":9,\"col\":12},\{\"id\":\"fn:add\",\"line\":10,\"col\":11},\{\"id\":\"field:P.x\",\"line\":10,\"col\":17}]}"

fn indexed(cmds List[Command]) Editor
    mut ed := typed(API_SRC, [])
    api := parse_api(API_JSON)
    ed.symbols = api.symbols
    ed.refs = api.refs
    ed.indexed = true
    ed.cols = 80
    ed.rows = 20
    for c in cmds
        ed.apply(c)
    ed

@test fn api_index_parses_nested_symbols()
    ed := indexed([])
    mut names := List[str]()
    for sym in ed.symbols
        names.push(sym.id)
    assert_eq(names.sorted(), ["field:P.x", "fn:add", "fn:main", "type:P"])
    assert_eq(ed.refs.len(), 4)

@test fn go_to_definition_and_hover()
    mut ed := indexed([Go(Bottom), Go(Home), Go(WordRight), Go(WordRight)])
    assert_eq(
        ed.word_at() else Range(line: 0, col: 0, end_line: 0, end_col: 0),
        Range(line: 9, col: 10, end_line: 9, end_col: 13),
    )
    ed.apply(GoToDefinition)
    assert_eq([ed.line, ed.col], [4, 3])
    assert_eq(ed.message, "fn add(a int, b int) int")
    ed.apply(Hover)
    assert_eq(ed.pane_text, ["fn add(a int, b int) int", "## Adds.", "fn fn:add, line 5"])
    ed.apply(Go(Top))
    ed.apply(Go(Down))
    ed.apply(Go(Down))
    ed.apply(GoToDefinition)
    assert_eq(ed.message, "no declaration found here")

## A key pressed with no modifiers.
fn press(k str) ui.Event
    Key(key: ui.key_code(k), ctrl: false, alt: false, shift: false)

## `ail api --refs` for `add` in API_SRC: its declaration and one call.
ADD_REFS_JSON := "\{\"api\":1,\"symbol\":\"fn:add\",\"refs\":[\{\"file\":\"t.ail.edit-query.ail\",\"line\":5,\"col\":4,\"def\":true},\{\"file\":\"t.ail.edit-query.ail\",\"line\":10,\"col\":11,\"def\":false},\{\"file\":\"other.ail\",\"line\":1,\"col\":1,\"def\":false}]}"

@test fn palette_lists_named_rows_and_runs_palette_only_ones()
    mut ws := Workspace.new(Editor.new("t.ail", "x\n", 40, 10))
    for r in ws.commands()
        assert(r.name != "")
    ws.run_command("nonesuch")
    assert_eq(ws.message, "no command `nonesuch`")
    ws.run_command("Toggle minimap")
    ws.run_command("Toggle zen mode")
    assert(ws.minimap and ws.zen)
    ws.run_command("Toggle zen mode")
    assert(not ws.zen)

@test fn changed_lines_show_in_the_gutter()
    mut ed := Editor.new("t.ail", "a\nb\nc\n", 40, 10)
    ed.git_marks = sdiff.changed_lines("@@ -2 +2 @@\n")
    row := ed.render().text[1]
    assert(row.contains("2+"))
    assert(not ed.render().text[0].contains("+"))
    ed.apply(Insert("x"))
    assert_eq(ed.git_marks.len(), 0)

@test fn dragging_a_tab_reorders_and_keeps_the_active_tab()
    mut ws := Workspace.new(Editor.new("a.ail", "a\n", 40, 10))
    ws.eds.push(Editor.new("b.ail", "b\n", 40, 10))
    ws.eds.push(Editor.new("c.ail", "c\n", 40, 10))
    ws.active = 0
    ws.move_tab(0, 2)
    assert_eq(ws.eds[0].path, "b.ail")
    assert_eq(ws.eds[2].path, "a.ail")
    assert_eq(ws.active, 2)
    ws.move_tab(5, 0)
    assert_eq(ws.eds[0].path, "b.ail")
    ws.run_command("Font larger")
    assert(ws.font > 20)

@test fn references_list_declaration_and_uses()
    found := refs_hits(".", parse_json(REFS_JSON) else Json.Null)
    assert_eq(found.len(), 3)
    assert_eq(found[0].text, "t.ail:9:5: declaration")
    assert_eq(found[1].text, "t.ail:10:15: reference")
    assert_eq(found[2].text, "other.ail:1:1: reference")
    assert_eq(found[2].loc.path, "other.ail")

@test fn reference_rows_stay_short_for_long_paths()
    long := "\{\"api\":1,\"refs\":[\{\"file\":\"/var/folders/zz/0123456789abcdef/T/some/deeper/project/other_module.ail\",\"line\":3,\"col\":7,\"def\":false}]}"
    found := refs_hits("/home/me/work", parse_json(long) else Json.Null)
    assert_eq(found[0].text, "other_module.ail:3:7: reference")
    assert(found[0].text.len() <= 80)

@test fn f2_renames_through_the_api_or_by_word()
    mut ed := indexed([Go(Bottom), Go(Home), Go(WordRight), Go(WordRight)])
    refs := parse_json(ADD_REFS_JSON) else Json.Null
    ed.rename = ed.rename_plan("add", refs)
    assert(ed.rename.semantic)
    assert_eq(ed.rename.at.len(), 2)
    ed.prompt = RenameTo
    ed.input = "add"
    for _ in 0..3
        ed.apply(Backspace)
    for c in keys("plus")
        ed.apply(c)
    assert(ed.message.starts_with("rename `add` (2 places, found by ail api) to: plus_"))
    ed.apply(Newline)
    assert_eq(ed.prompt, NoPrompt)
    assert_eq(ed.lines[4], "fn plus(a int, b int) int")
    assert_eq(ed.lines[9], "    print(plus(p.x, 2))")
    assert_eq(ed.col, 14)
    assert_eq(ed.message, "renamed 2 `add` to `plus` (via ail api); Ctrl-Z undoes")
    # Refs that don't name the cursor's place, or no answer: every whole word.
    ed.line = 4
    ed.set_col(8)
    assert(not ed.rename_plan("a", refs).semantic)
    ed.rename = ed.rename_plan("a", none)
    assert_eq(ed.rename.at.len(), 2)
    ed.prompt = RenameTo
    ed.input = "a"
    ed.apply(Backspace)
    ed.apply(Insert("x"))
    ed.apply(Newline)
    assert_eq(ed.lines[4], "fn plus(x int, b int) int")
    assert_eq(ed.lines[5], "    x + b")
    # A keyword isn't a name and keeps the prompt open; Esc cancels.
    ed.rename = ed.rename_plan("x", none)
    ed.prompt = RenameTo
    ed.input = ""
    ed.apply(Insert("if"))
    ed.apply(Newline)
    assert_eq(ed.message, "`if` isn't a name")
    assert_eq(ed.prompt, RenameTo)
    ed.apply(Escape)
    assert_eq(ed.prompt, NoPrompt)
    assert_eq(ed.lines[5], "    x + b")
    # One undo step per rename.
    ed.apply(Undo)
    assert_eq(ed.lines[4], "fn plus(a int, b int) int")
    assert_eq(key_command("f2", false, false, false), Rename)

@test fn completion_popup()
    mut ed := indexed([Go(Bottom), Newline, Insert("a"), Complete])
    assert(ed.completing)
    mut texts := List[str]()
    for c in ed.completions
        texts.push(c.text)
    assert_eq(texts, ["add", "and", "any", "as"])
    s := ed.render()
    assert(s.text[11].contains(" add fn add(a int, b int) int"))
    ed.apply(Insert("n"))
    assert_eq(ed.completions.len(), 2)
    ed.apply(Go(Down))
    ed.apply(Tab)
    assert(not ed.completing)
    assert_eq(ed.lines[10], "    any")
    ed.apply(Insert("."))
    ed.apply(Complete)
    assert_eq(ed.completions[0].text, "x")
    ed.apply(Insert(" "))
    assert(not ed.completing)
    assert_eq(key_command(" ", true, false, false), Complete)

@test fn brackets_and_quotes_pair()
    mut ed := typed("", [Insert("f"), Insert("("), Insert("\""), Insert("a")])
    assert_eq(ed.lines[0], "f(\"a\")")
    ed.apply(Insert("\""))
    ed.apply(Insert(")"))
    assert_eq(ed.lines[0], "f(\"a\")")
    assert_eq(ed.col, 6)
    ed.apply(Insert("["))
    ed.apply(Backspace)
    assert_eq(ed.lines[0], "f(\"a\")")
    ed.apply(Go(Home))
    ed.apply(Insert("("))
    assert_eq(ed.lines[0], "(f(\"a\")")

@test fn matching_bracket_is_marked()
    mut ed := typed("f(a[1],\n  b)", [Go(Right)])
    m := ed.bracket_match() else Range(line: 0, col: 0, end_line: 0, end_col: 0)
    assert_eq(m, Range(line: 0, col: 1, end_line: 1, end_col: 3))
    mut marked := 0
    for sp in ed.render().spans
        if sp.bg == BRACKET_BG
            marked += 1
    assert_eq(marked, 2)
    ed.apply(Go(Bottom))
    assert_eq(ed.bracket_match(), Range(line: 1, col: 3, end_line: 0, end_col: 1))

@test fn comment_duplicate_and_move_lines()
    mut ed := typed("fn f()\n    a\n\n    b", [Go(Down), Select(Down), Select(Down), Select(End)])
    ed.apply(ToggleComment)
    assert_eq(ed.lines, ["fn f()", "    # a", "", "    # b"])
    ed.apply(ToggleComment)
    assert_eq(ed.lines, ["fn f()", "    a", "", "    b"])
    ed.apply(Go(Top))
    ed.apply(DuplicateLine)
    assert_eq(ed.lines[..2], ["fn f()", "fn f()"])
    assert_eq(ed.line, 1)
    ed.apply(MoveLine(true))
    assert_eq(ed.lines[..3], ["fn f()", "    a", "fn f()"])
    assert_eq(ed.line, 2)
    ed.apply(MoveLine(false))
    ed.apply(MoveLine(false))
    assert_eq(ed.line, 0)
    ed.apply(MoveLine(false))
    assert_eq(ed.line, 0)
    assert_eq(key_command("down", false, true, false), MoveLine(true))
    assert_eq(key_command("/", true, false, false), ToggleComment)

@test fn replace_and_go_to_line()
    mut ed := typed("a b a\nab", [Find, Insert("a")])
    ed.apply(Replace)
    assert_eq(ed.prompt, ReplaceText)
    for c in ["x", "y"]
        ed.apply(Insert(c))
    ed.apply(Newline)
    assert_eq(ed.lines[0], "xy b a")
    assert_eq([ed.line, ed.col], [0, 5])
    ed.apply(ReplaceAll)
    assert_eq(ed.lines, ["xy b xy", "xyb"])
    assert_eq(ed.message, "replaced 2")
    ed.apply(Undo)
    assert_eq(ed.lines, ["xy b a", "ab"])
    ed.apply(GoToLine)
    for c in ["2", "x"]
        ed.apply(Insert(c))
    assert(ed.message.contains("go to line: 2_"))
    ed.apply(Newline)
    assert_eq(ed.line, 1)
    assert_eq(key_command("g", true, false, false), GoToLine)
    assert_eq(key_command("f", false, true, true), Format)

## The color of the last run drawn over a cell.
fn fg_at(s Screen, row int, col int) int
    mut fg := -1
    for sp in s.spans
        if sp.row == row and sp.col <= col and col < sp.col + sp.text.len()
            fg = sp.fg
    fg

@test fn multi_line_strings_are_highlighted()
    src := "x := \"\"\"\n    fn not code\n    \"\"\" + y\n# \"\"\" comment\nfn f()"
    mut ed := typed(src, [])
    ed.cols = 60
    s := ed.render()
    assert_eq(fg_at(s, 0, 9), STRING_FG)
    assert_eq(fg_at(s, 1, 8), STRING_FG)
    assert_eq(fg_at(s, 2, 8), STRING_FG)
    assert_eq(fg_at(s, 2, 12), OP_FG)
    assert_eq(fg_at(s, 3, 6), COMMENT_FG)
    assert_eq(fg_at(s, 4, 4), KEYWORD_FG)
    assert(not ends_in_triple("# \"\"\"".chars(), false))

@test fn dot_completes_and_paren_shows_signature()
    mut ed := indexed([Go(Bottom), Newline, Insert("p"), Insert(".")])
    assert(ed.completing)
    assert_eq(ed.completions[0].text, "x")
    ed.apply(Escape)
    ed.apply(Backspace)
    ed.apply(Backspace)
    for c in ["a", "d", "d", "("]
        ed.apply(Insert(c))
    assert_eq(ed.layer.sig.rows[0], "fn add(a int, b int) int")
    assert_eq(ed.lines[10], "    add()")

@test fn occurrences_and_inline_messages()
    mut ed := typed("total := 1\nx := total + subtotal\nprnt(total)", [Go(Right)])
    ed.cols = 60
    ds := parse_diags(DIAG_JSON)
    ed.diags = [Diag(
        severity: "error",
        rule: "expr.name.1",
        line: 3,
        col: 1,
        end_line: 3,
        end_col: 5,
        message: "unknown name",
        help: "",
        fix_title: "",
        fix: ds[0].fix,
    )]
    s := ed.render()
    mut occ := List[str]()
    for sp in s.spans
        if sp.bg == OCCUR_BG
            occ.push("{sp.row}:{sp.text}")
    assert_eq(occ, ["0:total", "1:total", "2:total"])
    assert(s.text[2].ends_with("prnt(total)   -- unknown name"))
    assert_eq(word_marks("ab abc ab".chars(), "ab"), [
        true,
        true,
        false,
        false,
        false,
        false,
        false,
        true,
        true,
    ])

@test fn else_lines_up_with_its_if()
    mut ed := typed("fn f()\n    if a\n        b", [Go(Bottom), Newline])
    for c in ["e", "l", "s", "e"]
        ed.apply(Insert(c))
    assert_eq(ed.lines[3], "    else")
    assert_eq(ed.col, 8)
    ed.apply(Newline)
    assert_eq(ed.lines[4], "        ")

LOCALS_JSON := "\{\"api\":1,\"file\":\"t.ail\",\"line\":11,\"col\":15,\"locals\":[\{\"name\":\"p\",\"type\":\"P\",\"mut\":false,\"kind\":\"binding\",\"line\":9,\"col\":5},\{\"name\":\"index\",\"type\":\"int\",\"mut\":false,\"kind\":\"loop\",\"line\":10,\"col\":9}]}"
REFS_JSON := "\{\"api\":1,\"file\":\"t.ail.edit-query.ail\",\"line\":9,\"col\":5,\"symbol\":\"local:p\",\"refs\":[\{\"file\":\"t.ail.edit-query.ail\",\"line\":9,\"col\":5,\"def\":true},\{\"file\":\"t.ail.edit-query.ail\",\"line\":10,\"col\":15,\"def\":false},\{\"file\":\"other.ail\",\"line\":1,\"col\":1,\"def\":false}]}"
TYPE_JSON := "\{\"api\":1,\"file\":\"t.ail\",\"line\":10,\"col\":11,\"text\":\"add\",\"start_col\":11,\"end_col\":14,\"type\":\"fn(int, int) int\",\"symbol\":\"fn:add\",\"callee\":\{\"signature\":\"fn add(a int, b int) int\",\"doc\":\"Adds.\"}}"

@test fn locals_and_member_types_steer_completion()
    mut ed := indexed([])
    ed.locals = parse_locals(parse_json(LOCALS_JSON) else Json.Null)
    assert_eq(ed.locals[1], Completion(text: "index", detail: "int (loop)"))
    ed.apply(Go(Bottom))
    ed.apply(Newline)
    ed.apply(Insert("i"))
    ed.apply(Complete)
    assert_eq(ed.completions[0].text, "index")
    ed.apply(Escape)
    ed.member_of = "Q"
    ed.apply(Insert("."))
    ed.apply(Complete)
    assert(not ed.completing)
    ed.member_of = parse_type_name("P")
    ed.apply(Complete)
    assert_eq(ed.completions[0].text, "x")
    assert_eq(parse_type_name("List[P]"), "List")

@test fn hover_shows_type_signature_and_doc()
    mut ed := indexed([])
    ed.show_info(parse_json(TYPE_JSON) else Json.Null, Json.Null)
    assert_eq(ed.pane_text, ["add: fn(int, int) int", "fn add(a int, b int) int", "## Adds."])
    assert_eq(ed.pane, Text)

@test fn outline_parse_and_jump()
    items := parse_outline("    1  fn main()\n        ## Doc.\n   12      fn Point.x(self) int\n")
    assert_eq(items.len(), 2)
    assert_eq(items[1].line, 12)
    assert_eq(items[1].text, "    fn Point.x(self) int")
    mut text := ""
    for i in 0..20
        text = "{text}line {i}\n"
    mut ed := typed(text, [])
    ed.outline = items
    ed.pane = Outline
    ed.apply(Go(Down))
    ed.apply(Newline)
    assert_eq(ed.line, 11)
    assert_eq(ed.pane, Diags)

@test fn mouse_clicks_drags_and_scrolls()
    mut ed := typed("fn main()\n    print(1)\n    print(2)\n", [])
    gw := ed.gutter_width()
    ed.on_event(Mouse(col: gw + 4, row: 1, button: Left, kind: Down))
    assert_eq([ed.line, ed.col], [1, 4])
    ed.on_event(Mouse(col: gw + 9, row: 2, button: Left, kind: Drag))
    ed.on_event(Mouse(col: gw + 9, row: 2, button: Left, kind: Up))
    assert_eq(ed.selected_text(), "print(1)\n    print")
    # Past the end of a line, a click lands at its end.
    ed.on_event(Mouse(col: 99, row: 0, button: Left, kind: Down))
    assert_eq([ed.line, ed.col], [0, 9])
    assert(ed.selection() == none)
    ed.on_event(Scroll(lines: 2))
    assert_eq(ed.top, 2)
    ed.on_event(Scroll(lines: -5))
    assert_eq(ed.top, 0)

@test fn clicking_a_diagnostic_jumps_to_it()
    mut ed := typed("fn main()\n    prnt(1)\n", [])
    ed.diags = parse_diags(DIAG_JSON)
    ed.on_event(Mouse(col: 3, row: ed.text_rows() + 1, button: Left, kind: Down))
    assert_eq([ed.line, ed.col], [1, 4])

@test fn run_output_goes_to_the_pane()
    mut ed := typed("", [])
    ed.show_output("run", proc.Output(status: 1, out: "a\nb\n", err: "oops\n"))
    assert_eq(ed.pane, Text)
    assert_eq(ed.pane_text, ["ail run: exit 1", "a", "b", "oops"])
    assert_eq(extra_key("f5", false, false, false), RunFile)
    assert(extra_key("f5", true, false, false) == none)

@test fn output_locations()
    loc := output_location(
        "/a/t.ail:3:13: trap[type.coll.4]: index 3",
        "x.ail",
    ) else unreachable("no location")
    assert_eq([loc.path, "{loc.line}", "{loc.col}"], ["/a/t.ail", "3", "13"])
    loc2 := output_location(
        "t.ail.edit-check.ail:7:2: trap",
        "t.ail",
    ) else unreachable("no location")
    assert_eq(loc2.path, "t.ail")
    loc3 := output_location(
        "FAIL a: assertion failed: left is 1, right is 2 at 4:14",
        "u.ail",
    ) else unreachable("no location")
    assert_eq([loc3.path, "{loc3.line}", "{loc3.col}"], ["u.ail", "4", "14"])
    assert(output_location("Hello, world!", "u.ail") == none)
    assert(output_location("see notes.ail", "u.ail") == none)

@test fn clicking_output_jumps()
    mut ed := typed("fn main()\n    xs := [1]\n    print(xs[3])\n", [])
    ed.show_output("run", proc.Output(
        status: 1,
        out: "",
        err: "t.ail:3:13: trap[type.coll.4]: out of bounds\n",
    ))
    assert_eq(ed.pane_text.len(), 2)
    ed.on_event(Mouse(col: 2, row: ed.text_rows() + 2, button: Left, kind: Down))
    assert_eq([ed.line, ed.col], [2, 12])
    # Long output keeps its end.
    mut long := ""
    for i in 0..50
        long = "{long}line {i}\n"
    ed.show_output("run", proc.Output(status: 0, out: long, err: ""))
    assert_eq(ed.pane_text[ed.pane_text.len() - 1], "line 49")
    assert(ed.pane_text[1].starts_with("... "))

@test fn shift_click_extends_the_selection()
    mut ws := Workspace.new(typed("abc\ndef\n", []))
    gw := ws.eds[0].gutter_width()
    plain := ui.Modifiers(ctrl: false, alt: false, shift: false)
    shift := ui.Modifiers(ctrl: false, alt: false, shift: true)
    ws.on_window_event(Mouse(col: gw + 1, row: 1, button: Left, kind: Down), plain)
    ws.on_window_event(Mouse(col: gw + 1, row: 1, button: Left, kind: Up), plain)
    ws.on_window_event(Mouse(col: gw + 2, row: 2, button: Left, kind: Down), shift)
    assert_eq(ws.eds[0].selected_text(), "bc\nde")
    # A second Shift-click moves the end, keeping the start.
    ws.on_window_event(Mouse(col: gw + 3, row: 1, button: Left, kind: Down), shift)
    assert_eq(ws.eds[0].selected_text(), "bc")

@test fn tabs_and_the_picker()
    mut ws := Workspace.new(typed("x", []))
    ws.eds[0].path = "a.ail"
    ws.eds.push(typed("y", []))
    ws.eds[1].path = "dir/b.ail"
    ws.on_event(Key(key: Tab, ctrl: true, alt: false, shift: false))
    assert_eq(ws.active, 1)
    ws.on_event(Key(key: Tab, ctrl: true, alt: false, shift: true))
    assert_eq(ws.active, 0)
    s := ws.render()
    assert_eq(s.text[0], " a.ail   b.ail ")
    assert_eq(s.text[1].trim(), "1 x")
    ws.on_event(Mouse(col: 9, row: 0, button: Left, kind: Down))
    assert_eq(ws.active, 1)
    assert(fuzzy("edit.ail", "EdA"))
    assert(not fuzzy("edit.ail", "zz"))
    ws.files = ["a.ail", "dir/b.ail", "dir/c.ail"]
    ws.picking = true
    ws.on_event(Key(key: Text("c"), ctrl: false, alt: false, shift: false))
    assert_eq(ws.matches(), ["dir/c.ail"])
    ws.on_event(Key(key: Escape, ctrl: false, alt: false, shift: false))
    assert(not ws.picking)
    # Ctrl-W closes a clean tab; the last one quits.
    ws.on_event(Key(key: Text("w"), ctrl: true, alt: false, shift: false))
    assert_eq(ws.eds.len(), 1)
    ws.on_event(Key(key: Text("w"), ctrl: true, alt: false, shift: false))
    assert(ws.quit)

@test fn probe_keys_reach_the_workspace_and_the_trace_tree_folds()
    assert_eq(workspace_key("r", true, false, true), Probes("probe"))
    assert_eq(workspace_key("f7", false, false, true), Probes("values"))
    assert_eq(workspace_key("f9", false, false, false), Probes("next"))
    mut ws := Workspace.new(Editor.new("a.ail", "fn main()\n    pass\n", 60, 20))
    ws.probe_view = probes.tree_of(
        "\{\"api\":1,\"trace\":\"call\",\"fn\":\"main\",\"depth\":1,\"args\":\{},\"line\":1,\"col\":1}\n\{\"api\":1,\"trace\":\"effect\",\"call\":\"time.now\",\"args\":[],\"line\":2,\"col\":5}",
        "",
    )
    ws.probe_view.on = true
    ws.show_list(ws.probe_view.title(), hits_of("a.ail", ws.probe_view.rows()))
    assert_eq(ws.hits.len(), 2)
    assert(ws.probe_fold("left"))
    assert_eq(ws.hits.len(), 1)
    assert(ws.probe_fold("right"))
    assert_eq(ws.hits.len(), 2)
    assert(not ws.probe_fold("x"))

@test fn every_palette_row_names_a_key_that_does_something()
    mut names := Set[str]()
    for r in key_rows()
        if r.spec == ""
            continue
        assert(not names.contains(r.name))
        names.add(r.name)
        match key_event(r.spec)
            Key(code, ctrl, alt, shift) =>
                k := code.name()
                assert(
                    key_command(k, ctrl, alt, shift) != none
                        or extra_key(k, ctrl, alt, shift) != none
                        or workspace_key(k, ctrl, alt, shift) != none,
                )
            Resize(_, _) | Close | Mouse(_, _, _, _) | Scroll(_) => assert(false)
    assert_eq(key_table()[0], "| Key | Does |")

@test fn the_palette_filters_and_runs_a_command()
    mut ws := Workspace.new(typed("x := 1", []))
    ws.on_event(key_event("ctrl+shift+p"))
    assert(ws.picking and ws.commanding)
    for k in ["t", "o", "g", "c"]
        ws.on_event(press(k))
    assert_eq(ws.choices().len(), 1)
    assert(ws.render().text[1].contains("command: togc"))
    ws.on_event(press("enter"))
    assert(not ws.picking)
    assert_eq(ws.eds[0].lines[0], "# x := 1")
    # Escape closes it; Ctrl-P is the file picker again.
    ws.on_event(key_event("ctrl+shift+p"))
    ws.on_event(press("escape"))
    assert(not ws.picking and not ws.commanding)
    ws.on_event(key_event("ctrl+p"))
    assert(ws.picking and not ws.commanding)

@test fn the_ask_bar_types_and_shows_its_prompt()
    mut ws := Workspace.new(typed("fn main()\n    print(1)", []))
    ws.on_event(key_event("ctrl+shift+a"))
    assert(ws.askbar.open)
    for k in ["w", "h", "o"]
        ws.on_event(press(k))
    assert(ws.render().text[0].contains(" ask: who"))
    ws.on_event(press("escape"))
    assert(not ws.askbar.open)
    ws.on_event(key_event("ctrl+t"))
    assert(ws.render().text[0].starts_with(" go to symbol: "))
    ws.on_event(press("enter"))
    assert(not ws.askbar.open)

@test fn ask_rows_become_jumpable_hits()
    got := ask_hits([
        ask.Site(file: "", line: 0, col: 0, id: "fn:f", kind: "head", text: "fn:f  (1)"),
        ask.Site(
            file: "a.ail",
            line: 3,
            col: 2,
            id: "fn:g",
            kind: "site",
            text: "  a.ail:3:2: fn:g  call",
        ),
    ])
    assert_eq(got.len(), 2)
    assert_eq(got[0].loc.line, 0)
    assert_eq(got[1].loc, Loc(path: "a.ail", line: 3, col: 2))
    assert_eq(got[1].text, "  a.ail:3:2: fn:g  call")

@test fn the_token_meter_sits_on_the_status_row()
    mut ws := Workspace.new(typed("fn main()\n    print(1)", []))
    ws.askbar.counted("", 0, 42)
    row := ws.render().text[1 + ws.eds[0].text_rows()]
    assert(row.ends_with(" tok 42 "))
    ws.askbar.selected(7)
    assert(ws.render().text[1 + ws.eds[0].text_rows()].ends_with(" tok 42 (sel 7) "))

@test fn project_search_fills_the_pane_and_jumps()
    hits := search_text("a.ail", "fn main()\n    total := 1\n    print(total)", "total")
    assert_eq(hits.len(), 2)
    assert_eq(hits[1].loc, Loc(path: "a.ail", line: 3, col: 11))
    assert_eq(hits[1].text, "a.ail:3:11: print(total)")
    mut ws := Workspace.new(typed("fn main()\n    total := 1\n    print(total)", []))
    ws.eds[0].path = "a.ail"
    ws.rows = 24
    ws.on_event(Resize(cols: 60, rows: 24))
    ws.on_event(key_event("ctrl+shift+f"))
    assert(ws.searching)
    assert_eq(ws.search, "fn")
    assert(ws.render().text[0].starts_with(" search the project: fn"))
    ws.on_event(press("escape"))
    assert(not ws.searching)
    ws.search = "total"
    ws.show_hits(hits)
    assert(ws.browsing)
    ed := ws.eds[0]
    assert_eq(ed.pane, Text)
    assert_eq(ed.pane_text[2], "a.ail:3:11: print(total)")
    ws.on_event(press("down"))
    ws.on_event(press("enter"))
    assert(not ws.browsing)
    assert_eq(ws.eds[0].line, 2)
    assert_eq(ws.eds[0].col, 10)
    # F4 wraps to the first hit; typing goes to the editor again.
    ws.on_event(press("f4"))
    assert_eq(ws.eds[0].line, 1)
    ws.on_event(press("x"))
    assert(ws.eds[0].lines[1].contains("x"))

# test.sandbox.2: it writes a directory beside the program, and opening an
# .ail file runs ail for highlighting and checks.
@needs(fs, proc) @test fn the_file_tree_lists_ail_files_first_and_opens_them()
    d := "edit-tree-test.tmp"
    fs.make_dir("{d}/sub") else err
        assert(false)
    for f in ["b.ail", "a.txt", ".hidden", "sub/c.ail"]
        fs.write_text("{d}/{f}", "fn main()\n") else err
            assert(false)
    mut ws := Workspace.new(typed("x", []))
    ws.on_event(Resize(cols: 80, rows: 20))
    ws.tree_root = d
    ws.on_event(key_event("ctrl+b"))
    assert(ws.tree_open and ws.tree_focus)
    assert_eq(ws.eds[0].cols, 80 - TREE_W - 1)
    mut names := List[str]()
    for t in ws.tree
        names.push(t.name)
    assert_eq(names, ["b.ail", "sub/", "a.txt"])
    assert(ws.render().text[1].starts_with(" b.ail"))
    ws.on_event(press("down"))
    ws.on_event(press("enter"))
    assert_eq(ws.tree.len(), 4)
    assert_eq(ws.tree[2].path, "{d}/sub/c.ail")
    ws.on_event(press("down"))
    ws.on_event(press("left"))
    assert_eq(ws.tree_sel, 1)
    ws.on_event(press("down"))
    ws.on_event(press("enter"))
    assert_eq(ws.eds.len(), 2)
    assert_eq(ws.eds[1].path, "{d}/sub/c.ail")
    assert(not ws.tree_focus)
    assert_eq(ws.eds[1].cols, 80 - TREE_W - 1)
    # Typing goes to the editor; Ctrl-B focuses the tree, then hides it.
    ws.on_event(press("x"))
    assert_eq(ws.eds[1].lines[0], "xfn main()")
    ws.on_event(key_event("ctrl+b"))
    assert(ws.tree_focus)
    ws.on_event(key_event("ctrl+b"))
    assert(not ws.tree_open)
    assert_eq(ws.eds[0].cols, 80)
    for f in ["b.ail", "a.txt", ".hidden", "sub/c.ail", "sub", ""]
        fs.remove("{d}/{f}") else err
            assert(false)

@test fn tab_labels_count_diagnostics()
    mut ws := Workspace.new(typed("x", []))
    ws.eds[0].path = "a.ail"
    ws.eds[0].diags = parse_diags(DIAG_JSON)
    assert_eq(ws.tab_labels(), [" a.ail E1 "])

@test fn agent_panel_rows_from_trace_errors_and_coverage()
    trace := "\{\"trace\":\"call\",\"fn\":\"half\",\"depth\":2,\"args\":\{\"n\":\"4\"},\"line\":12,\"col\":10}\n\{\"severity\":\"trap\",\"rule\":\"type.coll.4\",\"line\":15,\"col\":12,\"message\":\"index 2 is out of bounds\",\"stack\":[\{\"fn\":\"main\",\"line\":15,\"col\":12,\"args\":\{},\"locals\":\{\"x\":\"2\"}}]}"
    rows := trace_hits("a.ail", trace, "2")
    assert_eq(rows.len(), 4)
    assert_eq(rows[0].text, "  call half(n = 4)  12:10")
    assert_eq(rows[1].text, "trap[type.coll.4] index 2 is out of bounds  15:12")
    assert_eq(rows[2].text, "  in main 15:12  locals: x = 2")
    assert_eq(rows[3].loc.line, 0)
    errs := "\{\"functions\":[\{\"name\":\"half\",\"line\":5,\"fails_with\":[\"E\"],\"paths\":[\{\"line\":8,\"col\":16,\"kind\":\"return\",\"errors\":[\"E\"]}]}]}"
    paths := failure_hits("a.ail", errs)
    assert_eq(paths[0].text, "fn half fails with E")
    assert_eq(paths[1].text, "  8:16 return: E")
    assert_eq(paths[1].loc, Loc(path: "a.ail", line: 8, col: 16))
    missed := parse_coverage("\{\"test\":\"t\"}\n\{\"coverage\":true,\"missed\":[[2,3],[7,7]]}")
    assert_eq(missed.len(), 3)
    assert(missed.contains(1) and missed.contains(2) and missed.contains(6))
    # The marks show in the gutter until the next edit.
    mut ed := typed("a\nb\nc", [])
    ed.missed = missed
    assert(ed.render().text[1].starts_with("  2!"))
    ed.apply(Insert("x"))
    assert_eq(ed.missed.len(), 0)

@test fn the_program_card_lists_declarations_that_jump()
    card := "\{\"card\":\"p\",\"entry\":\"main in a.ail\",\"tests\":[\"t\"],\"modules\":[\{\"module\":\"\",\"count\":2,\"items\":[\{\"kind\":\"fn\",\"name\":\"half\",\"signature\":\"fn half(n int) int\",\"effects\":[\"fail\"],\"requires\":[\"n >= 0\"]},\{\"kind\":\"const\",\"name\":\"N\",\"signature\":\"N := 16\"}]}],\"dropped\":[]}"
    src := Source(path: "a.ail", lines: [
        "N := 0x10",
        "",
        "pub fn half(n int) int",
        "    requires n >= 0",
        "    n / 2",
    ])
    rows := card_hits(parse_json(card) else Json.Null, [src])
    mut texts := List[str]()
    for r in rows
        texts.push(r.text)
    assert_eq(texts, [
        "entry: main in a.ail",
        "tests: t",
        "module (root): 2 items",
        "  fn half(n int) int  [fail]",
        "      requires n >= 0",
        "  N := 16",
    ])
    assert_eq(rows[3].loc, Loc(path: "a.ail", line: 3, col: 1))
    assert_eq(rows[4].loc.line, 3)
    assert_eq(rows[5].loc.line, 1)
    assert_eq(rows[0].loc.line, 0)

@test fn ctrl_q_twice_quits_with_unsaved_tabs()
    mut ws := Workspace.new(typed("", keys("x")))
    ws.on_event(key_event("ctrl+q"))
    assert(not ws.quit)
    assert(ws.message.contains("unsaved"))
    ws.on_event(key_event("ctrl+q"))
    assert(ws.quit)

@test fn another_key_between_disarms_ctrl_q()
    mut ws := Workspace.new(typed("", keys("x")))
    ws.on_event(key_event("ctrl+q"))
    ws.on_event(key_event("right"))
    ws.on_event(key_event("ctrl+q"))
    assert(not ws.quit)

@test fn quitting_asks_once_for_unsaved_tabs()
    mut ws := Workspace.new(typed("", keys("x")))
    ws.on_event(Close)
    assert(not ws.quit)
    ws.on_event(Close)
    assert(ws.quit)

@test fn themes_recolor_and_cycle()
    mut ws := Workspace.new(typed("", []))
    assert_eq(ws.pal.bg_of(BG), BG)
    assert(ws.set_theme("light"))
    assert_eq(ws.pal.bg_of(BG), 0xffffff)
    assert_eq(ws.pal.fg_of(KEYWORD_FG), 0x0000ff)
    assert_eq(ws.pal.fg_of(OP_FG), ws.pal.fg_of(FG))
    # A background color used as text follows its background kind.
    assert_eq(ws.pal.fg_of(BG), 0xffffff)
    assert(not ws.set_theme("neon"))
    assert_eq(ws.theme, "light")
    ws.on_event(Key(key: Text("T"), ctrl: true, alt: false, shift: true))
    assert_eq(ws.theme, "solarized")
    assert_eq(ws.message, "theme solarized")
    ws.on_event(Key(key: Text("T"), ctrl: true, alt: false, shift: true))
    ws.on_event(Key(key: Text("T"), ctrl: true, alt: false, shift: true))
    assert_eq(ws.theme, "ail-dark")
    for name in themes.NAMES
        t := themes.named(name) else unreachable("listed")
        for k in t.keys()
            assert(FG_KINDS.contains(k) or BG_KINDS.contains(k))

@test fn the_ail_themes_are_complete_and_the_default()
    assert_eq(DEFAULT_THEME, "ail-dark")
    assert_eq(themes.NAMES[0], DEFAULT_THEME)
    mut ws := Workspace.new(typed("", []))
    assert(ws.set_theme("ail-dark"))
    assert_eq(ws.pal.bg_of(BG), 0x17181c)
    assert_eq(ws.pal.bg_of(PANE_BG), ws.pal.bg_of(STATUS_BG))
    assert(ws.set_theme("ail-light"))
    assert_eq(ws.pal.bg_of(BG), 0xfbfbfc)
    assert_eq(ws.pal.fg_of(KEYWORD_FG), 0x2f5fd0)
    # Both name every color kind the older full themes name.
    full := themes.named("light") else unreachable("listed")
    for name in ["ail-dark", "ail-light"]
        t := themes.named(name) else unreachable("listed")
        for k in full.keys()
            assert(t.contains(k))

@test fn the_semantic_layer_colors_declarations_and_shows_a_lens()
    mut ed := indexed([])
    ed.layer.level = 1
    ed.refresh_layer()
    assert_eq(ed.layer.lens.get(4) else "", "1 ref")
    assert_eq(ed.layer.lens.get(7) else "", "0 refs | effects: io")
    s := ed.render()
    assert(s.text[4].contains("1 ref"))
    mut fns := 0
    mut fields := 0
    for sp in s.spans
        if sp.fg == FN_FG and sp.text == "add"
            fns += 1
        if sp.fg == FIELD_FG and sp.text == "x"
            fields += 1
    assert_eq(fns, 2)
    assert_eq(fields, 1)
    ed.layer.level = 0
    assert(not ed.render().text[4].contains("1 ref"))

@test fn inlay_hints_show_after_the_binding_when_on()
    mut ed := indexed([])
    ed.layer.hints_on = true
    ed.layer.hints[8] = "p: P"
    assert(ed.render().text[8].contains("p: P"))
    ed.layer_key("h")
    assert(not ed.layer.hints_on)
    assert(not ed.render().text[8].contains("p: P"))

@test fn fix_all_previews_then_applies_in_one_undo_step()
    mut ed := typed("fn main()\n    prnt(1)", [])
    ed.diags = parse_diags("{DIAG_JSON}\n")
    ed.layer_key("x")
    assert(ed.layer.pending)
    assert(ed.pane_text.contains("2 -     prnt(1)"))
    assert(ed.pane_text.contains("2 +     print(1)"))
    assert_eq(ed.lines[1], "    prnt(1)")
    ed.on_event(Key(key: Enter, ctrl: false, alt: false, shift: false))
    assert(not ed.layer.pending)
    assert_eq(ed.lines[1], "    print(1)")
    ed.apply(Undo)
    assert_eq(ed.lines[1], "    prnt(1)")

@test fn any_other_key_cancels_a_pending_preview()
    mut ed := typed("fn main()\n    prnt(1)", [])
    ed.diags = parse_diags("{DIAG_JSON}\n")
    ed.layer_key("x")
    ed.on_event(Key(key: Down, ctrl: false, alt: false, shift: false))
    assert(not ed.layer.pending)
    assert_eq(ed.lines[1], "    prnt(1)")

@test fn explain_adds_the_spec_chapter_and_the_fix_as_a_change()
    mut ed := typed("fn main()\n    prnt(1)", [])
    ds := parse_diags("{DIAG_JSON}\n")
    ed.pane_text = []
    ed.explain_extras(ds[0])
    assert(ed.pane_text.contains("spec: docs/spec/05-expressions.md (rule expr.name.1)"))
    assert(ed.pane_text.contains("2 +     print(1)"))

@test fn the_palette_toggles_the_semantic_layer()
    mut ws := Workspace.new(indexed([]))
    ws.run_command("Semantic layer")
    assert_eq(ws.eds[0].layer.level, 1)
    assert(ws.eds[0].layer.lens.len() > 0)
    ws.run_command("Semantic layer")
    assert_eq(ws.eds[0].layer.level, 0)

@test fn ctrl_dot_previews_the_fix_and_ctrl_shift_dot_previews_fix_all()
    mut ws := Workspace.new(typed("fn main()\n    prnt(1)", []))
    ws.eds[0].diags = parse_diags("{DIAG_JSON}\n")
    ws.eds[0].line = 1
    ws.on_event(Key(key: Text("."), ctrl: true, alt: false, shift: false))
    assert(ws.eds[0].layer.pending)
    assert_eq(ws.eds[0].lines[1], "    prnt(1)")
    ws.on_event(Key(key: Escape, ctrl: false, alt: false, shift: false))
    assert(not ws.eds[0].layer.pending)
    ws.on_event(Key(key: Text("."), ctrl: true, alt: false, shift: true))
    assert(ws.eds[0].layer.pending)
    ws.on_event(Key(key: Enter, ctrl: false, alt: false, shift: false))
    assert_eq(ws.eds[0].lines[1], "    print(1)")

@test fn settings_keep_other_lines()
    text := with_setting("font 15\ntheme dark\n", "theme", "light")
    assert_eq(text, "font 15\ntheme light\n")
    assert_eq(setting(text, "theme") else "", "light")
    assert_eq(setting("", "theme") else "none", "none")

@test fn settings_list_cycles_and_remembers_in_the_session()
    mut ws := Workspace.new(typed("", []))
    ws.on_event(key_event("ctrl+,"))
    assert(ws.picking and ws.picker_mode == "settings")
    assert_eq(ws.choices()[0], "{"Theme".pad_right(24, ' ')} dark")
    ws.on_event(press("enter"))
    assert_eq(ws.theme, "light")
    assert(ws.picking)
    assert_eq(setting(ws.prefs, "theme") else "", "light")
    ws.on_event(press("down"))
    ws.on_event(press("enter"))
    assert_eq(ws.font, 24)
    assert_eq(setting(ws.prefs, "font") else "", "24")
    ws.on_event(press("escape"))
    assert(not ws.picking)
    assert_eq(ws.picker_mode, "")

@test fn rebound_keys_act_as_the_original()
    mut ws := Workspace.new(typed("", []))
    ws.on_event(key_event("ctrl+shift+p"))
    for c in "rebind".chars()
        ws.on_event(press("{c}"))
    ws.on_event(press("enter"))
    assert_eq(ws.picker_mode, "bind")
    for c in "ctrl+alt+t as Next theme".chars()
        ws.on_event(press("{c}"))
    ws.on_event(press("enter"))
    assert_eq(ws.binds.len(), 1)
    assert_eq(ws.message, "ctrl+alt+t now acts as ctrl+shift+t")
    assert_eq(setting(ws.prefs, "bind.ctrl+alt+t") else "", "ctrl+shift+t")
    ws.on_event(key_event("ctrl+alt+t"))
    assert_eq(ws.theme, "light")
    ws.on_event(key_event("ctrl+shift+p"))
    for c in "rebind".chars()
        ws.on_event(press("{c}"))
    ws.on_event(press("enter"))
    for c in "f9 as nothing".chars()
        ws.on_event(press("{c}"))
    ws.on_event(press("enter"))
    assert_eq(ws.binds.len(), 1)
    assert(ws.message.starts_with("no command"))

# test.sandbox.2: it writes a directory beside the program, and opening an
# .ail file runs ail for highlighting and checks.
@needs(fs, proc) @test fn enter_on_an_unmatched_path_creates_the_file()
    d := "edit-newfile-test.tmp"
    fs.make_dir(d) else err
        assert(false)
    mut ws := Workspace.new(typed("", []))
    ws.on_event(key_event("ctrl+p"))
    for c in "{d}/fresh.ail".chars()
        ws.on_event(press("{c}"))
    ws.on_event(press("enter"))
    assert(fs.exists("{d}/fresh.ail"))
    assert_eq(ws.eds[ws.active].path, "{d}/fresh.ail")
    fs.remove("{d}/fresh.ail") else err
        assert(false)
    fs.remove(d) else err
        assert(false)

@test fn new_project_refuses_bad_names()
    mut ws := Workspace.new(typed("", []))
    ws.on_event(key_event("ctrl+shift+n"))
    assert_eq(ws.picker_mode, "new")
    ws.on_event(press("escape"))
    ws.new_project("Bad Name")
    assert(ws.message.contains("isn't a project name"))
    assert_eq(ws.eds.len(), 1)

@test fn welcome_lists_recent_projects_and_dismisses()
    mut ws := Workspace.new(typed("", []))
    ws.on_event(Resize(cols: 80, rows: 30))
    ws.prefs = "open:/proj 3,4,/proj/a.ail\n"
    ws.welcome = true
    mut found := false
    for row in ws.render().text
        if row.contains("1  /proj")
            found = true
    assert(found)
    ws.on_event(press("x"))
    assert(not ws.welcome)
    assert_eq(ws.eds[0].lines[0], "x")

@test fn the_tree_shows_git_marks()
    mut ws := Workspace.new(typed("x", []))
    ws.on_event(Resize(cols: 80, rows: 20))
    ws.gitmarks = true
    ws.git = {"a.ail": "M"}
    ws.tree = [TreeRow(path: "a.ail", name: "a.ail", depth: 0, dir: false)]
    ws.tree_open = true
    ws.resize_tabs()
    row := ws.render().text[1]
    assert(row.starts_with(" a.ail"))
    assert(row.slice(0, TREE_W).contains(" M"))

@test fn ctrl_plus_and_minus_step_the_font_size()
    mut ws := Workspace.new(typed("", []))
    ws.on_event(Key(key: Text("="), ctrl: true, alt: false, shift: false))
    assert_eq(ws.font, 24)
    ws.on_event(Key(key: Text("-"), ctrl: true, alt: false, shift: false))
    ws.on_event(Key(key: Text("-"), ctrl: true, alt: false, shift: false))
    assert_eq(ws.font, 18)
    ws.on_event(Key(key: Text("0"), ctrl: true, alt: false, shift: false))
    assert_eq(ws.font, 20)
    assert_eq(ws.eds[0].lines, [""])
    assert_eq(font_flag(["--font", "13"]), 13)
    assert_eq(font_flag(["--font"]), 20)

# ---- Front ends ---------------------------------------------------------

# ---- Window front end (std.ui) -----------------------------------------

## Draws a screen: the runs in order, then the caret.
fn draw(mut w ui.Window, s Screen)
    draw_themed(mut w, s, palette(Map[str, int]()))

## Draws a screen in a theme's colors.
fn draw_themed(mut w ui.Window, s Screen, pal Palette)
    w.clear(pal.bg_of(BG))
    for sp in s.spans
        w.put(sp.col, sp.row, sp.text, pal.fg_of(sp.fg), pal.bg_of(sp.bg))
    w.cursor(s.cursor_col, s.cursor_row)
    w.present()

# ---- Themes (ADR 0295) -----------------------------------------------------

## A theme as a recoloring of the default (dark) colors, by role.
struct Palette
    fg Map[int, int]
    bg Map[int, int]

## The recoloring for a theme from `themes.named`.
fn palette(t Map[str, int]) Palette
    mut fg := Map[int, int]()
    for k in FG_KINDS.keys()
        if c := t.get(k)
            fg[FG_KINDS[k]] = c
    mut bg := Map[int, int]()
    for k in BG_KINDS.keys()
        if c := t.get(k)
            bg[BG_KINDS[k]] = c
    Palette(fg: fg, bg: bg)

## A text color in the theme; a background color used as text follows its
## background kind.
fn Palette.fg_of(self, c int) int
    self.fg.get(c) else (self.bg.get(c) else c)

fn Palette.bg_of(self, c int) int
    self.bg.get(c) else (self.fg.get(c) else c)

## The editor's settings file, `~/.ail-edit`: lines of `KEY VALUE`.
fn settings_path() str?
    home := env.home() else return none
    "{home}/.ail-edit"

## The value of `key` in settings text.
fn setting(text str, key str) str?
    for line in text.split("\n")
        if line.starts_with("{key} ")
            return line.chars()[key.chars().len() + 1..].join("").trim()
    none

## Settings text with `key` set to `value`, other lines kept.
fn with_setting(text str, key str, value str) str
    mut out := List[str]()
    for line in text.split("\n")
        if line != "" and not line.starts_with("{key} ")
            out.push(line)
    out.push("{key} {value}")
    "{out.join("\n")}\n"

## The theme remembered in `~/.ail-edit`, or `DEFAULT_THEME`.
fn saved_theme() str
    path := settings_path() else return DEFAULT_THEME
    if not fs.exists(path)
        return DEFAULT_THEME
    text := fs.read_text(path) else return DEFAULT_THEME
    setting(text, "theme") else DEFAULT_THEME

## The theme used when none is saved (slice E1).
DEFAULT_THEME := "ail-dark"

## Remembers `name` in `~/.ail-edit`; a failure only shows a message.
fn save_theme(name str) str
    path := settings_path() else return "no home directory: the theme isn't remembered"
    mut text := ""
    if fs.exists(path)
        text = fs.read_text(path) else ""
    fs.write_text(path, with_setting(text, "theme", name)) else err
        return "can't write {err.path}: {err.kind}"
    ""

## The settings key for the tabs open in project directory `dir`.
fn session_key(dir str) str
    "open:{dir}"

## Tabs and cursors as a setting value: `LINE,COL,PATH` entries (1-based)
## separated by `|`, the active tab first (ADR 0339).
fn session_value(eds List[Editor], active int) str
    mut parts := List[str]()
    for i in 0..eds.len()
        ed := eds[(active + i) % eds.len()]
        parts.push("{ed.line + 1},{ed.col + 1},{ed.path}")
    parts.join("|")

## The places a session value names, the active tab first.
fn session_places(value str) List[Loc]
    mut out := List[Loc]()
    for part in value.split("|")
        bits := part.split(",")
        if bits.len() < 3
            continue
        l := bits[0].to_int() else continue
        c := bits[1].to_int() else continue
        out.push(Loc(path: bits[2..].join(","), line: l, col: c))
    out

## Remembers the open tabs and cursors for the current directory in
## `~/.ail-edit`; a failure is silent, since the window is closing.
fn Workspace.save_session(self)
    path := settings_path() else return
    mut text := ""
    if fs.exists(path)
        text = fs.read_text(path) else ""
    fs.write_text(path, with_setting(
        text,
        session_key(env.cwd()),
        session_value(self.eds, self.active),
    )) else err
        return

## Reopens the tabs remembered for the current directory, at their cursors,
## then shows the file the editor was started with.
fn Workspace.restore_session(mut self)
    path := settings_path() else return
    if not fs.exists(path)
        return
    text := fs.read_text(path) else return
    value := setting(text, session_key(env.cwd())) else return
    first := self.eds[self.active].path
    for at in session_places(value)
        if at.path == first
            self.eds[self.active].jump_to(at)
        elif fs.exists(at.path)
            self.open(at.path)
            self.eds[self.active].jump_to(at)
    self.open(first)

## Uses the theme called `name`; false, changing nothing, if there is none.
fn Workspace.set_theme(mut self, name str) bool
    t := themes.named(name) else return false
    self.theme = name
    self.pal = palette(t)
    true

## Ctrl-Shift-T: the next theme, remembered for the next start.
fn Workspace.next_theme(mut self)
    at := themes.NAMES.index_of(self.theme) else -1
    self.set_theme(themes.NAMES[(at + 1) % themes.NAMES.len()])
    self.message = "theme {self.theme}"
    if self.remember
        failed := save_theme(self.theme)
        if failed != ""
            self.message = "theme {self.theme} ({failed})"

## Applies one window event. Closing the window is Ctrl-Q: with unsaved
## changes the first close asks and the second quits.
fn Editor.on_event(mut self, ev ui.Event)
    if self.layer.pending and self.layer_confirm(ev)
        return
    match ev
        Key(code, ctrl, alt, shift) =>
            k := code.name()
            if cmd := extra_key(k, ctrl, alt, shift)
                self.run_extra(cmd)
            elif cmd := key_command(k, ctrl, alt, shift)
                self.with_system_clipboard(cmd)
        Resize(c, r) => self.apply(Command.Resize(cols: c, rows: r))
        Close => self.apply(Quit)
        Mouse(c, r, button, kind) => self.on_mouse(c, r, button, kind)
        Scroll(n) => self.scroll_by(n)

## Runs `cmd`, with Copy, Cut and Paste going through the system clipboard
## (std.ui.12) as well as the editor's own.
fn Editor.with_system_clipboard(mut self, cmd Command)
    if cmd == Paste
        if t := ui.clipboard_get()
            self.clip = t
    before := self.clip
    self.run(cmd)
    if (cmd == Copy or cmd == Cut) and self.clip != before or cmd == Copy and self.clip != ""
        ui.clipboard_set(self.clip)

# ---- Mouse and wheel ----------------------------------------------------

## The buffer position under screen cell (`c`, `r`), or `none` outside the
## text rows.
fn Editor.position_at(self, c int, r int) Range?
    if r < 0 or r >= self.text_rows() or self.lines.len() == 0
        return none
    mut l := self.row_line(r)
    if l < 0
        l = self.lines.len() - 1
    n := self.lines[l].chars().len()
    at := (self.left + c - self.gutter_width()).max(0).min(n)
    Range(line: l, col: at, end_line: l, end_col: at)

## A click places the caret and starts a selection that a drag extends. A
## click in the pane picks a diagnostic or an outline entry.
fn Editor.on_mouse(mut self, c int, r int, button ui.MouseButton, kind ui.MouseKind)
    if button != Left or kind == Up
        return
    if p := self.position_at(c, r)
        if kind == Down
            self.extra = []
            self.selecting = true
            self.anchor_line = p.line
            self.anchor_col = p.col
        self.line = p.line
        self.set_col(p.col)
        self.scroll()
        return
    if kind == Down
        self.click_pane(r - self.text_rows() - 1)

## Shift-click: select from the caret, or the selection's start, to the
## place under screen cell (`c`, `r`).
fn Editor.extend_to(mut self, c int, r int)
    p := self.position_at(c, r) else return
    if not self.selecting or self.selection() == none
        self.selecting = true
        self.anchor_line = self.line
        self.anchor_col = self.col
    self.line = p.line
    self.set_col(p.col)
    self.scroll()

## A click on row `i` of the pane: jump to that diagnostic or outline item.
fn Editor.click_pane(mut self, i int)
    if i < 0
        return
    if self.pane == Diags and i < self.diags.len()
        d := self.diags[i]
        self.line = (d.line - 1).max(0).min(self.lines.len() - 1)
        self.set_col((d.col - 1).max(0).min(self.cur().len()))
        self.selecting = false
        self.scroll()
    elif loc := self.pane_location(i)
        if loc.path == self.path
            self.jump_to(loc)
    elif self.pane == Outline
        start := (self.outline_sel - self.pane_rows() + 1).max(0)
        if start + i < self.outline.len()
            self.outline_sel = start + i
            self.apply(Newline)

## The wheel moves the view by `n` lines without moving the caret; the next
## key brings the caret back into view.
fn Editor.scroll_by(mut self, n int)
    self.top = (self.top + n).min(self.lines.len() - 1).max(0)

# ---- Running the program and its tests ----------------------------------

## Commands of the window front end that aren't in `key_command`.
enum Extra
    RunFile
    TestFile
    Hints
    Signature

fn extra_key(key str, ctrl bool, alt bool, shift bool) Extra?
    if ctrl and shift and not alt and key == " "
        return Signature
    if alt and not ctrl and not shift and (key == "i" or key == "I")
        return Hints
    if ctrl or alt
        return none
    match key
        "f5" => RunFile
        "f6" => TestFile
        _ => none

## F5 runs the buffer with `ail run`, F6 its tests with `ail test`; the
## output goes to the pane. Unsaved changes are run as they are.
fn Editor.run_extra(mut self, x Extra)
    if x == Hints
        self.layer_key("h")
        return
    if x == Signature
        self.index()
        self.signature_help()
        if self.layer.sig.rows.len() == 0
            self.message = "not inside a call of a known function"
        return
    words := match x
        RunFile => ["run"]
        TestFile => ["test"]
        Hints | Signature => []
    r := self.ail_on_buffer(words) else return
    self.show_output(words[0], r)

## Runs the buffer's tests with `ail test --json` and keeps the counts for
## the status line, leaving the pane as it is (ADR 0354).
fn Editor.test_quietly(mut self)
    r := self.ail_on_buffer(["test", "--json"]) else return
    self.tests = test_counts(r.out)

## `tests P/N` from `ail test --json` output, or `tests: didn't run` when
## it has no summary (the program doesn't check).
fn test_counts(out str) str
    for l in out.lines()
        j := parse_json(l) else continue
        if j.get("summary") != none
            passed := jint(j, "passed")
            failed := jint(j, "failed")
            if failed > 0
                return "tests {failed} FAILED of {passed + failed}"
            return "tests {passed}/{passed} pass"
    "tests: didn't run"

@test fn test_counts_read_the_summary()
    assert_eq(
        test_counts("\{\"test\":\"a\"}\n\{\"summary\":true,\"passed\":2,\"failed\":1}\n"),
        "tests 1 FAILED of 3",
    )
    assert_eq(test_counts("\{\"summary\":true,\"passed\":2,\"failed\":0}"), "tests 2/2 pass")
    assert_eq(test_counts(""), "tests: didn't run")

## Shows a run's output in the pane: a header, then standard output and
## standard error. When it doesn't fit, the end is kept, since traps and
## failures come last. A click on a line with a location jumps there.
fn Editor.show_output(mut self, what str, r proc.Output)
    mut out := List[str]()
    for l in r.out.lines()
        out.push(l)
    for l in r.err.lines()
        out.push(l)
    self.pane = Text
    room := (self.pane_rows() - 1).max(1)
    self.pane_text = ["ail {what}: exit {r.status}"]
    if out.len() > room
        self.pane_text.push("... {out.len() - room + 1} lines above")
        out = out[out.len() - room + 1..]
    for l in out
        self.pane_text.push(l)
    self.message = "{what}: exit {r.status}; click a location to jump, Esc closes"

## A place in a file named by run output.
struct Loc
    path str
    line int
    col int

## The digits at the start of `cs` from `i`, as a number, and where they end.
fn number_at(cs List[char], i int) Range?
    mut j := i
    mut n := 0
    while j < cs.len() and cs[j].is_digit()
        n = n * 10 + (cs[j].to_digit(10) else 0)
        j += 1
    if j == i
        return none
    Range(line: n, col: j, end_line: 0, end_col: 0)

## The location in a line of `ail run` or `ail test` output: `FILE:L:C`
## (traps and failures) or `at L:C` (a failed test, in `path`). A check
## copy of an unsaved buffer (`FILE.edit-check.ail`) counts as `FILE`.
fn output_location(text str, path str) Loc?
    cs := text.chars()
    for i in 0..cs.len()
        if cs[i] != ':' or i < 4 or cs[i - 4..i].join("") != ".ail"
            continue
        l := number_at(cs, i + 1) else continue
        mut c := 1
        if l.col < cs.len() and cs[l.col] == ':'
            if n := number_at(cs, l.col + 1)
                c = n.line
        mut file := cs[..i].join("").trim()
        if f := file.strip_suffix(".edit-check.ail")
            file = f
        return Loc(path: file, line: l.line, col: c)
    parts := text.split(" at ")
    if parts.len() > 1
        tail := parts[parts.len() - 1].chars()
        l := number_at(tail, 0) else return none
        if l.col < tail.len() and tail[l.col] == ':'
            c := number_at(tail, l.col + 1) else return none
            return Loc(path: path, line: l.line, col: c.line)
    none

## Moves the caret to `loc`, which is in this editor's file.
fn Editor.jump_to(mut self, loc Loc)
    self.line = (loc.line - 1).max(0).min(self.lines.len() - 1)
    self.set_col((loc.col - 1).max(0).min(self.cur().len()))
    self.selecting = false
    self.scroll()

## The location named by pane row `i` of the output pane, if any.
fn Editor.pane_location(self, i int) Loc?
    if self.pane != Text or i < 0 or i >= self.pane_text.len()
        return none
    output_location(self.pane_text[i], self.path)

# ---- Keys and the command palette (Ctrl-Shift-P) ------------------------

## One row of the key table: the keys as the README shows them, the
## command's name in the palette, the key it presses (`ctrl+shift+f`
## form; empty for rows that aren't one command), and what it does. The
## README's table is `--keys` output and the palette is this list, so the
## two can't drift (ADR 0291).
struct KeyRow
    keys str
    name str
    spec str
    does str

fn key_row(shown str, name str, spec str, does str) KeyRow
    KeyRow(keys: shown, name: name, spec: spec, does: does)

## Every key, in the README's order.
fn key_rows() List[KeyRow]
    [
        key_row(
            "Arrows, Home, End, PageUp, PageDown",
            "",
            "",
            "Move. Home goes to the indentation, then column 1",
        ),
        key_row("Ctrl-Left, Ctrl-Right", "", "", "Move by word"),
        key_row(
            "Shift with any move",
            "",
            "",
            "Select; typing, Backspace or Delete replaces the selection",
        ),
        key_row("Ctrl-Home", "Go to the start of the file", "ctrl+home", "Start of the file"),
        key_row("Ctrl-End", "Go to the end of the file", "ctrl+end", "End of the file"),
        key_row("Ctrl-A", "Select all", "ctrl+a", "Select all"),
        key_row("Ctrl-C", "Copy", "ctrl+c", "Copy (in the window, also to the system clipboard)"),
        key_row("Ctrl-X", "Cut", "ctrl+x", "Cut (in the window, also to the system clipboard)"),
        key_row("Ctrl-V", "Paste", "ctrl+v", "Paste (in the window, from the system clipboard)"),
        key_row(
            "Enter",
            "",
            "",
            "New line, indented like this one, one level deeper after a block opener (`fn`, `if`, `match`, `x => `, `else err`, ...)",
        ),
        key_row("Tab", "", "", "Spaces to the next multiple of 4 (AIL has no tabs, lex.block.1)"),
        key_row("Backspace", "", "", "In indentation, removes one level"),
        key_row(
            "`(` `[` `\{` `\"`",
            "",
            "",
            "Insert the closing pair; typing the closer steps over it; Backspace in an empty pair deletes both",
        ),
        key_row(
            "Ctrl-Space",
            "Complete",
            "ctrl+space",
            "Complete the word: after `.`, fields, variants and methods; otherwise locals, the file's declarations (with signatures), keywords and words in the buffer. Up/Down choose, Enter or Tab accepts, Escape closes",
        ),
        key_row(
            "F12",
            "Go to definition",
            "f12",
            "Go to the definition of the name under the cursor, locals included (`ail api --refs`, else the `--symbols` index)",
        ),
        key_row(
            "Shift-F12",
            "Find references",
            "shift+f12",
            "Every place `ail api --refs` finds for the name under the cursor, its declaration included, in this file and others; Up/Down, Enter jumps, Esc closes (ADR 0489)",
        ),
        key_row(
            "Ctrl-I",
            "Show info",
            "ctrl+i",
            "Info on the name under the cursor: its type (`ail api --type`), signature, contracts, effects, error set, doc comment and number of uses (`--refs`) (ADR 0312)",
        ),
        key_row(
            "F2",
            "Rename",
            "f2",
            "Rename the name under the cursor: through `ail api --refs` (declarations and locals), else every whole word; the prompt shows the count and how they were found, Enter applies, Ctrl-Z undoes (ADR 0244)",
        ),
        key_row(
            "Alt-Shift-F",
            "Format",
            "alt+shift+f",
            "Format with `ail fmt` (also on save, when the program has no errors)",
        ),
        key_row(
            "Ctrl-/",
            "Toggle comment",
            "ctrl+/",
            "Comment or uncomment the line or selected lines",
        ),
        key_row("Ctrl-D", "Duplicate line", "ctrl+d", "Duplicate the line or selected lines"),
        key_row("Alt-Up", "Move line up", "alt+up", "Move the line or selected lines up"),
        key_row("Alt-Down", "Move line down", "alt+down", "Move the line or selected lines down"),
        key_row(
            "Alt-D",
            "Add next occurrence",
            "alt+d",
            "Select the word under the cursor; again, add a caret at its next occurrence. With several carets typing, Enter, Tab, Backspace, Delete, paste and moves act at every caret; Escape or a click drops the extras",
        ),
        key_row("Alt-Shift-Up", "Add caret above", "alt+shift+up", "Add a caret on the line above"),
        key_row(
            "Alt-Shift-Down",
            "Add caret below",
            "alt+shift+down",
            "Add a caret on the line below",
        ),
        key_row("Alt-click", "", "", "Add a caret at the clicked place (window)"),
        key_row(
            "Ctrl-Shift-[",
            "Fold or unfold block",
            "ctrl+shift+[",
