## The editor's color themes (ADR 0295). A theme maps a color kind of the
## editor to 0xRRGGBB; a kind it leaves out keeps the dark default. The
## kinds are those `edit.ail` names in `FG_KINDS` and `BG_KINDS`.

## The theme names, in the order Ctrl-Shift-T cycles through them.
pub NAMES := ["dark", "light", "solarized", "high-contrast"]

## The theme called `name`, or `none` for an unknown name.
pub fn named(name str) Map[str, int]?
    if name == "dark"
        return Map[str, int]()
    if name == "light"
        return LIGHT
    if name == "solarized"
        return SOLARIZED
    if name == "high-contrast"
        return HIGH_CONTRAST
    none

