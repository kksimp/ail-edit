## The editor's color themes (ADR 0295). A theme maps a color kind of the
## editor to 0xRRGGBB; a kind it leaves out keeps the dark default. The
## kinds are those `edit.ail` names in `FG_KINDS` and `BG_KINDS`.

## The theme names, in the order Ctrl-Shift-T cycles through them.
pub NAMES := ["ail-dark", "ail-light", "dark", "light", "solarized", "high-contrast"]

## The theme called `name`, or `none` for an unknown name.
pub fn named(name str) Map[str, int]?
    if name == "ail-dark"
        return AIL_DARK
    if name == "ail-light"
        return AIL_LIGHT
    if name == "dark"
        return Map[str, int]()
    if name == "light"
        return LIGHT
    if name == "solarized"
        return SOLARIZED
    if name == "high-contrast"
        return HIGH_CONTRAST
    none

## The default theme (slice E1): cool grey panes, blue-leaning syntax colors.
AIL_DARK := {
    "bg": 0x17181c,
    "pane_bg": 0x1d1f24,
    "line_bg": 0x22252b,
    "fg": 0xd6d9e0,
    "gutter_fg": 0x6b7280,
    "status_bg": 0x1d1f24,
    "status_fg": 0x9aa1ad,
